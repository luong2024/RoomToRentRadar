{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "CosmosDb": {
    "AccountEndpoint": "",
    "AuthKeyOrResourceToken": "",
    "DatabaseName": "RoomToRentRadarDb",
    "UsersContainerName": "Users",
    "RefreshTokensContainerName": "RefreshTokens",
    "EmailIndexContainerName": "EmailIndex",
    "ConnectionMode": "Direct"
  },
  "Jwt": {
    "Issuer": "RoomToRentRadar.Api",
    "Audience": "RoomToRentRadar.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "RateLimiting": {
    "AuthPermitLimit": 30,
    "AuthWindowSeconds": 60
  }
}
