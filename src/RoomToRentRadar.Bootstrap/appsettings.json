{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "RoomToRentRadar.Api",
    "Audience": "RoomToRentRadar.Client",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7,
    "ClockSkewSeconds": 30
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "Routing": {
    "BaseUrl": "https://router.project-osrm.org/",
    "Profile": "driving",
    "TimeoutSeconds": 10
  },
  "RateLimiting": {
    "AuthPermitLimit": 30,
    "AuthWindowSeconds": 60,
    "RoutingPermitLimit": 60,
    "RoutingWindowSeconds": 60
  },
  "PhotoStorage": {
    "Provider": "CloudflareR2",
    "AccountId": "",
    "BucketName": "roomtorentradar-photos",
    "AccessKeyId": "",
    "SecretAccessKey": "",
    "PublicBaseUrl": ""
  }
}