{
  "ConnectionStrings": {
    "Default": "Data Source=App_Data/roomtorentradar.db"
  },
  "Alerts": {
    "Enabled": true,
    "SweepIntervalMinutes": 5,
    "LookbackMinutes": 30,
    "DailyCap": 3
  },
  "Auth": {
    "RateLimitPerMinute": 10,
    "VerifyRateLimitPerMinute": 20,
    "Token": {
      "Issuer": "RoomToRentRadar.Api",
      "Audience": "RoomToRentRadar"
    },
    "Email": {
      "Smtp": {
        "Host": "",
        "Port": 587,
        "UseStartTls": true,
        "TimeoutSeconds": 8,
        "FromAddress": "no-reply@roomtorentradar.local",
        "FromName": "RoomToRentRadar",
        "OutboxDirectory": ""
      }
    }
  },
  "Travel": {
    "GoogleRoutesApiKey": "",
    "CacheMinutes": 10,
    "FallbackCacheSeconds": 45,
    "RateLimitPerMinute": 15
  },
  "ForwardedHeaders": {
    "KnownProxies": [],
    "KnownNetworks": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
