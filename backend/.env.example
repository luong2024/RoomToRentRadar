# =============================================================================
# Template for docker-compose.yml. Copy it, then fill in your own values:
#   PowerShell:  Copy-Item .env.example .env
# The real .env file is ignored by git: NEVER commit it.
# =============================================================================

# Secret used to sign JWT access tokens (HMAC-SHA256). Required, at least 32 characters.
# Generate a random one in PowerShell:
#   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
JWT_SIGNING_KEY=

# Host port for the API (the container always listens on 8080). Optional, default 8080.
API_PORT=8080

# Production (default) or Development (adds detailed error pages; never use when deployed).
ASPNETCORE_ENVIRONMENT=Production
