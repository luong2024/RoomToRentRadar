## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.

# Visual Studio & IDE cache/user files
.vs/
.vscode/
.idea/
*.rsuser
*.suo
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.sln.iml

# Mono Auto Generated Files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# Testing & Coverage
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
*.trx
coverage.cobertura.xml
*.coverage
*.coveragexml
*.VisualState.xml
TestResult.xml
nunit-*.xml

# .NET Core / .NET
project.lock.json
project.fragment.lock.json
artifacts/
launchSettings.json.user

# NuGet Packages
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
*.nuget.props
*.nuget.targets

# Android & MAUI Packages
*.apk
*.aab
*.ap_
*.dex

# Keystores & Signing Secrets (CRITICAL SECURITY)
*.keystore
*.jks
*.p12
*.pfx
*.cer
*.crt
*.mobileprovision
release.keystore
debug.keystore

# macOS / iOS / OS generated files
.DS_Store
Thumbs.db
*.app
*.dSYM/
*.ipa

# Local secrets & environment files
.env
.env.*
appsettings.Development.Local.json

# Ignored Markdown Documentation Files
README.md
CI-CD.md
**/CI-CD.md
