<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoWarn>$(NoWarn);MVVMTK0045</NoWarn>
  </PropertyGroup>

  <!--
    Automatically activates repository-tracked Git hooks (.githooks/) on every developer machine
    the very first time they build in Visual Studio or via `dotnet build` — zero manual setup required.
  -->
  <Target Name="EnsureGroup5GitHooksInstalled" BeforeTargets="CoreCompile" Condition="Exists('$(MSBuildThisFileDirectory).git') and Exists('$(MSBuildThisFileDirectory).githooks')">
    <Exec Command="git config core.hooksPath .githooks"
          WorkingDirectory="$(MSBuildThisFileDirectory)"
          IgnoreExitCode="true"
          StandardOutputImportance="Low"
          StandardErrorImportance="Low" />
  </Target>
</Project>
