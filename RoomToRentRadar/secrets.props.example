<!-- Template for local developer settings. Copy this file to secrets.props and set your Google Maps API key below. -->
<!-- File secrets.props is ignored by Git to prevent leaking credentials to public/remote repositories. -->
<!-- NOTE ON ANDROID SECURITY: Client API keys injected into AndroidManifest are packaged into the APK and can be inspected. -->
<!-- To secure your Google Maps key in Google Cloud Console: -->
<!--   1. API restrictions: Restrict the key solely to 'Maps SDK for Android'. -->
<!--   2. Application restrictions: Restrict by Android app package name (com.companyname.roomtorentradar) and SHA-1 signing fingerprint. -->
<!--   3. Never reuse this key for backend services or non-Maps APIs. -->
<Project>
	<PropertyGroup>
		<GoogleMapsApiKey>YOUR-ACTUAL-GOOGLE-MAPS-API-KEY-HERE</GoogleMapsApiKey>
	</PropertyGroup>
</Project>
