<!-- Template for local developer settings. Copy this file to secrets.props and put your real Google Maps API key below. -->
<!-- File secrets.props is ignored by Git, so your secret key will NEVER be committed or leaked. -->
<Project>
	<PropertyGroup>
		<GoogleMapsApiKey>YOUR-ACTUAL-GOOGLE-MAPS-API-KEY-HERE</GoogleMapsApiKey>
	</PropertyGroup>
</Project>
