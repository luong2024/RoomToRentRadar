# =============================================================================
# RoomToRentRadar - Mobile Client Environment Configuration Template
# Copy this file to client.env and replace the values with your local client config.
# NOTE: client.env is git-ignored and should NEVER contain server secrets or connection strings.
# =============================================================================

# -----------------------------------------------------------------------------
# Google OAuth 2.0 Client Configuration (US13 - Authentication)
# -----------------------------------------------------------------------------
# Client ID obtained from Google Cloud Console (APIs & Services > Credentials)
# Format: <project-number>-<hash>.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Android Custom URI Scheme redirect (matches ApplicationId)
GOOGLE_REDIRECT_URI=com.companyname.roomtorentradar:/oauth2redirect

# -----------------------------------------------------------------------------
# Backend API Configuration
# -----------------------------------------------------------------------------
# Base URL for API calls from client (10.0.2.2 for Android Emulator, localhost for Windows)
API_BASE_URL=http://10.0.2.2:5000

