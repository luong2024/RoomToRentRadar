<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.ViewModels"
             x:Class="RoomToRentRadar.Views.FavouritesPage"
             x:DataType="viewModels:FavouritesViewModel"
             Title="Yêu thích"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All">

    <Grid Padding="20,16,20,20" RowDefinitions="Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="BỘ SƯU TẬP CỦA BẠN"
                   Style="{StaticResource Eyebrow}"
                   FontSize="9"
                   TextColor="{StaticResource Accent}" />
            <Label Text="Phòng yêu thích"
                   FontSize="26" FontFamily="OpenSansSemibold" CharacterSpacing="-0.4"
                   SemanticProperties.HeadingLevel="Level1" />
        </VerticalStackLayout>

        <!-- Loading -->
        <ActivityIndicator Grid.Row="1"
                           IsRunning="{Binding IsLoadingVisible}"
                           IsVisible="{Binding IsLoadingVisible}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Đang tải phòng yêu thích" />

        <!-- Content -->
        <CollectionView Grid.Row="1"
                        ItemsSource="{Binding Favourites}"
                        IsVisible="{Binding IsContentVisible}"
                        SelectionMode="None"
                        AutomationId="FavouritesList">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewModels:FavouriteRoomItem">
                    <Border Padding="14"
                            Margin="0,0,0,10"
                            StrokeShape="RoundRectangle 20"
                            SemanticProperties.Description="{Binding Title}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnFavouriteTapped"
                                                  CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <Grid ColumnDefinitions="76,*" ColumnSpacing="14">
                            <Border WidthRequest="76" HeightRequest="76"
                                    StrokeShape="RoundRectangle 16" StrokeThickness="0"
                                    VerticalOptions="Start">
                                <Image Source="{Binding PhotoSource}" Aspect="AspectFill" />
                            </Border>
                            <VerticalStackLayout Grid.Column="1" Spacing="5">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding Title}"
                                           FontSize="15" FontFamily="OpenSansSemibold"
                                           LineBreakMode="TailTruncation"
                                           VerticalOptions="Center" />
                                    <Button Grid.Column="1"
                                            Text="♥"
                                            FontSize="20"
                                            Padding="0"
                                            WidthRequest="42" HeightRequest="42"
                                            MinimumHeightRequest="42"
                                            CornerRadius="21"
                                            BackgroundColor="{StaticResource SoftSurface}"
                                            TextColor="{StaticResource Accent}"
                                            Clicked="OnRemoveClicked"
                                            AutomationId="FavouriteRemoveButton"
                                            SemanticProperties.Description="Bỏ lưu phòng này"
                                            SemanticProperties.Hint="Bỏ phòng khỏi danh sách yêu thích, có thể hoàn tác trong 5 giây" />
                                </Grid>
                                <Label Text="{Binding PriceText, StringFormat='{0} / tháng'}"
                                       FontSize="14" FontFamily="OpenSansSemibold"
                                       TextColor="{StaticResource Accent}" />
                                <HorizontalStackLayout Spacing="8">
                                    <Border Padding="8,3"
                                            BackgroundColor="{StaticResource AccentSoft}"
                                            StrokeThickness="0"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding StatusText}"
                                               Style="{StaticResource Eyebrow}"
                                               FontSize="9"
                                               TextColor="{StaticResource Accent}" />
                                    </Border>
                                    <Label Text="{Binding AreaText}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                    <Label Text="{Binding BedroomsText}"
                                           Style="{StaticResource Caption}"
                                           VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Address}"
                                       Style="{StaticResource Caption}"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Empty -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsEmptyVisible}"
                             Spacing="12"
                             VerticalOptions="Center">
            <Label Text="Chưa có phòng yêu thích"
                   FontSize="22" FontFamily="OpenSansSemibold"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="Nhấn ♡ trên trang chi tiết phòng để lưu lại và so sánh sau này."
                   Style="{StaticResource BodyText}" />
        </VerticalStackLayout>

        <!-- Signed out -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsSignedOutVisible}"
                             Spacing="12"
                             VerticalOptions="Center">
            <Label Text="Đăng nhập để đồng bộ phòng yêu thích"
                   FontSize="22" FontFamily="OpenSansSemibold"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="Phòng yêu thích được lưu theo tài khoản nên bạn có thể xem lại trên mọi thiết bị."
                   Style="{StaticResource BodyText}" />
            <Button Text="Đăng nhập"
                    Command="{Binding ShowLoginCommand}"
                    HorizontalOptions="Start"
                    AutomationId="FavouritesSignInButton"
                    SemanticProperties.Description="Đăng nhập để xem phòng yêu thích đã lưu"
                    SemanticProperties.Hint="Mở trang đăng nhập" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout Grid.Row="1"
                             IsVisible="{Binding IsErrorVisible}"
                             Spacing="12"
                             VerticalOptions="Center">
            <Label Text="Chưa tải được phòng yêu thích"
                   FontSize="22" FontFamily="OpenSansSemibold"
                   SemanticProperties.HeadingLevel="Level2" />
            <Label Text="Kiểm tra kết nối mạng rồi thử lại nhé."
                   Style="{StaticResource BodyText}" />
            <Button Text="Thử lại"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="Tải lại danh sách phòng yêu thích"
                    SemanticProperties.Hint="Tải lại danh sách phòng yêu thích" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
