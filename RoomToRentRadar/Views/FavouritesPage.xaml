<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             x:Class="RoomToRentRadar.Views.FavouritesPage"
             x:DataType="vm:FavouritesViewModel"
             Title="Đã lưu"
             SafeAreaEdges="Container">

    <Grid>
        <!-- Ambient Liquid Glass Light Field -->
        <controls:LiquidBackdropView />

        <Grid RowDefinitions="Auto,*">

            <!-- Floating Liquid Glass Header -->
            <VerticalStackLayout Grid.Row="0" Padding="16,10,16,8">
                <Border Style="{StaticResource LiquidFloatingPanel}" Padding="18,14">
                    <VerticalStackLayout Spacing="2">
                        <Label Text="BỘ SƯU TẬP YÊU THÍCH" Style="{StaticResource Eyebrow}" />
                        <Label Text="Phòng đã lưu" Style="{StaticResource PageTitle}" />
                        <Label Text="Theo dõi nhanh giá thuê &amp; tình trạng phòng bạn quan tâm"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <!-- States & Saved Rooms Collection -->
            <Grid Grid.Row="1">
                <VerticalStackLayout IsVisible="{Binding IsLoadingVisible}" Padding="16,8" Spacing="14">
                    <controls:SkeletonPropertyCard />
                </VerticalStackLayout>

                <ContentView IsVisible="{Binding IsSignedOutVisible}" Padding="16,12">
                    <controls:StateFeedbackView IconSource="person_icon.png"
                                                EyebrowText="ĐỒNG BỘ ĐÁM MÂY"
                                                TitleText="Đăng nhập để xem phòng đã lưu"
                                                SubtitleText="Lưu và đồng bộ danh sách phòng yêu thích trên mọi thiết bị."
                                                ActionText="Đăng nhập ngay"
                                                ActionCommand="{Binding ShowLoginCommand}" />
                </ContentView>

                <ContentView IsVisible="{Binding IsEmptyVisible}" Padding="16,12">
                    <controls:StateFeedbackView IconSource="heart_outline.png"
                                                EyebrowText="CHƯA CÓ PHÒNG LƯU"
                                                TitleText="Danh sách yêu thích đang trống"
                                                SubtitleText="Chạm biểu tượng trái tim trên phòng trọ bất kỳ để lưu lại xem sau." />
                </ContentView>

                <ContentView IsVisible="{Binding IsErrorVisible}" Padding="16,12">
                    <controls:StateFeedbackView IconSource="close_icon.png"
                                                EyebrowText="LỖI TẢI DỮ LIỆU"
                                                TitleText="Chưa tải được phòng đã lưu"
                                                SubtitleText="Kiểm tra kết nối mạng và thử tải lại."
                                                ActionText="Thử lại"
                                                ActionCommand="{Binding LoadCommand}" />
                </ContentView>

                <CollectionView IsVisible="{Binding IsContentVisible}"
                                ItemsSource="{Binding Favourites}"
                                SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:FavouriteRoomItem">
                            <ContentView Padding="16,0">
                                <Border Style="{StaticResource LiquidGlassCard}" Padding="12">
                                    <Grid ColumnDefinitions="98,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                        <Border Grid.Column="0"
                                                WidthRequest="98"
                                                HeightRequest="98"
                                                StrokeShape="RoundRectangle 18"
                                                StrokeThickness="0"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavouriteTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="{Binding PhotoSource}" Aspect="AspectFill" />
                                        </Border>

                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <VerticalStackLayout.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnFavouriteTapped" CommandParameter="{Binding .}" />
                                            </VerticalStackLayout.GestureRecognizers>

                                            <HorizontalStackLayout Spacing="6">
                                                <Border Padding="8,3"
                                                        StrokeShape="RoundRectangle 999"
                                                        StrokeThickness="0"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}">
                                                    <Label Text="{Binding StatusText}"
                                                           FontFamily="FontSemiBold"
                                                           FontSize="10.5"
                                                           TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                </Border>
                                                <Label Text="{Binding AreaText}" Style="{StaticResource Caption}" FontSize="11.5" VerticalOptions="Center" />
                                            </HorizontalStackLayout>

                                            <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" FontSize="15" MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding PriceText}"
                                                   FontFamily="FontBold"
                                                   FontSize="16"
                                                   TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                            <Label Text="{Binding Address}" Style="{StaticResource Caption}" FontSize="11.5" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>

                                        <Border Grid.Column="2"
                                                Style="{StaticResource LiquidOrbBorder}"
                                                VerticalOptions="Center"
                                                SemanticProperties.Description="Xóa khỏi yêu thích">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnRemoveTapped" CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Image Source="close_icon.png" WidthRequest="15" HeightRequest="15" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </Border>
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.Footer>
                        <BoxView HeightRequest="28" Color="Transparent" />
                    </CollectionView.Footer>
                </CollectionView>
            </Grid>

        </Grid>
    </Grid>
</ContentPage>
