<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.LoginPage"
             x:DataType="vm:LoginViewModel"
             Title="Đăng nhập"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="Container">

    <Grid>
        <!-- Ambient Liquid Glass Light Field -->
        <controls:LiquidBackdropView />

        <ScrollView>
            <VerticalStackLayout x:Name="LoginContent"
                                 Padding="20,14,20,24"
                                 Spacing="18"
                                 MaximumWidthRequest="460">

                <!-- Top Bar -->
                <Grid ColumnDefinitions="Auto,*,Auto" VerticalOptions="Center">
                    <Border Grid.Column="0"
                            Style="{StaticResource LiquidOrbBorder}"
                            AutomationId="LoginBackButton">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CancelCommand}" />
                        </Border.GestureRecognizers>
                        <Image Source="back_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                    </Border>

                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <Image Source="radar_mark.png" WidthRequest="30" HeightRequest="30" />
                        <Label Text="Room Radar" FontFamily="FontBold" FontSize="17" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <BoxView Grid.Column="2" WidthRequest="44" Color="Transparent" />
                </Grid>

                <!-- Compact Single Heading (Fits one screen without scrolling!) -->
                <Label Text="Đăng nhập" Style="{StaticResource DisplayTitle}" FontSize="27" />

                <!-- Liquid Glass Auth Surface -->
                <Border Style="{StaticResource LiquidGlassCard}" Padding="20">
                    <VerticalStackLayout Spacing="16">

                        <!-- Liquid Glass Segmented Role Switcher -->
                        <Border Style="{StaticResource LiquidSegmentedTrack}">
                            <Grid ColumnDefinitions="*,*" ColumnSpacing="4">
                                <Border Grid.Column="0"
                                        Padding="10,10"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        AutomationId="LoginStudentTab">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsStudent}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#223554}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectStudentCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="Sinh viên" FontFamily="FontBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                                        <Label Text="Tìm &amp; lưu phòng" Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>

                                <Border Grid.Column="1"
                                        Padding="10,10"
                                        StrokeShape="RoundRectangle 14"
                                        StrokeThickness="0"
                                        BackgroundColor="Transparent"
                                        AutomationId="LoginLandlordTab">
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsLandlord}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#223554}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectLandlordCommand}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="1" HorizontalOptions="Center">
                                        <Label Text="Chủ phòng" FontFamily="FontBold" FontSize="13.5" HorizontalTextAlignment="Center" />
                                        <Label Text="Quản lý tin đăng" Style="{StaticResource Caption}" FontSize="11" HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <inputLayout:SfTextInputLayout Hint="Địa chỉ email"
                                                       HasError="{Binding HasEmailError}"
                                                       ErrorText="{Binding EmailError}">
                            <Entry Text="{Binding Email}"
                                   Keyboard="Email"
                                   ReturnType="Next"
                                   AutomationId="LoginEmailEntry" />
                        </inputLayout:SfTextInputLayout>

                        <inputLayout:SfTextInputLayout Hint="Mật khẩu"
                                                       EnablePasswordVisibilityToggle="True"
                                                       HasError="{Binding HasPasswordError}"
                                                       ErrorText="{Binding PasswordError}">
                            <Entry Text="{Binding Password}"
                                   IsPassword="True"
                                   ReturnType="Go"
                                   ReturnCommand="{Binding SignInCommand}"
                                   AutomationId="LoginPasswordEntry" />
                        </inputLayout:SfTextInputLayout>

                        <Label IsVisible="{Binding HasError}"
                               Text="{Binding ErrorMessage}"
                               FontFamily="FontSemiBold"
                               FontSize="12.5"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        <buttons:SfButton Text="Đăng nhập"
                                          Command="{Binding SignInCommand}"
                                          IsEnabled="{Binding IsNotBusy}"
                                          Style="{StaticResource LiquidPrimaryButton}"
                                          AutomationId="LoginSubmitButton" />

                    </VerticalStackLayout>
                </Border>

                <buttons:SfButton Text="Chưa có tài khoản? Tạo tài khoản mới"
                                  Command="{Binding GoToRegisterCommand}"
                                  Style="{StaticResource GhostSfButton}"
                                  HorizontalOptions="Center"
                                  AutomationId="LoginGoToRegisterButton" />

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
