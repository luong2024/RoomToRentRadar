<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.ModerationQueuePage"
             x:DataType="vm:ModerationQueueViewModel"
             Title="Kiểm duyệt"
             SafeAreaEdges="All">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="0"
          MaximumWidthRequest="960" HorizontalOptions="Fill">
        <!-- Header -->
        <Border StrokeShape="Rectangle" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="16,14" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Kiểm duyệt" Style="{StaticResource ScreenTitle}" FontSize="22"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Hàng đợi duyệt tin cho thuê" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <buttons:SfButton Grid.Column="1" Text="Làm mới" Command="{Binding LoadCommand}"
                                      Style="{StaticResource SoftSfButton}" VerticalOptions="Center"
                                      WidthRequest="96" HeightRequest="46" Padding="12,0"
                                      AutomationId="ModerationRefresh" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Progress & Banner -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,0" Spacing="8">
            <progressBar:SfLinearProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Border Padding="14,10" StrokeShape="RoundRectangle 14"
                    IsVisible="{Binding HasMessage}" StrokeThickness="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12.5"
                       SemanticProperties.Description="Thông báo kiểm duyệt" />
            </Border>
        </VerticalStackLayout>

        <!-- Loading -->
        <VerticalStackLayout Grid.Row="2" IsVisible="{Binding IsLoadingState}" Spacing="12"
                             VerticalOptions="Center" HorizontalOptions="Center" Padding="24">
            <ActivityIndicator IsRunning="{Binding IsLoadingState}" Color="{StaticResource Accent}" />
            <Label Text="Đang tải hàng đợi kiểm duyệt…" Style="{StaticResource Caption}" FontSize="13" />
        </VerticalStackLayout>

        <!-- Signed out -->
        <ScrollView Grid.Row="2" Padding="16,20" IsVisible="{Binding IsSignedOutState}">
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="14">
                    <Label Text="CẦN ĐĂNG NHẬP" Style="{StaticResource Eyebrow}"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                    <Label Text="Đăng nhập để duyệt tin" FontSize="22" FontFamily="OpenSansSemibold" />
                    <Label Text="Hàng đợi kiểm duyệt chỉ dành cho điều hành viên và quản trị viên."
                           Style="{StaticResource Caption}" FontSize="13.5" LineHeight="1.35" />
                    <buttons:SfButton Text="Đăng nhập" Command="{Binding SignInCommand}" HorizontalOptions="Fill"
                                      AutomationId="ModerationSignIn" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Denied -->
        <ScrollView Grid.Row="2" Padding="16,20" IsVisible="{Binding IsDeniedState}">
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="12">
                    <Label Text="KHÔNG CÓ QUYỀN TRUY CẬP" Style="{StaticResource Eyebrow}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                    <Label Text="Tài khoản của bạn không thể kiểm duyệt" FontSize="22" FontFamily="OpenSansSemibold" />
                    <Label Text="Tính năng này dành cho tài khoản điều hành viên hoặc quản trị viên. Hãy đăng nhập bằng tài khoản phù hợp."
                           Style="{StaticResource Caption}" FontSize="13.5" LineHeight="1.35" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Error -->
        <ScrollView Grid.Row="2" Padding="16,20" IsVisible="{Binding IsErrorState}">
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Chưa tải được hàng đợi" FontSize="22" FontFamily="OpenSansSemibold" />
                    <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="13.5" LineHeight="1.35" />
                    <buttons:SfButton Text="Thử lại" Command="{Binding LoadCommand}" HorizontalOptions="Start" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Empty -->
        <ScrollView Grid.Row="2" Padding="16,20" IsVisible="{Binding IsEmptyState}">
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                            Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                        <Image Source="radar_mark.png" WidthRequest="28" HeightRequest="28" />
                    </Border>
                    <Label Text="Không có tin nào chờ duyệt" FontFamily="OpenSansSemibold" FontSize="17" HorizontalTextAlignment="Center" />
                    <Label Text="Các tin mới gửi từ chủ phòng sẽ xuất hiện ở đây để bạn duyệt."
                           Style="{StaticResource Caption}" FontSize="13" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- Queue -->
        <CollectionView Grid.Row="2" ItemsSource="{Binding Items}" SelectionMode="None"
                        IsVisible="{Binding IsContentState}" Margin="16,10,16,12">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:ModerationQueueItem">
                    <cards:SfCardView Padding="16" Margin="0,0,0,12" Style="{StaticResource ElevatedCard}"
                                      IndicatorColor="{StaticResource Accent}" IndicatorPosition="Left" IndicatorThickness="4">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                       MaxLines="2" LineBreakMode="TailTruncation" VerticalOptions="Center" />
                                <chips:SfChip Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource AccentSfChip}" IsEnabled="False" />
                            </Grid>
                            <Label Text="{Binding CreatedText}" Style="{StaticResource Caption}" FontSize="12.5" />
                            <buttons:SfButton Text="Duyệt tin"
                                              Style="{StaticResource SoftSfButton}"
                                              HorizontalOptions="Start" WidthRequest="128"
                                              AutomationId="ModerationApprove"
                                              Command="{Binding ApproveCommand, Source={RelativeSource AncestorType={x:Type vm:ModerationQueueViewModel}}, x:DataType=vm:ModerationQueueViewModel}"
                                              CommandParameter="{Binding .}" />
                        </VerticalStackLayout>
                    </cards:SfCardView>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Load more -->
        <buttons:SfButton Grid.Row="3" Text="Tải thêm tin chờ duyệt" Command="{Binding LoadMoreCommand}"
                          Style="{StaticResource GhostSfButton}" HorizontalOptions="Center"
                          IsVisible="{Binding HasMore}" Margin="0,0,0,12"
                          AutomationId="ModerationLoadMore" />
    </Grid>
</ContentPage>
