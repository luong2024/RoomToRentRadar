<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RoomToRentRadar.Views.RoomDetails.RoomDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:models="clr-namespace:RoomToRentRadar.Models.RoomDetails"
    xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels.RoomDetails"
    Title="{Binding Title}"
    x:DataType="vm:RoomDetailViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- Top Navigation Header Bar -->
        <Border
            Grid.Row="0"
            Padding="{OnIdiom Phone='16,10', Tablet='24,12', Desktop='28,14'}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="1"
            ZIndex="10">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Back Button -->
                <Border
                    Grid.Column="0"
                    Padding="10,6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 10"
                    StrokeThickness="1"
                    VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="18"
                            Text="{x:Static f:FluentUI.arrow_left_20_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="13"
                            Text="Listings"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- Page Title -->
                <Label
                    Grid.Column="1"
                    FontAttributes="Bold"
                    FontSize="16"
                    HorizontalTextAlignment="Center"
                    LineBreakMode="TailTruncation"
                    MaxLines="1"
                    Text="{Binding Title}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                    VerticalOptions="Center" />

            </Grid>
        </Border>

        <!-- Main Scrollable Content Area -->
        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="{OnIdiom Phone='16,16', Tablet='24,20', Desktop='32,24'}"
                HorizontalOptions="Fill"
                MaximumWidthRequest="920"
                Spacing="16">

                <!-- Loading Spinner -->
                <ActivityIndicator
                    HorizontalOptions="Center"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    Margin="0,32,0,0"
                    Color="{StaticResource PrimaryBrand}" />

                <!-- Error / Not Found Card -->
                <Border
                    Padding="28"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    IsVisible="{Binding IsLoadStateVisible}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                    <VerticalStackLayout HorizontalOptions="Center" Spacing="12">
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="40"
                            HorizontalOptions="Center"
                            Text="{x:Static f:FluentUI.building_24_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                        <Label
                            FontAttributes="Bold"
                            FontSize="16"
                            HorizontalTextAlignment="Center"
                            Text="{Binding StatusMessage}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            Command="{Binding GoBackCommand}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            Margin="0,8,0,0"
                            Padding="20,10"
                            TextColor="White"
                            Text="Back to room listings" />
                        <Button
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            Command="{Binding LoadRoomDetailsCommand}"
                            CornerRadius="12"
                            FontAttributes="Bold"
                            HorizontalOptions="Center"
                            IsVisible="{Binding HasLoadError}"
                            Margin="0,8,0,0"
                            Padding="20,10"
                            TextColor="White"
                            Text="Retry" />
                    </VerticalStackLayout>
                </Border>

                <!-- Room Detail Container -->
                <VerticalStackLayout IsVisible="{Binding HasRoom}" Spacing="16">

                    <!-- Image Gallery / Carousel Card -->
                    <Border
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                        HeightRequest="{OnIdiom Phone='240', Tablet='340', Desktop='380'}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="0">
                        <Grid>
                            <!-- Image Carousel -->
                            <CarouselView
                                ItemsSource="{Binding Room.ImageUrls}"
                                IsVisible="{Binding Room.HasImages}"
                                Loop="True">
                                <CarouselView.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Image Aspect="AspectFill" Source="{Binding .}" />
                                    </DataTemplate>
                                </CarouselView.ItemTemplate>
                            </CarouselView>

                            <Label
                                FontAttributes="Bold"
                                FontSize="14"
                                HorizontalOptions="Center"
                                IsVisible="False"
                                Text="No photos available"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger Binding="{Binding Room.HasImages}" TargetType="Label" Value="False">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <!-- Scrim Overlay for Top Badges -->
                            <BoxView HeightRequest="72" VerticalOptions="Start">
                                <BoxView.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Offset="0.0" Color="{StaticResource ScrimStart}" />
                                        <GradientStop Offset="1.0" Color="{StaticResource ScrimEnd}" />
                                    </LinearGradientBrush>
                                </BoxView.Background>
                            </BoxView>

                            <!-- Top Badges Overlay -->
                            <Grid
                                Padding="14"
                                ColumnDefinitions="Auto,*,Auto"
                                VerticalOptions="Start">
                                <!-- Verified Badge -->
                                <Border
                                    Grid.Column="0"
                                    Padding="10,5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource VerifiedBadgeBg}, Dark={StaticResource VerifiedBadgeBgDark}}"
                                    IsVisible="{Binding Room.IsVerified}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="14"
                                            Text="{x:Static f:FluentUI.shield_checkmark_16_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            Text="100% Verified"
                                            TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <!-- Availability / Status Badge -->
                                <Border
                                    Grid.Column="2"
                                    Padding="10,5"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0">
                                    <Border.Triggers>
                                        <DataTrigger Binding="{Binding IsAvailable}" TargetType="Border" Value="True">
                                            <Setter Property="BackgroundColor" Value="#DCFCE7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsRented}" TargetType="Border" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FEF3C7" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsUnavailable}" TargetType="Border" Value="True">
                                            <Setter Property="BackgroundColor" Value="#FEE2E2" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger Binding="{Binding IsAvailable}" TargetType="Label" Value="True">
                                            <Setter Property="Text" Value="Available" />
                                                <Setter Property="TextColor" Value="#166534" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsRented}" TargetType="Label" Value="True">
                                            <Setter Property="Text" Value="Rented" />
                                                <Setter Property="TextColor" Value="#B45309" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsUnavailable}" TargetType="Label" Value="True">
                                            <Setter Property="Text" Value="Unavailable" />
                                                <Setter Property="TextColor" Value="#991B1B" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Unavailable Listing Warning Alert (AC3) -->
                    <Border
                        Padding="16,14"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentHighlightSoft}, Dark={StaticResource AccentHighlightSoftDark}}"
                        IsVisible="{Binding ShowSimilarRooms}"
                        Stroke="{StaticResource AccentHighlight}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1.5">
                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="24"
                                Text="{x:Static f:FluentUI.warning_24_regular}"
                                TextColor="{StaticResource AccentHighlight}"
                                VerticalOptions="Center" />
                            <VerticalStackLayout Grid.Column="1" Spacing="3">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14.5"
                                    Text="{Binding ListingStatusTitle}"
                                    TextColor="{StaticResource AccentHighlight}" />
                                <Label
                                    FontSize="13"
                                    LineBreakMode="WordWrap"
                                    Text="{Binding ListingStatusMessage}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <!-- Room Main Overview Card -->
                    <Border
                        Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        IsVisible="{Binding HasRoom}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="16">
                            <!-- Title & Rating -->
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Start">
                                <Label
                                    Grid.Column="0"
                                    FontAttributes="Bold"
                                    FontSize="20"
                                    LineHeight="1.25"
                                    Text="{Binding Room.Title}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />

                                <Border
                                    Grid.Column="1"
                                    Padding="8,4"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="14"
                                            Text="{x:Static f:FluentUI.star_16_regular}"
                                            TextColor="#EAB308"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12.5"
                                            Text="{Binding Room.RatingDisplay}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Address & Location -->
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="16"
                                    Text="{x:Static f:FluentUI.location_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    Text="{Binding Room.Address}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                    VerticalOptions="Center">
                                    <Label.Triggers>
                                        <DataTrigger Binding="{Binding IsAddressHidden}" TargetType="Label" Value="True">
                                            <Setter Property="Text" Value="Địa chỉ tạm thời được ẩn" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                            </HorizontalStackLayout>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- Price, Deposit & Last Updated Info -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="3">
                                    <Label
                                        FontSize="12"
                                        Text="MONTHLY RENT"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <HorizontalStackLayout Spacing="6" VerticalOptions="End">
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="22"
                                            Text="{Binding Room.FormattedPrice}"
                                            TextColor="{StaticResource AccentHighlight}" />
                                    </HorizontalStackLayout>
                                    <Label
                                        FontSize="12.5"
                                        Text="{Binding Room.FormattedDeposit, StringFormat='Deposit: {0}'}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1" HorizontalOptions="End" IsVisible="{Binding Room.HasLastUpdated}" Spacing="4" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="14"
                                            Text="{x:Static f:FluentUI.clock_16_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontSize="12"
                                            Text="{Binding Room.FormattedLastUpdated}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- Quick Specs Grid: 2x2 on Phone for breathing room, 4 columns on Tablet/Desktop -->
                            <!-- Phone: 2x2 -->
                            <Grid
                                ColumnDefinitions="*,*"
                                ColumnSpacing="10"
                                IsVisible="{OnIdiom Phone=True, Default=False}"
                                RowDefinitions="Auto,Auto"
                                RowSpacing="10"
                                VerticalOptions="Center">
                                <Border Grid.Row="0" Grid.Column="0" Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.grid_24_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Room.FormattedArea}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            <Label FontSize="11" Text="Area" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Row="0" Grid.Column="1" Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.building_home_24_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="13" LineBreakMode="TailTruncation" MaxLines="1" Text="{Binding Room.RoomType}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            <Label FontSize="11" Text="Room type" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="0" IsVisible="{Binding Room.HasBedrooms}" Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.bed_24_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Room.Bedrooms, StringFormat='{0} bedrooms'}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            <Label FontSize="11" Text="Bedrooms" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>

                                <Border Grid.Row="1" Grid.Column="1" IsVisible="{Binding Room.HasBathrooms}" Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="0">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.showerhead_24_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                        <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                                            <Label FontAttributes="Bold" FontSize="13" Text="{Binding Room.Bathrooms, StringFormat='{0} bathrooms'}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            <Label FontSize="11" Text="Bathrooms" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                        </VerticalStackLayout>
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Tablet / Desktop: 4 columns -->
                            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="10" IsVisible="{OnIdiom Phone=False, Default=True}" VerticalOptions="Center">
                                <!-- Area -->
                                <Border
                                    Grid.Column="0"
                                    Padding="10,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{x:Static f:FluentUI.grid_24_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            Text="{Binding Room.FormattedArea}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            FontSize="11"
                                            HorizontalOptions="Center"
                                            Text="Area"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Room Type -->
                                <Border
                                    Grid.Column="1"
                                    Padding="10,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{x:Static f:FluentUI.building_home_24_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12"
                                            HorizontalOptions="Center"
                                            LineBreakMode="TailTruncation"
                                            Text="{Binding Room.RoomType}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            FontSize="11"
                                            HorizontalOptions="Center"
                                            Text="Room type"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Bedrooms -->
                                <Border
                                    Grid.Column="2"
                                    IsVisible="{Binding Room.HasBedrooms}"
                                    Padding="10,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{x:Static f:FluentUI.bed_24_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            Text="{Binding Room.Bedrooms, StringFormat='{0} bedrooms'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            FontSize="11"
                                            HorizontalOptions="Center"
                                            Text="Bedrooms"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    </VerticalStackLayout>
                                </Border>

                                <!-- Bathrooms -->
                                <Border
                                    Grid.Column="3"
                                    IsVisible="{Binding Room.HasBathrooms}"
                                    Padding="10,12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    StrokeShape="RoundRectangle 12"
                                    StrokeThickness="0">
                                    <VerticalStackLayout HorizontalOptions="Center" Spacing="4">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="20"
                                            HorizontalOptions="Center"
                                            Text="{x:Static f:FluentUI.showerhead_24_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            HorizontalOptions="Center"
                                            Text="{Binding Room.Bathrooms, StringFormat='{0} bathrooms'}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            FontSize="11"
                                            HorizontalOptions="Center"
                                            Text="Bathrooms"
                                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Description Card -->
                    <Border
                        Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="10">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Description"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13.5"
                                LineHeight="1.5"
                                Text="{Binding Room.Description}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Amenities Card -->
                    <Border
                        Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="12">
                            <Label
                                FontAttributes="Bold"
                                FontSize="16"
                                Text="Amenities"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />

                            <FlexLayout
                                AlignContent="Start"
                                Direction="Row"
                                JustifyContent="Start"
                                BindableLayout.ItemsSource="{Binding Room.Amenities}"
                                Wrap="Wrap">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:RoomAmenityModel">
                                        <Border
                                            Padding="12,8"
                                            Margin="0,0,10,10"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1">
                                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                <Label
                                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                    FontSize="16"
                                                    Text="{Binding IconGlyph}"
                                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                                    VerticalOptions="Center" />
                                                <Label
                                                    FontSize="13"
                                                    Text="{Binding Name}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                                    VerticalOptions="Center" />
                                            </HorizontalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </FlexLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- House Rules Card (US11 AC1 & AC2: Shown before landlord contact) -->
                    <Border
                        Padding="{OnIdiom Phone='16', Tablet='20', Desktop='22'}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <!-- Header with subtle subtitle + Past updates / Edit actions -->
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="16"
                                        Text="House rules"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                    <Label
                                        FontSize="12"
                                        Text="{Binding HouseRulesSubtitleText}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                </VerticalStackLayout>

                                <Border
                                    Grid.Column="1"
                                    Padding="10,6"
                                    BackgroundColor="Transparent"
                                    IsVisible="{Binding CanViewHouseRulesHistory}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenHouseRulesHistoryCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="14"
                                            Text="{x:Static f:FluentUI.history_16_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12.5"
                                            Text="Past updates"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>

                                <Border
                                    Grid.Column="2"
                                    Padding="12,6"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                                    IsVisible="{Binding CanEditHouseRules}"
                                    StrokeShape="RoundRectangle 10"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding OpenEditHouseRulesCommand}" />
                                    </Border.GestureRecognizers>
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label
                                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                                            FontSize="14"
                                            Text="{x:Static f:FluentUI.edit_16_regular}"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                            VerticalOptions="Center" />
                                        <Label
                                            FontAttributes="Bold"
                                            FontSize="12.5"
                                            Text="Edit"
                                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                            VerticalOptions="Center" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>

                            <!-- Structured 4-Section House Rules (US11 AC1) -->
                            <VerticalStackLayout IsVisible="{Binding HasStructuredHouseRules}" Spacing="10">
                                <!-- Phone: 1 column -->
                                <VerticalStackLayout IsVisible="{OnIdiom Phone=True, Default=False}" Spacing="8">
                                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18" Text="{x:Static f:FluentUI.weather_moon_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Quiet hours" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" Text="{Binding HouseRules.QuietHours}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18" Text="{x:Static f:FluentUI.people_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Guest policy" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" Text="{Binding HouseRules.GuestPolicy}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18" Text="{x:Static f:FluentUI.food_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Cooking rules" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" Text="{Binding HouseRules.CookingRules}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                    <Border Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 12" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18" Text="{x:Static f:FluentUI.clock_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Parking rules" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" Text="{Binding HouseRules.ParkingRules}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </VerticalStackLayout>

                                <!-- Tablet / Desktop: 2x2 Grid -->
                                <Grid
                                    ColumnDefinitions="*,*"
                                    ColumnSpacing="10"
                                    IsVisible="{OnIdiom Phone=False, Default=True}"
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="10">
                                    <Border Grid.Row="0" Grid.Column="0" Padding="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.weather_moon_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Quiet hours" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" LineHeight="1.35" Text="{Binding HouseRules.QuietHours}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="0" Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.people_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Guest policy" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" LineHeight="1.35" Text="{Binding HouseRules.GuestPolicy}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="0" Padding="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.food_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Cooking rules" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" LineHeight="1.35" Text="{Binding HouseRules.CookingRules}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <Border Grid.Row="1" Grid.Column="1" Padding="14" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 14" StrokeThickness="1">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                                            <Label Grid.Column="0" FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.clock_20_regular}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" VerticalOptions="Center" />
                                            <VerticalStackLayout Grid.Column="1" Spacing="2">
                                                <Label FontAttributes="Bold" FontSize="12" Text="Parking rules" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                <Label FontSize="13" LineHeight="1.35" Text="{Binding HouseRules.ParkingRules}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!-- Additional regulations (reliable VerticalStackLayout) -->
                                <VerticalStackLayout IsVisible="{Binding HouseRules.HasAdditionalRules}" Spacing="6">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12.5"
                                        Text="Good to know"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding HouseRules.AdditionalRules}" Spacing="6">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="x:String">
                                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                        FontSize="14"
                                                        Text="{x:Static f:FluentUI.checkmark_circle_16_regular}"
                                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        FontSize="13"
                                                        Text="{Binding .}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>
                                </VerticalStackLayout>
                            </VerticalStackLayout>

                            <!-- Legacy Fallback Rules -->
                            <VerticalStackLayout IsVisible="{Binding ShowLegacyHouseRulesFallback}" Spacing="8">
                                <FlexLayout
                                    AlignContent="Start"
                                    BindableLayout.ItemsSource="{Binding Room.HouseRules}"
                                    Direction="Row"
                                    JustifyContent="Start"
                                    Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border
                                                Margin="0,0,8,8"
                                                Padding="12,7"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                                StrokeShape="RoundRectangle 12"
                                                StrokeThickness="1">
                                                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                                    <Label
                                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                        FontSize="14"
                                                        Text="{x:Static f:FluentUI.checkmark_circle_16_regular}"
                                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                                        VerticalOptions="Center" />
                                                    <Label
                                                        FontSize="13"
                                                        Text="{Binding .}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                                        VerticalOptions="Center" />
                                                </HorizontalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>

                            <!-- Empty State -->
                            <Label
                                FontSize="13"
                                IsVisible="{Binding ShowEmptyHouseRulesState}"
                                Text="No house rules have been provided by the landlord yet."
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Landlord Contact Card (AC4) -->
                    <Border
                        Padding="20"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Landlord Avatar -->
                            <Border
                                Grid.Column="0"
                                HeightRequest="48"
                                StrokeShape="RoundRectangle 24"
                                StrokeThickness="0"
                                WidthRequest="48">
                                <Image Aspect="AspectFill" Source="{Binding Room.LandlordAvatar}" />
                            </Border>

                            <!-- Name & Phone -->
                            <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="14.5"
                                    Text="{Binding Room.LandlordName}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                <Label
                                    FontSize="13"
                                    Text="{Binding DisplayPhoneNumber}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </VerticalStackLayout>

                            <!-- Call Button -->
                            <Button
                                Grid.Column="2"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                Command="{Binding CallLandlordCommand}"
                                CornerRadius="12"
                                FontAttributes="Bold"
                                FontSize="12.5"
                                HeightRequest="40"
                                IsEnabled="{Binding CanCallLandlord}"
                                Padding="14,0"
                                TextColor="White"
                                Text="Call landlord" />
                        </Grid>
                    </Border>

                    <!-- Similar Rooms Section (AC3 - Shown when Rented or Unavailable) -->
                    <VerticalStackLayout IsVisible="{Binding ShowSimilarRooms}" Spacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="Similar rooms near ICTU"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13"
                                Text="Available alternatives in a similar price range and area"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                        </VerticalStackLayout>

                        <!-- Similar Rooms List -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding SimilarRooms}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SimilarRoomModel">
                                    <Border
                                        Padding="14"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                        StrokeShape="RoundRectangle 16"
                                        StrokeThickness="1">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoomDetailViewModel}}, Path=SelectSimilarRoomCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" VerticalOptions="Center">
                                            <!-- Thumbnail -->
                                            <Border
                                                Grid.Column="0"
                                                HeightRequest="72"
                                                StrokeShape="RoundRectangle 10"
                                                StrokeThickness="0"
                                                WidthRequest="88">
                                                <Grid>
                                                    <Label
                                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                        FontSize="28"
                                                        HorizontalOptions="Center"
                                                        Text="{x:Static f:FluentUI.building_24_regular}"
                                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                                        VerticalOptions="Center" />
                                                    <Image Aspect="AspectFill" Source="{Binding ThumbnailUrl}" />
                                                </Grid>
                                            </Border>

                                            <!-- Info -->
                                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="14"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    Text="{Binding Title}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                                <Label
                                                    FontAttributes="Bold"
                                                    FontSize="13"
                                                    Text="{Binding FormattedPrice}"
                                                    TextColor="{StaticResource AccentHighlight}" />
                                                <Label
                                                    FontSize="12"
                                                    LineBreakMode="TailTruncation"
                                                    MaxLines="1"
                                                    Text="{Binding Address}"
                                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                            </VerticalStackLayout>

                                            <!-- Chevron / View Button -->
                                            <Label
                                                Grid.Column="2"
                                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                                FontSize="18"
                                                Text="{x:Static f:FluentUI.chevron_right_16_regular}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                                VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom Sticky Action Bar (CTA) -->
        <Border
            Grid.Row="2"
            Padding="{OnIdiom Phone='16,12', Tablet='24,14', Desktop='32,16'}"
            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
            IsVisible="{Binding HasRoom}"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="1"
            ZIndex="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalOptions="Center">
                <!-- Price / Package Summary -->
                <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                    <Label
                        FontSize="11.5"
                        Text="INITIAL PAYMENT"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                    <Label
                        FontAttributes="Bold"
                        FontSize="18"
                        Text="{Binding Room.FormattedTotalPackage}"
                        TextColor="{StaticResource AccentHighlight}" />
                    <Label
                        FontSize="11"
                        Text="(Room rent + deposit)"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                </VerticalStackLayout>

                <!-- Action Button -->
                <Button
                    Grid.Column="1"
                    BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                    Command="{Binding BookInspectionCommand}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    FontSize="14"
                    HeightRequest="48"
                    IsEnabled="{Binding CanBookOrContact}"
                    Padding="22,0"
                    TextColor="White"
                    Text="{Binding CanBookOrContact, Converter={x:Null}, StringFormat='{0}'}">
                    <Button.Triggers>
                        <DataTrigger Binding="{Binding CanBookOrContact}" TargetType="Button" Value="True">
                            <Setter Property="Text" Value="Schedule a viewing" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding CanBookOrContact}" TargetType="Button" Value="False">
                            <Setter Property="Text" Value="Room unavailable" />
                        </DataTrigger>
                    </Button.Triggers>
                </Button>
            </Grid>
        </Border>

        <!-- House Rules Version History Overlay (US11 AC3) -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="{Binding IsHouseRulesHistoryVisible}"
            ZIndex="20">
            <BoxView Color="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseHouseRulesHistoryCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                Margin="{OnIdiom Phone='16,24', Tablet='24,32', Desktop='32,40'}"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                HorizontalOptions="{OnIdiom Phone=Fill, Tablet=Center, Desktop=Center}"
                MaximumHeightRequest="560"
                MaximumWidthRequest="580"
                Padding="{OnIdiom Phone='18', Tablet='22', Desktop='24'}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Phone=-1, Tablet=520, Desktop=560}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="17"
                        Text="Past updates"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="10">
                            <ActivityIndicator IsRunning="{Binding IsLoadingHistory}" IsVisible="{Binding IsLoadingHistory}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding HouseRulesHistory}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="models:HouseRulesVersionModel">
                                        <Border
                                            Padding="14"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource DesktopRailBackgroundDark}}"
                                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                            StrokeShape="RoundRectangle 12"
                                            StrokeThickness="1">
                                            <VerticalStackLayout Spacing="4">
                                                <HorizontalStackLayout Spacing="8">
                                                    <Label FontAttributes="Bold" FontSize="13" Text="{Binding EditionLabel}" TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                                    <Label FontSize="12" Text="{Binding FormattedUpdatedAt}" TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                                </HorizontalStackLayout>
                                                <Label FontAttributes="Italic" FontSize="12" IsVisible="{Binding HasChangeNote}" Text="{Binding ChangeNote}" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                                <Label FontSize="12" Text="{Binding QuietHours, StringFormat='Quiet hours: {0}'}" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                                <Label FontSize="12" Text="{Binding GuestPolicy, StringFormat='Guests: {0}'}" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                                <Label FontSize="12" Text="{Binding CookingRules, StringFormat='Cooking: {0}'}" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                                <Label FontSize="12" Text="{Binding ParkingRules, StringFormat='Parking: {0}'}" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                            </VerticalStackLayout>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Button
                        Grid.Row="2"
                        Command="{Binding CloseHouseRulesHistoryCommand}"
                        CornerRadius="12"
                        Text="Close" />
                </Grid>
            </Border>
        </Grid>

        <!-- Edit House Rules Overlay (US11 AC3 - Landlord Only) -->
        <Grid
            Grid.Row="0"
            Grid.RowSpan="3"
            IsVisible="{Binding IsEditHouseRulesVisible}"
            ZIndex="21">
            <BoxView Color="#80000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseEditHouseRulesCommand}" />
                </BoxView.GestureRecognizers>
            </BoxView>
            <Border
                Margin="{OnIdiom Phone='16,24', Tablet='24,32', Desktop='32,40'}"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                HorizontalOptions="{OnIdiom Phone=Fill, Tablet=Center, Desktop=Center}"
                MaximumHeightRequest="520"
                MaximumWidthRequest="480"
                Padding="{OnIdiom Phone='16', Tablet='18', Desktop='20'}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1"
                VerticalOptions="Center"
                WidthRequest="{OnIdiom Phone=-1, Tablet=440, Desktop=460}">
                <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">
                    <Label
                        Grid.Row="0"
                        FontAttributes="Bold"
                        FontSize="16"
                        Text="Edit house rules"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />

                    <ScrollView Grid.Row="1" Padding="0,0,12,0">
                        <VerticalStackLayout Spacing="6">
                            <Label
                                FontSize="12"
                                IsVisible="{Binding HasHouseRulesEditError}"
                                Text="{Binding HouseRulesEditError}"
                                TextColor="Red" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Quiet hours *" />
                            <Entry FontSize="13" HeightRequest="38" HorizontalOptions="Fill" Placeholder="e.g. 22:00 - 06:00" Text="{Binding EditQuietHours}" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Guest policy *" />
                            <Entry FontSize="13" HeightRequest="38" HorizontalOptions="Fill" Placeholder="e.g. Guests allowed until 21:30" Text="{Binding EditGuestPolicy}" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Cooking rules *" />
                            <Entry FontSize="13" HeightRequest="38" HorizontalOptions="Fill" Placeholder="e.g. Electric cooker allowed" Text="{Binding EditCookingRules}" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Parking rules *" />
                            <Entry FontSize="13" HeightRequest="38" HorizontalOptions="Fill" Placeholder="e.g. Free 1 motorbike slot" Text="{Binding EditParkingRules}" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Additional rules (one per line)" />
                            <Editor AutoSize="TextChanges" FontSize="13" HorizontalOptions="Fill" MinimumHeightRequest="56" Placeholder="Optional extra rules" Text="{Binding EditAdditionalRulesText}" />

                            <Label FontAttributes="Bold" FontSize="12" Text="Change note (optional)" />
                            <Entry FontSize="13" HeightRequest="38" HorizontalOptions="Fill" Placeholder="Describe what changed" Text="{Binding EditChangeNote}" />
                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button
                            Grid.Column="0"
                            BackgroundColor="Transparent"
                            Command="{Binding CloseEditHouseRulesCommand}"
                            Text="Cancel"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        <Button
                            Grid.Column="1"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            Command="{Binding SaveHouseRulesCommand}"
                            CornerRadius="12"
                            IsEnabled="{Binding CanSaveHouseRules}"
                            Text="Save"
                            TextColor="White" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

    </Grid>
</ContentPage>
