<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.MapSearchPage"
             x:Name="MapPageRoot"
             x:DataType="vm:MapSearchViewModel"
             Title="Bản đồ"
             SafeAreaEdges="Container">

    <Grid>
        <!-- 1. FULL-BLEED INTERACTIVE MAPSUI CANVAS -->
        <mapsui:MapControl x:Name="MapView" />

        <!-- 2. LIQUID GLASS SPATIAL OVERLAY STAGE -->
        <Grid RowDefinitions="Auto,*,Auto"
              Padding="{OnPlatform Android='14,10,14,102', Default='14,10,14,16'}"
              InputTransparent="False"
              CascadeInputTransparent="False">

            <!-- ==================== TOP FLOATING LIQUID GLASS COMMAND BAR ==================== -->
            <VerticalStackLayout x:Name="HeaderPanel"
                                 Grid.Row="0"
                                 Spacing="8"
                                 MaximumWidthRequest="680"
                                 HorizontalOptions="Fill">

                <Border Style="{StaticResource LiquidFloatingPanel}" Padding="15,10">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding MapHeading}"
                                   FontFamily="FontBold"
                                   FontSize="15.5"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="{Binding MapSubtitle}"
                                   Style="{StaticResource Caption}"
                                   FontSize="12"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <Border Grid.Column="1"
                                Style="{StaticResource LiquidOrbBorder}"
                                AutomationId="MapSavedAreasButton"
                                SemanticProperties.Description="Khu vực đã lưu">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleSavedAreasCommand}" />
                            </Border.GestureRecognizers>
                            <Image Source="bookmark_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource LiquidOrbBorder}"
                                AutomationId="MapNotificationsButton"
                                SemanticProperties.Description="Thông báo khu vực">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleNotificationsCommand}" />
                            </Border.GestureRecognizers>
                            <Image Source="bell_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                    </Grid>
                </Border>

                <progressBar:SfLinearProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

                <!-- Dismissible Glass Toast -->
                <Border IsVisible="{Binding HasMapNotice}"
                        Style="{StaticResource LiquidFloatingPanel}"
                        Padding="14,9">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding MapNotice}" FontFamily="FontMedium" FontSize="12.5" VerticalOptions="Center" />
                        <buttons:SfButton Grid.Column="1"
                                          Text="Đóng"
                                          Clicked="OnDismissNoticeClicked"
                                          Style="{StaticResource GhostSfButton}"
                                          HeightRequest="34"
                                          MinimumHeightRequest="34" />
                    </Grid>
                </Border>

                <!-- Floating Liquid Glass Action Pills -->
                <HorizontalStackLayout Spacing="8" HorizontalOptions="Center">
                    <buttons:SfButton IsVisible="{Binding ShowStartDrawing}"
                                      Text="Vẽ vùng tìm trọ"
                                      Command="{Binding StartDrawingCommand}"
                                      Style="{StaticResource LiquidPrimaryButton}"
                                      HeightRequest="44"
                                      Padding="18,0"
                                      AutomationId="MapStartDrawingButton" />

                    <buttons:SfButton IsVisible="{Binding ShowStartDrawing}"
                                      Text="{Binding SelectedSortLabel}"
                                      Clicked="OnSortClicked"
                                      Style="{StaticResource LiquidGlassButton}"
                                      HeightRequest="44"
                                      Padding="15,0"
                                      FontSize="12.5"
                                      AutomationId="MapSortButton" />

                    <buttons:SfButton IsVisible="{Binding CanSearchAgain}"
                                      Text="Tìm lại"
                                      Command="{Binding SearchCommand}"
                                      Style="{StaticResource SecondaryActionButton}"
                                      HeightRequest="44"
                                      Padding="14,0"
                                      AutomationId="MapSearchAgainButton" />

                    <HorizontalStackLayout IsVisible="{Binding ShowDrawingTools}" Spacing="8">
                        <buttons:SfButton Text="Hoàn tác"
                                          Command="{Binding UndoVertexCommand}"
                                          Style="{StaticResource LiquidGlassButton}"
                                          HeightRequest="44"
                                          Padding="14,0" />
                        <buttons:SfButton Text="Tìm phòng"
                                          Command="{Binding FinishDrawingCommand}"
                                          IsEnabled="{Binding CanFinishDrawing}"
                                          Style="{StaticResource LiquidPrimaryButton}"
                                          HeightRequest="44"
                                          Padding="18,0" />
                        <buttons:SfButton Text="Hủy"
                                          Command="{Binding CancelDrawingCommand}"
                                          Style="{StaticResource LiquidGlassButton}"
                                          HeightRequest="44"
                                          Padding="14,0" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>

            <!-- ==================== RIGHT FLOATING SPECULAR MAP ORBS ==================== -->
            <VerticalStackLayout Grid.Row="1"
                                 IsVisible="{Binding ShowFloatingControls}"
                                 HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="0,10,0,0"
                                 Spacing="10">
                <Border x:Name="LocateButton"
                        Style="{StaticResource LiquidOrbBorder}"
                        SemanticProperties.Description="Định vị vị trí hiện tại">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnLocateClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="locate_icon.png" WidthRequest="19" HeightRequest="19" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>

                <Border IsVisible="{Binding HasPolygon}"
                        Style="{StaticResource LiquidOrbBorder}"
                        SemanticProperties.Description="Căn giữa vùng đã vẽ">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFocusAreaClicked" />
                    </Border.GestureRecognizers>
                    <Image Source="focus_area.png" WidthRequest="19" HeightRequest="19" HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
            </VerticalStackLayout>

            <!-- ==================== BOTTOM LIQUID GLASS SHEETS & CAROUSELS ==================== -->
            <VerticalStackLayout Grid.Row="2" Spacing="10" MaximumWidthRequest="680">

                <!-- Empty / Error State Glass Card -->
                <Border IsVisible="{Binding ShowSearchState}"
                        Style="{StaticResource LiquidGlassCard}"
                        Padding="16,14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="{Binding SearchStateTitle}" Style="{StaticResource CardTitle}" FontSize="14.5" />
                            <Label Text="{Binding SearchStateHint}" Style="{StaticResource Caption}" FontSize="12" />
                        </VerticalStackLayout>
                        <buttons:SfButton Grid.Column="1"
                                          IsVisible="{Binding ShowSearchError}"
                                          Text="Thử lại"
                                          Command="{Binding SearchCommand}"
                                          Style="{StaticResource SecondaryActionButton}"
                                          HeightRequest="40" />
                    </Grid>
                </Border>

                <!-- Selected Listing Liquid Glass Preview Panel -->
                <Border x:Name="PreviewPanel"
                        IsVisible="{Binding ShowPreviewCard}"
                        Style="{StaticResource LiquidGlassCard}"
                        Padding="14">
                    <Grid ColumnDefinitions="82,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="82"
                                HeightRequest="82"
                                StrokeShape="RoundRectangle 16"
                                StrokeThickness="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                            <Image Source="{Binding SelectedListing.PhotoSource}" Aspect="AspectFill" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="3" VerticalOptions="Center">
                            <VerticalStackLayout.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSelectedListingCommand}" />
                            </VerticalStackLayout.GestureRecognizers>
                            <Label Text="{Binding SelectedListing.Title}" Style="{StaticResource CardTitle}" FontSize="14.5" MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SelectedListing.DistanceText}" Style="{StaticResource Caption}" FontSize="11.5" />
                            <Label Text="{Binding SelectedListing.RentText}"
                                   FontFamily="FontBold"
                                   FontSize="15.5"
                                   TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                            <buttons:SfButton Text="Xem"
                                              Command="{Binding OpenSelectedListingCommand}"
                                              Style="{StaticResource LiquidPrimaryButton}"
                                              HeightRequest="38"
                                              MinimumHeightRequest="38"
                                              Padding="14,0" />
                            <buttons:SfButton Text="Đóng"
                                              Command="{Binding ClearSelectionCommand}"
                                              Style="{StaticResource GhostSfButton}"
                                              HeightRequest="32"
                                              MinimumHeightRequest="32"
                                              FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- Horizontal Result Glass Carousel -->
                <ContentView x:Name="ResultsPanel" IsVisible="{Binding HasResults}">
                    <CollectionView x:Name="ResultCards"
                                    ItemsSource="{Binding Listings}"
                                    SelectionMode="Single"
                                    SelectedItem="{Binding SelectedListing}"
                                    HeightRequest="96">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="10" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:MapListingItem">
                                <Border WidthRequest="248"
                                        Style="{StaticResource LiquidFloatingPanel}"
                                        StrokeShape="RoundRectangle 20"
                                        Padding="10">
                                    <Grid ColumnDefinitions="68,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Border Grid.Column="0" WidthRequest="68" HeightRequest="68" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                            <Image Source="{Binding PhotoSource}" Aspect="AspectFill" />
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                                            <Label Text="{Binding Title}" FontFamily="FontSemiBold" FontSize="13" MaxLines="1" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RentText}"
                                                   FontFamily="FontBold"
                                                   FontSize="13.5"
                                                   TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                            <Label Text="{Binding AreaText}" Style="{StaticResource Caption}" FontSize="11" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </ContentView>

                <!-- Saved Areas Liquid Glass Sheet -->
                <Border x:Name="SavedPanel"
                        IsVisible="{Binding IsSavedPanelOpen}"
                        Style="{StaticResource LiquidGlassCard}"
                        Padding="18">
                    <VerticalStackLayout Spacing="12">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="Khu vực tìm kiếm đã lưu" Style="{StaticResource SectionTitle}" />
                            <buttons:SfButton Grid.Column="1" Text="Đóng" Command="{Binding ToggleSavedAreasCommand}" Style="{StaticResource GhostSfButton}" />
                        </Grid>

                        <Grid IsVisible="{Binding HasPolygon}" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <inputLayout:SfTextInputLayout Grid.Column="0" Hint="Đặt tên vùng hiện tại">
                                <Entry Text="{Binding NewAreaName}" />
                            </inputLayout:SfTextInputLayout>
                            <buttons:SfButton Grid.Column="1"
                                              Text="Lưu"
                                              Command="{Binding SaveAreaCommand}"
                                              IsEnabled="{Binding CanSaveCurrentArea}"
                                              Style="{StaticResource LiquidPrimaryButton}"
                                              VerticalOptions="Center" />
                        </Grid>

                        <CollectionView ItemsSource="{Binding SavedAreas}"
                                        SelectionMode="Single"
                                        SelectedItem="{Binding SelectedSavedArea}"
                                        MaximumHeightRequest="150">
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:SavedAreaSearch">
                                    <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,6" Padding="12,9">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Name}" FontFamily="FontSemiBold" FontSize="13.5" />
                                            <Label Text="{Binding DetailText}" Style="{StaticResource Caption}" FontSize="11.5" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid IsVisible="{Binding HasSelectedSavedArea}" ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                            <buttons:SfButton Grid.Column="0" Text="Áp dụng" Command="{Binding ApplySavedAreaCommand}" Style="{StaticResource LiquidPrimaryButton}" HeightRequest="42" />
                            <buttons:SfButton Grid.Column="1" Text="{Binding AlertToggleText}" Command="{Binding ToggleSavedAreaAlertCommand}" IsEnabled="{Binding CanToggleAlert}" Style="{StaticResource LiquidGlassButton}" HeightRequest="42" />
                            <buttons:SfButton Grid.Column="2" Text="Xóa" Command="{Binding DeleteSavedAreaCommand}" Style="{StaticResource DangerActionButton}" HeightRequest="42" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Notifications Liquid Glass Sheet -->
                <Border x:Name="NotificationsPanel"
                        IsVisible="{Binding IsNotificationsPanelOpen}"
                        Style="{StaticResource LiquidGlassCard}"
                        Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <Label Text="{Binding NotificationsTitle}" Style="{StaticResource SectionTitle}" />
                            <buttons:SfButton Grid.Column="1" Text="Đóng" Command="{Binding ToggleNotificationsCommand}" Style="{StaticResource GhostSfButton}" />
                        </Grid>
                        <CollectionView ItemsSource="{Binding Notifications}" MaximumHeightRequest="160">
                            <CollectionView.EmptyView>
                                <Label Text="Chưa có thông báo phòng mới trong vùng bạn theo dõi." Style="{StaticResource Caption}" Padding="0,8" />
                            </CollectionView.EmptyView>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:MapNotificationItem">
                                    <Border Style="{StaticResource SubtleCard}" Margin="0,0,0,6" Padding="12,9">
                                        <VerticalStackLayout Spacing="2">
                                            <Label Text="{Binding Title}" FontFamily="FontSemiBold" FontSize="13" />
                                            <Label Text="{Binding Body}" Style="{StaticResource Caption}" FontSize="12" />
                                            <Label Text="{Binding TimeText}" Style="{StaticResource Caption}" FontSize="10.5" />
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </Grid>
</ContentPage>
