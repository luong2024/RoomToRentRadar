<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RoomToRentRadar.Views.RoomListings.ListingLocationPickerPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:loc="clr-namespace:RoomToRentRadar.Core.Localization"
    xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels.RoomListings"
    x:DataType="vm:ListingLocationPickerViewModel"
    Title="{loc:Translate ListingLocation_Title}"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    SafeAreaEdges="Container">

    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="12" Padding="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="{loc:Translate ListingLocation_Title}"
                   FontSize="22"
                   FontAttributes="Bold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="{Binding MapMessage}" />
        </VerticalStackLayout>

        <ContentView x:Name="MapHost" Grid.Row="1" />

        <Grid Grid.Row="2" RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,*"
              RowSpacing="8" ColumnSpacing="12">
            <Label Grid.ColumnSpan="2" Text="{Binding SelectionSummary}" />
            <Label Grid.Row="1" Grid.ColumnSpan="2"
                   Text="{loc:Translate ListingLocation_NavigationError}"
                   IsVisible="{Binding HasCloseError}"
                   TextColor="{StaticResource Error}" />
            <Button Grid.Row="2" Text="{loc:Translate ListingLocation_Cancel}"
                    Style="{StaticResource SecondaryButton}" Command="{Binding CancelCommand}"
                    AutomationId="ListingLocationCancel" />
            <Button Grid.Row="2" Grid.Column="1" Text="{loc:Translate ListingLocation_Confirm}"
                    Command="{Binding ConfirmCommand}" AutomationId="ListingLocationConfirm" />
        </Grid>
    </Grid>
</ContentPage>
