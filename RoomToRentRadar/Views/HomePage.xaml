<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.HomePage"
             x:Name="PageRoot"
             x:DataType="vm:HomeViewModel"
             Title="Khám phá"
             SafeAreaEdges="Container">

    <Grid>
        <!-- 0. AMBIENT LIQUID LIGHT FIELD BACKDROP -->
        <controls:LiquidBackdropView />

        <!-- 1. MAIN EXPLORE & DISCOVERY STREAM (FULL-VIEWPORT FOR 60/120 FPS ZERO-RELAYOUT SCROLLING) -->
        <Grid IsClippedToBounds="True">

            <!-- ==================== VIRTUALIZED LIQUID GLASS COLLECTION STREAM ==================== -->
            <RefreshView IsRefreshing="{Binding IsRefreshing}"
                         Command="{Binding RefreshCommand}"
                         RefreshColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}">

                <CollectionView ItemsSource="{Binding Listings}"
                                SelectionMode="None"
                                Scrolled="OnListingsScrolled"
                                RemainingItemsThreshold="4"
                                RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">

                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical"
                                         Span="{OnIdiom Phone=1, Tablet=2, Desktop=2}"
                                         VerticalItemSpacing="16"
                                         HorizontalItemSpacing="16" />
                    </CollectionView.ItemsLayout>

                    <!-- TOP SPACER MATCHING FLOATING LIQUID GLASS HEADER + ACTIVE FILTERS + SECTION HEADING -->
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="16,158,16,12" Spacing="12">

                            <!-- 1. Active Filter Summary Glass Pills -->
                            <ScrollView Orientation="Horizontal"
                                        HorizontalScrollBarVisibility="Never"
                                        IsVisible="{Binding HasActiveFilters}">
                                <HorizontalStackLayout Spacing="8">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding ActiveFilterChips}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FilterSummaryChip">
                                                <Border Padding="12,6"
                                                        StrokeShape="RoundRectangle 999"
                                                        StrokeThickness="1"
                                                        Stroke="#99FFFFFF"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}">
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding RemoveCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding DisplayLabel}"
                                                           FontFamily="FontSemiBold"
                                                           FontSize="12"
                                                           TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>

                                    <buttons:SfButton Text="Xóa lọc"
                                                      Command="{Binding ClearFiltersCommand}"
                                                      Style="{StaticResource GhostSfButton}"
                                                      HeightRequest="34"
                                                      MinimumHeightRequest="34"
                                                      FontSize="12.5" />
                                </HorizontalStackLayout>
                            </ScrollView>

                            <!-- 4. Section Heading & Results Count -->
                            <Grid ColumnDefinitions="*,Auto" VerticalOptions="End" Margin="2,2,2,0">
                                <Label Grid.Column="0"
                                       Text="Phòng trọ đề xuất"
                                       Style="{StaticResource SectionTitle}"
                                       FontSize="18.5" />
                                <Label Grid.Column="1"
                                       Text="{Binding ResultsText}"
                                       Style="{StaticResource Caption}"
                                       VerticalOptions="Center" />
                            </Grid>

                            <!-- 5. Frosted Skeleton Loading Cards -->
                            <VerticalStackLayout IsVisible="{Binding ShowLoadingState}" Spacing="14">
                                <controls:SkeletonPropertyCard />
                                <controls:SkeletonPropertyCard />
                            </VerticalStackLayout>

                            <!-- 6. Error State -->
                            <controls:StateFeedbackView IsVisible="{Binding HasError}"
                                                        IconSource="close_icon.png"
                                                        EyebrowText="KẾT NỐI TẠM GIÁN ĐOẠN"
                                                        TitleText="Chưa tải được danh sách phòng"
                                                        SubtitleText="{Binding ErrorMessage}"
                                                        ActionText="Thử tải lại"
                                                        ActionCommand="{Binding RetryCommand}" />

                            <!-- 7. Empty State -->
                            <controls:StateFeedbackView IsVisible="{Binding ShowEmptyState}"
                                                        IconSource="search_icon.png"
                                                        EyebrowText="KHÔNG TÌM THẤY PHÒNG"
                                                        TitleText="Chưa có phòng phù hợp bộ lọc"
                                                        SubtitleText="{Binding EmptyMessage}"
                                                        ActionText="Đặt lại bộ lọc"
                                                        ActionCommand="{Binding ClearFiltersCommand}" />
                        </VerticalStackLayout>
                    </CollectionView.Header>

                    <!-- LIQUID GLASS PROPERTY CARD ITEM -->
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="vm:HomeListingItem">
                            <ContentView Padding="16,0">
                                <controls:HomePropertyCard
                                    OpenCommand="{Binding OpenListingCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                    CompareCommand="{Binding ToggleCompareCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}" />
                            </ContentView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="16,8,16,116" Spacing="8">
                            <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                               IsVisible="{Binding IsLoadingMore}"
                                               Color="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}"
                                               HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>

                </CollectionView>
            </RefreshView>

            <!-- ==================== GPU-COMPOSITED FLOATING LIQUID GLASS STICKY HEADER ==================== -->
            <Grid x:Name="StickyHeaderContainer"
                  VerticalOptions="Start"
                  InputTransparent="True"
                  CascadeInputTransparent="False">

                <!-- Soft Frosted Top Scrim (high optical density prevents text bleed-through when header reveals mid-scroll) -->
                <BoxView x:Name="HeaderGlassScrim"
                         InputTransparent="True"
                         Color="{AppThemeBinding Light=#F4EDF4FD, Dark=#F2091222}" />

                <VerticalStackLayout Padding="16,8,16,8"
                                     Spacing="0"
                                     InputTransparent="True"
                                     CascadeInputTransparent="False">

                    <!-- Compact Brand & Theme Row (glides & dissolves 1:1 with scroll finger on GPU) -->
                    <Grid x:Name="BrandUtilityRow"
                          HeightRequest="49"
                          Padding="0,0,0,9"
                          ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="10"
                          VerticalOptions="Center">
                        <Border Grid.Column="0"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1.2"
                                Stroke="{AppThemeBinding Light={StaticResource GlassSpecularRimLight}, Dark={StaticResource GlassSpecularRimDark}}"
                                Padding="0"
                                BackgroundColor="#FFFFFF"
                                VerticalOptions="Center">
                            <Border.Shadow>
                                <Shadow Brush="{AppThemeBinding Light={StaticResource GlassShadowLight}, Dark={StaticResource GlassShadowDark}}"
                                        Offset="0,4" Radius="10" Opacity="0.18" />
                            </Border.Shadow>
                            <Image Source="radar_mark.png"
                                   WidthRequest="40"
                                   HeightRequest="40"
                                   Aspect="AspectFill"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                            <Label Text="Room Radar"
                                   FontFamily="FontBold"
                                   FontSize="16.5"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="Phòng trọ chuẩn gần giảng đường"
                                   Style="{StaticResource Caption}"
                                   FontSize="11"
                                   MaxLines="1"
                                   LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <!-- Specular Glass Dark/Light Mode Orb -->
                        <Border Grid.Column="2"
                                Style="{StaticResource LiquidOrbBorder}"
                                WidthRequest="40"
                                HeightRequest="40"
                                StrokeShape="RoundRectangle 20"
                                AutomationId="HomeThemeToggleButton"
                                SemanticProperties.Description="Chuyển chế độ Sáng hoặc Tối">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnThemeToggleTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="theme_icon.png"
                                   WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                    </Grid>

                    <!-- Sticky Liquid Glass Search Capsule (centers smoothly on GPU) + Filter Orb (dissolves on scroll) -->
                    <Grid ColumnDefinitions="*,Auto"
                          Margin="0,0,0,9"
                          InputTransparent="True"
                          CascadeInputTransparent="False">
                        <Border x:Name="HomeSearchCapsule"
                                Grid.Column="0"
                                Style="{StaticResource LiquidSearchCapsule}"
                                Padding="14,0"
                                HeightRequest="48"
                                Margin="0,0,10,0"
                                AutomationId="HomeSearchTrigger">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding OpenSearchCommand}" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                <Image Grid.Column="0"
                                       Source="search_icon.png"
                                       WidthRequest="18"
                                       HeightRequest="18"
                                       VerticalOptions="Center" />
                                <VerticalStackLayout Grid.Column="1" Spacing="0" VerticalOptions="Center">
                                    <Label Text="{Binding SearchDisplayText}"
                                           FontFamily="FontSemiBold"
                                           FontSize="13.5"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    <Label Text="Chọn trường đại học · đo bán kính"
                                           Style="{StaticResource Caption}"
                                           FontSize="10.5"
                                           MaxLines="1"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>

                        <!-- Specular Liquid Glass Filter Trigger (dissolves smoothly as you scroll) -->
                        <Border x:Name="HomeFilterOrb"
                                Grid.Column="1"
                                Style="{StaticResource LiquidSearchCapsule}"
                                WidthRequest="48"
                                HeightRequest="48"
                                AutomationId="HomeFilterTrigger"
                                SemanticProperties.Description="{Binding FilterButtonText}">
                            <Border.Triggers>
                                <DataTrigger TargetType="Border" Binding="{Binding HasActiveFilters}" Value="True">
                                    <Setter Property="Background" Value="{StaticResource LiquidSapphireBrush}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFilterPanelCommand}" />
                            </Border.GestureRecognizers>
                            <Grid>
                                <Image Source="filter_icon.png"
                                       WidthRequest="19"
                                       HeightRequest="19"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center" />
                                <Border IsVisible="{Binding HasActiveFilters}"
                                        HorizontalOptions="End"
                                        VerticalOptions="Start"
                                        Margin="4"
                                        WidthRequest="18"
                                        HeightRequest="18"
                                        StrokeShape="RoundRectangle 9"
                                        StrokeThickness="0"
                                        BackgroundColor="#FFFFFF">
                                    <Label Text="{Binding ActiveFilterCount}"
                                           FontFamily="FontBold"
                                           FontSize="10"
                                           TextColor="{StaticResource Brand}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center" />
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- Liquid Glass Category Filter Chips (dissolves smoothly on scroll, returns when pulling back to top) -->
                    <ScrollView x:Name="CategoryChipsScroll"
                                Orientation="Horizontal"
                                HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding RoomTypeChips}" Spacing="8" Padding="0,1">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="vm:FilterChip">
                                    <Border Style="{StaticResource LiquidFilterChip}" Padding="10,6">
                                        <Border.Triggers>
                                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource LiquidSapphireBrush}" />
                                                <Setter Property="Stroke" Value="#A8FFFFFF" />
                                            </DataTrigger>
                                        </Border.Triggers>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnChipTapped" Command="{Binding SelectCommand}" />
                                        </Border.GestureRecognizers>

                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Border WidthRequest="22"
                                                    HeightRequest="22"
                                                    StrokeShape="RoundRectangle 11"
                                                    StrokeThickness="0"
                                                    BackgroundColor="Transparent"
                                                    VerticalOptions="Center">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="#EBFFFFFF" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Image Source="{Binding ImageSource}"
                                                       WidthRequest="13"
                                                       HeightRequest="13"
                                                       HorizontalOptions="Center"
                                                       VerticalOptions="Center" />
                                            </Border>
                                            <Label Text="{Binding Label}"
                                                   FontFamily="FontSemiBold"
                                                   FontSize="12.5"
                                                   VerticalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}">
                                                <Label.Triggers>
                                                    <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="TextColor" Value="#FFFFFF" />
                                                    </DataTrigger>
                                                </Label.Triggers>
                                            </Label>
                                        </HorizontalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <progressBar:SfLinearProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
                </VerticalStackLayout>
            </Grid>

            <!-- ==================== PROGRESSIVE FROSTED BOTTOM MIST VEIL (SOFTENS TEXT BEHIND FLOATING TABBAR) ==================== -->
            <BoxView VerticalOptions="End"
                     HeightRequest="108"
                     InputTransparent="True">
                <BoxView.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0.0" />
                        <GradientStop Color="{AppThemeBinding Light=#B8EDF4FD, Dark=#C4080E1A}" Offset="0.52" />
                        <GradientStop Color="{AppThemeBinding Light=#F2F2F6FC, Dark=#F2080E1A}" Offset="1.0" />
                    </LinearGradientBrush>
                </BoxView.Background>
            </BoxView>

            <!-- ==================== FLOATING LIQUID GLASS COMPARISON DOCK ==================== -->
            <VerticalStackLayout VerticalOptions="End"
                                 HorizontalOptions="Center"
                                 Margin="18,0,18,106"
                                 Spacing="8">

                <Border IsVisible="{Binding HasCompareHint}"
                        Style="{StaticResource LiquidFloatingPanel}"
                        Padding="16,10"
                        HorizontalOptions="Center">
                    <Label Text="{Binding CompareHint}"
                           FontFamily="FontSemiBold"
                           FontSize="12.5"
                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                </Border>

                <Border IsVisible="{Binding ShowComparisonBar}"
                        Style="{StaticResource LiquidFloatingPanel}"
                        Padding="16,10"
                        HorizontalOptions="Center"
                        AutomationId="HomeComparisonBar">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenComparisonCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                        <Border WidthRequest="34"
                                HeightRequest="34"
                                StrokeShape="RoundRectangle 17"
                                StrokeThickness="0"
                                Background="{StaticResource LiquidSapphireBrush}">
                            <Image Source="compare_icon_light.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <VerticalStackLayout Spacing="0" VerticalOptions="Center">
                            <Label Text="{Binding ComparisonBarText}"
                                   FontFamily="FontBold"
                                   FontSize="13.5"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="Chạm để đối chiếu chi tiết"
                                   Style="{StaticResource Caption}"
                                   FontSize="11" />
                        </VerticalStackLayout>
                        <Image Source="chevron_right.png" WidthRequest="16" HeightRequest="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>

        </Grid>

        <!-- 2. LIQUID GLASS CAMPUS SEARCH MODAL OVERLAY -->
        <Grid IsVisible="{Binding IsSearchOpen}"
              BackgroundColor="{StaticResource Scrim}"
              Padding="16,20">
            <Border Style="{StaticResource LiquidGlassCard}"
                    VerticalOptions="Start"
                    MaximumWidthRequest="520"
                    Padding="18">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="TÌM GẦN GIẢNG ĐƯỜNG" Style="{StaticResource Eyebrow}" />
                            <Label Text="Chọn trường đại học của bạn" Style="{StaticResource SectionTitle}" />
                        </VerticalStackLayout>
                        <buttons:SfButton Grid.Column="1"
                                          Style="{StaticResource IconCircleButton}"
                                          Command="{Binding CloseSearchCommand}"
                                          AutomationId="HomeCloseSearchButton">
                            <buttons:SfButton.Content>
                                <DataTemplate>
                                    <Image Source="close_icon.png" WidthRequest="16" HeightRequest="16" HorizontalOptions="Center" VerticalOptions="Center" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>
                    </Grid>

                    <inputLayout:SfTextInputLayout Hint="Nhập tên trường (Bách Khoa, KHTN, CNTT...)">
                        <Entry Text="{Binding SearchQuery}"
                               ReturnType="Search"
                               ReturnCommand="{Binding SubmitSearchCommand}"
                               AutomationId="HomeSearchEntry" />
                    </inputLayout:SfTextInputLayout>

                    <Label IsVisible="{Binding HasNoSuggestions}"
                           Text="Không tìm thấy cơ sở khớp từ khóa."
                           Style="{StaticResource Caption}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding CampusSuggestions}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="vm:CampusOption">
                                <Border Style="{StaticResource SubtleCard}" Padding="14,12">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectSearchCampusCommand, Source={RelativeSource AncestorType={x:Type vm:HomeViewModel}}, x:DataType=vm:HomeViewModel}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                                        <Image Grid.Column="0" Source="location_pin.png" WidthRequest="16" HeightRequest="16" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Name}"
                                               FontFamily="FontSemiBold"
                                               FontSize="14" />
                                        <Image Grid.Column="2" Source="chevron_right.png" WidthRequest="15" HeightRequest="15" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>
        </Grid>

        <!-- 3. LIQUID GLASS FILTER BOTTOM SHEET -->
        <bottomSheet:SfBottomSheet x:Name="FilterBottomSheet"
                                   HalfExpandedRatio="0.76"
                                   FullExpandedRatio="0.92"
                                   CornerRadius="28,28,0,0"
                                   ShowGrabber="True"
                                   Background="{AppThemeBinding Light=#F7FBFF, Dark=#121E33}">
            <bottomSheet:SfBottomSheet.BottomSheetContent>
                <Grid RowDefinitions="Auto,*,Auto" Padding="20,8,20,20" RowSpacing="14">

                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="BỘ LỌC THÔNG MINH" Style="{StaticResource Eyebrow}" />
                            <Label Text="Tinh chỉnh khoảng giá &amp; vị trí" Style="{StaticResource SectionTitle}" />
                        </VerticalStackLayout>
                        <buttons:SfButton Grid.Column="1"
                                          Text="Đặt lại"
                                          Command="{Binding ResetDraftCommand}"
                                          Style="{StaticResource GhostSfButton}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="18" Padding="0,4,0,12">

                            <!-- Price Quick Chips + Inputs -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Khoảng giá thuê (triệu đồng / tháng)" FontFamily="FontSemiBold" FontSize="13.5" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding PriceChips}" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChip">
                                            <Border Style="{StaticResource LiquidFilterChip}" Margin="0,0,8,8" Padding="14,8">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource LiquidSapphireBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Label}" FontFamily="FontSemiBold" FontSize="12.5">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <inputLayout:SfTextInputLayout Grid.Column="0" Hint="Từ (triệu)">
                                        <Entry Text="{Binding PriceMinText}" Keyboard="Numeric" />
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="1" Hint="Đến (triệu)">
                                        <Entry Text="{Binding PriceMaxText}" Keyboard="Numeric" />
                                    </inputLayout:SfTextInputLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Area Range -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Diện tích phòng (m²)" FontFamily="FontSemiBold" FontSize="13.5" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                                    <inputLayout:SfTextInputLayout Grid.Column="0" Hint="Tối thiểu m²">
                                        <Entry Text="{Binding AreaMinText}" Keyboard="Numeric" />
                                    </inputLayout:SfTextInputLayout>
                                    <inputLayout:SfTextInputLayout Grid.Column="1" Hint="Tối đa m²">
                                        <Entry Text="{Binding AreaMaxText}" Keyboard="Numeric" />
                                    </inputLayout:SfTextInputLayout>
                                </Grid>
                            </VerticalStackLayout>

                            <!-- Campus & Distance -->
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Trường đại học" FontFamily="FontSemiBold" FontSize="13.5" />
                                <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding CampusChips}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:FilterChip">
                                                <Border Style="{StaticResource LiquidFilterChip}" Padding="14,8">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="Background" Value="{StaticResource LiquidSapphireBrush}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Border.GestureRecognizers>
                                                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                    </Border.GestureRecognizers>
                                                    <Label Text="{Binding Label}" FontFamily="FontSemiBold" FontSize="12.5">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="TextColor" Value="#FFFFFF" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </HorizontalStackLayout>
                                </ScrollView>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="10">
                                <Label Text="Bán kính tới trường" FontFamily="FontSemiBold" FontSize="13.5" />
                                <HorizontalStackLayout BindableLayout.ItemsSource="{Binding DistanceChips}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:FilterChip">
                                            <Border Style="{StaticResource LiquidFilterChip}" Padding="14,8">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource LiquidSapphireBrush}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectCommand}" />
                                                </Border.GestureRecognizers>
                                                <Label Text="{Binding Label}" FontFamily="FontSemiBold" FontSize="12.5">
                                                    <Label.Triggers>
                                                        <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="TextColor" Value="#FFFFFF" />
                                                        </DataTrigger>
                                                    </Label.Triggers>
                                                </Label>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label IsVisible="{Binding HasFilterError}"
                                   Text="{Binding FilterError}"
                                   FontFamily="FontSemiBold"
                                   FontSize="12.5"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />

                        </VerticalStackLayout>
                    </ScrollView>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <buttons:SfButton Grid.Column="0"
                                          Text="Đóng"
                                          Command="{Binding ToggleFilterPanelCommand}"
                                          Style="{StaticResource LiquidGlassButton}" />
                        <buttons:SfButton Grid.Column="1"
                                          Text="Áp dụng bộ lọc"
                                          Command="{Binding ApplyFiltersCommand}"
                                          Style="{StaticResource LiquidPrimaryButton}"
                                          AutomationId="HomeApplyFiltersButton" />
                    </Grid>
                </Grid>
            </bottomSheet:SfBottomSheet.BottomSheetContent>
        </bottomSheet:SfBottomSheet>

    </Grid>
</ContentPage>
