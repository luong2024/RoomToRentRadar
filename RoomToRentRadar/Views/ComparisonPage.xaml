<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.ComparisonPage"
             x:DataType="vm:ComparisonViewModel"
             Title="So sánh phòng"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="Container">

    <Grid>
        <controls:LiquidBackdropView />

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. Floating Liquid Glass Top Bar -->
            <VerticalStackLayout Grid.Row="0"
                                 IsVisible="{Binding ShowChrome}"
                                 Padding="16,10,16,6">
                <Border Style="{StaticResource LiquidFloatingPanel}" Padding="12,10">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                        <Border Grid.Column="0"
                                Style="{StaticResource LiquidOrbBorder}"
                                AutomationId="ComparisonBackButton">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Border.GestureRecognizers>
                            <Image Source="back_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                            <Label Text="SO SÁNH PHÒNG TRỌ" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding ComparisonSummary}" Style="{StaticResource CardTitle}" FontSize="15" MaxLines="1" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>

                        <buttons:SfButton Grid.Column="2"
                                          IsVisible="{Binding ShowContent}"
                                          Text="Xóa hết"
                                          Command="{Binding ClearAllCommand}"
                                          Style="{StaticResource GhostSfButton}" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- 2. Comparison Matrix Body -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="16,8,16,32" Spacing="14">

                    <VerticalStackLayout IsVisible="{Binding IsLoading}" Spacing="12">
                        <controls:SkeletonPropertyCard />
                    </VerticalStackLayout>

                    <controls:StateFeedbackView IsVisible="{Binding HasError}"
                                                IconSource="close_icon.png"
                                                EyebrowText="LỖI TẢI DỮ LIỆU"
                                                TitleText="Không tải được bảng so sánh"
                                                SubtitleText="{Binding ErrorMessage}"
                                                ActionText="Thử lại"
                                                ActionCommand="{Binding RetryCommand}" />

                    <controls:StateFeedbackView IsVisible="{Binding ShowEmptyState}"
                                                IconSource="compare_icon.png"
                                                EyebrowText="CHƯA CÓ PHÒNG"
                                                TitleText="Chưa chọn phòng để so sánh"
                                                SubtitleText="Bấm biểu tượng so sánh ở góc trên bên phải mỗi thẻ phòng ngoài trang Khám phá."
                                                ActionText="Quay lại Khám phá"
                                                ActionCommand="{Binding GoBackCommand}" />

                    <VerticalStackLayout IsVisible="{Binding ShowContent}" Spacing="14">

                        <!-- Campus Selector Card -->
                        <Border Style="{StaticResource LiquidGlassCard}" Padding="16,14">
                            <VerticalStackLayout Spacing="8">
                                <inputLayout:SfTextInputLayout Hint="Chọn trường đại học để đo khoảng cách">
                                    <Picker ItemsSource="{Binding CampusNames}"
                                            SelectedItem="{Binding SelectedCampusName}" />
                                </inputLayout:SfTextInputLayout>
                                <Label IsVisible="{Binding HasDistanceNote}"
                                       Text="{Binding DistanceNote}"
                                       Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Horizontal Scrollable Comparison Table -->
                        <Border Style="{StaticResource CalmReadingCard}" Padding="14">
                            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                                <VerticalStackLayout Spacing="12">

                                    <!-- Room Headers -->
                                    <HorizontalStackLayout Spacing="12">
                                        <BoxView WidthRequest="96" Color="Transparent" />
                                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Columns}" Spacing="12">
                                            <BindableLayout.ItemTemplate>
                                                <DataTemplate x:DataType="models:ComparisonColumnHeader">
                                                    <Border WidthRequest="162" Style="{StaticResource SubtleCard}" Padding="10">
                                                        <VerticalStackLayout Spacing="6">
                                                            <Grid>
                                                                <Border HeightRequest="96" StrokeShape="RoundRectangle 14" StrokeThickness="0">
                                                                    <Grid>
                                                                        <Image Source="room_1.png" Aspect="AspectFill" />
                                                                        <Image Source="{Binding PhotoSource}" Aspect="AspectFill" IsVisible="{Binding HasPhoto}" />
                                                                    </Grid>
                                                                </Border>
                                                                <Border HorizontalOptions="End"
                                                                        VerticalOptions="Start"
                                                                        Margin="6"
                                                                        WidthRequest="28"
                                                                        HeightRequest="28"
                                                                        StrokeShape="RoundRectangle 14"
                                                                        StrokeThickness="1"
                                                                        Stroke="#CCFFFFFF"
                                                                        BackgroundColor="#EAFFFFFF">
                                                                    <Border.GestureRecognizers>
                                                                        <TapGestureRecognizer Command="{Binding RemoveRoomCommand, Source={RelativeSource AncestorType={x:Type vm:ComparisonViewModel}}, x:DataType=vm:ComparisonViewModel}"
                                                                                              CommandParameter="{Binding Id}" />
                                                                    </Border.GestureRecognizers>
                                                                    <Image Source="close_icon.png" WidthRequest="12" HeightRequest="12" HorizontalOptions="Center" VerticalOptions="Center" />
                                                                </Border>
                                                            </Grid>
                                                            <Label Text="{Binding Title}" FontFamily="FontSemiBold" FontSize="13.5" MaxLines="2" LineBreakMode="TailTruncation" />
                                                            <Label Text="{Binding PriceText}"
                                                                   FontFamily="FontBold"
                                                                   FontSize="15"
                                                                   TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                        </VerticalStackLayout>
                                                    </Border>
                                                </DataTemplate>
                                            </BindableLayout.ItemTemplate>
                                        </HorizontalStackLayout>
                                    </HorizontalStackLayout>

                                    <!-- Criteria Rows -->
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rows}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:ComparisonRow">
                                                <HorizontalStackLayout Spacing="12" VerticalOptions="Center">
                                                    <Label WidthRequest="96"
                                                           Text="{Binding Label}"
                                                           FontFamily="FontSemiBold"
                                                           FontSize="12.5"
                                                           VerticalOptions="Center"
                                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />

                                                    <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Cells}" Spacing="12">
                                                        <BindableLayout.ItemTemplate>
                                                            <DataTemplate x:DataType="models:ComparisonCell">
                                                                <Border WidthRequest="162"
                                                                        Padding="12,10"
                                                                        StrokeShape="RoundRectangle 14"
                                                                        StrokeThickness="1"
                                                                        Stroke="{AppThemeBinding Light={StaticResource SubtleLine}, Dark={StaticResource LineDark}}"
                                                                        BackgroundColor="{AppThemeBinding Light=#CCFFFFFF, Dark={StaticResource SoftSurfaceDark}}">
                                                                    <Border.Triggers>
                                                                        <DataTrigger TargetType="Border" Binding="{Binding IsBest}" Value="True">
                                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
                                                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                                        </DataTrigger>
                                                                    </Border.Triggers>
                                                                    <VerticalStackLayout Spacing="2">
                                                                        <Label IsVisible="{Binding IsBest}"
                                                                               Text="★ TỐT NHẤT"
                                                                               Style="{StaticResource Eyebrow}"
                                                                               FontSize="9.5" />
                                                                        <Label Text="{Binding Text}" FontFamily="FontSemiBold" FontSize="13.5" />
                                                                    </VerticalStackLayout>
                                                                </Border>
                                                            </DataTemplate>
                                                        </BindableLayout.ItemTemplate>
                                                    </HorizontalStackLayout>
                                                </HorizontalStackLayout>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                </VerticalStackLayout>
                            </ScrollView>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 3. Floating Share Bar -->
            <Border Grid.Row="2"
                    IsVisible="{Binding ShowBottomBar}"
                    Style="{StaticResource LiquidFloatingPanel}"
                    Margin="16,4,16,12"
                    Padding="12,10">
                <buttons:SfButton Text="Chia sẻ ảnh so sánh phòng"
                                  Clicked="OnShareClicked"
                                  Style="{StaticResource LiquidPrimaryButton}" />
            </Border>

        </Grid>
    </Grid>
</ContentPage>
