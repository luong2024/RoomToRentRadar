<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:RoomToRentRadar.Views.MapSearch"
             xmlns:f="clr-namespace:Fonts"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels.MapSearch"
             x:Class="RoomToRentRadar.Views.MapSearch.MapSearchPage"
             x:DataType="vm:MapSearchViewModel"
             Title="Map Search"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#F8FAFC">

    <ContentPage.Resources>
        <Style x:Key="MapIconButton" TargetType="Button">
            <Setter Property="FontFamily" Value="{x:Static f:FluentUI.FontFamily}" />
            <Setter Property="FontSize" Value="22" />
            <Setter Property="FontAutoScalingEnabled" Value="False" />
            <Setter Property="WidthRequest" Value="48" />
            <Setter Property="HeightRequest" Value="48" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="BorderWidth" Value="1" />
            <Setter Property="BorderColor" Value="#E2E8F0" />
            <Setter Property="BackgroundColor" Value="#FFFFFF" />
            <Setter Property="TextColor" Value="#1E293B" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <!-- Layer 0: Base Google Map (Edge-to-edge full screen) -->
        <local:MapSearchMap x:Name="SearchMap"
                  IsShowingUser="True"
                  MapType="Street"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill" />

        <!-- Shared boundary preview and touch canvas -->
        <GraphicsView x:Name="CanvasView"
                      IsVisible="False"
                      InputTransparent="True"
                      StartInteraction="OnCanvasStart"
                      DragInteraction="OnCanvasDrag"
                      EndInteraction="OnCanvasEnd"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill" />

        <Grid VerticalOptions="Start"
              Margin="16,40,68,0"
              ColumnDefinitions="Auto,*,Auto"
              ColumnSpacing="8">
            <HorizontalStackLayout Spacing="8" IsVisible="{Binding ShowSavedAreas}">
                <Button Style="{StaticResource MapIconButton}"
                        Text="{x:Static f:FluentUI.arrow_counterclockwise_24_regular}"
                        IsVisible="{Binding ShowCompletedToolbar}"
                        SemanticProperties.Description="Draw again"
                        Command="{Binding DrawAgainCommand}" />
                <Button Style="{StaticResource MapIconButton}"
                        Text="{x:Static f:FluentUI.bookmark_multiple_24_regular}"
                        SemanticProperties.Description="Saved areas"
                        Clicked="OnSavedAreasClicked" />
            </HorizontalStackLayout>

            <Button Style="{StaticResource MapIconButton}"
                    Text="{x:Static f:FluentUI.arrow_left_24_regular}"
                    IsVisible="{Binding IsInteractingMode}"
                    SemanticProperties.Description="{Binding BackButtonText}"
                    Command="{Binding HandleBackCommand}" />

            <Border Grid.Column="1"
                    IsVisible="{Binding IsInteractingMode}"
                    StrokeThickness="1"
                    Stroke="#E2E8F0"
                    BackgroundColor="#FFFFFF"
                    Padding="14,8"
                    StrokeShape="RoundRectangle 20"
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    Shadow="{Shadow Brush='#1E3A8A', Offset='0,4', Radius=16, Opacity=0.10}">
                <Label Text="{Binding StatusMessage}"
                       FontSize="12"
                       FontFamily="SegoeSemibold"
                       TextColor="#2563EB"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />
            </Border>

            <Button Grid.Column="2"
                    Style="{StaticResource MapIconButton}"
                    Text="{x:Static f:FluentUI.checkmark_24_regular}"
                    IsVisible="{Binding IsEditingMode}"
                    SemanticProperties.Description="Done editing"
                    Command="{Binding FinishEditingCommand}"
                    BorderWidth="0"
                    Background="{StaticResource PrimaryBrandGradient}"
                    TextColor="White" />
        </Grid>

        <Border VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="20,0,20,32"
                IsVisible="{Binding CanStartDrawing}"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 28"
                Shadow="{Shadow Brush='#1E3A8A', Offset='0,10', Radius=24, Opacity=0.20}">
            <Button Text="✏  Draw area"
                    Command="{Binding StartDrawingCommand}"
                    Background="{StaticResource PrimaryBrandGradient}"
                    TextColor="White"
                    CornerRadius="28"
                    Padding="26,0"
                    HeightRequest="50"
                    FontFamily="SegoeSemibold"
                    FontSize="15" />
        </Border>

        <VerticalStackLayout VerticalOptions="End"
                HorizontalOptions="Center"
                Margin="12,0,12,28"
                Spacing="8"
                MaximumWidthRequest="480"
                IsVisible="{Binding ShowCompletedToolbar}">
            <Border IsVisible="{Binding HasSelectedRoom}"
                    Padding="10"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#E2E8F0"
                    BackgroundColor="#FFFFFF">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10"
                          SemanticProperties.Hint="Opens room details">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnRoomPreviewTapped" />
                        </Grid.GestureRecognizers>
                        <Image Source="{Binding SelectedRoom.ThumbnailUrl}"
                               IsVisible="{Binding SelectedRoom.HasThumbnail, TargetNullValue=False}"
                               WidthRequest="76"
                               HeightRequest="76"
                               Aspect="AspectFill" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2">
                            <Label Text="{Binding SelectedRoom.Title}" TextColor="#0F172A" FontAttributes="Bold"
                                   MaxLines="1" LineBreakMode="TailTruncation" />
                            <Label Text="{Binding SelectedRoom.PriceDisplay}" FontAttributes="Bold"
                                   TextColor="#1D4ED8" />
                            <Label Text="{Binding SelectedRoom.AreaDisplay}" TextColor="#475569" FontSize="12" />
                            <Label Text="{Binding SelectedRoom.Address}" TextColor="#475569" FontSize="12"
                                   MaxLines="2" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                    </Grid>
                    <Button Grid.Column="1" Text="×" MinimumWidthRequest="44" MinimumHeightRequest="44"
                            VerticalOptions="Start" Padding="0"
                            BackgroundColor="Transparent"
                            TextColor="#334155"
                            SemanticProperties.Description="Close room preview"
                            Clicked="OnClosePreviewClicked" />
                </Grid>
            </Border>

            <Border IsVisible="{Binding HasSearchMessage}"
                    HorizontalOptions="Center"
                    Padding="12,4"
                    StrokeShape="RoundRectangle 16"
                    Stroke="#E2E8F0"
                    BackgroundColor="#FFFFFF">
                <HorizontalStackLayout Spacing="6">
                    <ActivityIndicator Color="#2563EB" IsRunning="{Binding IsSearching}" IsVisible="{Binding IsSearching}" />
                    <Label Text="{Binding SearchMessage}" TextColor="#334155" VerticalOptions="Center"
                           FontSize="12" HorizontalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <Border HorizontalOptions="Center"
                    Padding="6"
                    StrokeShape="RoundRectangle 22"
                    Stroke="#E2E8F0"
                    BackgroundColor="#FFFFFF">

                <Border.Shadow>
                    <Shadow Brush="#1E3A8A" Offset="0,10" Radius="26" Opacity="0.14" />
                </Border.Shadow>

                <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                    <Button Style="{StaticResource MapIconButton}"
                            Text="{x:Static f:FluentUI.edit_24_regular}"
                            SemanticProperties.Description="Edit area"
                            Command="{Binding StartEditingCommand}" />
                    <Button Style="{StaticResource MapIconButton}"
                            Text="{x:Static f:FluentUI.heart_24_regular}"
                            IsVisible="{Binding IsAreaConfirmed}"
                            SemanticProperties.Description="Save area"
                            Clicked="OnSaveAreaClicked" />
                    <Button Style="{StaticResource MapIconButton}"
                            Text="{x:Static f:FluentUI.delete_24_regular}"
                            SemanticProperties.Description="Clear area"
                            Command="{Binding ClearPolygonCommand}" />
                    <Button Text="Confirm Area"
                            Command="{Binding ConfirmAreaCommand}"
                            Background="{StaticResource PrimaryBrandGradient}"
                            TextColor="White"
                            CornerRadius="16"
                            Padding="12,0"
                            HeightRequest="48"
                            FontFamily="SegoeSemibold"
                            FontSize="13">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding CanRetrySearch}" Value="True">
                                <Setter Property="Text" Value="Try again" />
                            </DataTrigger>
                            <DataTrigger TargetType="Button" Binding="{Binding IsSearching}" Value="True">
                                <Setter Property="IsEnabled" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                </HorizontalStackLayout>
            </Border>
        </VerticalStackLayout>
    </Grid>
</ContentPage>
