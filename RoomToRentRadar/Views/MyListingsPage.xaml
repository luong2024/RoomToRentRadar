<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.MyListingsPage"
             x:DataType="vm:MyListingsViewModel"
             Title="Tin của tôi"
             SafeAreaEdges="All">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0"
          MaximumWidthRequest="960" HorizontalOptions="Fill">
        <!-- 8.1 White-First Screen Header -->
        <Border StrokeShape="Rectangle" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="0">
                <Grid Padding="16,14" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                        <Label Text="Tin của tôi" Style="{StaticResource ScreenTitle}" FontSize="22"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Quản lý và cập nhật phòng cho thuê của bạn" Style="{StaticResource Caption}" FontSize="12" />
                    </VerticalStackLayout>
                    <buttons:SfButton Grid.Column="1" Text="+ Đăng tin" Command="{Binding CreateCommand}"
                                      IsVisible="{Binding IsAuthenticated}" VerticalOptions="Center"
                                      HeightRequest="44" WidthRequest="104" Padding="10,0" />
                    <buttons:SfButton Grid.Column="2" Text="Đăng xuất" Command="{Binding SignOutCommand}"
                                      IsVisible="{Binding IsAuthenticated}" Style="{StaticResource SoftSfButton}"
                                      VerticalOptions="Center" HeightRequest="44" WidthRequest="96" Padding="8,0"
                                      AutomationId="MyListingsSignOut" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
            </VerticalStackLayout>
        </Border>

        <!-- Progress & Error / Status Bar -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,0" Spacing="8">
            <progressBar:SfLinearProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />
            <Border Padding="14,10" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsAuthenticated}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Message}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12.5"
                           VerticalOptions="Center" SemanticProperties.Description="Thông báo quản lý tin" />
                    <buttons:SfButton Grid.Column="1" Text="Tải lại" Command="{Binding LoadCommand}"
                                      Style="{StaticResource SoftSfButton}" WidthRequest="88" />
                </Grid>
            </Border>
        </VerticalStackLayout>

        <!-- 8.2 Dedicated Logged-Out Experience (Shown only when IsAuthenticated == False) -->
        <ScrollView Grid.Row="2" Padding="16,20">
            <ScrollView.Triggers>
                <DataTrigger TargetType="ScrollView" Binding="{Binding IsAuthenticated}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </ScrollView.Triggers>
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource InkBrush}" Offset="0,6" Radius="16" Opacity="0.06" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Border WidthRequest="56" HeightRequest="56" Padding="12" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                            StrokeShape="RoundRectangle 16" HorizontalOptions="Start">
                        <Image Source="radar_mark.png" />
                    </Border>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="DÀNH CHO CHỦ PHÒNG" Style="{StaticResource Eyebrow}"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                        <Label Text="Quản lý phòng trọ dễ dàng" FontSize="22" FontFamily="OpenSansSemibold"
                               CharacterSpacing="-0.4" />
                        <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="13.5" LineHeight="1.35" />
                    </VerticalStackLayout>
                    <buttons:SfButton Text="Đăng nhập ngay" Command="{Binding SignInCommand}" HorizontalOptions="Fill" />
                    <buttons:SfButton Text="Kiểm tra lại trạng thái đăng nhập" Command="{Binding LoadCommand}"
                                      Style="{StaticResource GhostSfButton}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- 8.3 & 8.4 Authenticated Listings Collection with Dedicated Empty State -->
        <pullToRefresh:SfPullToRefresh Grid.Row="2" IsRefreshing="{Binding IsBusy}" RefreshCommand="{Binding LoadCommand}"
                                       IsVisible="{Binding IsAuthenticated}" Padding="16,10,16,12">
            <pullToRefresh:SfPullToRefresh.PullableContent>
                <CollectionView ItemsSource="{Binding Listings}" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <ContentView>
                        <Border Padding="24,28" Margin="0,8" VerticalOptions="Start" StrokeShape="RoundRectangle 22">
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                        Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                                    <Image Source="radar_mark.png" WidthRequest="28" HeightRequest="28" />
                                </Border>
                                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                                <Label Text="Bạn chưa có tin đăng nào" FontFamily="OpenSansSemibold" FontSize="17" HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="Text" Value="Đang tải tin của bạn…" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="Không thể tải tin của bạn. Kiểm tra kết nối và thử lại.">
                                            <Setter Property="Text" Value="Chưa tải được tin đăng" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <Label Text="Tạo tin cho thuê với ảnh đẹp và thông tin rõ ràng để người thuê dễ tìm thấy phòng."
                                       Style="{StaticResource Caption}" FontSize="13" HorizontalTextAlignment="Center">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                        <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="Không thể tải tin của bạn. Kiểm tra kết nối và thử lại.">
                                            <Setter Property="Text" Value="Kiểm tra kết nối, sau đó bấm Tải lại ở phía trên." />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <buttons:SfButton Text="+ Đăng tin đầu tiên" Command="{Binding CreateCommand}"
                                                  HorizontalOptions="Center" WidthRequest="190" Margin="0,4,0,0" />
                            </VerticalStackLayout>
                        </Border>
                        </ContentView>
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:OwnedListingItem">
                            <cards:SfCardView Padding="16" Margin="0,0,0,12" Style="{StaticResource ElevatedCard}"
                                              IndicatorColor="{StaticResource Accent}" IndicatorPosition="Left" IndicatorThickness="4">
                                <VerticalStackLayout Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <Label Text="{Binding PriceText}" FontFamily="OpenSansSemibold" FontSize="18"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"
                                               VerticalOptions="Center" />
                                        <chips:SfChip Grid.Column="1" Text="{Binding StatusText}" Style="{StaticResource AccentSfChip}" IsEnabled="False" />
                                    </Grid>
                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                           MaxLines="2" LineBreakMode="TailTruncation" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Image Source="location_pin.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Start" Margin="0,2,0,0" />
                                        <Label Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Caption}" MaxLines="2" LineBreakMode="TailTruncation" />
                                    </Grid>
                                    <buttons:SfButton Text="Chỉnh sửa &amp; quản lý tin  →"
                                                      Style="{StaticResource SoftSfButton}"
                                                      Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                      CommandParameter="{Binding .}" />
                                </VerticalStackLayout>
                            </cards:SfCardView>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>
    </Grid>
</ContentPage>
