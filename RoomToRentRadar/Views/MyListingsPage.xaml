<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.MyListingsPage"
             x:DataType="vm:MyListingsViewModel"
             Title="Tin của tôi"
             SafeAreaEdges="Container">
    <ContentPage.Resources>
        <Color x:Key="WarmAccentDark">#F2B872</Color>
        <SolidColorBrush x:Key="DangerSoftDarkBrush" Color="{StaticResource DangerSoftDark}" />
    </ContentPage.Resources>

    <Grid>
        <controls:LiquidBackdropView />

        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="0" HorizontalOptions="Fill">
            <!-- Floating Liquid Glass Header (2-row layout prevents button clipping on narrow phones) -->
            <ContentView Padding="16,10,16,6">
                <Border Style="{StaticResource LiquidFloatingPanel}" Padding="16,12" MaximumWidthRequest="960">
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout Spacing="1">
                            <Label Text="Tin của tôi" Style="{StaticResource ScreenTitle}" FontSize="20"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="Quản lý và cập nhật phòng cho thuê của bạn" Style="{StaticResource Caption}" FontSize="11.5" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10"
                              IsVisible="{Binding IsAuthenticated}">
                            <buttons:SfButton Grid.Column="0"
                                              Text="+ Đăng tin"
                                              Command="{Binding CreateCommand}"
                                              Style="{StaticResource LiquidPrimaryButton}"
                                              HorizontalOptions="Fill"
                                              HeightRequest="42"
                                              MinimumHeightRequest="42"
                                              Padding="12,0"
                                              FontSize="13" />
                            <buttons:SfButton Grid.Column="1"
                                              Text="Đăng xuất"
                                              Command="{Binding SignOutCommand}"
                                              Style="{StaticResource OutlineSfButton}"
                                              HorizontalOptions="Fill"
                                              HeightRequest="42"
                                              MinimumHeightRequest="42"
                                              Padding="12,0"
                                              FontSize="13"
                                              AutomationId="MyListingsSignOut" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </ContentView>

        <!-- Progress, Status Banner & Dashboard Filter Bar -->
        <VerticalStackLayout Grid.Row="1" Padding="16,8,16,0" Spacing="8"
                             MaximumWidthRequest="960" HorizontalOptions="Fill">
            <progressBar:SfLinearProgressBar IsIndeterminate="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Border Padding="14,10" StrokeShape="RoundRectangle 14" IsVisible="{Binding IsAuthenticated}">
                <Border.Triggers>
                    <DataTrigger TargetType="Border" Binding="{Binding Message}" Value="">
                        <Setter Property="IsVisible" Value="False" />
                    </DataTrigger>
                </Border.Triggers>
                <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="12.5"
                       VerticalOptions="Center" SemanticProperties.Description="Thông báo quản lý tin" />
            </Border>
            <ContentView IsVisible="{Binding IsAuthenticated}">
                <VerticalStackLayout Spacing="8" Padding="0,2,0,4" IsVisible="{Binding HasAnyListings}">
                    <Label Text="{Binding DashboardSummaryText}"
                           Style="{StaticResource Caption}"
                           FontSize="12.5"
                           AutomationId="MyListingsDashboardSummary" />
                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout Spacing="8"
                                               BindableLayout.ItemsSource="{Binding StatusFilters}"
                                               AutomationId="MyListingsStatusFilters">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:OwnedListingFilterOption">
                                    <buttons:SfButton Text="{Binding DisplayText}"
                                                      Command="{Binding SelectCommand}"
                                                      Style="{StaticResource OutlineSfButton}"
                                                      HeightRequest="38"
                                                      MinimumHeightRequest="38"
                                                      Padding="14,0"
                                                      FontSize="12.5"
                                                      CornerRadius="19">
                                        <buttons:SfButton.Triggers>
                                            <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsSelected}" Value="True">
                                                <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource AccentSoftBrush}, Dark={StaticResource AccentSoftDarkBrush}}" />
                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource AccentPressed}, Dark={StaticResource AccentDark}}" />
                                                <Setter Property="Stroke" Value="{StaticResource AccentBrush}" />
                                                <Setter Property="StrokeThickness" Value="1.5" />
                                            </DataTrigger>
                                        </buttons:SfButton.Triggers>
                                    </buttons:SfButton>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </ContentView>
        </VerticalStackLayout>

        <!-- 8.2 Dedicated Logged-Out Experience (Shown only when IsAuthenticated == False) -->
        <ScrollView Grid.Row="2" Padding="16,20">
            <ScrollView.Triggers>
                <DataTrigger TargetType="ScrollView" Binding="{Binding IsAuthenticated}" Value="True">
                    <Setter Property="IsVisible" Value="False" />
                </DataTrigger>
            </ScrollView.Triggers>
            <Border Padding="24,28" StrokeShape="RoundRectangle 22" VerticalOptions="Start" MaximumWidthRequest="460" HorizontalOptions="Fill">
                <VerticalStackLayout Spacing="16" HorizontalOptions="Fill">
                    <Border WidthRequest="56" HeightRequest="56" Padding="12" StrokeThickness="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                            StrokeShape="RoundRectangle 16" HorizontalOptions="Start">
                        <Image Source="radar_mark.png" WidthRequest="32" HeightRequest="32" />
                    </Border>
                    <VerticalStackLayout Spacing="6">
                        <Label Text="DÀNH CHO CHỦ PHÒNG" Style="{StaticResource Eyebrow}"
                               TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                        <Label Text="Quản lý phòng trọ dễ dàng" FontSize="22" FontFamily="FontSemiBold"
                               CharacterSpacing="-0.4" />
                        <Label Text="{Binding Message}" Style="{StaticResource Caption}" FontSize="13.5" LineHeight="1.35" />
                    </VerticalStackLayout>
                    <buttons:SfButton Text="Đăng nhập ngay" Command="{Binding SignInCommand}" HorizontalOptions="Fill" />
                    <buttons:SfButton Text="Kiểm tra lại trạng thái đăng nhập" Command="{Binding LoadCommand}"
                                      Style="{StaticResource GhostSfButton}" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>
        </ScrollView>

        <!-- 8.3 & 8.4 Authenticated Listings Pull-to-Refresh + ScrollView + BindableLayout -->
        <RefreshView Grid.Row="2"
                     IsVisible="{Binding IsAuthenticated}"
                     Refreshing="OnRefreshing"
                     RefreshColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}">
        <ScrollView>
            <VerticalStackLayout Padding="16,10,16,116" Spacing="12"
                                 MaximumWidthRequest="960" HorizontalOptions="Fill">
                <Border Padding="24,28" Margin="0,4" VerticalOptions="Start" StrokeShape="RoundRectangle 22"
                        IsVisible="{Binding ShowEmptyState}">
                    <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                                Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 18" HorizontalOptions="Center">
                            <Image Source="radar_mark.png" WidthRequest="28" HeightRequest="28" />
                        </Border>
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
                        <Label Text="Bạn chưa có tin đăng nào" FontFamily="FontSemiBold" FontSize="17" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFilteredEmpty}" Value="True">
                                    <Setter Property="Text" Value="Không có tin nào ở trạng thái này" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Text" Value="Đang tải tin của bạn…" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="Không thể tải tin của bạn. Kiểm tra kết nối và thử lại.">
                                    <Setter Property="Text" Value="Chưa tải được tin đăng" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <Label Text="Tạo tin cho thuê với ảnh đẹp và thông tin rõ ràng để người thuê dễ tìm thấy phòng."
                               Style="{StaticResource Caption}" FontSize="13" HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsFilteredEmpty}" Value="True">
                                    <Setter Property="Text" Value="Chọn bộ lọc khác ở phía trên để xem các tin đăng còn lại của bạn." />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                                <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="Không thể tải tin của bạn. Kiểm tra kết nối và thử lại.">
                                    <Setter Property="Text" Value="Kiểm tra kết nối, sau đó bấm Tải lại ở phía trên." />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                        <buttons:SfButton Text="+ Đăng tin đầu tiên" Command="{Binding CreateCommand}"
                                          IsVisible="{Binding NoOwnedListings}"
                                          HorizontalOptions="Center" WidthRequest="190" Margin="0,4,0,0" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="12" BindableLayout.ItemsSource="{Binding Listings}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:OwnedListingItem">
                            <Border Padding="16" StrokeThickness="1" StrokeShape="RoundRectangle 18"
                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsPublished}" Value="True">
                                        <Setter Property="Stroke" Value="{StaticResource AvailableBorder}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <VerticalStackLayout Spacing="12">
                                    <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                        <Border WidthRequest="96" HeightRequest="84" Padding="0" StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14" VerticalOptions="Start"
                                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                            <Grid WidthRequest="96" HeightRequest="84">
                                                <Image Source="{Binding FallbackIllustration}" WidthRequest="96" HeightRequest="84" Aspect="AspectFill"
                                                       SemanticProperties.Description="Hình đại diện mặc định khi chưa có ảnh phòng" />
                                                <Image Source="{Binding CoverThumbnailUrl}" WidthRequest="96" HeightRequest="84" Aspect="AspectFill"
                                                       IsVisible="{Binding HasCoverThumbnail}"
                                                       SemanticProperties.Description="Ảnh bìa phòng cho thuê" />
                                            </Grid>
                                        </Border>
                                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding PriceText}" FontFamily="FontSemiBold" FontSize="17"
                                                       TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"
                                                       VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation" />
                                                <Border Grid.Column="1" Padding="10,4" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                        VerticalOptions="Center"
                                                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPendingReview}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource WarmSoft}, Dark={StaticResource WarmSoftDark}}" />
                                                        </DataTrigger>
                                                        <DataTrigger TargetType="Border" Binding="{Binding IsPublished}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource AvailableBg}, Dark={StaticResource AvailableBgDark}}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Label Text="{Binding StatusText}" FontFamily="FontSemiBold" FontSize="11.5"
                                                           TextColor="{AppThemeBinding Light={StaticResource AccentPressed}, Dark={StaticResource AccentDark}}">
                                                        <Label.Triggers>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsPendingReview}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource WarmAccent}, Dark={StaticResource WarmAccentDark}}" />
                                                            </DataTrigger>
                                                            <DataTrigger TargetType="Label" Binding="{Binding IsPublished}" Value="True">
                                                                <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Available}, Dark={StaticResource AvailableDark}}" />
                                                            </DataTrigger>
                                                        </Label.Triggers>
                                                    </Label>
                                                </Border>
                                            </Grid>
                                            <Label Text="{Binding Title}" Style="{StaticResource CardTitle}"
                                                   MaxLines="2" LineBreakMode="TailTruncation" />
                                            <Label Text="{Binding RoomSummaryText}" Style="{StaticResource Caption}"
                                                   FontSize="12.5" MaxLines="1" LineBreakMode="TailTruncation" />
                                        </VerticalStackLayout>
                                    </Grid>
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Image Source="location_pin.png" WidthRequest="14" HeightRequest="14" VerticalOptions="Start" Margin="0,2,0,0" />
                                        <Label Grid.Column="1" Text="{Binding Address}" Style="{StaticResource Caption}"
                                               MaxLines="2" LineBreakMode="TailTruncation" />
                                    </Grid>
                                    <HorizontalStackLayout Spacing="8">
                                        <buttons:SfButton Text="Ảnh"
                                                          Style="{StaticResource OutlineSfButton}"
                                                          HeightRequest="40" MinimumHeightRequest="40" Padding="14,0" FontSize="13" CornerRadius="12"
                                                          AutomationId="MyListingsManagePhotos"
                                                          SemanticProperties.Description="Quản lý thư viện ảnh của tin, bao gồm ảnh 360 độ"
                                                          Command="{Binding ManagePhotosCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                        <buttons:SfButton Text="Chỉnh sửa"
                                                          Style="{StaticResource SoftSfButton}"
                                                          IsVisible="{Binding CanEdit}"
                                                          HeightRequest="40" MinimumHeightRequest="40" Padding="14,0" FontSize="13" CornerRadius="12"
                                                          Command="{Binding EditCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                        <buttons:SfButton Text="Đăng lại"
                                                          Style="{StaticResource OutlineSfButton}"
                                                          IsVisible="{Binding CanPublish}"
                                                          HeightRequest="40" MinimumHeightRequest="40" Padding="14,0" FontSize="13" CornerRadius="12"
                                                          Command="{Binding PublishCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                        <buttons:SfButton Text="Gỡ đăng"
                                                          Style="{StaticResource OutlineSfButton}"
                                                          IsVisible="{Binding CanUnpublish}"
                                                          HeightRequest="40" MinimumHeightRequest="40" Padding="14,0" FontSize="13" CornerRadius="12"
                                                          Command="{Binding UnpublishCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                        <buttons:SfButton Text="Xóa"
                                                          Style="{StaticResource DangerSoftSfButton}"
                                                          TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                          Background="{AppThemeBinding Light={StaticResource DangerSoftBrush}, Dark={StaticResource DangerSoftDarkBrush}}"
                                                          HeightRequest="40" MinimumHeightRequest="40" Padding="14,0" FontSize="13" CornerRadius="12"
                                                          Command="{Binding DeleteCommand, Source={RelativeSource AncestorType={x:Type vm:MyListingsViewModel}}, x:DataType=vm:MyListingsViewModel}"
                                                          CommandParameter="{Binding .}" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
        </RefreshView>
        </Grid>
    </Grid>
</ContentPage>
