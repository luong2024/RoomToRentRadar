<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:listings="clr-namespace:RoomToRentRadar.Shared.Listings;assembly=RoomToRentRadar.Shared"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:bottomSheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Views.RoomDetailPage"
             x:Name="DetailPageRoot"
             x:DataType="vm:RoomDetailViewModel"
             Title="Chi tiết phòng"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="Container">

    <Grid>
        <!-- 0. AMBIENT LIQUID LIGHT FIELD -->
        <controls:LiquidBackdropView />

        <Grid RowDefinitions="*,Auto">

            <!-- 1. SCROLLABLE HERO + OVERLAPPING GLASS BRIDGE + CALM READING SECTIONS -->
            <ScrollView Grid.Row="0">
                <VerticalStackLayout Spacing="16" Padding="0,0,0,24">

                    <!-- Loading State -->
                    <VerticalStackLayout IsVisible="{Binding IsLoadingVisible}" Padding="16,18" Spacing="14">
                        <controls:SkeletonPropertyCard />
                        <controls:SkeletonPropertyCard />
                    </VerticalStackLayout>

                    <!-- Not Found State -->
                    <ContentView IsVisible="{Binding IsNotFoundVisible}" Padding="16,32">
                        <controls:StateFeedbackView IconSource="search_icon.png"
                                                    EyebrowText="KHÔNG TÌM THẤY"
                                                    TitleText="Tin đăng không còn tồn tại"
                                                    SubtitleText="Phòng này có thể đã được gỡ khỏi hệ thống."
                                                    ActionText="Quay lại Khám phá"
                                                    ActionCommand="{Binding GoBackCommand}" />
                    </ContentView>

                    <!-- Error State -->
                    <ContentView IsVisible="{Binding IsErrorVisible}" Padding="16,32">
                        <controls:StateFeedbackView IconSource="close_icon.png"
                                                    EyebrowText="KẾT NỐI GIÁN ĐOẠN"
                                                    TitleText="Chưa tải được chi tiết phòng"
                                                    SubtitleText="Kiểm tra kết nối mạng và thử tải lại."
                                                    ActionText="Thử lại"
                                                    ActionCommand="{Binding LoadCommand}" />
                    </ContentView>

                    <!-- Unavailable State + Similar Rooms -->
                    <VerticalStackLayout IsVisible="{Binding IsUnavailableVisible}" Padding="16,20" Spacing="16">
                        <controls:StateFeedbackView IconSource="home_icon.png"
                                                    EyebrowText="ĐÃ NGỪNG CHO THUÊ"
                                                    TitleText="Phòng này hiện đã có người thuê"
                                                    SubtitleText="Gợi ý các phòng tương tự đang còn trống bên dưới."
                                                    ActionText="Quay lại"
                                                    ActionCommand="{Binding GoBackCommand}" />

                        <VerticalStackLayout IsVisible="{Binding HasSimilarRooms}" Spacing="10">
                            <Label Text="Phòng tương tự quanh khu vực" Style="{StaticResource SectionTitle}" />
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SimilarRooms}" Spacing="10">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="listings:ListingSummaryDto">
                                        <Border Style="{StaticResource LiquidGlassCard}" Padding="14">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Command="{Binding OpenSimilarRoomCommand, Source={RelativeSource AncestorType={x:Type vm:RoomDetailViewModel}}, x:DataType=vm:RoomDetailViewModel}"
                                                                      CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                                                <VerticalStackLayout Spacing="3">
                                                    <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding Address}" Style="{StaticResource Caption}" MaxLines="1" LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="1"
                                                       Text="{Binding Price, StringFormat='{0:N0} đ'}"
                                                       FontFamily="FontBold"
                                                       FontSize="15.5"
                                                       TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>

                    <!-- ==================== MAIN CONTENT ==================== -->
                    <VerticalStackLayout x:Name="DetailContent" IsVisible="{Binding IsContentVisible}" Spacing="14">

                        <!-- A. HERO IMAGE GALLERY STAGE + SPECULAR GLASS ACTION ORBS -->
                        <Border HeightRequest="292"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 0,0,30,30"
                                Padding="0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                            <Grid>
                                <Image Source="{Binding PhotoSource}" Aspect="AspectFill" />

                                <!-- Top Floating Liquid Glass Orbs -->
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto"
                                      Padding="16,14"
                                      ColumnSpacing="10"
                                      VerticalOptions="Start">

                                    <Border Grid.Column="0"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="1.2"
                                            Stroke="#E0FFFFFF"
                                            BackgroundColor="#EAFFFFFF"
                                            AutomationId="RoomDetailBackButton"
                                            SemanticProperties.Description="Quay lại">
                                        <Border.Shadow>
                                            <Shadow Brush="#240B2545" Offset="0,4" Radius="12" Opacity="0.18" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="back_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <Border Grid.Column="2"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="1.2"
                                            Stroke="#E0FFFFFF"
                                            BackgroundColor="#EAFFFFFF"
                                            SemanticProperties.Description="Chia sẻ">
                                        <Border.Shadow>
                                            <Shadow Brush="#240B2545" Offset="0,4" Radius="12" Opacity="0.18" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnShareClicked" />
                                        </Border.GestureRecognizers>
                                        <Image Source="share_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <Border Grid.Column="3"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="1.2"
                                            Stroke="#E0FFFFFF"
                                            BackgroundColor="#EAFFFFFF"
                                            AutomationId="RoomDetailReportButton"
                                            SemanticProperties.Description="Báo cáo tin">
                                        <Border.Shadow>
                                            <Shadow Brush="#240B2545" Offset="0,4" Radius="12" Opacity="0.18" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Command="{Binding OpenReportCommand}" />
                                        </Border.GestureRecognizers>
                                        <Image Source="flag_icon.png" WidthRequest="18" HeightRequest="18" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>

                                    <Border x:Name="FavouriteButtonBorder"
                                            Grid.Column="4"
                                            WidthRequest="44"
                                            HeightRequest="44"
                                            StrokeShape="RoundRectangle 22"
                                            StrokeThickness="1.2"
                                            Stroke="#E0FFFFFF"
                                            BackgroundColor="#EAFFFFFF"
                                            AutomationId="RoomDetailFavouriteButton"
                                            SemanticProperties.Description="Lưu yêu thích">
                                        <Border.Shadow>
                                            <Shadow Brush="#240B2545" Offset="0,4" Radius="12" Opacity="0.18" />
                                        </Border.Shadow>
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnFavouriteTapped" />
                                        </Border.GestureRecognizers>
                                        <Image Source="{Binding FavouriteIconSource}" WidthRequest="19" HeightRequest="19" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>

                                <!-- Bottom-Left Hero Typology Pill -->
                                <Border HorizontalOptions="Start"
                                        VerticalOptions="End"
                                        Margin="16,0,16,44"
                                        Padding="12,6"
                                        StrokeShape="RoundRectangle 999"
                                        StrokeThickness="1"
                                        Stroke="#CCFFFFFF"
                                        BackgroundColor="{AppThemeBinding Light=#EAFFFFFF, Dark=#DF0E192D}">
                                    <HorizontalStackLayout Spacing="6">
                                        <Label Text="{Binding StatusDisplayText}"
                                               FontFamily="FontSemiBold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Available}, Dark={StaticResource AvailableDark}}" />
                                        <Label Text="·" Style="{StaticResource Caption}" />
                                        <Label Text="{Binding RoomTypeDisplayText}"
                                               FontFamily="FontSemiBold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    </HorizontalStackLayout>
                                </Border>
                            </Grid>
                        </Border>

                        <!-- B. OVERLAPPING LIQUID GLASS BRIDGE CARD (Price + Title + Landlord) -->
                        <Border Style="{StaticResource LiquidGlassCard}"
                                Margin="16,-44,16,0"
                                Padding="20,18">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                    <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                        <Label Text="{Binding PriceDisplayText}"
                                               Style="{StaticResource PriceHero}"
                                               FontSize="23" />
                                        <Label Text="/ tháng"
                                               Style="{StaticResource Caption}"
                                               VerticalOptions="End"
                                               Margin="0,0,0,3" />
                                    </HorizontalStackLayout>

                                    <Border Grid.Column="1"
                                            Style="{StaticResource StatusBadge}">
                                        <Label Text="{Binding PostedOnText, StringFormat='Đăng {0}'}"
                                               FontFamily="FontSemiBold"
                                               FontSize="11"
                                               TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                    </Border>
                                </Grid>

                                <Label Text="{Binding Listing.Title}"
                                       Style="{StaticResource PageTitle}"
                                       FontSize="20" />

                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="7" VerticalOptions="Center">
                                    <Image Grid.Column="0" Source="location_pin.png" WidthRequest="15" HeightRequest="15" />
                                    <Label Grid.Column="1" Text="{Binding Listing.Address}" Style="{StaticResource Caption}" FontSize="13" />
                                </Grid>

                                <Border Style="{StaticResource SubtleCard}" Padding="12,9" Margin="0,2,0,0">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10" VerticalOptions="Center">
                                        <Image Grid.Column="0" Source="person_icon.png" WidthRequest="18" HeightRequest="18" />
                                        <Label Grid.Column="1"
                                               Text="{Binding Listing.LandlordName, StringFormat='Chủ phòng: {0}'}"
                                               FontFamily="FontSemiBold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                    </Grid>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                        <!-- C. 2x2 BENTO SPEC TILES (Clean high-contrast reading cards) -->
                        <Grid Padding="16,0" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                            <Border Grid.Row="0" Grid.Column="0" Style="{StaticResource CalmReadingCard}" Padding="14,12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Tiền đặt cọc" Style="{StaticResource Caption}" FontSize="11.5" />
                                    <Label Text="{Binding DepositDisplayText}" FontFamily="FontBold" FontSize="15.5" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="0" Grid.Column="1" Style="{StaticResource CalmReadingCard}" Padding="14,12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Diện tích" Style="{StaticResource Caption}" FontSize="11.5" />
                                    <Label Text="{Binding AreaDisplayText}" FontFamily="FontBold" FontSize="15.5" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="0" Style="{StaticResource CalmReadingCard}" Padding="14,12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Không gian ngủ" Style="{StaticResource Caption}" FontSize="11.5" />
                                    <Label Text="{Binding BedroomsText}" FontFamily="FontBold" FontSize="15.5" />
                                </VerticalStackLayout>
                            </Border>

                            <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource CalmReadingCard}" Padding="14,12">
                                <VerticalStackLayout Spacing="3">
                                    <Label Text="Chỉ số an ninh" Style="{StaticResource Caption}" FontSize="11.5" />
                                    <Label Text="{Binding SecurityDisplayText}"
                                           FontFamily="FontBold"
                                           FontSize="15.5"
                                           TextColor="{AppThemeBinding Light={StaticResource Available}, Dark={StaticResource AvailableDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- D. CALM DESCRIPTION SECTION (High readability, not over-glassed) -->
                        <Border IsVisible="{Binding HasDescription}"
                                Style="{StaticResource CalmReadingCard}"
                                Margin="16,0">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Giới thiệu phòng" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding Listing.Description}" Style="{StaticResource BodyText}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- E. AMENITIES -->
                        <Border IsVisible="{Binding HasAmenities}"
                                Style="{StaticResource CalmReadingCard}"
                                Margin="16,0">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Tiện nghi có sẵn" Style="{StaticResource SectionTitle}" />
                                <FlexLayout BindableLayout.ItemsSource="{Binding AmenityDisplayLabels}" Wrap="Wrap">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="x:String">
                                            <Border Margin="0,0,8,8"
                                                    Padding="12,7"
                                                    StrokeShape="RoundRectangle 14"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource SubtleLine}, Dark={StaticResource LineDark}}"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}">
                                                <Label Text="{Binding .}"
                                                       FontFamily="FontSemiBold"
                                                       FontSize="12.5"
                                                       TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- F. CAMPUS COMMUTE & DIRECTIONS -->
                        <Border x:Name="TravelSection"
                                x:DataType="vm:RoomDetailTravelViewModel"
                                Style="{StaticResource CalmReadingCard}"
                                Margin="16,0">
                            <VerticalStackLayout Spacing="12">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="DI CHUYỂN TỚI TRƯỜNG" Style="{StaticResource Eyebrow}" />
                                    <Label Text="Ước tính thời gian &amp; quãng đường" Style="{StaticResource SectionTitle}" />
                                </VerticalStackLayout>

                                <inputLayout:SfTextInputLayout Hint="Chọn trường đại học của bạn">
                                    <Picker ItemsSource="{Binding CampusNames}"
                                            SelectedItem="{Binding SelectedCampusName}"
                                            AutomationId="TravelCampusPicker" />
                                </inputLayout:SfTextInputLayout>

                                <ActivityIndicator IsRunning="{Binding IsLoadingVisible}"
                                                   IsVisible="{Binding IsLoadingVisible}"
                                                   Color="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}"
                                                   HorizontalOptions="Start" />

                                <Label IsVisible="{Binding IsNoCampusVisible}"
                                       Text="Chọn một trường đại học để đo thời gian đi xe máy, xe buýt và đi bộ."
                                       Style="{StaticResource Caption}" />

                                <Label IsVisible="{Binding IsRateLimitedVisible}"
                                       Text="{Binding RateLimitedMessage}"
                                       Style="{StaticResource Caption}" />

                                <VerticalStackLayout IsVisible="{Binding IsLoadedVisible}" Spacing="10">
                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Estimates}" Spacing="8">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="vm:TravelModeEstimateItem">
                                                <Border Style="{StaticResource SubtleCard}" Padding="14,10">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <Label Text="{Binding ModeLabel}" FontFamily="FontSemiBold" FontSize="13.5" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding ValueText}"
                                                               FontFamily="FontBold"
                                                               FontSize="13.5"
                                                               TextColor="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <buttons:SfButton Text="Mở bản đồ chỉ đường"
                                                      Command="{Binding OpenDirectionsCommand}"
                                                      Style="{StaticResource SecondaryActionButton}"
                                                      AutomationId="OpenDirectionsButton" />
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>

                        <!-- G. VERSIONED HOUSE RULES -->
                        <Border IsVisible="{Binding HasHouseRules}"
                                Style="{StaticResource CalmReadingCard}"
                                Margin="16,0">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Nội quy phòng trọ" Style="{StaticResource SectionTitle}" />
                                <Label Text="{Binding HouseRulesVersionText}" Style="{StaticResource Caption}" FontSize="11.5" />

                                <Border Style="{StaticResource SubtleCard}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Giờ giấc yên tĩnh" FontFamily="FontSemiBold" FontSize="13" />
                                        <Label Text="{Binding HouseRules.QuietHours}" Style="{StaticResource BodyText}" FontSize="13.5" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource SubtleCard}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Khách đến thăm" FontFamily="FontSemiBold" FontSize="13" />
                                        <Label Text="{Binding HouseRules.GuestPolicy}" Style="{StaticResource BodyText}" FontSize="13.5" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource SubtleCard}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Nấu ăn" FontFamily="FontSemiBold" FontSize="13" />
                                        <Label Text="{Binding HouseRules.CookingRules}" Style="{StaticResource BodyText}" FontSize="13.5" />
                                    </VerticalStackLayout>
                                </Border>
                                <Border Style="{StaticResource SubtleCard}" Padding="12,10">
                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Gửi xe" FontFamily="FontSemiBold" FontSize="13" />
                                        <Label Text="{Binding HouseRules.ParkingRules}" Style="{StaticResource BodyText}" FontSize="13.5" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>

                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>

            <!-- 2. FLOATING LIQUID GLASS BOTTOM CONTACT BAR -->
            <Border Grid.Row="1"
                    IsVisible="{Binding IsContentVisible}"
                    Style="{StaticResource LiquidFloatingPanel}"
                    Margin="14,4,14,12"
                    Padding="18,12">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label Text="Liên hệ chủ phòng" Style="{StaticResource Caption}" FontSize="11.5" />
                        <Label IsVisible="{Binding IsPhoneVisible}"
                               Text="{Binding LandlordPhone}"
                               FontFamily="FontBold"
                               FontSize="17"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                        <Label IsVisible="{Binding IsSignInPromptVisible}"
                               Text="Đăng nhập để mở khóa SĐT"
                               FontFamily="FontSemiBold"
                               FontSize="13.5"
                               TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </VerticalStackLayout>

                    <buttons:SfButton Grid.Column="1"
                                      IsVisible="{Binding IsPhoneVisible}"
                                      Text="Gọi ngay"
                                      Clicked="OnCallClicked"
                                      Style="{StaticResource LiquidPrimaryButton}"
                                      HeightRequest="46" />

                    <buttons:SfButton Grid.Column="1"
                                      IsVisible="{Binding IsSignInPromptVisible}"
                                      Text="Đăng nhập"
                                      Command="{Binding ShowLoginCommand}"
                                      Style="{StaticResource LiquidPrimaryButton}"
                                      HeightRequest="46"
                                      AutomationId="DetailSignInButton" />
                </Grid>
            </Border>

        </Grid>

        <!-- 3. LIQUID GLASS REPORT LISTING BOTTOM SHEET -->
        <bottomSheet:SfBottomSheet x:Name="ReportBottomSheet"
                                   x:DataType="vm:RoomReportViewModel"
                                   HalfExpandedRatio="0.76"
                                   FullExpandedRatio="0.92"
                                   CornerRadius="28,28,0,0"
                                   ShowGrabber="True"
                                   Background="{AppThemeBinding Light=#F7FBFF, Dark=#121E33}">
            <bottomSheet:SfBottomSheet.BottomSheetContent>
                <Grid RowDefinitions="Auto,*,Auto" Padding="20,8,20,20" RowSpacing="14">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="BÁO CÁO TIN ĐĂNG" Style="{StaticResource Eyebrow}" />
                            <Label Text="{Binding ListingTitle}" Style="{StaticResource CardTitle}" MaxLines="1" LineBreakMode="TailTruncation" />
                        </VerticalStackLayout>
                        <buttons:SfButton Grid.Column="1"
                                          Text="Đóng"
                                          Command="{Binding CloseCommand}"
                                          Style="{StaticResource GhostSfButton}" />
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Spacing="12">
                            <VerticalStackLayout IsVisible="{Binding IsSignInRequiredVisible}" Spacing="12" Padding="0,12">
                                <Label Text="Vui lòng đăng nhập để gửi báo cáo tin đăng tới đội ngũ kiểm duyệt."
                                       Style="{StaticResource BodyText}" />
                                <buttons:SfButton Text="Đăng nhập ngay"
                                                  Command="{Binding SignInCommand}"
                                                  Style="{StaticResource LiquidPrimaryButton}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout IsVisible="{Binding IsFormVisible}" Spacing="10">
                                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Reasons}" Spacing="8">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="vm:ReportReasonOption">
                                            <Border Style="{StaticResource SubtleCard}" Padding="14,11">
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
                                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer Command="{Binding SelectReasonCommand, Source={RelativeSource AncestorType={x:Type vm:RoomReportViewModel}}, x:DataType=vm:RoomReportViewModel}"
                                                                          CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="{Binding Label}" FontFamily="FontSemiBold" FontSize="14" />
                                                    <Label Text="{Binding Description}" Style="{StaticResource Caption}" FontSize="12" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <inputLayout:SfTextInputLayout Hint="Ghi chú thêm (không bắt buộc)">
                                    <Editor Text="{Binding Note}" HeightRequest="84" AutoSize="TextChanges" />
                                </inputLayout:SfTextInputLayout>

                                <Label Text="{Binding NoteLengthText}" Style="{StaticResource Caption}" HorizontalTextAlignment="End" />

                                <Label IsVisible="{Binding HasStatusMessage}"
                                       Text="{Binding StatusMessage}"
                                       FontFamily="FontSemiBold"
                                       FontSize="12.5"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <buttons:SfButton Grid.Row="2"
                                      IsVisible="{Binding IsFormVisible}"
                                      Text="{Binding SubmitButtonText}"
                                      Command="{Binding SubmitCommand}"
                                      IsEnabled="{Binding CanSubmit}"
                                      Style="{StaticResource LiquidPrimaryButton}" />
                </Grid>
            </bottomSheet:SfBottomSheet.BottomSheetContent>
        </bottomSheet:SfBottomSheet>

    </Grid>
</ContentPage>
