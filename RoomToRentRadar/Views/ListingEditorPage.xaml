<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:controls="clr-namespace:RoomToRentRadar.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
             xmlns:expander="clr-namespace:Syncfusion.Maui.Toolkit.Expander;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:maps="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             x:Class="RoomToRentRadar.Views.ListingEditorPage"
             x:DataType="vm:ListingEditorViewModel"
             Title="{Binding PageTitle}"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             SafeAreaEdges="Container">
    <ContentPage.Resources>
        <SolidColorBrush x:Key="DangerSoftDarkBrush" Color="{StaticResource DangerSoftDark}" />
        <Style x:Key="FieldError" TargetType="Label">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>
        <Style x:Key="SectionLabel" TargetType="Label">
            <Setter Property="FontFamily" Value="FontSemiBold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        </Style>
        <Style x:Key="HelperLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
        </Style>
        <Style x:Key="FormEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="MinimumHeightRequest" Value="44" />
        </Style>
        <Style x:Key="FormEditor" TargetType="Editor">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
        </Style>
    </ContentPage.Resources>

    <Grid>
        <controls:LiquidBackdropView />
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Floating Liquid Glass Header (high-contrast Ink/InkDark title, no duplicate NavBar) -->
            <ContentView Grid.Row="0" Padding="16,10,16,6">
                <Border Style="{StaticResource LiquidFloatingPanel}" Padding="12,10" MaximumWidthRequest="740">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Grid.Column="0"
                                Style="{StaticResource LiquidOrbBorder}"
                                SemanticProperties.Description="Quay lại">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnBackTapped" />
                            </Border.GestureRecognizers>
                            <Image Source="back_icon.png" WidthRequest="18" HeightRequest="18"
                                   HorizontalOptions="Center" VerticalOptions="Center" />
                        </Border>
                        <Label Grid.Column="1"
                               Text="{Binding PageTitle}"
                               Style="{StaticResource ScreenTitle}"
                               FontSize="19"
                               VerticalOptions="Center"
                               MaxLines="1"
                               LineBreakMode="TailTruncation"
                               SemanticProperties.HeadingLevel="Level1" />
                        <chips:SfChip Grid.Column="2"
                                      Text="{Binding StatusText}"
                                      Style="{StaticResource AccentSfChip}"
                                      IsEnabled="False"
                                      VerticalOptions="Center" />
                    </Grid>
                </Border>
            </ContentView>

            <ScrollView Grid.Row="1">
                    <VerticalStackLayout Padding="16,8,16,32" Spacing="14" MaximumWidthRequest="740" HorizontalOptions="Fill">
                        <!-- Status / Sign-in Banner (only shown when needed; pull down to refresh) -->
                        <Border Style="{StaticResource LiquidGlassCard}" Padding="14,12">
                            <Border.Triggers>
                                <MultiTrigger TargetType="Border">
                                    <MultiTrigger.Conditions>
                                        <BindingCondition Binding="{Binding IsAuthenticated}" Value="True" />
                                        <BindingCondition Binding="{Binding Message}" Value="" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="IsVisible" Value="False" />
                                </MultiTrigger>
                            </Border.Triggers>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{Binding Message}" AutomationId="ListingFormMessage" Style="{StaticResource Caption}" FontSize="13">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label" Binding="{Binding Message}" Value="">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>
                                <buttons:SfButton Text="Đăng nhập để lưu tin" Command="{Binding SignInCommand}">
                                    <buttons:SfButton.Triggers>
                                        <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsAuthenticated}" Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </buttons:SfButton.Triggers>
                                </buttons:SfButton>
                            </VerticalStackLayout>
                        </Border>

            <!-- Step 01: Basic Info -->
            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="14" IsEnabled="{Binding IsNotBusy}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                            <Label Text="01" FontSize="11" FontFamily="FontSemiBold"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Thông tin cơ bản" Style="{StaticResource SectionTitle}" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <inputLayout:SfTextInputLayout Hint="Tiêu đề *">
                            <Entry Text="{Binding TitleField.Text}" Placeholder="Ví dụ: Phòng studio gần trường" MaxLength="200"
                                   AutomationId="ListingTitle" SemanticProperties.Description="Tiêu đề tin đăng, bắt buộc"
                                   Style="{StaticResource FormEntry}" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding TitleField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <inputLayout:SfTextInputLayout Hint="Địa chỉ *">
                            <Entry Text="{Binding AddressField.Text}" MaxLength="300" Placeholder="Số nhà, đường, phường, thành phố"
                                   AutomationId="ListingAddress" SemanticProperties.Description="Địa chỉ phòng, bắt buộc"
                                   Style="{StaticResource FormEntry}" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding AddressField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <inputLayout:SfTextInputLayout Hint="Tiền thuê mỗi tháng (₫) *">
                            <Entry Text="{Binding RentField.Text}" Keyboard="Numeric" Placeholder="3000000"
                                   AutomationId="ListingRent" SemanticProperties.Description="Tiền thuê mỗi tháng bằng đồng"
                                   Style="{StaticResource FormEntry}" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding RentField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <inputLayout:SfTextInputLayout Hint="Tiền cọc (₫) *">
                            <Entry Text="{Binding DepositField.Text}" Keyboard="Numeric" Placeholder="Nhập 0 nếu không yêu cầu cọc"
                                   AutomationId="ListingDeposit" SemanticProperties.Description="Tiền cọc bằng đồng, bắt buộc, có thể bằng không"
                                   Style="{StaticResource FormEntry}" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding DepositField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <inputLayout:SfTextInputLayout Hint="Diện tích (m²) *">
                            <Entry Text="{Binding AreaField.Text}" Keyboard="Numeric" Placeholder="25"
                                   AutomationId="ListingArea" SemanticProperties.Description="Diện tích phòng bằng mét vuông"
                                   Style="{StaticResource FormEntry}" />
                        </inputLayout:SfTextInputLayout>
                        <Label Text="{Binding AreaField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Loại phòng *" Style="{StaticResource SectionLabel}" FontSize="12" Margin="4,0,0,0" />
                        <Border Padding="12,0" StrokeShape="RoundRectangle 14"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}">
                            <Picker ItemsSource="{Binding RoomTypes}" SelectedItem="{Binding SelectedRoomType}" Title="Chọn loại phòng"
                                    ItemDisplayBinding="{Binding Name, x:DataType=models:RoomTypeOption}" AutomationId="ListingRoomType" />
                        </Border>
                        <Label Text="{Binding RoomTypeError}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Step 02: Location -->
            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="12" IsEnabled="{Binding IsNotBusy}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                            <Label Text="02" FontSize="11" FontFamily="FontSemiBold"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Vị trí phòng" Style="{StaticResource SectionTitle}" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="Chạm bản đồ, dùng GPS hiện tại hoặc nhập tọa độ bên dưới để đặt vị trí phòng chính xác."
                           Style="{StaticResource HelperLabel}" />

                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <buttons:SfButton Text="📍 Dùng vị trí hiện tại (GPS)"
                                          Command="{Binding UseCurrentLocationCommand}"
                                          IsEnabled="{Binding CanUseCurrentLocation}"
                                          Style="{StaticResource SoftSfButton}"
                                          HeightRequest="42"
                                          MinimumHeightRequest="42"
                                          Padding="14,0"
                                          FontSize="13"
                                          CornerRadius="13"
                                          AutomationId="ListingUseCurrentLocation"
                                          SemanticProperties.Description="Lấy tọa độ GPS hiện tại của thiết bị">
                            <buttons:SfButton.Triggers>
                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsLocating}" Value="True">
                                    <Setter Property="Text" Value="Đang định vị GPS…" />
                                </DataTrigger>
                            </buttons:SfButton.Triggers>
                        </buttons:SfButton>
                        <ActivityIndicator IsRunning="{Binding IsLocating}"
                                           IsVisible="{Binding IsLocating}"
                                           WidthRequest="18"
                                           HeightRequest="18"
                                           VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Border StrokeShape="RoundRectangle 18" StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" Padding="0">
                        <Grid HeightRequest="260">
                            <maps:MapControl x:Name="LocationMap" SemanticProperties.Description="Bản đồ chọn vị trí phòng" />
                            <ImageButton Source="locate_icon.png"
                                         Command="{Binding UseCurrentLocationCommand}"
                                         IsEnabled="{Binding CanUseCurrentLocation}"
                                         Style="{StaticResource IconImageButton}"
                                         WidthRequest="44"
                                         HeightRequest="44"
                                         MinimumWidthRequest="44"
                                         MinimumHeightRequest="44"
                                         Padding="11"
                                         HorizontalOptions="End"
                                         VerticalOptions="End"
                                         Margin="12"
                                         AutomationId="ListingMapLocateButton"
                                         SemanticProperties.Description="Định vị vị trí hiện tại trên bản đồ">
                                <ImageButton.Shadow>
                                    <Shadow Brush="{StaticResource InkBrush}" Offset="0,3" Radius="10" Opacity="0.14" />
                                </ImageButton.Shadow>
                            </ImageButton>
                        </Grid>
                    </Border>

                    <Label Text="{Binding LocationStatusMessage}"
                           AutomationId="ListingLocationStatus"
                           Style="{StaticResource Caption}"
                           FontSize="12.5"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding LocationStatusMessage}" Value="">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="4">
                            <inputLayout:SfTextInputLayout Hint="Vĩ độ">
                                <Entry Text="{Binding LatitudeField.Text}" Keyboard="Text" Placeholder="10.7769"
                                       SemanticProperties.Description="Vĩ độ vị trí phòng" Style="{StaticResource FormEntry}" />
                            </inputLayout:SfTextInputLayout>
                            <Label Text="{Binding LatitudeField.Error}" Style="{StaticResource FieldError}" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Grid.Column="1" Spacing="4">
                            <inputLayout:SfTextInputLayout Hint="Kinh độ">
                                <Entry Text="{Binding LongitudeField.Text}" Keyboard="Text" Placeholder="106.7009"
                                       SemanticProperties.Description="Kinh độ vị trí phòng" Style="{StaticResource FormEntry}" />
                            </inputLayout:SfTextInputLayout>
                            <Label Text="{Binding LongitudeField.Error}" Style="{StaticResource FieldError}" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Step 03: Photos -->
            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <VerticalStackLayout Spacing="12" IsEnabled="{Binding IsNotBusy}">
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                            <Label Text="03" FontSize="11" FontFamily="FontSemiBold"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Grid.Column="1" Text="Ảnh phòng *" Style="{StaticResource SectionTitle}" FontSize="16" VerticalOptions="Center" />
                        <chips:SfChip Grid.Column="2" Text="{Binding PhotoCountText}" Style="{StaticResource AccentSfChip}" IsEnabled="False" />
                    </Grid>

                    <Label Text="Ít nhất 3 ảnh JPG hoặc PNG, tối đa 10 MB mỗi ảnh. Tối đa 10 ảnh mới mỗi lần lưu."
                           Style="{StaticResource HelperLabel}" />
                    <buttons:SfButton Text="+ Chọn ảnh từ thiết bị" Command="{Binding PickPhotosCommand}" AutomationId="ListingPickPhotos"
                                      Style="{StaticResource OutlineSfButton}" HorizontalOptions="Start" />
                    <Label Text="{Binding PhotoError}" Style="{StaticResource FieldError}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ExistingPhotos}" Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="models:ExistingListingPhoto">
                                <Border Padding="10" StrokeThickness="0" StrokeShape="RoundRectangle 16"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                    <Grid ColumnDefinitions="96,*" ColumnSpacing="12">
                                        <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" HeightRequest="76" WidthRequest="96">
                                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill"
                                                   SemanticProperties.Description="Ảnh đã lưu của tin đăng" />
                                        </Border>
                                        <Label Grid.Column="1" Text="Ảnh đã lưu trên hệ thống" Style="{StaticResource Caption}"
                                               VerticalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never" AutomationId="SelectedPhotoGrid">
                        <HorizontalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding SelectedPhotos}">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:SelectedListingPhoto">
                                    <VerticalStackLayout WidthRequest="104" Spacing="4">
                                        <Grid WidthRequest="104" HeightRequest="84">
                                            <Border WidthRequest="104" HeightRequest="84" Padding="0" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                                <Image Source="{Binding Path}" WidthRequest="104" HeightRequest="84" Aspect="AspectFill"
                                                       SemanticProperties.Description="Ảnh mới được chọn" />
                                            </Border>
                                            <buttons:SfButton Text="×" Command="{Binding RemoveCommand}"
                                                              Style="{StaticResource DangerSoftSfButton}"
                                                              TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                                              Background="{AppThemeBinding Light={StaticResource DangerSoftBrush}, Dark={StaticResource DangerSoftDarkBrush}}"
                                                              WidthRequest="28" HeightRequest="28"
                                                              MinimumWidthRequest="28" MinimumHeightRequest="28"
                                                              Padding="0" FontSize="14"
                                                              HorizontalOptions="End" VerticalOptions="Start" Margin="0,4,4,0"
                                                              SemanticProperties.Description="Bỏ ảnh đã chọn" />
                                        </Grid>
                                        <Label Text="{Binding FileName}" FontSize="11" MaxLines="1" LineBreakMode="TailTruncation"
                                               HorizontalTextAlignment="Center" />
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>
            </Border>

            <!-- Step 04: Optional Description -->
            <Border Padding="14,12" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                <expander:SfExpander IsExpanded="True" IsEnabled="{Binding IsNotBusy}">
                    <expander:SfExpander.Header>
                        <HorizontalStackLayout Spacing="10" Padding="4,6" VerticalOptions="Center">
                            <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                                <Label Text="04" FontSize="11" FontFamily="FontSemiBold"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                       HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                            </Border>
                            <Label Text="Mô tả thêm (tùy chọn)" Style="{StaticResource SectionTitle}" FontSize="16" VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </expander:SfExpander.Header>
                    <expander:SfExpander.Content>
                        <VerticalStackLayout Spacing="6" Padding="4,10,4,6">
                            <inputLayout:SfTextInputLayout Hint="Giới thiệu không gian, giờ giấc, tiện ích xung quanh..." HeightRequest="136">
                                <Editor Text="{Binding DescriptionField.Text}" AutoSize="TextChanges" MinimumHeightRequest="110" MaxLength="4000"
                                        SemanticProperties.Description="Mô tả phòng, không bắt buộc" Style="{StaticResource FormEditor}" />
                            </inputLayout:SfTextInputLayout>
                            <Label Text="{Binding DescriptionField.Error}" Style="{StaticResource FieldError}" />
                        </VerticalStackLayout>
                    </expander:SfExpander.Content>
                </expander:SfExpander>
            </Border>

            <!-- Step 05: House Rules (edit mode only) -->
            <Border Padding="18" StrokeThickness="1" StrokeShape="RoundRectangle 22"
                    IsVisible="{Binding IsEditMode}"
                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                    AutomationId="HouseRulesEditor">
                <VerticalStackLayout Spacing="14" IsEnabled="{Binding IsNotBusy}">
                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                        <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                            <Label Text="05" FontSize="11" FontFamily="FontSemiBold"
                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                   HorizontalTextAlignment="Center" VerticalTextAlignment="Center" />
                        </Border>
                        <Label Text="Nội quy tòa nhà" Style="{StaticResource SectionTitle}" FontSize="16" VerticalOptions="Center" />
                    </HorizontalStackLayout>

                    <Label Text="{Binding HouseRulesVersionText}" AutomationId="HouseRulesVersion"
                           Style="{StaticResource HelperLabel}" />
                    <Label Text="Nội quy hiển thị cho khách xem tin ngay sau khi lưu."
                           Style="{StaticResource HelperLabel}" />

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Giờ yên tĩnh *" Style="{StaticResource SectionLabel}" FontSize="12.5" />
                        <Border Padding="10,4" HeightRequest="96" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                            <Editor Text="{Binding QuietHoursField.Text}"
                                    MaxLength="300" Style="{StaticResource FormEditor}"
                                    AutomationId="HouseRulesQuietHours"
                                    SemanticProperties.Description="Giờ yên tĩnh của tòa nhà, bắt buộc" />
                        </Border>
                        <Label Text="{Binding QuietHoursField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Khách đến thăm *" Style="{StaticResource SectionLabel}" FontSize="12.5" />
                        <Border Padding="10,4" HeightRequest="96" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                            <Editor Text="{Binding GuestPolicyField.Text}"
                                    MaxLength="300" Style="{StaticResource FormEditor}"
                                    AutomationId="HouseRulesGuestPolicy"
                                    SemanticProperties.Description="Quy định khách đến thăm, bắt buộc" />
                        </Border>
                        <Label Text="{Binding GuestPolicyField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Nấu ăn *" Style="{StaticResource SectionLabel}" FontSize="12.5" />
                        <Border Padding="10,4" HeightRequest="96" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                            <Editor Text="{Binding CookingRulesField.Text}"
                                    MaxLength="300" Style="{StaticResource FormEditor}"
                                    AutomationId="HouseRulesCooking"
                                    SemanticProperties.Description="Quy định nấu ăn, bắt buộc" />
                        </Border>
                        <Label Text="{Binding CookingRulesField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Gửi xe *" Style="{StaticResource SectionLabel}" FontSize="12.5" />
                        <Border Padding="10,4" HeightRequest="96" StrokeThickness="1" StrokeShape="RoundRectangle 12"
                                Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                            <Editor Text="{Binding ParkingRulesField.Text}"
                                    MaxLength="300" Style="{StaticResource FormEditor}"
                                    AutomationId="HouseRulesParking"
                                    SemanticProperties.Description="Quy định gửi xe, bắt buộc" />
                        </Border>
                        <Label Text="{Binding ParkingRulesField.Error}" Style="{StaticResource FieldError}" />
                    </VerticalStackLayout>

                    <buttons:SfButton Text="Lưu nội quy" Command="{Binding SaveHouseRulesCommand}"
                                      HorizontalOptions="Start" Style="{StaticResource SoftSfButton}"
                                      AutomationId="HouseRulesSave"
                                      SemanticProperties.Description="Lưu nội quy và tạo phiên bản mới" />
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    <Border Grid.Row="2" Padding="20,12,20,16" StrokeShape="Rectangle" StrokeThickness="0"
            IsVisible="{Binding IsAuthenticated}" BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
        <Grid RowDefinitions="Auto,Auto" RowSpacing="8" MaximumWidthRequest="740" HorizontalOptions="Fill">
            <Grid HeightRequest="50">
                <buttons:SfButton Text="Lưu tin đăng" Command="{Binding SaveCommand}" AutomationId="ListingSave"
                                  IsEnabled="{Binding CanSaveListing}" HorizontalOptions="Fill" Padding="16,0">
                    <buttons:SfButton.Triggers>
                        <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsBusy}" Value="True">
                            <Setter Property="Text" Value="Đang xử lý…" />
                        </DataTrigger>
                    </buttons:SfButton.Triggers>
                </buttons:SfButton>
                <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" InputTransparent="True"
                                   HorizontalOptions="End" WidthRequest="20" HeightRequest="20" Margin="0,0,14,0"
                                   Color="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            </Grid>
            <HorizontalStackLayout Grid.Row="1" Spacing="8" HorizontalOptions="End" IsVisible="{Binding IsEditMode}">
                <buttons:SfButton Text="Đăng lại" Command="{Binding PublishCommand}" IsVisible="{Binding CanPublish}"
                                  IsEnabled="{Binding IsNotBusy}" AutomationId="ListingPublish"
                                  Style="{StaticResource SoftSfButton}" HeightRequest="44" MinimumHeightRequest="44"
                                  Padding="16,0" />
                <buttons:SfButton Text="Gỡ tin" Command="{Binding UnpublishCommand}" IsVisible="{Binding CanUnpublish}"
                                  IsEnabled="{Binding IsNotBusy}" AutomationId="ListingUnpublish"
                                  Style="{StaticResource OutlineSfButton}" HeightRequest="44" MinimumHeightRequest="44"
                                  Padding="16,0" />
                <buttons:SfButton Text="Xóa tin" Command="{Binding DeleteCommand}" IsVisible="{Binding IsEditMode}"
                                  IsEnabled="{Binding CanDeleteWhenIdle}" AutomationId="ListingDelete"
                                  Style="{StaticResource DestructiveActionButton}"
                                  TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                                  Background="{AppThemeBinding Light={StaticResource DangerSoftBrush}, Dark={StaticResource DangerSoftDarkBrush}}"
                                  HeightRequest="44" MinimumHeightRequest="44" Padding="16,0" />
            </HorizontalStackLayout>
        </Grid>
    </Border>
        </Grid>
    </Grid>
</ContentPage>
