<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
                    xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
                    xmlns:chips="clr-namespace:Syncfusion.Maui.Toolkit.Chips;assembly=Syncfusion.Maui.Toolkit"
                    xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
                    xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
                    xmlns:shimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
                    xmlns:helpers="clr-namespace:RoomToRentRadar.Helpers">

    <helpers:StringNotEmptyConverter x:Key="StringNotEmptyConverter" />

    <!-- Global Page Surface -->
    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource CanvasLight}, Dark={StaticResource CanvasDark}}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="FontRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <!-- Default SfButton = Liquid Sapphire Jewel -->
    <Style TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidPrimaryButton}" />

    <Style x:Key="SecondaryActionButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidGlassButton}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="AccentActionButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidPrimaryButton}" />

    <Style x:Key="OutlineActionButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidGlassButton}" />

    <Style x:Key="SoftSfButton" TargetType="buttons:SfButton" BasedOn="{StaticResource SecondaryActionButton}">
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style x:Key="GhostSfButton" TargetType="buttons:SfButton">
        <Setter Property="FontFamily" Value="FontSemiBold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="MinimumHeightRequest" Value="42" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style x:Key="DangerActionButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidGlassButton}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource DangerTint}, Dark={StaticResource DangerTintDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="IconCircleButton" TargetType="buttons:SfButton">
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="MinimumWidthRequest" Value="44" />
        <Setter Property="MinimumHeightRequest" Value="44" />
        <Setter Property="CornerRadius" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="StrokeThickness" Value="1.2" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SubtleLine}, Dark={StaticResource StrongLineDark}}" />
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource GlassSurfaceFillLight}, Dark={StaticResource GlassSurfaceFillDark}}" />
    </Style>

    <!-- Card Aliases mapped to Liquid Glass / Calm Reading Cards -->
    <Style x:Key="ElevatedCard" TargetType="Border" BasedOn="{StaticResource LiquidGlassCard}" />
    <Style x:Key="SubtleCard" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 18" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SpecularMidLight}, Dark={StaticResource LineDark}}" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#CCF0F6FF, Dark=#B817253D}" />
        <Setter Property="Padding" Value="14" />
    </Style>

    <Style x:Key="StatusBadge" TargetType="Border">
        <Setter Property="StrokeShape" Value="RoundRectangle 999" />
        <Setter Property="StrokeThickness" Value="1" />
        <Setter Property="Stroke" Value="#66FFFFFF" />
        <Setter Property="Padding" Value="11,5" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
    </Style>

    <!-- Liquid Glass compatibility styles for Profile, Settings, Landlord & Moderation views -->
    <Style x:Key="OutlineSfButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidGlassButton}" />

    <Style x:Key="DangerSoftSfButton" TargetType="buttons:SfButton" BasedOn="{StaticResource LiquidGlassButton}">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
    </Style>

    <Style x:Key="DestructiveActionButton" TargetType="buttons:SfButton" BasedOn="{StaticResource DangerSoftSfButton}" />

    <Style x:Key="IconImageButton" TargetType="ImageButton">
        <Setter Property="WidthRequest" Value="42" />
        <Setter Property="HeightRequest" Value="42" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="CornerRadius" Value="21" />
        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
    </Style>

    <Style x:Key="AccentSfChip" TargetType="chips:SfChip">
        <Setter Property="Background" Value="{AppThemeBinding Light={StaticResource BrandTint}, Dark={StaticResource BrandTintDark}}" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="FontFamily" Value="FontSemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Liquid Glass Outlined Text Input -->
    <Style TargetType="inputLayout:SfTextInputLayout">
        <Setter Property="ContainerType" Value="Outlined" />
        <Setter Property="OutlineCornerRadius" Value="18" />
        <Setter Property="ContainerBackground" Value="{AppThemeBinding Light=#DCFFFFFF, Dark=#C2142036}" />
        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource SubtleLine}, Dark={StaticResource StrongLineDark}}" />
        <Setter Property="FocusedStrokeThickness" Value="1.8" />
        <Setter Property="UnfocusedStrokeThickness" Value="1.1" />
        <Setter Property="ReserveSpaceForAssistiveLabels" Value="False" />
        <Setter Property="HintLabelStyle">
            <Setter.Value>
                <inputLayout:LabelStyle FontFamily="FontMedium"
                                        FontSize="13"
                                        TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="FontFamily" Value="FontMedium" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource PlaceholderInk}, Dark={StaticResource PlaceholderInkDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Editor">
        <Setter Property="FontFamily" Value="FontRegular" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource PlaceholderInk}, Dark={StaticResource PlaceholderInkDark}}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>

    <Style TargetType="Picker">
        <Setter Property="FontFamily" Value="FontMedium" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
        <Setter Property="TitleColor" Value="{AppThemeBinding Light={StaticResource PlaceholderInk}, Dark={StaticResource PlaceholderInkDark}}" />
    </Style>

    <Style TargetType="progressBar:SfLinearProgressBar">
        <Setter Property="TrackHeight" Value="3" />
        <Setter Property="ProgressHeight" Value="3" />
        <Setter Property="TrackFill" Value="{AppThemeBinding Light=#CCE0F0FF, Dark=#223452}" />
        <Setter Property="ProgressFill" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style TargetType="shimmer:SfShimmer">
        <Setter Property="Fill" Value="{AppThemeBinding Light=#DCE8F8, Dark=#17263F}" />
        <Setter Property="WaveColor" Value="{AppThemeBinding Light=#FFFFFF, Dark=#2A4166}" />
        <Setter Property="WaveWidth" Value="140" />
    </Style>

</ResourceDictionary>
