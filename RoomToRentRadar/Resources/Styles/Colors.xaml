<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =======================================================================
         ROOM RADAR — LIQUID GLASS COLOR PALETTE
         Light Mode: "Crystal Glacier & Sapphire Cyan"
         Dark Mode:  "Abyssal Glass & Luminous Azure"
         ======================================================================= -->

    <!-- Brand & Liquid Jewel Accents (Light) -->
    <Color x:Key="Brand">#0066FF</Color>
    <Color x:Key="BrandDeep">#004EC4</Color>
    <Color x:Key="BrandCyan">#06B6D4</Color>
    <Color x:Key="BrandTint">#E0EFFF</Color>
    <Color x:Key="Accent">#0891B2</Color>
    <Color x:Key="AccentTint">#DFF7FA</Color>

    <!-- Brand & Liquid Jewel Accents (Dark) -->
    <Color x:Key="BrandDark">#38BDF8</Color>
    <Color x:Key="BrandDeepDark">#2589FF</Color>
    <Color x:Key="BrandTintDark">#152C4A</Color>
    <Color x:Key="AccentDark">#22D3EE</Color>
    <Color x:Key="AccentTintDark">#112E3B</Color>

    <!-- Base Canvases & Solid Reading Surfaces (Light) -->
    <Color x:Key="CanvasLight">#F2F6FC</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SoftSurface">#E8EFF9</Color>
    <Color x:Key="SurfaceElevated">#F9FBFF</Color>

    <!-- Base Canvases & Solid Reading Surfaces (Dark) -->
    <Color x:Key="CanvasDark">#080E1A</Color>
    <Color x:Key="SurfaceDark">#111B2E</Color>
    <Color x:Key="SoftSurfaceDark">#17243B</Color>
    <Color x:Key="SurfaceElevatedDark">#1B2A44</Color>

    <!-- Controlled Translucent Liquid Glass Surfaces (Light) -->
    <Color x:Key="GlassUltraLight">#DCFFFFFF</Color>
    <Color x:Key="GlassLight">#C9F8FBFF</Color>
    <Color x:Key="GlassMediumLight">#B5F2F7FF</Color>
    <Color x:Key="GlassCardBodyLight">#EBFFFFFF</Color>
    <Color x:Key="GlassChipIdleLight">#B8FFFFFF</Color>
    <Color x:Key="GlassPillOverlayLight">#E6FFFFFF</Color>

    <!-- Controlled Translucent Liquid Glass Surfaces (Dark) -->
    <Color x:Key="GlassUltraDark">#D9152238</Color>
    <Color x:Key="GlassDark">#C4121E32</Color>
    <Color x:Key="GlassMediumDark">#AD0F192B</Color>
    <Color x:Key="GlassCardBodyDark">#E3121D30</Color>
    <Color x:Key="GlassChipIdleDark">#B518263E</Color>
    <Color x:Key="GlassPillOverlayDark">#DF0F1829</Color>

    <!-- Specular Rim Highlights & Hairline Borders -->
    <Color x:Key="SpecularBrightLight">#F7FFFFFF</Color>
    <Color x:Key="SpecularMidLight">#90FFFFFF</Color>
    <Color x:Key="SpecularEdgeLight">#B8CAD9EC</Color>
    <Color x:Key="SubtleLine">#D5E0EE</Color>
    <Color x:Key="Line">#BFD0E4</Color>

    <Color x:Key="SpecularBrightDark">#66FFFFFF</Color>
    <Color x:Key="SpecularMidDark">#24FFFFFF</Color>
    <Color x:Key="SpecularEdgeDark">#4038BDF8</Color>
    <Color x:Key="LineDark">#24344F</Color>
    <Color x:Key="StrongLineDark">#33496B</Color>

    <!-- High-Contrast Typography Ink (WCAG AA/AAA Verified) -->
    <Color x:Key="Ink">#0B1526</Color>
    <Color x:Key="InkSecondary">#2C3D55</Color>
    <Color x:Key="Muted">#4B5E78</Color>
    <Color x:Key="PlaceholderInk">#7588A3</Color>

    <Color x:Key="InkDark">#F4F8FF</Color>
    <Color x:Key="InkSecondaryDark">#C8D6EA</Color>
    <Color x:Key="MutedDark">#93A8C4</Color>
    <Color x:Key="PlaceholderInkDark">#69809E</Color>

    <!-- Semantic Colors -->
    <Color x:Key="Available">#059669</Color>
    <Color x:Key="AvailableTint">#DCFCE7</Color>
    <Color x:Key="AvailableDark">#34D399</Color>
    <Color x:Key="AvailableTintDark">#0E2E26</Color>

    <Color x:Key="Warning">#D97706</Color>
    <Color x:Key="WarningTint">#FEF3C7</Color>
    <Color x:Key="WarningDark">#FBBF24</Color>
    <Color x:Key="WarningTintDark">#33250E</Color>

    <Color x:Key="Danger">#E11D48</Color>
    <Color x:Key="DangerTint">#FFE4E6</Color>
    <Color x:Key="DangerDark">#FB7185</Color>
    <Color x:Key="DangerTintDark">#361520</Color>

    <Color x:Key="Scrim">#66081120</Color>
    <Color x:Key="GlassShadowLight">#1A0B2545</Color>
    <Color x:Key="GlassShadowDark">#5502060D</Color>

    <!-- Legacy aliases kept for full compatibility -->
    <Color x:Key="Primary">#0066FF</Color>
    <Color x:Key="PrimaryDark">#38BDF8</Color>
    <Color x:Key="PrimaryDarkText">#080E1A</Color>
    <Color x:Key="Secondary">#E0EFFF</Color>
    <Color x:Key="SecondaryDarkText">#0066FF</Color>
    <Color x:Key="Tertiary">#0891B2</Color>
    <Color x:Key="AccentPressed">#004ECC</Color>
    <Color x:Key="AccentSoft">#E0EEFF</Color>
    <Color x:Key="AccentSoftDark">#122A4D</Color>
    <Color x:Key="AvailableBg">#DCFCE7</Color>
    <Color x:Key="AvailableBgDark">#0E2E26</Color>
    <Color x:Key="AvailableBorder">#86EFAC</Color>
    <Color x:Key="BodyInk">#2C3D55</Color>
    <Color x:Key="Canvas">#F2F6FC</Color>
    <Color x:Key="DangerSoft">#FFE4E6</Color>
    <Color x:Key="DangerSoftDark">#361520</Color>
    <Color x:Key="WarmAccent">#D97706</Color>
    <Color x:Key="WarmSoft">#FEF3C7</Color>
    <Color x:Key="WarmSoftDark">#33250E</Color>

    <SolidColorBrush x:Key="AccentBrush" Color="#0066FF" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#E0EEFF" />
    <SolidColorBrush x:Key="AccentSoftDarkBrush" Color="#122A4D" />
    <SolidColorBrush x:Key="AvailableBrush" Color="#059669" />
    <SolidColorBrush x:Key="AvailableBgBrush" Color="#DCFCE7" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#FFE4E6" />
    <SolidColorBrush x:Key="InkBrush" Color="#0B1526" />
    <SolidColorBrush x:Key="WarmAccentBrush" Color="#D97706" />
    <SolidColorBrush x:Key="WarmSoftBrush" Color="#FEF3C7" />

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#0B1526</Color>
    <Color x:Key="OffBlack">#080E1A</Color>
    <Color x:Key="Gray100">#E8EFF9</Color>
    <Color x:Key="Gray200">#D5E0EE</Color>
    <Color x:Key="Gray300">#B5C6DC</Color>
    <Color x:Key="Gray400">#8DA2BE</Color>
    <Color x:Key="Gray500">#5E7391</Color>
    <Color x:Key="Gray600">#3E506B</Color>
    <Color x:Key="Gray900">#111B2E</Color>
    <Color x:Key="Gray950">#080E1A</Color>

</ResourceDictionary>
