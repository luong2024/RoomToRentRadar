<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary 
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Note: For Android please see also Platforms\Android\Resources\values\colors.xml -->

    <Color x:Key="Primary">#512BD4</Color>
    <Color x:Key="PrimaryDark">#ac99ea</Color>
    <Color x:Key="PrimaryDarkText">#242424</Color>
    <Color x:Key="Secondary">#DFD8F7</Color>
    <Color x:Key="SecondaryDarkText">#9880e5</Color>
    <Color x:Key="Tertiary">#2B0B98</Color>

    <Color x:Key="DarkBackground">#17171a</Color>
    <Color x:Key="LightOnDarkBackground">#C3C3C3</Color>
    <Color x:Key="LightBackground">#F2F2F2</Color>
    <Color x:Key="DarkOnLightBackground">#0D0D0D</Color>

    <Color x:Key="LightSecondaryBackground">#E0E0E0</Color>
    <Color x:Key="DarkSecondaryBackground">#222228</Color>

    <Color x:Key="White">White</Color>
    <Color x:Key="Black">Black</Color>
    <Color x:Key="Magenta">#D600AA</Color>
    <Color x:Key="MidnightBlue">#190649</Color>
    <Color x:Key="OffBlack">#1f1f1f</Color>

    <Color x:Key="Gray100">#E1E1E1</Color>
    <Color x:Key="Gray200">#C8C8C8</Color>
    <Color x:Key="Gray300">#ACACAC</Color>
    <Color x:Key="Gray400">#919191</Color>
    <Color x:Key="Gray500">#6E6E6E</Color>
    <Color x:Key="Gray600">#404040</Color>
    <Color x:Key="Gray900">#212121</Color>
    <Color x:Key="Gray950">#141414</Color>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="SecondaryBrush" Color="{StaticResource Secondary}"/>
    <SolidColorBrush x:Key="TertiaryBrush" Color="{StaticResource Tertiary}"/>
    <SolidColorBrush x:Key="WhiteBrush" Color="{StaticResource White}"/>
    <SolidColorBrush x:Key="BlackBrush" Color="{StaticResource Black}"/>

    <SolidColorBrush x:Key="Gray100Brush" Color="{StaticResource Gray100}"/>
    <SolidColorBrush x:Key="Gray200Brush" Color="{StaticResource Gray200}"/>
    <SolidColorBrush x:Key="Gray300Brush" Color="{StaticResource Gray300}"/>
    <SolidColorBrush x:Key="Gray400Brush" Color="{StaticResource Gray400}"/>
    <SolidColorBrush x:Key="Gray500Brush" Color="{StaticResource Gray500}"/>
    <SolidColorBrush x:Key="Gray600Brush" Color="{StaticResource Gray600}"/>
    <SolidColorBrush x:Key="Gray900Brush" Color="{StaticResource Gray900}"/>
    <SolidColorBrush x:Key="Gray950Brush" Color="{StaticResource Gray950}"/>

    <!-- UI Polish Design System Tokens (Slate & Modern Tech Blue) -->
    <Color x:Key="PageBackground">#F8FAFC</Color>
    <Color x:Key="PageBackgroundDark">#0F172A</Color>

    <Color x:Key="CardBackground">#FFFFFF</Color>
    <Color x:Key="CardBackgroundDark">#1E293B</Color>

    <Color x:Key="SurfaceSubtle">#F1F5F9</Color>
    <Color x:Key="SurfaceSubtleDark">#334155</Color>

    <Color x:Key="BorderSubtle">#E2E8F0</Color>
    <Color x:Key="BorderSubtleDark">#334155</Color>

    <Color x:Key="PrimaryBrand">#2563EB</Color>
    <Color x:Key="PrimaryBrandDark">#60A5FA</Color>
    <Color x:Key="PrimaryBrandPressed">#1D4ED8</Color>
    <Color x:Key="PrimaryBrandSoft">#EFF6FF</Color>
    <Color x:Key="PrimaryBrandSoftDark">#1E3A8A</Color>

    <LinearGradientBrush x:Key="PrimaryBrandGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0.0" Color="#2563EB" />
        <GradientStop Offset="1.0" Color="#1D4ED8" />
    </LinearGradientBrush>

    <Color x:Key="TextPrimarySlate">#0F172A</Color>
    <Color x:Key="TextPrimarySlateDark">#F8FAFC</Color>
    <Color x:Key="TextSecondarySlate">#475569</Color>
    <Color x:Key="TextSecondarySlateDark">#CBD5E1</Color>
    <Color x:Key="TextMutedSlate">#64748B</Color>
    <Color x:Key="TextMutedSlateDark">#94A3B8</Color>

    <Color x:Key="AccentTeal">#0F766E</Color>
    <Color x:Key="AccentTealDark">#5EEAD4</Color>
    <Color x:Key="AccentTealSoft">#F0FDFA</Color>
    <Color x:Key="AccentTealSoftDark">#134E4A</Color>

    <Color x:Key="VerifiedBadgeBg">#DCFCE7</Color>
    <Color x:Key="VerifiedBadgeBgDark">#14532D</Color>
    <Color x:Key="VerifiedBadgeText">#166534</Color>
    <Color x:Key="VerifiedBadgeTextDark">#86EFAC</Color>

    <Color x:Key="HeroOverlayGlass">#26FFFFFF</Color>
    <Color x:Key="HeroSubtitleLight">#DBEAFE</Color>
    <Color x:Key="DistanceOverlayBg">#CC0F172A</Color>
    <Color x:Key="ScrimStart">#590F172A</Color>
    <Color x:Key="ScrimEnd">#000F172A</Color>

    <!-- Desktop Window TitleBar & Shell Frame Tokens -->
    <Color x:Key="TitleBarBackground">#F1F5F9</Color>
    <Color x:Key="TitleBarBackgroundDark">#0F172A</Color>
    <Color x:Key="TitleBarForeground">#0F172A</Color>
    <Color x:Key="TitleBarForegroundDark">#F8FAFC</Color>
    <Color x:Key="TitleBarSearchBackground">#FFFFFF</Color>
    <Color x:Key="TitleBarSearchBackgroundDark">#1E293B</Color>
    <Color x:Key="TitleBarSearchBorder">#CBD5E1</Color>
    <Color x:Key="TitleBarSearchBorderDark">#334155</Color>
    <Color x:Key="TitleBarPlaceholder">#64748B</Color>
    <Color x:Key="TitleBarPlaceholderDark">#94A3B8</Color>
    <Color x:Key="TitleBarAccentIcon">#2563EB</Color>
    <Color x:Key="TitleBarAccentIconDark">#60A5FA</Color>
    <Color x:Key="DesktopFrameBackdrop">#F1F5F9</Color>
    <Color x:Key="DesktopFrameBackdropDark">#0F172A</Color>
    <Color x:Key="DesktopRailBackground">#F1F5F9</Color>
    <Color x:Key="DesktopRailBackgroundDark">#1E293B</Color>
</ResourceDictionary>