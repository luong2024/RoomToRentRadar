<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <!-- ROOM RADAR — Payoo Blue Palette -->
    <!-- Primary Brand Tokens -->
    <Color x:Key="Accent">#0072BC</Color>
    <Color x:Key="AccentPressed">#005893</Color>
    <Color x:Key="AccentLight">#C6E6F8</Color>
    <Color x:Key="AccentSoft">#E7F4FC</Color>
    <Color x:Key="AccentBlue">#28AAE2</Color>
    <Color x:Key="AccentCyan">#7FCFF2</Color>

    <!-- Background & Surface Tokens -->
    <Color x:Key="Canvas">#EFF6FB</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SurfaceElevated">#FFFFFF</Color>
    <Color x:Key="SoftSurface">#F4F9FC</Color>

    <!-- Typography Tokens -->
    <Color x:Key="Ink">#152430</Color>
    <Color x:Key="BodyInk">#33424E</Color>
    <Color x:Key="Muted">#7B8B98</Color>
    <Color x:Key="DisabledInk">#9BAAB6</Color>
    <Color x:Key="SubtleText">#92A1AD</Color>

    <!-- Border Tokens -->
    <Color x:Key="Line">#E1EAF2</Color>
    <Color x:Key="SubtleLine">#EDF4F9</Color>
    <Color x:Key="FocusBorder">#0072BC</Color>

    <!-- Semantic Tokens (Green strictly for Available / Success status) -->
    <Color x:Key="Available">#1E7B4F</Color>
    <Color x:Key="AvailableBg">#ECF8F1</Color>
    <Color x:Key="AvailableBorder">#CDEBDD</Color>
    <Color x:Key="WarmAccent">#A9652A</Color>
    <Color x:Key="WarmSoft">#FBF1E4</Color>
    <Color x:Key="Danger">#C7423B</Color>
    <Color x:Key="DangerSoft">#FBEAE8</Color>
    <Color x:Key="Information">#4A7A9B</Color>
    <Color x:Key="Scrim">#66101824</Color>

    <Color x:Key="ActionBorder">#D3E7F5</Color>
    <Color x:Key="DangerPressed">#F6D5D1</Color>
    <Color x:Key="FocusRing">#66B0E0</Color>
    <SolidColorBrush x:Key="ActionBorderBrush" Color="{StaticResource ActionBorder}" />
    <SolidColorBrush x:Key="DangerPressedBrush" Color="{StaticResource DangerPressed}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="{StaticResource FocusRing}" />

    <!-- Dark Mode Parity Tokens -->
    <Color x:Key="CanvasDark">#0B1218</Color>
    <Color x:Key="SurfaceDark">#121B23</Color>
    <Color x:Key="SurfaceElevatedDark">#1A2530</Color>
    <Color x:Key="SoftSurfaceDark">#1A2530</Color>
    <Color x:Key="InkDark">#EDF4FA</Color>
    <Color x:Key="MutedDark">#A3B3C0</Color>
    <Color x:Key="AccentDark">#5FB4EA</Color>
    <Color x:Key="AccentSoftDark">#0E2A3D</Color>
    <Color x:Key="AccentLightDark">#173F59</Color>
    <Color x:Key="LineDark">#26333F</Color>
    <Color x:Key="AvailableDark">#6BD6A0</Color>
    <Color x:Key="AvailableBgDark">#0C2C1C</Color>
    <Color x:Key="WarmSoftDark">#3A2A14</Color>
    <Color x:Key="DangerDark">#F2918B</Color>
    <Color x:Key="DangerSoftDark">#3F1D1A</Color>

    <!-- Shimmer Tokens -->
    <Color x:Key="ShimmerFillLight">#E9F1F7</Color>
    <Color x:Key="ShimmerWaveLight">#F4F9FC</Color>
    <Color x:Key="ShimmerFillDark">#1A2530</Color>
    <Color x:Key="ShimmerWaveDark">#26333F</Color>

    <!-- SolidColorBrushes for Syncfusion Controls -->
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource Accent}" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressed}" />
    <SolidColorBrush x:Key="AccentLightBrush" Color="{StaticResource AccentLight}" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="{StaticResource AccentSoft}" />
    <SolidColorBrush x:Key="AccentSoftDarkBrush" Color="{StaticResource AccentSoftDark}" />
    <SolidColorBrush x:Key="AccentLightDarkBrush" Color="{StaticResource AccentLightDark}" />
    <SolidColorBrush x:Key="SoftSurfaceBrush" Color="{StaticResource SoftSurface}" />
    <SolidColorBrush x:Key="SoftSurfaceDarkBrush" Color="{StaticResource SoftSurfaceDark}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}" />
    <SolidColorBrush x:Key="SurfaceDarkBrush" Color="{StaticResource SurfaceDark}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource Line}" />
    <SolidColorBrush x:Key="LineDarkBrush" Color="{StaticResource LineDark}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource Muted}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource Ink}" />
    <SolidColorBrush x:Key="WhiteBrush" Color="White" />
    <SolidColorBrush x:Key="TransparentBrush" Color="Transparent" />
    <SolidColorBrush x:Key="AvailableBrush" Color="{StaticResource Available}" />
    <SolidColorBrush x:Key="AvailableBgBrush" Color="{StaticResource AvailableBg}" />
    <SolidColorBrush x:Key="WarmAccentBrush" Color="{StaticResource WarmAccent}" />
    <SolidColorBrush x:Key="WarmSoftBrush" Color="{StaticResource WarmSoft}" />
    <SolidColorBrush x:Key="DangerBrush" Color="{StaticResource Danger}" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="{StaticResource DangerSoft}" />
</ResourceDictionary>
