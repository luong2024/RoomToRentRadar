<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- =======================================================================
         LIQUID GLASS TYPOGRAPHY & SPATIAL SCALE (Be Vietnam Pro)
         Crisp geometric legibility over both frosted glass and solid surfaces
         ======================================================================= -->

    <x:Double x:Key="RadiusSm">12</x:Double>
    <x:Double x:Key="RadiusMd">18</x:Double>
    <x:Double x:Key="RadiusLg">24</x:Double>
    <x:Double x:Key="RadiusXl">30</x:Double>
    <x:Double x:Key="RadiusPill">999</x:Double>

    <Style x:Key="Eyebrow" TargetType="Label">
        <Setter Property="FontFamily" Value="FontBold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="CharacterSpacing" Value="1.15" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style x:Key="DisplayTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="FontBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="1.18" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="FontBold" />
        <Setter Property="FontSize" Value="22" />
        <Setter Property="LineHeight" Value="1.22" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="ScreenTitle" TargetType="Label" BasedOn="{StaticResource PageTitle}" />

    <Style x:Key="SectionTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="FontBold" />
        <Setter Property="FontSize" Value="17.5" />
        <Setter Property="LineHeight" Value="1.25" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="CardTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="FontSemiBold" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineHeight" Value="1.3" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
    </Style>

    <Style x:Key="PriceHero" TargetType="Label">
        <Setter Property="FontFamily" Value="FontBold" />
        <Setter Property="FontSize" Value="21" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Brand}, Dark={StaticResource BrandDark}}" />
    </Style>

    <Style x:Key="BodyText" TargetType="Label">
        <Setter Property="FontFamily" Value="FontRegular" />
        <Setter Property="FontSize" Value="14.5" />
        <Setter Property="LineHeight" Value="1.48" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource InkSecondary}, Dark={StaticResource InkSecondaryDark}}" />
    </Style>

    <Style x:Key="Caption" TargetType="Label">
        <Setter Property="FontFamily" Value="FontMedium" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="LineHeight" Value="1.36" />
        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
    </Style>

</ResourceDictionary>
