<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoomToRentRadar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:RoomToRentRadar.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="RoomToRentRadar">

    <!-- 1. Initial Launch Screen: SIGN IN (AUTH FLOW) -->
    <ShellContent
        Title="Sign In"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate pages:LoginPage}"
        Route="login"
        SemanticProperties.Description="Sign in to your account"
        SemanticProperties.Hint="Sign in using email or ICTU SSO" />

    <!-- 2. Main Post-Authentication Landing Screen: EXPLORE / HOME (Always available in Debug and Release) -->
    <ShellContent
        Title="Explore"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainLandingPage}"
        Route="main"
        SemanticProperties.Description="Explore verified student rooms"
        SemanticProperties.Hint="Browse student rental properties near ICTU" />

    <!-- 3. UI Design System Catalog (Developer tool - hidden in Release) -->
    <ShellContent
        x:Name="UiCatalogContent"
        Title="UI Catalog"
        Icon="{StaticResource IconRibbon}"
        ContentTemplate="{DataTemplate pages:UiCatalogPage}"
        Route="uicatalog"
        SemanticProperties.Description="UI Design System Catalog"
        SemanticProperties.Hint="Explore colors, typography, buttons, inputs, and components" />

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
