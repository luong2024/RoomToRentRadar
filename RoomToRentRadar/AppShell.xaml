<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoomToRentRadar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:homeViews="clr-namespace:RoomToRentRadar.Features.Home.Views"
    xmlns:loc="clr-namespace:RoomToRentRadar.Core.Localization"
    xmlns:authViews="clr-namespace:RoomToRentRadar.Features.Authentication.Views"
    xmlns:roomViews="clr-namespace:RoomToRentRadar.Features.RoomListings.Views"
    xmlns:profileViews="clr-namespace:RoomToRentRadar.Features.Profile.Views"
    Title="Trọ ICTU"
    FlyoutBackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource DesktopRailBackgroundDark}}"
    FlyoutVerticalScrollMode="{OnPlatform WinUI=Disabled, Default=Auto}"
    FlyoutWidth="296"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="{OnPlatform WinUI=False, Default=True}">

    <Shell.FlyoutHeader>
        <VerticalStackLayout
            x:Name="FlyoutHeaderExpandedPanel"
            Padding="12,10,12,8"
            Spacing="14">
            <!-- Modern Campus Brand Card -->
            <Border
                Padding="14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 16"
                StrokeThickness="1">
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Black}"
                        Offset="0,4"
                        Opacity="0.05"
                        Radius="10" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" VerticalOptions="Center">
                        <Border
                            Grid.Column="0"
                            Padding="0"
                            Background="{StaticResource PrimaryBrandGradient}"
                            HeightRequest="42"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="0"
                            VerticalOptions="Center"
                            WidthRequest="42">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="22"
                                HorizontalOptions="Center"
                                Text="{x:Static f:FluentUI.building_home_24_regular}"
                                TextColor="{StaticResource White}"
                                VerticalOptions="Center" />
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="15"
                                Text="Trọ ICTU"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="12"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{loc:Translate Campus_Location}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                    <HorizontalStackLayout Spacing="6">
                        <Border
                            Padding="8,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource VerifiedBadgeBg}, Dark={StaticResource VerifiedBadgeBgDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="13"
                                    Text="{x:Static f:FluentUI.shield_checkmark_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="{loc:Translate Badge_Verified}"
                                    TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <Border
                            Padding="8,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="13"
                                    Text="{x:Static f:FluentUI.location_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="11"
                                    Text="{loc:Translate Badge_Radius}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Navigation Section Caption -->
            <Label
                Margin="6,2,6,0"
                CharacterSpacing="0.8"
                FontAttributes="Bold"
                FontSize="11"
                Text="{loc:Translate Nav_SectionTitle}"
                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
        </VerticalStackLayout>
    </Shell.FlyoutHeader>

    <Shell.ItemTemplate>
        <DataTemplate x:DataType="BaseShellItem">
            <Grid Padding="{OnPlatform WinUI='0,4', Default='12,3'}">
                <Border
                    Padding="{OnPlatform WinUI='4,6', Default='14,11'}"
                    BackgroundColor="Transparent"
                    Stroke="Transparent"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VisualStateManager.VisualStateGroups>
                        <VisualStateGroupList>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="Transparent" />
                                        <Setter Property="Stroke" Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Selected">
                                    <VisualState.Setters>
                                        <Setter Property="BackgroundColor" Value="{OnPlatform WinUI=Transparent, Default={AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}}" />
                                        <Setter Property="Stroke" Value="{OnPlatform WinUI=Transparent, Default={AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateGroupList>
                    </VisualStateManager.VisualStateGroups>

                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14" VerticalOptions="Center">
                        <Image
                            Grid.Column="0"
                            HeightRequest="20"
                            HorizontalOptions="Center"
                            Source="{Binding FlyoutIcon}"
                            VerticalOptions="Center"
                            WidthRequest="20" />
                        <Grid Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                FontAttributes="Bold"
                                FontSize="14"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding Title}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />
                            <Label
                                Grid.Column="1"
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="14"
                                Text="{x:Static f:FluentUI.chevron_right_16_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                VerticalOptions="Center" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>
    </Shell.ItemTemplate>

    <ShellContent
        x:Name="HomeShellContent"
        Title="{loc:Translate Nav_Home}"
        Icon="{StaticResource IconNavHome}"
        Route="home"
        SemanticProperties.Description="{loc:Translate Nav_Home}"
        SemanticProperties.Hint="{loc:Translate Nav_Home_Hint}" />

    <ShellContent
        x:Name="RoomListingsShellContent"
        Title="{loc:Translate Nav_Rooms}"
        Icon="{StaticResource IconNavRooms}"
        Route="rooms"
        SemanticProperties.Description="{loc:Translate Nav_Rooms}"
        SemanticProperties.Hint="{loc:Translate Nav_Rooms_Hint}" />

    <FlyoutItem Title="Sign In / Register" Route="auth" Icon="{StaticResource IconProjects}">
        <ShellContent
            x:Name="AuthShellContent"
            Title="Authentication"
            Route="login"
            SemanticProperties.Description="Sign In and Sign Up"
            SemanticProperties.Hint="Navigate to authentication" />
    </FlyoutItem>

    <ShellContent
        x:Name="ProfileShellContent"
        Title="Hồ sơ"
        Icon="{StaticResource IconProjects}"
        Route="profile"
        SemanticProperties.Description="View and edit your profile"
        SemanticProperties.Hint="Open your profile" />

    <Shell.FlyoutFooter>
        <VerticalStackLayout
            x:Name="FlyoutFooterExpandedPanel"
            Padding="12,8,12,16"
            Spacing="10">
            <BoxView
                HeightRequest="1"
                Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

            <!-- Expandable Language Selector Box (Tiếng Việt / English) -->
            <VerticalStackLayout Spacing="6">
                <!-- Trigger Box: Tap to show/hide language options -->
                <Border
                    x:Name="LanguageSelectorBox"
                    Padding="12,10"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    MinimumHeightRequest="44"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToggleLanguageMenuTapped" />
                    </Border.GestureRecognizers>

                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8" VerticalOptions="Center">
                        <Label
                            Grid.Column="0"
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="18"
                            Text="{x:Static f:FluentUI.globe_20_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            VerticalOptions="Center" />

                        <Label
                            Grid.Column="1"
                            FontAttributes="Bold"
                            FontSize="12.5"
                            Text="{loc:Translate Language_Label}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                            VerticalOptions="Center" />

                        <Border
                            Grid.Column="2"
                            Padding="8,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Label
                                x:Name="SelectedLanguageBadgeLabel"
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Text="🇻🇳 Tiếng Việt"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                        </Border>

                        <Label
                            x:Name="LanguageDropdownChevron"
                            Grid.Column="3"
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="14"
                            Text="{x:Static f:FluentUI.chevron_down_16_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                            VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Dropdown Language List (Shown when user taps the Language Selector Box) -->
                <Border
                    x:Name="LanguageOptionsPanel"
                    Padding="6"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    IsVisible="False"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 12"
                    StrokeThickness="1">
                    <VerticalStackLayout Spacing="4">
                        <!-- Tiếng Việt Option -->
                        <Border
                            x:Name="VietnameseButton"
                            Padding="10,9"
                            MinimumHeightRequest="40"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectVietnameseTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" FontSize="15" Text="🇻🇳" VerticalOptions="Center" />
                                <Label
                                    x:Name="VietnameseLabel"
                                    Grid.Column="1"
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    Text="Tiếng Việt"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="VietnameseCheckmark"
                                    Grid.Column="2"
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="15"
                                    Text="{x:Static f:FluentUI.checkmark_16_regular}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>

                        <!-- English Option -->
                        <Border
                            x:Name="EnglishButton"
                            Padding="10,9"
                            MinimumHeightRequest="40"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnSelectEnglishTapped" />
                            </Border.GestureRecognizers>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                                <Label Grid.Column="0" FontSize="15" Text="🇬🇧" VerticalOptions="Center" />
                                <Label
                                    x:Name="EnglishLabel"
                                    Grid.Column="1"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="13"
                                    Text="English"
                                    VerticalOptions="Center" />
                                <Label
                                    x:Name="EnglishCheckmark"
                                    Grid.Column="2"
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="15"
                                    IsVisible="False"
                                    Text="{x:Static f:FluentUI.checkmark_16_regular}"
                                    VerticalOptions="Center" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>

            <HorizontalStackLayout HorizontalOptions="Center" Spacing="6" VerticalOptions="Center">
                <Label
                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                    FontSize="13"
                    Text="{x:Static f:FluentUI.compass_northwest_16_regular}"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                    VerticalOptions="Center" />
                <Label
                    FontSize="11.5"
                    Text="{loc:Translate Footer_Version}"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                    VerticalOptions="Center" />
            </HorizontalStackLayout>
        </VerticalStackLayout>
    </Shell.FlyoutFooter>

</Shell>
