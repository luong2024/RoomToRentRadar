<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoomToRentRadar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:homeViews="clr-namespace:RoomToRentRadar.Features.Home.Views"
    xmlns:authViews="clr-namespace:RoomToRentRadar.Views"
    Shell.FlyoutBehavior="Flyout"
    Title="RoomToRentRadar">

    <!-- 1. Home is the default landing page (login is NOT mandatory on launch) -->
    <FlyoutItem Title="Home" Icon="{StaticResource IconDashboard}">
        <ShellContent
            Title="Home"
            ContentTemplate="{DataTemplate homeViews:HomePage}"
            Route="home"
            SemanticProperties.Description="Home"
            SemanticProperties.Hint="Navigate to home" />
    </FlyoutItem>

    <!-- 2. Sign In / Register available via Flyout and navigation buttons -->
    <FlyoutItem Title="Sign In / Register" Route="auth" Icon="{StaticResource IconProjects}">
        <ShellContent
            Title="Authentication"
            ContentTemplate="{DataTemplate authViews:AuthPage}"
            Route="login"
            SemanticProperties.Description="Sign In and Sign Up"
            SemanticProperties.Hint="Navigate to authentication" />
    </FlyoutItem>

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl"
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
