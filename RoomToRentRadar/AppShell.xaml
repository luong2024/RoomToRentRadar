<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoomToRentRadar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:pages="clr-namespace:RoomToRentRadar.Pages"
    Shell.FlyoutBehavior="Flyout"
    Title="RoomToRentRadar">

    <ShellContent
        Title="Tìm phòng"
        Icon="{StaticResource IconRooms}"
        ContentTemplate="{DataTemplate pages:RoomListPage}"
        Route="rooms"
        SemanticProperties.Description="Danh sách phòng trọ"
        SemanticProperties.Hint="Xem danh sách phòng trọ quanh ICTU"/>

    <ShellContent
        Title="Bản đồ"
        Icon="{StaticResource IconMap}"
        ContentTemplate="{DataTemplate pages:MapSearchPage}"
        Route="map"
        SemanticProperties.Description="Tìm phòng trên bản đồ"
        SemanticProperties.Hint="Khoanh vùng tìm phòng quanh ICTU"/>

    <ShellContent
        Title="Yêu thích"
        Icon="{StaticResource IconFavourites}"
        ContentTemplate="{DataTemplate pages:FavouritesPage}"
        Route="favourites"
        SemanticProperties.Description="Danh sách phòng đã lưu"
        SemanticProperties.Hint="Xem và quản lý các phòng trọ yêu thích"/>

    <ShellContent
        Title="Bộ lọc tìm kiếm"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate pages:FilterBottomSheet}"
        Route="filter-search"
        SemanticProperties.Description="Bộ lọc tìm kiếm phòng trọ"
        SemanticProperties.Hint="Lọc phòng theo giá, diện tích, loại phòng và khoảng cách tới ICTU"/>

    <ShellContent
        Title="Chi tiết phòng"
        Icon="{StaticResource IconRibbon}"
        ContentTemplate="{DataTemplate pages:RoomDetailPage}"
        Route="room-detail"
        SemanticProperties.Description="Chi tiết phòng trọ"
        SemanticProperties.Hint="Xem thông tin chi tiết phòng trọ, tiện ích, nội quy và liên hệ chủ trọ"/>

    <ShellContent
        Title="Đăng tin trọ"
        Icon="{StaticResource IconAdd}"
        ContentTemplate="{DataTemplate pages:CreateListingPage}"
        Route="create-listing"
        SemanticProperties.Description="Đăng tin phòng trọ"
        SemanticProperties.Hint="Đăng tin phòng trọ mới kèm ảnh thực tế chờ kiểm duyệt"/>
    <ShellContent
        Title="Dashboard"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate pages:MainPage}"
        Route="main"
        SemanticProperties.Description="Dashboard"
        SemanticProperties.Hint="Navigate to dashboard"/>

    <ShellContent
        Title="Projects"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate pages:ProjectListPage}"
        Route="projects"
        SemanticProperties.Description="Projects"
        SemanticProperties.Hint="Navigate to projects"/>

    <ShellContent
        Title="Manage Meta"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate pages:ManageMetaPage}"
        Route="manage"
        SemanticProperties.Description="Manage Meta"
        SemanticProperties.Hint="Navigate to manage meta"/>

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
