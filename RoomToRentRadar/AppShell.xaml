<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="RoomToRentRadar.AppShell" Title="Room Radar"
       FlyoutBehavior="Disabled" Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="{StaticResource Surface}"
       Shell.TabBarForegroundColor="{StaticResource Accent}"
       Shell.TabBarTitleColor="{StaticResource Accent}"
       Shell.TabBarUnselectedColor="{StaticResource Muted}"
       Shell.BackgroundColor="{StaticResource Surface}">
    <TabBar>
        <ShellContent x:Name="ExploreTab" Title="Khám phá phòng" Route="home" />
        <ShellContent x:Name="MapTab" Title="Bản đồ" Route="map" />
    </TabBar>
</Shell>
