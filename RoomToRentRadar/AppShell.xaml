<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       x:Class="RoomToRentRadar.AppShell" Title="Room Radar"
       FlyoutBehavior="Disabled" Shell.NavBarIsVisible="False"
       Shell.TabBarBackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
       Shell.TabBarForegroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
       Shell.TabBarTitleColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
       Shell.TabBarUnselectedColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}"
       Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
       Shell.ForegroundColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
       Shell.TitleColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}">
    <TabBar>
        <ShellContent x:Name="ExploreTab" Icon="explore_tab.png" Title="Khám phá" Route="home" />
        <ShellContent x:Name="FavouritesTab" Icon="favourites_tab.png" Title="Yêu thích" Route="favourites" />
        <ShellContent x:Name="MapTab" Icon="map_tab.png" Title="Bản đồ" Route="map" />
        <ShellContent x:Name="MyListingsTab" Icon="listings_tab.png" Title="Tin của tôi" Route="my-listings" IsVisible="False" />
        <ShellContent x:Name="ModerationTab" Icon="moderation_tab.png" Title="Kiểm duyệt" Route="moderation" IsVisible="False" />
    </TabBar>
</Shell>
