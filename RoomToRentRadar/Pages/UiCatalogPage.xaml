<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:common="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             xmlns:inputs="clr-namespace:RoomToRentRadar.Pages.Controls.Inputs"
             xmlns:cards="clr-namespace:RoomToRentRadar.Pages.Controls.Cards"
             xmlns:feedback="clr-namespace:RoomToRentRadar.Pages.Controls.Feedback"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.UiCatalogPage"
             x:DataType="vm:UiCatalogPageModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCanvasLight}, Dark={StaticResource SurfaceCanvasDark}}">

    <Grid RowDefinitions="Auto, *">
        <!-- 1. Header Bar -->
        <common:PageHeaderBar Grid.Row="0"
                               Title="UI Design System"
                               Subtitle="Navy + Teal Design System · Cross-Platform Foundation"
                               CanGoBack="True" />

        <!-- 2. Scrollable Catalog Content -->
        <ScrollView Grid.Row="1" Padding="{StaticResource ScreenMargin}">
            <VerticalStackLayout Spacing="28" MaximumWidthRequest="1000">

                <!-- Interactive Toast/Feedback Banner -->
                <Border StrokeShape="RoundRectangle 8"
                        StrokeThickness="1"
                        Padding="12,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}">
                    <Label Text="{Binding FeedbackMessage}"
                           FontFamily="{StaticResource FontFamilySemibold}"
                           FontSize="{StaticResource FontSizeCaption}"
                           TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}"
                           HorizontalTextAlignment="Center" />
                </Border>

                <!-- SECTION 1: COLOR PALETTE SWATCHES -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="1. CORE COLOR PALETTE (NAVY BLUE + TEAL)" Style="{StaticResource TextH3}" />
                    <FlexLayout Wrap="Wrap" JustifyContent="SpaceBetween" AlignItems="Center">
                        <!-- Primary -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#163A5F" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Primary" TextColor="White" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#163A5F" TextColor="White" Opacity="0.8" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Secondary -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#256D85" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Secondary" TextColor="White" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#256D85" TextColor="White" Opacity="0.8" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Accent Teal -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#4CB5AE" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Accent (Teal)" TextColor="#163A5F" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#4CB5AE" TextColor="#163A5F" Opacity="0.8" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Background -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#F4F7FA" Stroke="#E2E8F0" StrokeThickness="1" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Background" TextColor="#1E293B" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#F4F7FA" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Surface -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#FFFFFF" Stroke="#E2E8F0" StrokeThickness="1" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Surface (Card)" TextColor="#1E293B" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#FFFFFF" TextColor="#64748B" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                        <!-- Text Primary -->
                        <Border StrokeShape="RoundRectangle 8" WidthRequest="140" HeightRequest="65" BackgroundColor="#1E293B" Margin="4" Padding="8">
                            <VerticalStackLayout VerticalOptions="Center">
                                <Label Text="Text Primary" TextColor="White" FontFamily="{StaticResource FontFamilySemibold}" FontSize="12" />
                                <Label Text="#1E293B" TextColor="White" Opacity="0.8" FontSize="11" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>

                <!-- SECTION 2: TYPOGRAPHY SCALE -->
                <VerticalStackLayout Spacing="8">
                    <Label Text="2. TYPOGRAPHY SCALE" Style="{StaticResource TextH3}" />
                    <Border Style="{StaticResource BaseCardBorderStyle}" Padding="16">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Display Bold (32/40pt) — 2,500,000 VND" Style="{StaticResource TextDisplay}" />
                            <Label Text="Heading 1 (24/28pt) — Rental Room Details" Style="{StaticResource TextH1}" />
                            <Label Text="Heading 2 (20/22pt) — Amenities &amp; Location" Style="{StaticResource TextH2}" />
                            <Label Text="Heading 3 (16/18pt) — Studio Room near ICTU Campus" Style="{StaticResource TextH3}" />
                            <Label Text="Body Large (16pt) — Overview description for featured room listings and rental conditions." Style="{StaticResource TextBodyLarge}" />
                            <Label Text="Body Medium (14pt) — Standard text: 18 Z115 Street, Quyet Thang, Thai Nguyen City." Style="{StaticResource TextBodyMedium}" />
                            <Label Text="Caption (12pt) — 350m from ICTU Campus • High-speed Wi-Fi included" Style="{StaticResource TextCaption}" />
                            <Label Text="Price Highlight (20pt) — 2,200,000 VND/month" Style="{StaticResource TextPriceLarge}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION 3: BUTTON SUITE & INTERACTION -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="3. BUTTON SUITE &amp; INTERACTION" Style="{StaticResource TextH3}" />
                        <Button Grid.Column="1"
                                Text="Toggle Loading State"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ToggleButtonLoadingCommand}" />
                    </Grid>

                    <FlexLayout Wrap="Wrap" JustifyContent="Start" AlignItems="Center">
                        <!-- Native Style Buttons -->
                        <Button Text="Primary CTA" Style="{StaticResource PrimaryButton}" Margin="4" />
                        <Button Text="Secondary Button" Style="{StaticResource SecondaryButton}" Margin="4" />
                        <Button Text="Accent Teal" Style="{StaticResource AccentButton}" Margin="4" />
                        <Button Text="Outline Button" Style="{StaticResource OutlineButton}" Margin="4" />
                        <Button Text="Ghost Action" Style="{StaticResource GhostButton}" Margin="4" />
                        <Button Text="Destructive" Style="{StaticResource DestructiveButton}" Margin="4" />
                    </FlexLayout>

                    <!-- Advanced RadaButton Component with Spinner State -->
                    <Label Text="RadaButton Component (Integrated Spinner with zero layout shift):" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                    <HorizontalStackLayout Spacing="12">
                        <common:RadaButton Text="Button with Loading State"
                                           Variant="Primary"
                                           IsLoading="{Binding IsButtonLoading}"
                                           Command="{Binding ToggleButtonLoadingCommand}" />

                        <common:RadaButton Text="Accent Teal Button"
                                           Variant="Accent"
                                           IsLoading="{Binding IsButtonLoading}"
                                           Command="{Binding ToggleButtonLoadingCommand}" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION 4: BADGES & ATOMS -->
                <VerticalStackLayout Spacing="10">
                    <Label Text="4. BADGES &amp; ATOMS" Style="{StaticResource TextH3}" />
                    <HorizontalStackLayout Spacing="10">
                        <common:RadaBadge Type="Verified" />
                        <common:RadaBadge Type="Available" />
                        <common:RadaBadge Type="AlmostFull" />
                        <common:RadaBadge Type="Full" />
                    </HorizontalStackLayout>

                    <Label Text="Amenity Chips (AmenityChip):" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                    <HorizontalStackLayout Spacing="8">
                        <common:AmenityChip Title="Free Wi-Fi" IsSelected="True" />
                        <common:AmenityChip Title="Air Conditioner" IsSelected="False" />
                        <common:AmenityChip Title="Water Heater" IsSelected="False" />
                        <common:AmenityChip Title="Private Bath" IsSelected="True" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <!-- SECTION 5: FORM INPUT CONTROLS -->
                <VerticalStackLayout Spacing="10">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <Label Grid.Column="0" Text="5. INPUT &amp; SEARCH CONTROLS" Style="{StaticResource TextH3}" />
                        <Button Grid.Column="1"
                                Text="Toggle Error State"
                                Style="{StaticResource GhostButton}"
                                Command="{Binding ToggleInputErrorCommand}" />
                    </Grid>

                    <inputs:SearchBarView SearchText="{Binding SearchQuery, Mode=TwoWay}"
                                         Placeholder="Search by street name or amenities near ICTU..." />

                    <inputs:ValidatedEntry LabelText="Tenant Full Name *"
                                           Placeholder="Enter full name..."
                                           Text="{Binding InputText, Mode=TwoWay}"
                                           ErrorMessage="{Binding InputError}" />
                </VerticalStackLayout>

                <!-- SECTION 6: ADAPTIVE CARD SYSTEM -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="6. ADAPTIVE CARD SYSTEM" Style="{StaticResource TextH3}" />

                    <!-- Room Card Preview -->
                    <cards:RoomCardView Room="{Binding SampleRoom}"
                                        BookmarkCommand="{Binding ToggleBookmarkCommand}"
                                        DetailsCommand="{Binding ViewRoomDetailsCommand}" />

                    <!-- Metric Cards Row -->
                    <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                        <cards:MetricCardView Grid.Column="0"
                                              Title="VERIFIED ROOMS"
                                              IconGlyph="{x:Static fonts:FluentUI.home_20_regular}"
                                              ValueText="128"
                                              TrendText="+12 new rooms this week" />

                        <cards:MetricCardView Grid.Column="1"
                                              Title="OCCUPANCY RATE"
                                              IconGlyph="{x:Static fonts:FluentUI.data_trending_20_regular}"
                                              ValueText="94%"
                                              TrendText="Near ICTU Gate Area" />
                    </Grid>

                    <!-- Comparison Card Preview (US10) -->
                    <Label Text="3-Room Comparison Card (US10):" Style="{StaticResource TextCaption}" Margin="0,4,0,0" />
                    <cards:ComparisonCardView Room="{Binding SampleRoom}"
                                              RemoveCommand="{Binding ToggleBookmarkCommand}" />
                </VerticalStackLayout>

                <!-- SECTION 7: THE 4 UX STATES (FEEDBACK & RESILIENCE) -->
                <VerticalStackLayout Spacing="12">
                    <Label Text="7. UX RESILIENCE STATES (STATE MACHINE)" Style="{StaticResource TextH3}" />

                    <Label Text="A) Skeleton Shimmer Loader (Prevents layout shifts while loading):" Style="{StaticResource TextCaption}" />
                    <feedback:SkeletonShimmer />

                    <Label Text="B) Empty State (Empty list with recovery action):" Style="{StaticResource TextCaption}" />
                    <Border Style="{StaticResource BaseCardBorderStyle}">
                        <feedback:EmptyStateView ActionCommand="{Binding ResetFiltersCommand}" />
                    </Border>

                    <Label Text="C) Error State (Connection failure with retry action):" Style="{StaticResource TextCaption}" />
                    <Border Style="{StaticResource BaseCardBorderStyle}">
                        <feedback:ErrorRetryView RetryCommand="{Binding RetryOperationCommand}" />
                    </Border>
                </VerticalStackLayout>

                <!-- SECTION 8: CULTURE-AWARE FORMATTING -->
                <VerticalStackLayout Spacing="12" Margin="0,0,0,24">
                    <Label Text="8. CULTURE-AWARE FORMATTING"
                           Style="{StaticResource TextH3}"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="Preview formatting without changing raw values or global app language."
                           Style="{StaticResource TextBodyMedium}" />

                    <!-- Culture Controls Card -->
                    <Border Style="{StaticResource BaseCardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <!-- Local Culture Preview Switcher (non-color-only state with Fluent checkmark) -->
                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Border Grid.Column="0"
                                        StrokeShape="RoundRectangle 12"
                                        MinimumHeightRequest="{StaticResource MinTouchTarget}"
                                        Padding="12,10"
                                        StrokeThickness="1.5"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                        SemanticProperties.Description="Preview Vietnamese culture vi-VN">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPreviewCultureCommand}"
                                                              CommandParameter="vi-VN" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsVietnamesePreview}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionPrimaryDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionAccentDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto, *"
                                          ColumnSpacing="6"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{x:Static fonts:FluentUI.checkmark_circle_16_regular}"
                                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                               FontSize="16"
                                               VerticalTextAlignment="Center"
                                               IsVisible="{Binding IsVietnamesePreview}"
                                               TextColor="{StaticResource White}" />
                                        <Label Grid.Column="1"
                                               Text="Tiếng Việt (vi-VN)"
                                               FontFamily="{StaticResource FontFamilySemibold}"
                                               FontSize="{StaticResource FontSizeBodyMedium}"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsVietnamesePreview}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>

                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 12"
                                        MinimumHeightRequest="{StaticResource MinTouchTarget}"
                                        Padding="12,10"
                                        StrokeThickness="1.5"
                                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                        SemanticProperties.Description="Preview English culture en-US">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding SelectPreviewCultureCommand}"
                                                              CommandParameter="en-US" />
                                    </Border.GestureRecognizers>
                                    <Border.Triggers>
                                        <DataTrigger TargetType="Border" Binding="{Binding IsEnglishPreview}" Value="True">
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionPrimaryDark}}" />
                                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionAccentDark}}" />
                                        </DataTrigger>
                                    </Border.Triggers>
                                    <Grid ColumnDefinitions="Auto, *"
                                          ColumnSpacing="6"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center">
                                        <Label Grid.Column="0"
                                               Text="{x:Static fonts:FluentUI.checkmark_circle_16_regular}"
                                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                               FontSize="16"
                                               VerticalTextAlignment="Center"
                                               IsVisible="{Binding IsEnglishPreview}"
                                               TextColor="{StaticResource White}" />
                                        <Label Grid.Column="1"
                                               Text="English (en-US)"
                                               FontFamily="{StaticResource FontFamilySemibold}"
                                               FontSize="{StaticResource FontSizeBodyMedium}"
                                               VerticalTextAlignment="Center"
                                               HorizontalTextAlignment="Center"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                            <Label.Triggers>
                                                <DataTrigger TargetType="Label" Binding="{Binding IsEnglishPreview}" Value="True">
                                                    <Setter Property="TextColor" Value="{StaticResource White}" />
                                                </DataTrigger>
                                            </Label.Triggers>
                                        </Label>
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Culture Status & Reset to App Culture -->
                            <Border Style="{StaticResource SubtleContainerBorderStyle}" Padding="12,10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding CultureStatusText}"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
                                    <Label Text="{Binding PreviewModeText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                            </Border>

                            <Button Text="Use app culture"
                                    Style="{StaticResource OutlineButton}"
                                    Command="{Binding UseAppCultureCommand}"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Description="Reset formatting preview to follow the current app culture" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- 6 Culture-Aware Converter Previews -->
                    <Border Style="{StaticResource BaseCardBorderStyle}">
                        <VerticalStackLayout Spacing="12">
                            <!-- 1. Currency -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Currency"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoCurrencyInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource CurrencyConverter}">
                                            <Binding Path="DemoCurrencyAmount" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- 2. Number -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Number"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoNumberInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource NumberConverter}">
                                            <Binding Path="DemoNumberValue" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- 3. Date -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Date"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoDateInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource DateConverter}">
                                            <Binding Path="DemoDateValue" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- 4. Time -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Time"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoTimeInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource TimeConverter}">
                                            <Binding Path="DemoTimeValue" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- 5. Area -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Area"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoAreaInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource AreaConverter}">
                                            <Binding Path="DemoAreaValue" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- 6. Distance -->
                            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="12">
                                <VerticalStackLayout Grid.Column="0" Spacing="2">
                                    <Label Text="Distance"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                                    <Label Text="{Binding DemoDistanceInputText}"
                                           Style="{StaticResource TextBodyMedium}" />
                                </VerticalStackLayout>
                                <Label Grid.Column="1"
                                       Style="{StaticResource TextH3}"
                                       HorizontalTextAlignment="End"
                                       VerticalTextAlignment="Center">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay" Converter="{StaticResource DistanceConverter}">
                                            <Binding Path="DemoDistanceValue" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Optional Preview: SampleRoom values formatted via converters without modifying RoomCardView -->
                    <Border Style="{StaticResource BaseCardBorderStyle}">
                        <VerticalStackLayout Spacing="8">
                            <Label Text="Preview room values (SampleRoom)"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />

                            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                                <Label Grid.Column="0"
                                       Text="Price:"
                                       Style="{StaticResource TextBodyMedium}" />
                                <Label Grid.Column="1"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       FontSize="{StaticResource FontSizeBodyMedium}"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                    <Label.Text>
                                        <MultiBinding Mode="OneWay"
                                                      Converter="{StaticResource CurrencyConverter}"
                                                      StringFormat="{}{0} / month">
                                            <Binding Path="SampleRoom.PricePerMonth" />
                                            <Binding Path="PreviewCulture" />
                                        </MultiBinding>
                                    </Label.Text>
                                </Label>
                            </Grid>

                            <Grid ColumnDefinitions="*, *" ColumnSpacing="12">
                                <Grid Grid.Column="0" ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                    <Label Grid.Column="0"
                                           Text="Area:"
                                           Style="{StaticResource TextBodyMedium}" />
                                    <Label Grid.Column="1"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                        <Label.Text>
                                            <MultiBinding Mode="OneWay" Converter="{StaticResource AreaConverter}">
                                                <Binding Path="SampleRoom.AreaSquareMeters" />
                                                <Binding Path="PreviewCulture" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>

                                <Grid Grid.Column="1" ColumnDefinitions="Auto, *" ColumnSpacing="6">
                                    <Label Grid.Column="0"
                                           Text="Distance:"
                                           Style="{StaticResource TextBodyMedium}" />
                                    <Label Grid.Column="1"
                                           FontFamily="{StaticResource FontFamilySemibold}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}">
                                        <Label.Text>
                                            <MultiBinding Mode="OneWay" Converter="{StaticResource DistanceConverter}">
                                                <Binding Path="SampleRoom.DistanceMeters" />
                                                <Binding Path="PreviewCulture" />
                                            </MultiBinding>
                                        </Label.Text>
                                    </Label>
                                </Grid>
                            </Grid>
                        </VerticalStackLayout>
