<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             x:Class="RoomToRentRadar.Pages.RoomListPage"
             x:Name="RoomListPageRoot"
             x:DataType="pageModels:RoomListViewModel"
             Title="Phòng trọ quanh ICTU"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ContentPage.Behaviors>
        <toolkit:EventToCommandBehavior
            BindingContext="{Binding Path=BindingContext, Source={x:Reference RoomListPageRoot}, x:DataType=ContentPage}"
            EventName="Appearing"
            Command="{Binding AppearingCommand}" />
    </ContentPage.Behaviors>

    <Grid RowDefinitions="Auto,Auto,*"
          Padding="12,10,12,0"
          RowSpacing="10">

        <!-- Thanh đếm phòng & Sắp xếp 1 dòng gọn cho Mobile (dưới Shell NavBar) -->
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <VerticalStackLayout Grid.Column="0"
                                 VerticalOptions="Center">
                <Label Text="{Binding TotalCount, StringFormat='{0} phòng khả dụng'}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />
                <Label Text="Đã xác minh quanh ICTU"
                       FontSize="11.5"
                       TextColor="{AppThemeBinding Light=#64748B, Dark={StaticResource Gray400}}" />
            </VerticalStackLayout>

            <Border Grid.Column="1"
                    Padding="8,0"
                    HeightRequest="38"
                    VerticalOptions="Center"
                    StrokeShape="RoundRectangle 5"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource DarkSecondaryBackground}}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}"
                    StrokeThickness="1">
                <HorizontalStackLayout Spacing="4"
                                       VerticalOptions="Center">
                    <Image HeightRequest="15"
                           WidthRequest="15"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.arrow_sort_20_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Color="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}"
                                             Size="15" />
                        </Image.Source>
                    </Image>
                    <Picker AutomationId="SortPicker"
                            Title="Sắp xếp"
                            FontSize="12.5"
                            ItemsSource="{Binding SortOptions}"
                            SelectedItem="{Binding SelectedSortOption}"
                            VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <!-- Banner lỗi mất mạng êm ái -->
        <Border Grid.Row="1"
                IsVisible="{Binding HasError}"
                BackgroundColor="#FEF2F2"
                Stroke="#EF4444"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 5"
                Padding="12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                <Label Text="{Binding ErrorMessage}"
                       Style="{StaticResource Caption1}"
                       TextColor="#991B1B"
                       VerticalOptions="Center" />
                <Button Grid.Column="1"
                        Text="Thử lại"
                        FontSize="13"
                        Padding="10,6"
                        Command="{Binding LoadInitialListingsCommand}" />
            </Grid>
        </Border>

        <!-- Danh sách phòng với Pull-to-Refresh + Infinite Scroll -->
        <RefreshView Grid.Row="2"
                     IsRefreshing="{Binding IsRefreshing}"
                     Command="{Binding LoadInitialListingsCommand}">
            <CollectionView AutomationId="ListingCollectionView"
                            ItemsSource="{Binding Listings}"
                            RemainingItemsThreshold="5"
                            RemainingItemsThresholdReachedCommand="{Binding LoadMoreListingsCommand}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedRoom}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:RoomListingItemModel">
                        <controls:RoomCardView />
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <VerticalStackLayout VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Padding="24"
                                         Spacing="10">
                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}" />
                        <Label Text="Đang tải danh sách phòng quanh ICTU..."
                               Style="{StaticResource Body2}"
                               TextColor="{AppThemeBinding Light=#64748B, Dark={StaticResource Gray400}}"
                               IsVisible="{Binding IsLoading}"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Không tìm thấy phòng trọ phù hợp quanh ICTU."
                               Style="{StaticResource Body2}"
                               HorizontalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label"
                                             Binding="{Binding IsLoading}"
                                             Value="True">
                                    <Setter Property="IsVisible" Value="False" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </VerticalStackLayout>
                </CollectionView.EmptyView>

                <CollectionView.Footer>
                    <VerticalStackLayout Padding="12" Spacing="6" HorizontalOptions="Center">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                           IsVisible="{Binding IsLoadingMore}" />
                        <Label Text="Đã hiển thị toàn bộ phòng trọ khả dụng."
                               Style="{StaticResource Caption1}"
                               TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                               IsVisible="{Binding HasReachedEnd}"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>