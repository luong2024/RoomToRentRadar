<?xml version="1.0" encoding="utf-8" ?>
<Border xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
        xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
        xmlns:models="clr-namespace:RoomToRentRadar.Models"
        xmlns:fonts="clr-namespace:Fonts"
        x:Class="RoomToRentRadar.Pages.Controls.RoomCardView"
        x:DataType="models:RoomListingItemModel"
        AutomationId="{Binding CardAutomationId}"
        StrokeShape="RoundRectangle 5"
        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark={StaticResource DarkSecondaryBackground}}"
        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}"
        StrokeThickness="1"
        Padding="0">

    <Border.Shadow>
        <Shadow Brush="#0F172A"
                Offset="0,2"
                Radius="8"
                Opacity="0.06" />
    </Border.Shadow>

    <VerticalStackLayout Spacing="0">

        <!-- 1. Ảnh banner phòng + badge ĐÃ XÁC MINH + pill Giá -->
        <Grid HeightRequest="140"
              BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A34}">
            <Image Source="placeholder_room.png"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />

            <Image Source="{Binding EffectiveThumbnail}"
                   Aspect="AspectFill"
                   HorizontalOptions="Fill"
                   VerticalOptions="Fill" />

            <!-- Tag ĐÃ XÁC MINH góc trên trái (isVerified) -->
            <Border Margin="8"
                    Padding="7,3"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    IsVisible="{Binding IsVerified}"
                    AutomationId="{Binding VerifiedBadgeAutomationId}"
                    BackgroundColor="#E60F172A"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 4">
                <HorizontalStackLayout Spacing="4">
                    <Image HeightRequest="11"
                           WidthRequest="11"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.shield_checkmark_16_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Color="#4ADE80"
                                             Size="11" />
                        </Image.Source>
                    </Image>
                    <Label Text="ĐÃ XÁC MINH"
                           TextColor="White"
                           FontSize="10"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Pill Giá thuê góc dưới trái (rent) -->
            <Border Margin="8"
                    Padding="8,3"
                    HorizontalOptions="Start"
                    VerticalOptions="End"
                    BackgroundColor="#F20F172A"
                    Stroke="#334155"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 4">
                <HorizontalStackLayout Spacing="3"
                                       VerticalOptions="Center">
                    <Label Text="{Binding FormattedRentAmount}"
                           TextColor="White"
                           FontSize="13.5"
                           FontAttributes="Bold"
                           VerticalOptions="Center" />
                    <Label Text="/ tháng"
                           TextColor="#CBD5E1"
                           FontSize="10.5"
                           VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>
        </Grid>

        <BoxView HeightRequest="1"
                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}" />

        <!-- 2. Tiêu đề + Địa chỉ + Khoảng cách tới ICTU -->
        <VerticalStackLayout Padding="12,10"
                             Spacing="8">

            <VerticalStackLayout Spacing="3">
                <Label Text="{Binding Title}"
                       FontSize="14.5"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />

                <Grid ColumnDefinitions="Auto,*"
                      ColumnSpacing="4">
                    <Image Grid.Column="0"
                           HeightRequest="13"
                           WidthRequest="13"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.location_16_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Color="{AppThemeBinding Light=#94A3B8, Dark={StaticResource Gray400}}"
                                             Size="13" />
                        </Image.Source>
                    </Image>
                    <Label Grid.Column="1"
                           Text="{Binding Address}"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#64748B, Dark={StaticResource Gray400}}"
                           MaxLines="1"
                           LineBreakMode="TailTruncation"
                           VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>

            <!-- Khoảng cách tới trường (chỉ hiển thị đúng distanceMeters của Backend) -->
            <Border Padding="8,6"
                    StrokeShape="RoundRectangle 4"
                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#1E202B}"
                    Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}"
                    StrokeThickness="1">
                <Grid ColumnDefinitions="Auto,*,Auto"
                      ColumnSpacing="6">
                    <Image Grid.Column="0"
                           HeightRequest="14"
                           WidthRequest="14"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.hat_graduation_16_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Color="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}"
                                             Size="14" />
                        </Image.Source>
                    </Image>

                    <Label Grid.Column="1"
                           Text="ĐH CNTT&amp;TT (ICTU)"
                           FontSize="12"
                           FontAttributes="Bold"
                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#F1F5F9}"
                           VerticalOptions="Center" />

                    <Border Grid.Column="2"
                            Padding="6,2"
                            StrokeShape="RoundRectangle 4"
                            BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E3A8A}"
                            Stroke="{AppThemeBinding Light=#DBEAFE, Dark=#1D4ED8}"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                        <Label Text="{Binding FormattedShortDistance}"
                               FontSize="11"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}"
                               VerticalOptions="Center" />
                    </Border>
                </Grid>
            </Border>
        </VerticalStackLayout>

        <BoxView HeightRequest="1"
                 Color="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A34}" />

        <!-- 3. Footer thẻ: RoomType + Area + chỉ dẫn Chi tiết -->
        <Grid Padding="12,7,12,9"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="8">
            <HorizontalStackLayout Grid.Column="0"
                                   Spacing="6"
                                   VerticalOptions="Center">
                <Border Padding="6,2"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A34}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3F3F4E}"
                        StrokeThickness="1">
                    <Label Text="{Binding RoomType}"
                           FontSize="11"
                           TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                           VerticalOptions="Center" />
                </Border>

                <Border Padding="6,2"
                        StrokeShape="RoundRectangle 4"
                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#2A2A34}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3F3F4E}"
                        StrokeThickness="1">
                    <HorizontalStackLayout Spacing="3">
                        <Image HeightRequest="11"
                               WidthRequest="11"
                               VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.ruler_16_regular}"
                                                 FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                 Color="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                                                 Size="11" />
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding FormattedArea}"
                               FontSize="11"
                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="3"
                                   VerticalOptions="Center">
                <Label Text="Chi tiết"
                       FontSize="11.5"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}"
                       VerticalOptions="Center" />
                <Image HeightRequest="12"
                       WidthRequest="12"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:FluentUI.arrow_right_16_regular}"
                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                         Color="{AppThemeBinding Light=#1D4ED8, Dark=#93C5FD}"
                                         Size="12" />
                    </Image.Source>
                </Image>
            </HorizontalStackLayout>
        </Grid>
    </VerticalStackLayout>
</Border>