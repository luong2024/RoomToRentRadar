<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             x:Class="RoomToRentRadar.Pages.Controls.RoomCardView"
             x:DataType="models:RoomListingItem">
    <Border Margin="0,0,14,18" Padding="0" StrokeShape="RoundRectangle 22">
        <Grid RowDefinitions="204,Auto">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 21,21,0,0" Padding="0">
                <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                    <Image Source="{Binding Illustration}" Aspect="AspectFill" SemanticProperties.Description="Hình minh họa phòng mẫu" />
                    <Border Margin="12" Padding="10,6" HorizontalOptions="Start" VerticalOptions="End"
                            StrokeThickness="0" StrokeShape="RoundRectangle 10">
                        <Label Text="●  Còn trống" FontSize="11" FontFamily="OpenSansSemibold"
                               TextColor="{AppThemeBinding Light={StaticResource Available}, Dark={StaticResource AvailableDark}}" />
                    </Border>
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Row="1" Padding="16,14,16,16" Spacing="9">
                <Label Text="{Binding Title}" Style="{StaticResource CardTitle}" MaxLines="2" LineBreakMode="TailTruncation" MinimumHeightRequest="42" />
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <Label VerticalOptions="Center" MaxLines="1" LineBreakMode="TailTruncation">
                        <Label.FormattedText>
                            <FormattedString>
                                <Span Text="{Binding RentAmountText}" FontSize="23" FontFamily="OpenSansSemibold"
                                      TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                <Span Text=" / tháng" FontSize="11"
                                      TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                            </FormattedString>
                        </Label.FormattedText>
                    </Label>
                    <HorizontalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                        <Image Source="area_icon.png" HeightRequest="15" WidthRequest="15" />
                        <Label Text="{Binding AreaText}" FontSize="12" FontFamily="OpenSansSemibold" />
                    </HorizontalStackLayout>
                </Grid>
                <Grid ColumnDefinitions="16,*" ColumnSpacing="6">
                    <Image Source="location_pin.png" HeightRequest="15" WidthRequest="15" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{Binding DistanceText}" Style="{StaticResource Caption}" FontSize="12" />
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
