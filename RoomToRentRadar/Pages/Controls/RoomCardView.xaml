<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             x:Class="RoomToRentRadar.Pages.Controls.RoomCardView" x:DataType="models:RoomListingItem">
    <Border Margin="0,0,18,22" Padding="8" StrokeShape="RoundRectangle 18">
        <Grid RowDefinitions="174,Auto">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0">
                <Grid BackgroundColor="{StaticResource SoftSurface}">
                    <Image Source="{Binding Illustration}" Aspect="AspectFill" SemanticProperties.Description="Hình minh họa phòng mẫu" />
                    <Border Margin="10" Padding="9,5" HorizontalOptions="Start" VerticalOptions="Start"
                            StrokeThickness="0" StrokeShape="RoundRectangle 7" BackgroundColor="#F9FCF7" IsVisible="{Binding IsVerified}">
                        <Label Text="✓  Đã xác minh" TextColor="{StaticResource Accent}" FontSize="10" FontFamily="OpenSansSemibold" />
                    </Border>
                    <Border Margin="10" Padding="7,3" HorizontalOptions="End" VerticalOptions="End"
                            StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="#F8F9F3">
                        <Label Text="Ảnh minh họa" FontSize="9" TextColor="{StaticResource Muted}" />
                    </Border>
                </Grid>
            </Border>
            <VerticalStackLayout Grid.Row="1" Padding="10,16,10,10" Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="PHÒNG CHO THUÊ" Style="{StaticResource Eyebrow}" FontSize="9" CharacterSpacing="1" />
                    <Label Grid.Column="1" Text="●  Còn trống" FontSize="10" TextColor="{StaticResource Accent}" />
                </Grid>
                <Label Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold" HeightRequest="46"
                       LineBreakMode="TailTruncation" MaxLines="2" />
                <Label>
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{Binding RentAmountText}" FontSize="23" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                            <Span Text="  / tháng" FontSize="11" TextColor="{StaticResource Muted}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
                <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,2" />
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                    <HorizontalStackLayout Spacing="6">
                        <Image Source="area_icon.png" HeightRequest="14" WidthRequest="14" />
                        <Label Text="{Binding AreaText}" FontSize="11" TextColor="{StaticResource Muted}" />
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="5" HorizontalOptions="End">
                        <Image Source="location_pin.png" HeightRequest="14" WidthRequest="14" />
                        <Label Text="{Binding DistanceText}" FontSize="11" TextColor="{StaticResource Muted}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>
