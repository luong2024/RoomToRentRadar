<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Pages.Controls.RoomDetail.Models"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.MonthlyCostsCardControl"
             x:DataType="vm:RoomDetailPageModel">

    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Shadow="{StaticResource Elevation1Shadow}"
            Padding="16">
        <VerticalStackLayout Spacing="8">
            <!-- Header -->
            <Label Text="{loc:LocalizedStrings RoomDetail_MonthlyCosts}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeH3}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   Margin="0,0,0,4" />

            <!-- Utility Cost Line Items -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding CostBreakdownRows}"
                                 Spacing="6">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:CostRowItem">
                        <Grid ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0"
                                   Text="{Binding Label}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding ValueFormatted}"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

            <!-- Divider Line -->
            <BoxView HeightRequest="1"
                     Margin="0,8,0,6"
                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

            <!-- Estimated Total Row -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="{loc:LocalizedStrings RoomDetail_EstimatedTotal}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeBodyLarge}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalTextAlignment="Center" />
                <Label Grid.Column="1"
                       Text="{Binding EstimatedTotalFormatted}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeH2}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}"
                       VerticalTextAlignment="Center" />
            </Grid>

            <!-- Estimation Formula Note -->
            <Label Text="{Binding EstimateNoteFormatted}"
                   FontFamily="{StaticResource FontFamilyRegular}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        </VerticalStackLayout>
    </Border>
</ContentView>
