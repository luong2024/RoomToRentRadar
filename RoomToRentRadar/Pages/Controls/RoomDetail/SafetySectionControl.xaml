<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Pages.Controls.RoomDetail.Models"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.SafetySectionControl"
             x:DataType="vm:RoomDetailPageModel">

    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Shadow="{StaticResource Elevation1Shadow}"
            Padding="16">
        <VerticalStackLayout Spacing="10">
            <!-- Header with Safety Verification Badge -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="{loc:LocalizedStrings RoomDetail_Safety}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeH3}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalTextAlignment="Center" />

                <!-- Verification Pill Badge -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 9999"
                        StrokeThickness="1"
                        Stroke="#15803D"
                        BackgroundColor="#1516A34A"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Label Text="{x:Static fonts:FluentUI.shield_checkmark_16_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="14"
                               TextColor="#15803D"
                               VerticalTextAlignment="Center" />
                        <Label Text="{Binding SafetyScoreFormatted}"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeBadge}"
                               FontAttributes="Bold"
                               TextColor="#15803D"
                               VerticalTextAlignment="Center" />
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Safety Checklist Items -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SafetyChecklist}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SafetyCheckItem">
                        <Grid ColumnDefinitions="24, *" VerticalOptions="Center">
                            <Label Grid.Column="0"
                                   Text="{Binding IconGlyph}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="16"
                                   TextColor="{Binding IconColor}"
                                   VerticalTextAlignment="Center" />
                            <Label Grid.Column="1"
                                   Text="{Binding Description}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
