<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Pages.Controls.RoomDetail.Models"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.SafetySectionControl"
             x:DataType="vm:RoomDetailPageModel">

    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Shadow="{StaticResource Elevation1Shadow}"
            Padding="16">
        <VerticalStackLayout Spacing="10">
            <!-- Header with Safety Verification Badge -->
            <Grid ColumnDefinitions="*, Auto">
                <Label Grid.Column="0"
                       Text="{loc:LocalizedStrings RoomDetail_Safety}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeH3}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       VerticalTextAlignment="Center" />

                <!-- Verification Pill Badge (distinct styles for Verified vs Unverified) -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 9999"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                        Padding="10,4"
                        VerticalOptions="Center">
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSafetyVerified}" Value="True">
                            <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource StatusSuccessLight}, Dark={StaticResource StatusSuccessDark}}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                        <Image WidthRequest="14"
                               HeightRequest="14"
                               VerticalOptions="Center"
                               IsVisible="{Binding IsSafetyVerified}">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.shield_checkmark_16_regular}"
                                                 FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                 Size="14"
                                                 Color="{AppThemeBinding Light={StaticResource StatusSuccessTextLight}, Dark={StaticResource StatusSuccessDark}}" />
                            </Image.Source>
                        </Image>
                        <Image WidthRequest="14"
                               HeightRequest="14"
                               VerticalOptions="Center"
                               IsVisible="False">
                            <Image.Triggers>
                                <DataTrigger TargetType="Image" Binding="{Binding IsSafetyVerified}" Value="False">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </Image.Triggers>
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.info_16_regular}"
                                                 FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                 Size="14"
                                                 Color="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                            </Image.Source>
                        </Image>
                        <Label Text="{Binding SafetyScoreFormatted}"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="{StaticResource FontSizeBadge}"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}"
                               VerticalTextAlignment="Center">
                            <Label.Triggers>
                                <DataTrigger TargetType="Label" Binding="{Binding IsSafetyVerified}" Value="True">
                                    <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource StatusSuccessTextLight}, Dark={StaticResource StatusSuccessDark}}" />
                                </DataTrigger>
                            </Label.Triggers>
                        </Label>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Safety Checklist Items -->
            <VerticalStackLayout BindableLayout.ItemsSource="{Binding SafetyChecklist}"
                                 Spacing="8">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:SafetyCheckItem">
                        <Grid ColumnDefinitions="24, *" VerticalOptions="Center">
                            <Image Grid.Column="0"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   IsVisible="{Binding IsVerified}">
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding IconGlyph}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="16"
                                                     Color="{AppThemeBinding Light={StaticResource StatusSuccessLight}, Dark={StaticResource StatusSuccessDark}}" />
                                </Image.Source>
                            </Image>
                            <Image Grid.Column="0"
                                   WidthRequest="16"
                                   HeightRequest="16"
                                   HorizontalOptions="Start"
                                   VerticalOptions="Center"
                                   IsVisible="False">
                                <Image.Triggers>
                                    <DataTrigger TargetType="Image" Binding="{Binding IsVerified}" Value="False">
                                        <Setter Property="IsVisible" Value="True" />
                                    </DataTrigger>
                                </Image.Triggers>
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding IconGlyph}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="16"
                                                     Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1"
                                   Text="{Binding Description}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalTextAlignment="Center" />
                        </Grid>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
