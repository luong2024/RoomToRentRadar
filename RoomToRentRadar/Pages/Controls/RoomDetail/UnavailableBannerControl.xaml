<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.UnavailableBannerControl"
             x:DataType="vm:RoomDetailPageModel">

    <Border IsVisible="{Binding IsUnavailable}"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource StatusWarningLight}, Dark={StaticResource StatusWarningDark}}"
            BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#33260A}"
            Padding="14,12"
            Margin="0,0,0,12">
        <Grid ColumnDefinitions="28, *" VerticalOptions="Center">
            <!-- Warning / Info Icon -->
            <Label Grid.Column="0"
                   Text="{x:Static fonts:FluentUI.warning_24_regular}"
                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                   FontSize="22"
                   TextColor="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}"
                   VerticalTextAlignment="Center" />

            <!-- Unavailable Notice Message -->
            <Label Grid.Column="1"
                   Text="{Binding UnavailableBannerText}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeBodyMedium}"
                   TextColor="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}"
                   LineBreakMode="WordWrap"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>
