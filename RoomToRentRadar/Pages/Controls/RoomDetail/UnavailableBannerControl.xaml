<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.UnavailableBannerControl"
             x:DataType="vm:RoomDetailPageModel">

    <Border IsVisible="{Binding IsUnavailable}"
            StrokeShape="RoundRectangle 0"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource StatusWarningSubtleLight}, Dark={StaticResource StatusWarningSubtleDark}}"
            Padding="16,12"
            Margin="0">
        <Grid ColumnDefinitions="24, *" ColumnSpacing="10" VerticalOptions="Center">
            <!-- Info Icon -->
            <Image Grid.Column="0"
                   WidthRequest="20"
                   HeightRequest="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="{x:Static fonts:FluentUI.info_24_regular}"
                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                     Size="20"
                                     Color="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}" />
                </Image.Source>
            </Image>

            <!-- Unavailable Notice Message -->
            <Label Grid.Column="1"
                   Text="{Binding UnavailableBannerText}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeBodyMedium}"
                   TextColor="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}"
                   LineBreakMode="WordWrap"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>
