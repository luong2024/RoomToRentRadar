<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:photos="clr-namespace:RoomToRentRadar.Ports.Contracts.Responses.Photos;assembly=RoomToRentRadar.Ports"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.RoomHeroGalleryControl"
             x:DataType="vm:RoomDetailPageModel">

    <Grid HeightRequest="260" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}">
        <!-- 1. Room Hero Swipeable Photo Carousel -->
        <CarouselView ItemsSource="{Binding Photos}"
                      Position="{Binding CurrentPhotoIndexZeroBased, Mode=TwoWay}"
                      Loop="False"
                      HeightRequest="260"
                      HorizontalOptions="Fill"
                      VerticalOptions="Fill"
                      IsVisible="{Binding HasPhotos}">
            <CarouselView.ItemTemplate>
                <DataTemplate x:DataType="photos:PhotoDto">
                    <Image Source="{Binding MediumUrl}"
                           Aspect="AspectFill"
                           HeightRequest="260"
                           HorizontalOptions="Fill"
                           VerticalOptions="Fill" />
                </DataTemplate>
            </CarouselView.ItemTemplate>
        </CarouselView>

        <!-- Fallback Placeholder when image is missing -->
        <VerticalStackLayout IsVisible="{Binding HasNoPhotos}"
                             HorizontalOptions="Center"
                             VerticalOptions="Center"
                             Spacing="8">
            <Image WidthRequest="48"
                   HeightRequest="48"
                   HorizontalOptions="Center"
                   VerticalOptions="Center">
                <Image.Source>
                    <FontImageSource Glyph="{x:Static fonts:FluentUI.home_48_regular}"
                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                     Size="48"
                                     Color="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                </Image.Source>
            </Image>
            <Label Text="{loc:LocalizedStrings RoomDetail_NoPhotos}"
                   FontSize="{StaticResource FontSizeCaption}"
                   HorizontalTextAlignment="Center"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
        </VerticalStackLayout>

        <!-- Top Scrim Gradient for button contrast -->
        <BoxView HeightRequest="80"
                 VerticalOptions="Start"
                 Color="#33000000" />

        <!-- 2. Top Navigation Bar: Back, Share, Favourite -->
        <Grid Padding="16,16,16,0"
              VerticalOptions="Start">
            <!-- Back Button (Touch target 48x48) -->
            <Border StrokeShape="RoundRectangle 9999"
                    StrokeThickness="0"
                    WidthRequest="48"
                    HeightRequest="48"
                    BackgroundColor="#EEFFFFFF"
                    HorizontalOptions="Start"
                    VerticalOptions="Start"
                    Shadow="{StaticResource Elevation1Shadow}"
                    SemanticProperties.Description="Back to previous page">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Border.GestureRecognizers>
                <Image WidthRequest="22"
                       HeightRequest="22"
                       HorizontalOptions="Center"
                       VerticalOptions="Center">
                    <Image.Source>
                        <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_left_24_regular}"
                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                         Size="22"
                                         Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                    </Image.Source>
                </Image>
            </Border>

            <!-- Actions: Share & Favourite (only shown when room is available) -->
            <HorizontalStackLayout IsVisible="{Binding IsAvailable}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Start"
                                   Spacing="10">
                <!-- Share Button -->
                <Border StrokeShape="RoundRectangle 9999"
                        StrokeThickness="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#EEFFFFFF"
                        Shadow="{StaticResource Elevation1Shadow}"
                        SemanticProperties.Description="Share listing">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShareListingCommand}" />
                    </Border.GestureRecognizers>
                    <Image WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.share_24_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Size="20"
                                             Color="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        </Image.Source>
                    </Image>
                </Border>

                <!-- Favourite Button -->
                <Border StrokeShape="RoundRectangle 9999"
                        StrokeThickness="0"
                        WidthRequest="48"
                        HeightRequest="48"
                        BackgroundColor="#EEFFFFFF"
                        Shadow="{StaticResource Elevation1Shadow}"
                        SemanticProperties.Description="Save room to favourites">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ToggleFavouriteCommand}" />
                    </Border.GestureRecognizers>
                    <Image WidthRequest="20"
                           HeightRequest="20"
                           HorizontalOptions="Center"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{Binding FavouriteIconGlyph}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Size="20"
                                             Color="{Binding FavouriteIconColor}" />
                        </Image.Source>
                    </Image>
                </Border>
            </HorizontalStackLayout>
        </Grid>

        <!-- 3. Bottom Badges: 360 View Pill & Photo Counter (only shown when room is available) -->
        <Grid IsVisible="{Binding IsAvailable}"
              Padding="16,0,16,16"
              VerticalOptions="End">
            <!-- 360° View Button Pill -->
            <Border IsVisible="{Binding Is360Available}"
                    StrokeShape="RoundRectangle 9999"
                    StrokeThickness="0"
                    BackgroundColor="#DD1E293B"
                    Padding="12,6"
                    HorizontalOptions="Start"
                    VerticalOptions="End">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding Open360ViewCommand}" />
                </Border.GestureRecognizers>
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <Image WidthRequest="16"
                           HeightRequest="16"
                           VerticalOptions="Center">
                        <Image.Source>
                            <FontImageSource Glyph="{x:Static fonts:FluentUI.arrow_rotate_clockwise_24_regular}"
                                             FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                             Size="16"
                                             Color="White" />
                        </Image.Source>
                    </Image>
                    <Label Text="{loc:LocalizedStrings RoomDetail_360View}"
                           FontFamily="{StaticResource FontFamilySemibold}"
                           FontSize="{StaticResource FontSizeBadge}"
                           FontAttributes="Bold"
                           TextColor="White"
                           VerticalTextAlignment="Center" />
                </HorizontalStackLayout>
            </Border>

            <!-- Photo Counter Badge (e.g. "1 / 12") -->
            <Border StrokeShape="RoundRectangle 9999"
                    StrokeThickness="0"
                    BackgroundColor="#B3000000"
                    Padding="10,4"
                    HorizontalOptions="End"
                    VerticalOptions="End">
                <Label Text="{Binding PhotoCounterText}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeBadge}"
                       FontAttributes="Bold"
                       TextColor="White"
                       VerticalTextAlignment="Center" />
            </Border>
        </Grid>
    </Grid>
</ContentView>
