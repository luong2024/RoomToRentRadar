<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Pages.Controls.RoomDetail.Models"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.RoomKeyFactsGridControl"
             x:DataType="vm:RoomDetailPageModel">

    <VerticalStackLayout BindableLayout.ItemsSource="{Binding KeyFactRows}"
                         Spacing="8">
        <BindableLayout.ItemTemplate>
            <DataTemplate x:DataType="models:KeyFactRowItem">
                <Grid ColumnDefinitions="*, *, *"
                      ColumnSpacing="8">
                    <!-- Column 0 -->
                    <Border Grid.Column="0"
                            HeightRequest="84"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Shadow="{StaticResource Elevation1Shadow}">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Image WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Start">
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding First.IconGlyph}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource ActionAccentLight}, Dark={StaticResource ActionAccentDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding First.Value}"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="{Binding First.Label}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBadge}"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Column 1 -->
                    <Border Grid.Column="1"
                            IsVisible="{Binding HasSecond}"
                            HeightRequest="84"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Shadow="{StaticResource Elevation1Shadow}">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Image WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Start">
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding Second.IconGlyph}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource ActionAccentLight}, Dark={StaticResource ActionAccentDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding Second.Value}"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="{Binding Second.Label}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBadge}"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>

                    <!-- Column 2 -->
                    <Border Grid.Column="2"
                            IsVisible="{Binding HasThird}"
                            HeightRequest="84"
                            Padding="10,8"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Shadow="{StaticResource Elevation1Shadow}">
                        <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                            <Image WidthRequest="18"
                                   HeightRequest="18"
                                   HorizontalOptions="Start">
                                <Image.Source>
                                    <FontImageSource Glyph="{Binding Third.IconGlyph}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="18"
                                                     Color="{AppThemeBinding Light={StaticResource ActionAccentLight}, Dark={StaticResource ActionAccentDark}}" />
                                </Image.Source>
                            </Image>
                            <Label Text="{Binding Third.Value}"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   FontSize="{StaticResource FontSizeBodyMedium}"
                                   FontAttributes="Bold"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                            <Label Text="{Binding Third.Label}"
                                   FontFamily="{StaticResource FontFamilyRegular}"
                                   FontSize="{StaticResource FontSizeBadge}"
                                   LineBreakMode="TailTruncation"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                        </VerticalStackLayout>
                    </Border>
                </Grid>
            </DataTemplate>
        </BindableLayout.ItemTemplate>
    </VerticalStackLayout>
</ContentView>
