<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Pages.Controls.RoomDetail.Models"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.Controls.RoomDetail.SimilarRoomsCarouselControl"
             x:DataType="vm:RoomDetailPageModel">

    <VerticalStackLayout IsVisible="{Binding HasSimilarRooms}"
                         Spacing="10"
                         Margin="0,8,0,12">
        <!-- Header: Title & Filter Criteria -->
        <Grid ColumnDefinitions="*, Auto">
            <Label Grid.Column="0"
                   Text="{loc:LocalizedStrings RoomDetail_SimilarRoomsNearby}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeH3}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                   VerticalTextAlignment="Center" />

            <Label Grid.Column="1"
                   Text="{loc:LocalizedStrings RoomDetail_SimilarRoomsCriteria}"
                   FontFamily="{StaticResource FontFamilyRegular}"
                   FontSize="{StaticResource FontSizeCaption}"
                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                   VerticalTextAlignment="Center" />
        </Grid>

        <!-- Horizontal Carousel of Similar Rooms -->
        <CollectionView ItemsSource="{Binding SimilarRooms}"
                        HeightRequest="215"
                        SelectionMode="None">
            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Horizontal"
                                   ItemSpacing="12" />
            </CollectionView.ItemsLayout>
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:SimilarRoomDisplayModel">
                    <Border WidthRequest="185"
                            StrokeShape="RoundRectangle 12"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Shadow="{StaticResource Elevation1Shadow}"
                            Margin="0,2,0,6">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoomDetailPageModel}}, Path=SelectSimilarRoomCommand}"
                                                  CommandParameter="{Binding Id}" />
                        </Border.GestureRecognizers>

                        <VerticalStackLayout Spacing="0">
                            <!-- Room Thumbnail / Fallback -->
                            <Grid HeightRequest="105" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}">
                                <Image Source="{Binding ThumbnailUrl}"
                                       Aspect="AspectFill"
                                       HeightRequest="105"
                                       HorizontalOptions="Fill"
                                       VerticalOptions="Fill" />
                                <Label Text="{x:Static fonts:FluentUI.home_24_regular}"
                                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                       FontSize="24"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </Grid>

                            <!-- Room Brief Info -->
                            <VerticalStackLayout Padding="10,8" Spacing="4">
                                <!-- Price -->
                                <Label Text="{Binding PriceFormatted}"
                                       FontFamily="{StaticResource FontFamilySemibold}"
                                       FontSize="{StaticResource FontSizeH3}"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />

                                <!-- Title (Max 2 lines) -->
                                <Label Text="{Binding Title}"
                                       FontFamily="{StaticResource FontFamilyRegular}"
                                       FontSize="{StaticResource FontSizeCaption}"
                                       LineBreakMode="TailTruncation"
                                       MaxLines="2"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

                                <!-- Distance from target room -->
                                <Label Text="{Binding DistanceFormatted}"
                                       FontFamily="{StaticResource FontFamilyRegular}"
                                       FontSize="{StaticResource FontSizeBadge}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </VerticalStackLayout>
</ContentView>
