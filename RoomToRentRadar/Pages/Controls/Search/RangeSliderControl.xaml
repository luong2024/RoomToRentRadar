<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="RoomToRentRadar.Pages.Controls.Search.RangeSliderControl">

    <Grid x:Name="Host"
          HeightRequest="48"
          BackgroundColor="Transparent"
          SizeChanged="OnHostSizeChanged">

        <!-- Track + thumbs are drawn here; the transparent hosts above it capture drags. -->
        <GraphicsView x:Name="Canvas"
                      InputTransparent="True" />

        <Grid x:Name="LowerThumbHost"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnLowerPanUpdated" />
            </Grid.GestureRecognizers>
        </Grid>

        <Grid x:Name="UpperThumbHost"
              WidthRequest="48"
              HeightRequest="48"
              HorizontalOptions="Start"
              VerticalOptions="Center"
              BackgroundColor="Transparent">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnUpperPanUpdated" />
            </Grid.GestureRecognizers>
        </Grid>
    </Grid>
</ContentView>
