<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls.Search"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.Search.ExploreFilterBarControl"
             x:DataType="controls:ExploreFilterBarControl">

    <Grid ColumnDefinitions="*, Auto, Auto"
          ColumnSpacing="8">

        <!-- Filters + active-count badge -->
        <Border Grid.Column="0"
                HeightRequest="48"
                Padding="14,0"
                StrokeThickness="0"
                StrokeShape="RoundRectangle 12"
                SemanticProperties.Description="{Binding FiltersButtonDescription}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenFiltersCommand}" />
            </Border.GestureRecognizers>
            <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                <Label Text="{x:Static fonts:FluentUI.filter_20_regular}"
                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                       FontSize="18"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
                <Label Grid.Column="1"
                       Text="{Binding FiltersButtonText}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="14"
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Border Grid.Column="2"
                        MinimumWidthRequest="22"
                        HeightRequest="22"
                        Padding="6,0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 11"
                        VerticalOptions="Center"
                        IsVisible="{Binding HasActiveFilters}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionPrimaryDark}}">
                    <Label Text="{Binding ActiveFilterCount}"
                           FontSize="{StaticResource FontSizeCaption}"
                           HorizontalTextAlignment="Center"
                           VerticalTextAlignment="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           TextColor="{AppThemeBinding Light={StaticResource TextInverseLight}, Dark={StaticResource TextInverseDark}}" />
                </Border>
            </Grid>
        </Border>

        <!-- Sort selector -->
        <Border Grid.Column="1"
                HeightRequest="48"
                Padding="14,0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                SemanticProperties.Description="{Binding SortButtonDescription}"
                Stroke="{AppThemeBinding Light={StaticResource BorderInputLight}, Dark={StaticResource BorderInputDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenSortCommand}" />
            </Border.GestureRecognizers>
            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                <Label Text="{Binding CurrentSortLabel}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="14"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="{x:Static fonts:FluentUI.chevron_down_16_regular}"
                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                       FontSize="16"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </HorizontalStackLayout>
        </Border>

        <!-- Map view -->
        <Border Grid.Column="2"
                WidthRequest="48"
                HeightRequest="48"
                Padding="0"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 12"
                SemanticProperties.Description="{Binding MapDescription}"
                Stroke="{AppThemeBinding Light={StaticResource BorderInputLight}, Dark={StaticResource BorderInputDark}}"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding OpenMapCommand}" />
            </Border.GestureRecognizers>
            <Label Text="{x:Static fonts:FluentUI.map_20_regular}"
                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                   FontSize="20"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   AutomationProperties.IsInAccessibleTree="False"
                   TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
        </Border>
    </Grid>
</ContentView>
