<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.FavoriteHeartButton"
             x:Name="ThisControl">
    <Border x:Name="HeartBorder"
            StrokeShape="RoundRectangle 20"
            Stroke="Transparent"
            BackgroundColor="{Binding ButtonBackground, Source={x:Reference ThisControl}}"
            HeightRequest="{Binding ButtonSize, Source={x:Reference ThisControl}}"
            WidthRequest="{Binding ButtonSize, Source={x:Reference ThisControl}}"
            Padding="0"
            HorizontalOptions="Center"
            VerticalOptions="Center">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Tapped="OnTapped" />
        </Border.GestureRecognizers>
        <Label x:Name="HeartIcon"
               Text="{x:Static fonts:FluentUI.heart_24_regular}"
               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
               FontSize="{Binding IconSize, Source={x:Reference ThisControl}}"
               TextColor="{Binding HeartColor, Source={x:Reference ThisControl}}"
               HorizontalOptions="Center"
               VerticalOptions="Center"
               SemanticProperties.Description="Nút yêu thích" />
    </Border>
</ContentView>

