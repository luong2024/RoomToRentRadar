<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             x:Class="RoomToRentRadar.Pages.Controls.Common.RadaButton"
             x:Name="RootButtonView">

    <Border x:Name="ButtonBorder"
            StrokeShape="RoundRectangle 8"
            StrokeThickness="1"
            HeightRequest="{Binding Source={x:Reference RootButtonView}, Path=ButtonHeight}"
            MinimumHeightRequest="{StaticResource MinTouchTarget}"
            Padding="16,0"
            HorizontalOptions="{Binding Source={x:Reference RootButtonView}, Path=HorizontalOptions}"
            VerticalOptions="Center">
        <Border.GestureRecognizers>
            <TapGestureRecognizer Command="{Binding Source={x:Reference RootButtonView}, Path=Command}"
                                  CommandParameter="{Binding Source={x:Reference RootButtonView}, Path=CommandParameter}" />
        </Border.GestureRecognizers>

        <Grid HorizontalOptions="Center" VerticalOptions="Center" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Loading Spinner (Shown when IsLoading is true) -->
            <ActivityIndicator Grid.Column="0"
                               x:Name="LoadingSpinner"
                               IsRunning="{Binding Source={x:Reference RootButtonView}, Path=IsLoading}"
                               IsVisible="{Binding Source={x:Reference RootButtonView}, Path=IsLoading}"
                               WidthRequest="20"
                               HeightRequest="20"
                               Color="{Binding Source={x:Reference RootButtonView}, Path=TextColor}"
                               VerticalOptions="Center" />

            <!-- Optional Leading Icon (Shown when not loading) -->
            <Image Grid.Column="0"
                   x:Name="ButtonIcon"
                   Source="{Binding Source={x:Reference RootButtonView}, Path=LeadingIcon}"
                   IsVisible="{Binding Source={x:Reference RootButtonView}, Path=HasLeadingIcon}"
                   WidthRequest="18"
                   HeightRequest="18"
                   VerticalOptions="Center" />

            <!-- Button Text Label -->
            <Label Grid.Column="1"
                   x:Name="ButtonLabel"
                   Text="{Binding Source={x:Reference RootButtonView}, Path=Text}"
                   TextColor="{Binding Source={x:Reference RootButtonView}, Path=TextColor}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeBodyMedium}"
                   VerticalTextAlignment="Center"
                   HorizontalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>

