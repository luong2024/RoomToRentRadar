<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             x:Class="RoomToRentRadar.Pages.Controls.Common.RadaBadge"
             x:Name="RootBadgeView">

    <Border x:Name="BadgeBorder"
            StrokeShape="RoundRectangle 9999"
            StrokeThickness="0"
            HeightRequest="24"
            Padding="10,0"
            HorizontalOptions="Start"
            VerticalOptions="Center"
            BackgroundColor="{Binding Source={x:Reference RootBadgeView}, Path=BadgeColor}">

        <Label x:Name="BadgeLabel"
               Text="{Binding Source={x:Reference RootBadgeView}, Path=Text}"
               TextColor="{Binding Source={x:Reference RootBadgeView}, Path=BadgeTextColor}"
               FontFamily="{StaticResource FontFamilySemibold}"
               FontSize="{StaticResource FontSizeBadge}"
               FontAttributes="Bold"
               VerticalTextAlignment="Center"
               HorizontalTextAlignment="Center" />
    </Border>
</ContentView>

