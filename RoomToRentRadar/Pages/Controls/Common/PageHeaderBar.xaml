<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:common="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             x:Class="RoomToRentRadar.Pages.Controls.Common.PageHeaderBar"
             x:Name="RootHeaderView"
             x:DataType="common:PageHeaderBar">

    <Border StrokeShape="Rectangle"
            StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Padding="{OnPlatform Default='16,12,16,12', iOS='16,48,16,12'}">

        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
            <!-- Back Navigation Button -->
            <Border Grid.Column="0"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    WidthRequest="38"
                    HeightRequest="38"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                    VerticalOptions="Center"
                    IsVisible="{Binding CanGoBack}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <Label Text="←"
                       FontSize="20"
                       FontAttributes="Bold"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
            </Border>

            <!-- Title & Subtitle Column -->
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                <Label Text="{Binding Title}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="{StaticResource FontSizeH2}"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                       LineBreakMode="TailTruncation" />

                <Label Text="{Binding Subtitle}"
                       FontFamily="{StaticResource FontFamilyRegular}"
                       FontSize="{StaticResource FontSizeCaption}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                       IsVisible="{Binding HasSubtitle}"
                       LineBreakMode="TailTruncation" />
            </VerticalStackLayout>

            <!-- Trailing Action Slot / Button -->
            <Border Grid.Column="2"
                    StrokeShape="RoundRectangle 8"
                    StrokeThickness="0"
                    WidthRequest="38"
                    HeightRequest="38"
                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                    VerticalOptions="Center"
                    IsVisible="{Binding HasAction}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding ActionCommand}" />
                </Border.GestureRecognizers>
                <Label Text="{Binding ActionIcon}"
                       FontSize="18"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
            </Border>
        </Grid>
    </Border>
</ContentView>

