<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:feedback="clr-namespace:RoomToRentRadar.Pages.Controls.Feedback"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.Controls.Feedback.OfflineBannerView"
             x:DataType="feedback:OfflineBannerView"
             x:Name="RootOfflineBanner"
             InputTransparent="True">

    <Border StrokeThickness="0"
            BackgroundColor="{AppThemeBinding Light={StaticResource StatusWarningSubtleLight}, Dark={StaticResource StatusWarningSubtleDark}}"
            Padding="16,10">

        <Grid ColumnSpacing="8" AutomationProperties.IsInAccessibleTree="False">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Label Grid.Column="0"
                   Text="{x:Static fonts:FluentUI.wifi_off_20_regular}"
                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                   FontSize="18"
                   TextColor="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}"
                   VerticalTextAlignment="Center" />

            <Label x:Name="BannerLabel"
                   Grid.Column="1"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="13"
                   FontAttributes="Bold"
                   LineBreakMode="WordWrap"
                   TextColor="{AppThemeBinding Light={StaticResource StatusWarningTextLight}, Dark={StaticResource StatusWarningDark}}"
                   VerticalTextAlignment="Center" />
        </Grid>
    </Border>
</ContentView>