<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:feedback="clr-namespace:RoomToRentRadar.Pages.Controls.Feedback"
             x:Class="RoomToRentRadar.Pages.Controls.Feedback.SkeletonShimmer"
             x:Name="RootSkeletonView">

    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Padding="0"
            Shadow="{StaticResource Elevation1Shadow}">

        <VerticalStackLayout Spacing="12">
            <!-- Simulated Image Skeleton Area -->
            <BoxView x:Name="ImagePlaceholder"
                     HeightRequest="180"
                     Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                     Opacity="0.7" />

            <VerticalStackLayout Padding="16, 0, 16, 16" Spacing="10">
                <!-- Simulated Price Bar -->
                <BoxView x:Name="PriceBar"
                         HeightRequest="24"
                         WidthRequest="140"
                         HorizontalOptions="Start"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                         Opacity="0.7" />

                <!-- Simulated Title Bar -->
                <BoxView x:Name="TitleBar"
                         HeightRequest="18"
                         WidthRequest="260"
                         HorizontalOptions="Start"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                         Opacity="0.6" />

                <!-- Simulated Location Bar -->
                <BoxView x:Name="LocationBar"
                         HeightRequest="14"
                         WidthRequest="180"
                         HorizontalOptions="Start"
                         CornerRadius="4"
                         Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}"
                         Opacity="0.5" />

                <!-- Simulated Amenities Chips Row -->
                <HorizontalStackLayout Spacing="8" Margin="0,4,0,0">
                    <BoxView WidthRequest="60" HeightRequest="20" CornerRadius="10" Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}" Opacity="0.5" />
                    <BoxView WidthRequest="60" HeightRequest="20" CornerRadius="10" Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}" Opacity="0.5" />
                    <BoxView WidthRequest="60" HeightRequest="20" CornerRadius="10" Color="{AppThemeBinding Light={StaticResource SurfaceSubtleLight}, Dark={StaticResource SurfaceSubtleDark}}" Opacity="0.5" />
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>

