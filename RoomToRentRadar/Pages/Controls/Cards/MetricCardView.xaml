<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:cards="clr-namespace:RoomToRentRadar.Pages.Controls.Cards"
             x:Class="RoomToRentRadar.Pages.Controls.Cards.MetricCardView"
             x:Name="RootMetricView"
             x:DataType="cards:MetricCardView">

    <Border StrokeShape="RoundRectangle 12"
            StrokeThickness="1"
            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
            Padding="16"
            Shadow="{StaticResource Elevation1Shadow}">

        <VerticalStackLayout Spacing="8">
            <!-- Icon and Subtitle Row -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <Label Grid.Column="0"
                       Text="{Binding Title}"
                       FontFamily="{StaticResource FontFamilyRegular}"
                       FontSize="{StaticResource FontSizeCaption}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}" />

                <Label Grid.Column="1"
                       Text="{Binding IconGlyph}"
                       FontSize="18"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
            </Grid>

            <!-- Large Metric Value -->
            <Label Text="{Binding ValueText}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="{StaticResource FontSizeDisplay}"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />

            <!-- Subtitle / Trend Indicator -->
            <Label Text="{Binding TrendText}"
                   FontFamily="{StaticResource FontFamilyRegular}"
                   FontSize="{StaticResource FontSizeBadge}"
                   TextColor="{Binding TrendColor}"
                   IsVisible="{Binding HasTrend}" />
        </VerticalStackLayout>
    </Border>
</ContentView>

