<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Pages.RoomListingPage"
             x:DataType="vm:RoomListingPageModel"
             Title="Room Radar"
             SafeAreaEdges="All">
    <Grid RowDefinitions="Auto,*,Auto">
        <Border StrokeShape="Rectangle" StrokeThickness="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
            <VerticalStackLayout Spacing="0">
                <Grid x:Name="TopBar" Padding="40,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                      MaximumWidthRequest="1360" HorizontalOptions="Fill">
                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                            Padding="8" StrokeThickness="0" StrokeShape="RoundRectangle 14" VerticalOptions="Center">
                        <Image Source="radar_mark.png" HeightRequest="26" WidthRequest="26" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="1">
                        <Label Text="Room Radar" FontFamily="OpenSansSemibold" FontSize="21" CharacterSpacing="-0.6" />
                        <Label Text="Một nơi ở. Một khởi đầu mới." Style="{StaticResource Caption}" FontSize="11" />
                    </VerticalStackLayout>
                    <Label x:Name="NavCaption" Grid.Column="2" Text="KHÔNG GIAN NHỎ · CUỘC SỐNG LỚN"
                           Style="{StaticResource Eyebrow}" VerticalOptions="Center" IsVisible="False"
                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                </Grid>
                <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}" />
            </VerticalStackLayout>
        </Border>

        <pullToRefresh:SfPullToRefresh x:Name="ListingRefresh" Grid.Row="1" IsRefreshing="{Binding IsRefreshing}"
                                       RefreshCommand="{Binding RefreshCommand}"
                                       Margin="40,0,22,0" MaximumWidthRequest="1280" HorizontalOptions="Fill">
            <pullToRefresh:SfPullToRefresh.PullableContent>
                <CollectionView x:Name="Listings" ItemsSource="{Binding Rooms}" SelectionMode="None"
                                RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout x:Name="CardsLayout" Orientation="Vertical" Span="1" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <VerticalStackLayout Padding="0,14,14,14" Spacing="14">
                            <cards:SfCardView Padding="16,14" CornerRadius="20" BorderWidth="0"
                                              Background="{AppThemeBinding Light={StaticResource SurfaceBrush}, Dark={StaticResource SurfaceDarkBrush}}"
                                              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="24">
                                    <VerticalStackLayout Spacing="10" VerticalOptions="Center">
                                        <HorizontalStackLayout Spacing="8">
                                            <BoxView Color="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                                     WidthRequest="22" HeightRequest="2.5" VerticalOptions="Center" CornerRadius="2" />
                                            <Label Text="TÌM PHÒNG GẦN TRƯỜNG" Style="{StaticResource Eyebrow}"
                                                   TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                        </HorizontalStackLayout>
                                        <Label x:Name="HeroTitle" Text="Phòng gần trường của bạn" FontSize="20"
                                               FontFamily="OpenSansSemibold" CharacterSpacing="-0.6" LineHeight="1.08" />
                                        <Label Text="Chọn trường, tìm khoảng cách phù hợp và khám phá không gian sống mới."
                                               Style="{StaticResource Caption}" FontSize="13" MaxLines="2" />
                                    </VerticalStackLayout>
                                    <Image x:Name="HeroArt" Grid.Column="1" Source="campus_scene.png"
                                           WidthRequest="210" HeightRequest="140" IsVisible="False" Aspect="AspectFit"
                                           SemanticProperties.Description="Minh họa khuôn viên trường" />
                                </Grid>
                            </cards:SfCardView>

                            <cards:SfCardView Padding="14,8" CornerRadius="16">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                            StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                            HeightRequest="46" WidthRequest="46" VerticalOptions="Center">
                                        <Image Source="location_pin.png" WidthRequest="21" HeightRequest="21" />
                                    </Border>
                                    <VerticalStackLayout Grid.Column="1" Spacing="2">
                                        <Label Text="CAMPUS CỦA BẠN" Style="{StaticResource Eyebrow}" FontSize="9" />
                                        <Picker ItemsSource="{Binding Campuses}" Title="" Loaded="CampusPickerLoaded"
                                                ItemDisplayBinding="{Binding Name, x:DataType=models:Campus}" SelectedItem="{Binding SelectedCampus}"
                                                SemanticProperties.Description="Chọn campus để tìm phòng gần trường" />
                                    </VerticalStackLayout>
                                </Grid>
                            </cards:SfCardView>

                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Khám phá phòng trọ" FontSize="18" FontFamily="OpenSansSemibold" CharacterSpacing="-0.4" />
                                    <Label Text="{Binding ResultsText}" Style="{StaticResource Caption}" FontSize="12" />
                                </VerticalStackLayout>
                                <HorizontalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="6">
                                    <Image Source="location_pin.png" WidthRequest="14" HeightRequest="14" />
                                    <Label Text="Gần nhất trước" Style="{StaticResource Caption}" FontSize="11" />
                                </HorizontalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:RoomListingItem"><controls:RoomCardView /></DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <cards:SfCardView Padding="24,30" Margin="0,8,18,8" CornerRadius="24">
                            <VerticalStackLayout Spacing="12" HorizontalOptions="Center">
                                <Image Source="location_pin.png" WidthRequest="30" HeightRequest="30" />
                                <Label Text="{Binding EmptyMessage}" HorizontalTextAlignment="Center" Style="{StaticResource Caption}" />
                            </VerticalStackLayout>
                        </cards:SfCardView>
                    </CollectionView.EmptyView>
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="0,12,18,32" Spacing="14">
                            <progressBar:SfCircularProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" HorizontalOptions="Center" />
                            <buttons:SfButton Text="Xem thêm phòng" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}"
                                              Style="{StaticResource SoftSfButton}" HorizontalOptions="Center" Padding="26,12" />
                            <Label Text="Chỉ hiển thị phòng còn trống, đã xác minh." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                            <Label Text="Khoảng cách đường chim bay đến campus đã chọn." Style="{StaticResource Caption}" FontSize="10" HorizontalTextAlignment="Center" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>
            </pullToRefresh:SfPullToRefresh.PullableContent>
        </pullToRefresh:SfPullToRefresh>

        <cards:SfCardView Grid.Row="2" IsVisible="{Binding HasError}" Margin="20,8" Padding="16"
                          IndicatorColor="{StaticResource Danger}" IndicatorPosition="Left" IndicatorThickness="4">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <Label Text="{Binding ErrorMessage}" VerticalOptions="Center" />
                <buttons:SfButton Grid.Column="1" Text="Thử lại" Command="{Binding RetryCommand}" Style="{StaticResource SoftSfButton}" />
            </Grid>
        </cards:SfCardView>
    </Grid>
</ContentPage>
