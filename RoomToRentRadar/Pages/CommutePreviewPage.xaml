<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls"
             x:Class="RoomToRentRadar.Pages.CommutePreviewPage"
             x:DataType="pageModels:CommuteViewModel"
             Title="Thời gian di chuyển"
             BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#0F172A}">

    <ScrollView>
        <VerticalStackLayout Padding="14" Spacing="14">
            <Label Text="Kiểm tra nhanh US09 / T09.2 — Thời gian di chuyển tới trường"
                   FontSize="15"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

            <controls:CommuteSectionView />

            <Button AutomationId="ToggleCommuteFallbackButton"
                    Text="{Binding FallbackToggleButtonText}"
                    Command="{Binding ToggleSimulateFallbackCommand}"
                    BackgroundColor="#0F172A"
                    TextColor="White"
                    FontSize="13"
                    FontAttributes="Bold"
                    CornerRadius="8"
                    Padding="14,10" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
