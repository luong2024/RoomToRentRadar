<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:common="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.RoleSelectionPage"
             x:DataType="vm:RoleSelectionPageModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCanvasLight}, Dark={StaticResource SurfaceCanvasDark}}">

    <Grid RowDefinitions="Auto, *">
        <!-- Header Bar -->
        <common:PageHeaderBar Grid.Row="0"
                               Title="Choose Your Role"
                               CanGoBack="True"
                               BackCommand="{Binding NavigateToLoginCommand}" />

        <!-- Main Scroll Area -->
        <ScrollView Grid.Row="1" Padding="{StaticResource ScreenMargin}">
            <VerticalStackLayout Spacing="24" MaximumWidthRequest="720" HorizontalOptions="Center">

                <!-- Header Title & Subtitle -->
                <VerticalStackLayout Spacing="8" Margin="0,12,0,0">
                    <Label Text="How would you like to join?"
                           Style="{StaticResource TextH1}"
                           HorizontalTextAlignment="Center" />

                    <Label Text="Select your role to personalize your experience and search tools."
                           Style="{StaticResource TextBodyMedium}"
                           HorizontalTextAlignment="Center"
                           MaximumWidthRequest="500" />
                </VerticalStackLayout>

                <!-- Responsive 2-Card Layout (Stacked on Mobile, 2 Columns on Desktop/Tablet) -->
                <Grid ColumnSpacing="16" RowSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{OnIdiom Phone='*', Tablet='*', Desktop='*'}" />
                        <ColumnDefinition Width="{OnIdiom Phone='0', Tablet='*', Desktop='*'}" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="{OnIdiom Phone='Auto', Tablet='0', Desktop='0'}" />
                    </Grid.RowDefinitions>

                    <!-- CARD 1: STUDENT -->
                    <Border Grid.Row="0" Grid.Column="0"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Padding="20"
                            Shadow="{StaticResource Elevation2Shadow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectStudentCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsStudentSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ActionAccentLight}" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="14">
                            <!-- Icon & Badge Header -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Image Grid.Column="0" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.hat_graduation_24_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Color="{StaticResource ActionAccentLight}"
                                                         Size="32" />
                                    </Image.Source>
                                </Image>
                                <common:RadaBadge Grid.Column="1" Type="Custom" BadgeColor="{StaticResource ActionAccentLight}" BadgeTextColor="{StaticResource ActionPrimaryLight}" Text="100% Free" />
                            </Grid>

                            <!-- Role Title -->
                            <Label Text="Student / Tenant"
                                   Style="{StaticResource TextH2}" />

                            <Label Text="For ICTU students and renters looking for verified rooms near campus."
                                   Style="{StaticResource TextBodyMedium}" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- Features List -->
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionAccentLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Search verified rooms near ICTU campus" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionAccentLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Explore listings with 360° virtual tours" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionAccentLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Compare up to 3 rooms side-by-side" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionAccentLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="1-Click sign in with your ICTU Google SSO" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <!-- CARD 2: LANDLORD -->
                    <Border Grid.Row="{OnIdiom Phone='1', Tablet='0', Desktop='0'}"
                            Grid.Column="{OnIdiom Phone='0', Tablet='1', Desktop='1'}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="1"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                            Padding="20"
                            Shadow="{StaticResource Elevation2Shadow}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding SelectLandlordCommand}" />
                        </Border.GestureRecognizers>
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsLandlordSelected}" Value="True">
                                <Setter Property="Stroke" Value="{StaticResource ActionPrimaryLight}" />
                                <Setter Property="StrokeThickness" Value="2.5" />
                            </DataTrigger>
                        </Border.Triggers>

                        <VerticalStackLayout Spacing="14">
                            <!-- Icon & Badge Header -->
                            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                                <Image Grid.Column="0" WidthRequest="32" HeightRequest="32" HorizontalOptions="Start">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.building_home_24_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Color="{StaticResource ActionPrimaryLight}"
                                                         Size="32" />
                                    </Image.Source>
                                </Image>
                                <common:RadaBadge Grid.Column="1" Type="Custom" BadgeColor="{StaticResource ActionPrimaryLight}" BadgeTextColor="{StaticResource White}" Text="Fast Posting" />
                            </Grid>

                            <!-- Role Title -->
                            <Label Text="Landlord / Owner"
                                   Style="{StaticResource TextH2}" />

                            <Label Text="For landlords and property owners wanting to reach ICTU students directly."
                                   Style="{StaticResource TextBodyMedium}" />

                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                            <!-- Features List -->
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionPrimaryLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Publish room listings with 360° photos" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionPrimaryLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Manage room availability and vacancies" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionPrimaryLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="Direct connection with verified students" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{x:Static fonts:FluentUI.checkmark_16_regular}" FontFamily="{x:Static fonts:FluentUI.FontFamily}" TextColor="{StaticResource ActionPrimaryLight}" FontSize="14" VerticalTextAlignment="Center" />
                                    <Label Text="'Verified' trust badge for published rooms" Style="{StaticResource TextCaption}" VerticalTextAlignment="Center" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- Actions CTA -->
                <VerticalStackLayout Spacing="12" Margin="0,16,0,24">
                    <common:RadaButton Text="Continue with selected role"
                                       Variant="Primary"
                                       Command="{Binding ContinueCommand}"
                                       ButtonHeight="48"
                                       HorizontalOptions="Fill" />

                    <Button Text="Already have an account? Sign in"
                            Style="{StaticResource GhostButton}"
                            Command="{Binding NavigateToLoginCommand}"
                            HorizontalOptions="Center" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
