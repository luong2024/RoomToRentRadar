<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:nav="clr-namespace:RoomToRentRadar.Pages.Controls.Navigation"
             xmlns:common="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             xmlns:fonts="clr-namespace:Fonts"
             xmlns:loc="clr-namespace:RoomToRentRadar.Resources.Strings"
             x:Class="RoomToRentRadar.Pages.AccountPlaceholderPage"
             x:DataType="vm:AccountPageModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCanvasLight}, Dark={StaticResource SurfaceCanvasDark}}">

    <Grid RowDefinitions="Auto, *, Auto">

        <!-- Top Page Title: Account -->
        <Grid Grid.Row="0" Padding="20,16,20,8">
            <Label Text="{Binding TitleText}"
                   FontFamily="{StaticResource FontFamilySemibold}"
                   FontSize="28"
                   FontAttributes="Bold"
                   TextColor="{AppThemeBinding Light={StaticResource Navy700}, Dark=White}" />
        </Grid>

        <!-- Main Scrollable Content -->
        <ScrollView Grid.Row="1" Padding="16,0,16,16">
            <VerticalStackLayout Spacing="16" MaximumWidthRequest="460" HorizontalOptions="Center">

                <!-- 1A. USER PROFILE HERO CARD (AUTHENTICATED ONLY) -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Navy800}"
                        Padding="16"
                        IsVisible="{Binding IsAuthenticated}"
                        Shadow="{StaticResource Elevation2Shadow}">
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="16" VerticalOptions="Center">
                        <!-- Circle Avatar with Initials -->
                        <Border Grid.Column="0"
                                WidthRequest="56"
                                HeightRequest="56"
                                StrokeShape="RoundRectangle 28"
                                StrokeThickness="0"
                                BackgroundColor="{StaticResource Ocean600}"
                                HorizontalOptions="Center"
                                VerticalOptions="Center">
                            <Label Text="{Binding Initials}"
                                   TextColor="White"
                                   FontSize="20"
                                   FontAttributes="Bold"
                                   FontFamily="{StaticResource FontFamilySemibold}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>

                        <!-- User Info & Role Pill -->
                        <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                            <Label Text="{Binding DisplayName}"
                                   TextColor="White"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   FontFamily="{StaticResource FontFamilySemibold}" />

                            <Label Text="{Binding Email}"
                                   TextColor="{StaticResource Slate400}"
                                   FontSize="13"
                                   FontFamily="{StaticResource FontFamilyRegular}" />

                            <!-- Role Pill Badge -->
                            <Border StrokeShape="RoundRectangle 12"
                                    StrokeThickness="1"
                                    Stroke="{StaticResource Navy600}"
                                    BackgroundColor="{StaticResource Navy950}"
                                    Padding="10,3"
                                    HorizontalOptions="Start"
                                    Margin="0,4,0,0">
                                <Label Text="{Binding RoleBadgeText}"
                                       TextColor="White"
                                       FontSize="11"
                                       FontAttributes="Bold"
                                       FontFamily="{StaticResource FontFamilySemibold}" />
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <!-- 1B. GUEST WELCOME HERO CARD (GUEST ONLY) -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        BackgroundColor="{StaticResource Navy800}"
                        Padding="20"
                        IsVisible="{Binding IsGuest}"
                        Shadow="{StaticResource Elevation2Shadow}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="{Binding GuestWelcomeTitleText}"
                               TextColor="White"
                               FontSize="18"
                               FontAttributes="Bold"
                               FontFamily="{StaticResource FontFamilySemibold}" />

                        <Label Text="{Binding GuestWelcomeMessageText}"
                               TextColor="{StaticResource Slate300}"
                               FontSize="13"
                               FontFamily="{StaticResource FontFamilyRegular}"
                               LineBreakMode="WordWrap" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="12" Margin="0,4,0,0">
                            <common:RadaButton Grid.Column="0"
                                               Text="{Binding GuestSignInText}"
                                               Variant="Accent"
                                               ButtonHeight="40"
                                               Command="{Binding SignInCommand}" />

                            <common:RadaButton Grid.Column="1"
                                               Text="{Binding GuestRegisterText}"
                                               Variant="Outline"
                                               ButtonHeight="40"
                                               Command="{Binding RegisterCommand}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2. NAVIGATION SETTINGS LIST CARD -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Shadow="{StaticResource Elevation1Shadow}"
                        Padding="0">
                    <VerticalStackLayout Spacing="0">

                        <!-- Item 1: My campus (Everyone) -->
                        <Grid HeightRequest="52"
                              Padding="16,0"
                              ColumnDefinitions="Auto, *, Auto, Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateCampusCommand}" />
                            </Grid.GestureRecognizers>

                            <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.location_24_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="20"
                                                     Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1" Text="{Binding ItemMyCampusText}"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding CampusName}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="3" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="16"
                                                     Color="{StaticResource Slate400}" />
                                </Image.Source>
                            </Image>
                        </Grid>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                        <!-- Item 2: Language (Everyone) -->
                        <Grid HeightRequest="52"
                              Padding="16,0"
                              ColumnDefinitions="Auto, *, Auto, Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateLanguageCommand}" />
                            </Grid.GestureRecognizers>

                            <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.globe_24_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="20"
                                                     Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1" Text="{Binding ItemLanguageText}"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Label Grid.Column="2" Text="{Binding LanguageName}"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="3" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="16"
                                                     Color="{StaticResource Slate400}" />
                                </Image.Source>
                            </Image>
                        </Grid>

                        <!-- Item 3: Personal details (Authenticated Only) -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAuthenticated}">
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                            <Grid HeightRequest="52"
                                  Padding="16,0"
                                  ColumnDefinitions="Auto, *, Auto"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigatePersonalDetailsCommand}" />
                                </Grid.GestureRecognizers>

                                <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.person_24_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="20"
                                                         Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                    </Image.Source>
                                </Image>
                                <Label Grid.Column="1" Text="{Binding ItemPersonalDetailsText}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Image Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="16"
                                                         Color="{StaticResource Slate400}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Item 4: Saved searches (Authenticated Only) -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAuthenticated}">
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                            <Grid HeightRequest="52"
                                  Padding="16,0"
                                  ColumnDefinitions="Auto, *, Auto, Auto"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateSavedSearchesCommand}" />
                                </Grid.GestureRecognizers>

                                <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.star_24_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="20"
                                                         Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                    </Image.Source>
                                </Image>
                                <Label Grid.Column="1" Text="{Binding ItemSavedSearchesText}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding SavedSearchesCount}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                                <Image Grid.Column="3" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="16"
                                                         Color="{StaticResource Slate400}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Item 5: Notifications (Authenticated Only) -->
                        <VerticalStackLayout Spacing="0" IsVisible="{Binding IsAuthenticated}">
                            <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
                            <Grid HeightRequest="52"
                                  Padding="16,0"
                                  ColumnDefinitions="Auto, *, Auto, Auto"
                                  ColumnSpacing="12"
                                  VerticalOptions="Center">
                                <Grid.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding NavigateNotificationsCommand}" />
                                </Grid.GestureRecognizers>

                                <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.alert_24_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="20"
                                                         Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                    </Image.Source>
                                </Image>
                                <Label Grid.Column="1" Text="{Binding ItemNotificationsText}"
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                       VerticalOptions="Center" />
                                <Label Grid.Column="2" Text="{Binding NotificationsCount}"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                                       VerticalOptions="Center" />
                                <Image Grid.Column="3" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                    <Image.Source>
                                        <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                         FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                         Size="16"
                                                         Color="{StaticResource Slate400}" />
                                    </Image.Source>
                                </Image>
                            </Grid>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />

                        <!-- Item 6: Help, terms & privacy (Everyone) -->
                        <Grid HeightRequest="52"
                              Padding="16,0"
                              ColumnDefinitions="Auto, *, Auto"
                              ColumnSpacing="12"
                              VerticalOptions="Center">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding NavigateHelpCommand}" />
                            </Grid.GestureRecognizers>

                            <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.info_24_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="20"
                                                     Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                                </Image.Source>
                            </Image>
                            <Label Grid.Column="1" Text="{Binding ItemHelpText}"
                                   FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                                   VerticalOptions="Center" />
                            <Image Grid.Column="2" WidthRequest="16" HeightRequest="16" VerticalOptions="Center">
                                <Image.Source>
                                    <FontImageSource Glyph="{x:Static fonts:FluentUI.chevron_right_20_regular}"
                                                     FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                     Size="16"
                                                     Color="{StaticResource Slate400}" />
                                </Image.Source>
                            </Image>
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- 3. PUSH NOTIFICATIONS SWITCH CARD (AUTHENTICATED ONLY) -->
                <Border StrokeShape="RoundRectangle 16"
                        StrokeThickness="1"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        Shadow="{StaticResource Elevation1Shadow}"
                        IsVisible="{Binding IsAuthenticated}"
                        Padding="16,10">
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <Image Grid.Column="0" WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.alert_24_regular}"
                                                 FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                 Size="20"
                                                 Color="{AppThemeBinding Light={StaticResource Navy700}, Dark={StaticResource Teal400}}" />
                            </Image.Source>
                        </Image>

                        <Label Grid.Column="1" Text="{Binding ItemPushNotificationsText}"
                               FontSize="15"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}"
                               VerticalOptions="Center" />

                        <Switch Grid.Column="2"
                                IsToggled="{Binding IsPushNotificationsEnabled}"
                                OnColor="{StaticResource Navy700}"
                                ThumbColor="{StaticResource Navy700}"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- 4. SIGN OUT BUTTON (AUTHENTICATED ONLY) -->
                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1.5"
                        Stroke="{AppThemeBinding Light={StaticResource StatusDangerLight}, Dark={StaticResource StatusDangerDark}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                        HeightRequest="48"
                        Padding="16,0"
                        Margin="0,4,0,0"
                        IsVisible="{Binding IsAuthenticated}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SignOutCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="8">
                        <Image WidthRequest="20" HeightRequest="20" VerticalOptions="Center">
                            <Image.Source>
                                <FontImageSource Glyph="{x:Static fonts:FluentUI.sign_out_24_regular}"
                                                 FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                                 Size="20"
                                                 Color="{AppThemeBinding Light={StaticResource StatusDangerLight}, Dark={StaticResource StatusDangerDark}}" />
                            </Image.Source>
                        </Image>

                        <Label Text="{Binding ItemSignOutText}"
                               TextColor="{AppThemeBinding Light={StaticResource StatusDangerLight}, Dark={StaticResource StatusDangerDark}}"
                               FontSize="15"
                               FontAttributes="Bold"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>

                <!-- 5. FOOTER COPYRIGHT / GROUP INFO -->
                <Label Text="{Binding FooterCopyrightText}"
                       TextColor="{AppThemeBinding Light={StaticResource TextMutedLight}, Dark={StaticResource TextMutedDark}}"
                       FontSize="12"
                       HorizontalOptions="Center"
                       Margin="0,4,0,16" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- 6. BOTTOM NAVIGATION BAR (ACTIVE ON ACCOUNT) -->
        <nav:BottomNavBarControl Grid.Row="2"
                                 ActiveTab="Account" />
    </Grid>
</ContentPage>
