<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pageModels="clr-namespace:RoomToRentRadar.PageModels"
             x:Class="RoomToRentRadar.Pages.CreateListingPage"
             x:DataType="pageModels:CreateListingViewModel"
             Title="Đăng tin phòng trọ">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121216}">

        <!-- MAIN SCROLLABLE FORM -->
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="16,14,16,24"
                                 Spacing="14">

                <!-- Header Banner -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B1D8F" Offset="0.0" />
                            <GradientStop Color="#512BD4" Offset="0.6" />
                            <GradientStop Color="#7C4DFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Đăng tin cho thuê quanh ICTU"
                                   FontSize="18"
                                   FontAttributes="Bold"
                                   TextColor="White" />
                            <Border Grid.Column="1"
                                    BackgroundColor="#28FFFFFF"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="8,4">
                                <Label Text="{Binding DataSourceBadgeText}"
                                       FontSize="10.5"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                            </Border>
                        </Grid>
                        <Label Text="Tin đăng mới cần tối thiểu 3 ảnh JPG/PNG (≤ 10MB) và sẽ được lưu ở trạng thái PendingReview để kiểm duyệt."
                               FontSize="12.5"
                               TextColor="#E9D5FF" />
                    </VerticalStackLayout>
                </Border>

                <!-- PENDING REVIEW CONFIRMATION BADGE (Appium: PendingReviewBadge) -->
                <Border AutomationId="PendingReviewBadge"
                        IsVisible="{Binding IsSubmittedPendingReview}"
                        BackgroundColor="{AppThemeBinding Light=#FFFBEB, Dark=#2A220E}"
                        Stroke="#F59E0B"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="10">
                            <Border Grid.Column="0"
                                    BackgroundColor="#FEF3C7"
                                    Stroke="#F59E0B"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,4">
                                <Label Text="{Binding ModerationStatusBadgeText}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="#B45309" />
                            </Border>
                            <Label Grid.Column="1"
                                   Text="{Binding SubmittedListingId, StringFormat='Mã tin: {0}'}"
                                   FontSize="12"
                                   FontAttributes="Bold"
                                   VerticalOptions="Center"
                                   TextColor="{AppThemeBinding Light=#92400E, Dark=#FCD34D}" />
                        </Grid>

                        <Label Text="{Binding SubmissionStatusText}"
                               FontSize="13"
                               TextColor="{AppThemeBinding Light=#78350F, Dark=#FDE68A}" />

                        <Button AutomationId="ResetListingFormButton"
                                Text="➕ Đăng thêm tin phòng mới"
                                Command="{Binding ResetFormCommand}"
                                BackgroundColor="#F59E0B"
                                TextColor="White"
                                FontSize="12.5"
                                FontAttributes="Bold"
                                CornerRadius="10"
                                Padding="12,8"
                                HorizontalOptions="Start" />
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION 1: BASIC INFORMATION -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D2D38}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="1. Thông tin cơ bản &amp; Giá thuê"
                               FontSize="15.5"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <!-- Title -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Tiêu đề tin đăng *"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,2">
                                <Entry AutomationId="ListingTitleEntry"
                                       Placeholder="VD: Phòng khép kín ban công thoáng cách ICTU 350m"
                                       Text="{Binding Title}"
                                       FontSize="13.5" />
                            </Border>
                            <Label Text="{Binding TitleError}"
                                   IsVisible="{Binding HasTitleError}"
                                   FontSize="11.5"
                                   TextColor="#DC2626" />
                        </VerticalStackLayout>

                        <!-- Room Type Chips -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Loại phòng trọ *"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <CollectionView ItemsSource="{Binding RoomTypeOptions}"
                                            HeightRequest="40"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Horizontal"
                                                       ItemSpacing="8" />
                                </CollectionView.ItemsLayout>
                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="pageModels:ListingRoomTypeOptionModel">
                                        <Border BackgroundColor="{Binding ChipBackgroundHex}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 14"
                                                Padding="12,8">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:CreateListingViewModel}}, Path=SelectRoomTypeCommand, x:DataType=pageModels:CreateListingViewModel}"
                                                    CommandParameter="{Binding .}" />
                                            </Border.GestureRecognizers>
                                            <Label Text="{Binding DisplayName}"
                                                   FontSize="12.5"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding ChipTextColorHex}"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>

                        <!-- Rent & Deposit -->
                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <Label Text="Giá thuê (đ/tháng) *"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="RentEntry"
                                           Placeholder="VD: 1800000"
                                           Keyboard="Numeric"
                                           Text="{Binding RentText}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding RentError}"
                                       IsVisible="{Binding HasRentError}"
                                       FontSize="11.5"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Tiền cọc (đ)"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="DepositEntry"
                                           Placeholder="Mặc định 1 tháng"
                                           Keyboard="Numeric"
                                           Text="{Binding DepositText}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding DepositError}"
                                       IsVisible="{Binding HasDepositError}"
                                       FontSize="11.5"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Area & Address -->
                        <Grid ColumnDefinitions="110,*"
                              ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <Label Text="Diện tích (m²) *"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="AreaEntry"
                                           Placeholder="22.5"
                                           Keyboard="Numeric"
                                           Text="{Binding AreaText}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding AreaError}"
                                       IsVisible="{Binding HasAreaError}"
                                       FontSize="11"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Địa chỉ gần ICTU *"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="AddressEntry"
                                           Placeholder="Ngõ 23 Z115, Quyết Thắng, Thái Nguyên"
                                           Text="{Binding Address}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding AddressError}"
                                       IsVisible="{Binding HasAddressError}"
                                       FontSize="11"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Grid>

                        <!-- Description -->
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Mô tả chi tiết *"
                                   FontSize="12.5"
                                   FontAttributes="Bold"
                                   TextColor="{AppThemeBinding Light=#334155, Dark=#CBD5E1}" />
                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                    Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 10"
                                    Padding="10,4">
                                <Editor AutomationId="DescriptionEditor"
                                        Placeholder="Mô tả vị trí, an ninh, giờ giấc, điện nước và ưu điểm phòng..."
                                        Text="{Binding Description}"
                                        HeightRequest="88"
                                        FontSize="13" />
                            </Border>
                            <Label Text="{Binding DescriptionError}"
                                   IsVisible="{Binding HasDescriptionError}"
                                   FontSize="11.5"
                                   TextColor="#DC2626" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION 2: PHOTOS (>= 3 JPG/PNG <= 10MB) -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D2D38}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="2. Hình ảnh phòng trọ (Tối thiểu 3 ảnh)"
                               FontSize="15.5"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <Label AutomationId="PhotoCountSummaryLabel"
                               Text="{Binding PhotoCountSummaryText}"
                               FontSize="12.5"
                               FontAttributes="Bold"
                               TextColor="#512BD4" />

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    AutomationId="PickPhotosButton"
                                    Text="📷 Chọn ảnh phòng (JPG/PNG)"
                                    Command="{Binding PickPhotosCommand}"
                                    BackgroundColor="#512BD4"
                                    TextColor="White"
                                    FontSize="13"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    Padding="12,10" />

                            <Button Grid.Column="1"
                                    AutomationId="AddSamplePhotosButton"
                                    Text="✨ Thêm 3 ảnh mẫu"
                                    Command="{Binding AddSamplePhotosCommand}"
                                    BackgroundColor="#EDE9FE"
                                    TextColor="#512BD4"
                                    FontSize="12.5"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    Padding="12,10" />
                        </Grid>

                        <Label AutomationId="PhotosErrorLabel"
                               Text="{Binding PhotosError}"
                               IsVisible="{Binding HasPhotosError}"
                               FontSize="12"
                               TextColor="#DC2626" />

                        <VerticalStackLayout AutomationId="PhotosCollectionView"
                                             IsVisible="{Binding HasPhotos}"
                                             BindableLayout.ItemsSource="{Binding Photos}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:ListingPhotoDraftModel">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3F3F46}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10">
                                        <Grid ColumnDefinitions="56,*,Auto,Auto"
                                              ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    WidthRequest="56"
                                                    HeightRequest="56"
                                                    BackgroundColor="#E0E7FF"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">
                                                <Image Source="{Binding LocalPathOrUrl}"
                                                       Aspect="AspectFill" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="3"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding DisplayTitle}"
                                                       FontSize="12.5"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding FormattedSize}"
                                                       FontSize="11.5"
                                                       TextColor="#64748B" />
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="{Binding Badge360Text}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:CreateListingViewModel}}, Path=TogglePhoto360Command, x:DataType=pageModels:CreateListingViewModel}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{Binding Badge360BackgroundHex}"
                                                    TextColor="{Binding Badge360TextColorHex}"
                                                    FontSize="11"
                                                    FontAttributes="Bold"
                                                    Padding="8,4"
                                                    HeightRequest="30"
                                                    CornerRadius="8"
                                                    VerticalOptions="Center" />

                                            <Button Grid.Column="3"
                                                    Text="✕"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:CreateListingViewModel}}, Path=RemovePhotoCommand, x:DataType=pageModels:CreateListingViewModel}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#FEE2E2"
                                                    TextColor="#DC2626"
                                                    FontSize="12"
                                                    FontAttributes="Bold"
                                                    WidthRequest="30"
                                                    HeightRequest="30"
                                                    Padding="0"
                                                    CornerRadius="8"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION 3: AMENITIES & HOUSE RULES -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D2D38}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="3. Tiện ích &amp; Nội quy phòng trọ"
                               FontSize="15.5"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <CollectionView ItemsSource="{Binding Amenities}"
                                        HeightRequest="40"
                                        SelectionMode="None">
                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Horizontal"
                                                   ItemSpacing="8" />
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="pageModels:SelectableAmenityModel">
                                    <Border BackgroundColor="{Binding ChipBackgroundHex}"
                                            Stroke="{Binding ChipStrokeHex}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="12,6">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:CreateListingViewModel}}, Path=ToggleAmenityCommand, x:DataType=pageModels:CreateListingViewModel}"
                                                CommandParameter="{Binding .}" />
                                        </Border.GestureRecognizers>
                                        <Label Text="{Binding DisplayText}"
                                               FontSize="12"
                                               FontAttributes="Bold"
                                               TextColor="{Binding ChipTextColorHex}"
                                               VerticalOptions="Center" />
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="3">
                                <Label Text="Giờ yên tĩnh"
                                       FontSize="12"
                                       TextColor="#64748B" />
                                <Entry Text="{Binding QuietHours}"
                                       FontSize="12.5" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="3">
                                <Label Text="Để xe"
                                       FontSize="12"
                                       TextColor="#64748B" />
                                <Entry Text="{Binding ParkingRules}"
                                       FontSize="12.5" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="3">
                            <Label Text="Quy định khách &amp; nấu ăn"
                                   FontSize="12"
                                   TextColor="#64748B" />
                            <Entry Text="{Binding GuestPolicy}"
                                   FontSize="12.5" />
                            <Entry Text="{Binding CookingRules}"
                                   FontSize="12.5" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- SECTION 4: LANDLORD CONTACT -->
                <Border BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D2D38}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="16">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="4. Thông tin chủ trọ liên hệ"
                               FontSize="15.5"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#0F172A, Dark=#F8FAFC}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="10">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="4">
                                <Label Text="Tên chủ trọ *"
                                       FontSize="12.5"
                                       FontAttributes="Bold" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="LandlordNameEntry"
                                           Placeholder="VD: Cô Lan"
                                           Text="{Binding LandlordName}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding LandlordNameError}"
                                       IsVisible="{Binding HasLandlordNameError}"
                                       FontSize="11"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="4">
                                <Label Text="Số điện thoại *"
                                       FontSize="12.5"
                                       FontAttributes="Bold" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                                        StrokeThickness="1"
                                        StrokeShape="RoundRectangle 10"
                                        Padding="10,2">
                                    <Entry AutomationId="LandlordPhoneEntry"
                                           Placeholder="0987654321"
                                           Keyboard="Telephone"
                                           Text="{Binding LandlordPhone}"
                                           FontSize="13.5" />
                                </Border>
                                <Label Text="{Binding LandlordPhoneError}"
                                       IsVisible="{Binding HasLandlordPhoneError}"
                                       FontSize="11"
                                       TextColor="#DC2626" />
                            </VerticalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- STICKY SUBMIT FOOTER -->
        <Border Grid.Row="1"
                Padding="16,12"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0">
            <VerticalStackLayout Spacing="8">
                <Label AutomationId="FormErrorSummaryLabel"
                       Text="{Binding FormErrorSummary}"
                       IsVisible="{Binding HasFormErrorSummary}"
                       FontSize="12"
                       TextColor="#DC2626" />

                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                    <Button Grid.Column="0"
                            AutomationId="SubmitListingButton"
                            Text="📤 Gửi tin chờ duyệt (PendingReview)"
                            Command="{Binding SubmitListingCommand}"
                            BackgroundColor="#512BD4"
                            TextColor="White"
                            FontSize="14"
                            FontAttributes="Bold"
                            CornerRadius="12"
                            Padding="16,12" />

                    <ActivityIndicator Grid.Column="1"
                                       IsRunning="{Binding IsSubmitting}"
                                       IsVisible="{Binding IsSubmitting}"
                                       VerticalOptions="Center" />
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
