<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:pageModels="clr-namespace:RoomToRentRadar.PageModels"
             x:Class="RoomToRentRadar.Pages.CompareRoomsPage"
             x:DataType="pageModels:CompareRoomsViewModel"
             Title="So sánh phòng trọ">

    <Grid RowDefinitions="*,Auto"
          BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#121216}">

        <ScrollView Grid.Row="0">
            <VerticalStackLayout Padding="14"
                                 Spacing="12"
                                 MaximumWidthRequest="820"
                                 HorizontalOptions="Fill">

                <!-- HEADER BANNER & ACTION BUTTONS -->
                <Border StrokeThickness="0"
                        StrokeShape="RoundRectangle 20"
                        Padding="16">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#3B1D8F" Offset="0.0" />
                            <GradientStop Color="#512BD4" Offset="0.6" />
                            <GradientStop Color="#7C4DFF" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="2">
                                <Label Text="So sánh phòng trọ cạnh nhau"
                                       FontSize="17.5"
                                       FontAttributes="Bold"
                                       TextColor="White" />
                                <Label AutomationId="CompareCountLabel"
                                       Text="{Binding CompareCountText}"
                                       FontSize="12.5"
                                       TextColor="#E9D5FF" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    AutomationId="ClearComparisonButton"
                                    Text="Xóa hết"
                                    Command="{Binding ClearComparisonCommand}"
                                    BackgroundColor="#28FFFFFF"
                                    TextColor="White"
                                    FontSize="12"
                                    FontAttributes="Bold"
                                    CornerRadius="10"
                                    Padding="12,6"
                                    VerticalOptions="Start" />
                        </Grid>

                        <Border IsVisible="{Binding HasBestValueSummary}"
                                BackgroundColor="#22FFFFFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 12"
                                Padding="10,7">
                            <Label AutomationId="BestValueSummaryLabel"
                                   Text="{Binding BestValueSummaryText}"
                                   FontSize="12"
                                   TextColor="White" />
                        </Border>

                        <Grid ColumnDefinitions="*,Auto"
                              ColumnSpacing="8">
                            <Button Grid.Column="0"
                                    AutomationId="AddRoomToCompareButton"
                                    Text="➕ Thêm phòng so sánh"
                                    Command="{Binding ToggleRoomPickerCommand}"
                                    BackgroundColor="White"
                                    TextColor="#3B1D8F"
                                    FontSize="12.5"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="12,9" />

                            <Button Grid.Column="1"
                                    AutomationId="ShareComparisonImageButton"
                                    Text="📤 Chia sẻ ảnh"
                                    Command="{Binding ShareComparisonImageCommand}"
                                    BackgroundColor="#10B981"
                                    TextColor="White"
                                    FontSize="12.5"
                                    FontAttributes="Bold"
                                    CornerRadius="12"
                                    Padding="12,9" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- ROOM PICKER PANEL (Collapsible) -->
                <Border IsVisible="{Binding IsPickerOpen}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#3F3F46}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="14">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Grid.Column="0"
                                   Text="Chọn tối đa 3 phòng quanh ICTU"
                                   FontSize="14.5"
                                   FontAttributes="Bold" />
                            <Button Grid.Column="1"
                                    Text="Đóng"
                                    Command="{Binding ToggleRoomPickerCommand}"
                                    BackgroundColor="#F1F5F9"
                                    TextColor="#0F172A"
                                    FontSize="11.5"
                                    Padding="10,4"
                                    HeightRequest="28"
                                    CornerRadius="8" />
                        </Grid>

                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding AvailableRooms}"
                                             Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:RoomComparisonItemModel">
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#25252E}"
                                            Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#3F3F46}"
                                            StrokeThickness="1"
                                            StrokeShape="RoundRectangle 12"
                                            Padding="10">
                                        <Grid ColumnDefinitions="56,*,Auto"
                                              ColumnSpacing="10">
                                            <Border Grid.Column="0"
                                                    WidthRequest="56"
                                                    HeightRequest="56"
                                                    Padding="0"
                                                    BackgroundColor="#EDE9FE"
                                                    StrokeThickness="0"
                                                    StrokeShape="RoundRectangle 10">
                                                <Grid IsClippedToBounds="True">
                                                    <Image Source="{Binding ResolvedImageUrl}"
                                                           WidthRequest="56"
                                                           HeightRequest="56"
                                                           Aspect="AspectFill"
                                                           HorizontalOptions="Fill"
                                                           VerticalOptions="Fill" />
                                                </Grid>
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                                 Spacing="2"
                                                                 VerticalOptions="Center">
                                                <Label Text="{Binding Title}"
                                                       FontSize="12.5"
                                                       FontAttributes="Bold"
                                                       LineBreakMode="TailTruncation" />
                                                <Label Text="{Binding FormattedRent}"
                                                       FontSize="12"
                                                       FontAttributes="Bold"
                                                       TextColor="#512BD4" />
                                                <Label FontSize="11"
                                                       TextColor="#64748B">
                                                    <Label.Text>
                                                        <MultiBinding StringFormat="{}{0} • Cách ICTU {1}">
                                                            <Binding Path="FormattedArea" />
                                                            <Binding Path="FormattedDistance" />
                                                        </MultiBinding>
                                                    </Label.Text>
                                                </Label>
                                            </VerticalStackLayout>

                                            <Button Grid.Column="2"
                                                    Text="{Binding PickerActionText}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type pageModels:CompareRoomsViewModel}}, Path=AddRoomCommand, x:DataType=pageModels:CompareRoomsViewModel}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="{Binding PickerButtonBgHex}"
                                                    TextColor="White"
                                                    FontSize="11.5"
                                                    FontAttributes="Bold"
                                                    Padding="10,6"
                                                    HeightRequest="34"
                                                    CornerRadius="10"
                                                    VerticalOptions="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- EMPTY STATE -->
                <Border IsVisible="{Binding HasNoComparedRooms}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#2D2D38}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 18"
                        Padding="22">
                    <VerticalStackLayout Spacing="8"
                                         HorizontalOptions="Center">
                        <Label Text="⚖️ Chưa có phòng nào được chọn để so sánh"
                               FontSize="15"
                               FontAttributes="Bold"
                               HorizontalTextAlignment="Center" />
                        <Label Text="Bấm nút 'Thêm phòng so sánh' ở trên để chọn 2 đến 3 phòng trọ đối chiếu giá thuê, diện tích, khoảng cách và tiện ích."
                               FontSize="12.5"
                               TextColor="#64748B"
                               HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </Border>

                <!-- SIDE-BY-SIDE COMPARISON GRID (Appium: ComparisonGrid) -->
                <Border x:Name="ComparisonGrid"
                        AutomationId="ComparisonGrid"
                        IsVisible="{Binding HasComparedRooms}"
                        BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                        Stroke="{AppThemeBinding Light=#CBD5E1, Dark=#32323C}"
                        StrokeThickness="1"
                        StrokeShape="RoundRectangle 20"
                        Padding="12">
                    <VerticalStackLayout Spacing="10">

                        <!-- Room Header Cards Row (1 - 3 Columns) -->
                        <Grid ColumnDefinitions="92,*,*,*"
                              ColumnSpacing="6">
                            <VerticalStackLayout Grid.Column="0"
                                                 VerticalOptions="Center"
                                                 Padding="4">
                                <Label Text="Tiêu chí"
                                       FontSize="12.5"
                                       FontAttributes="Bold"
                                       TextColor="#64748B" />
                                <Label Text="Đối chiếu"
                                       FontSize="11"
                                       TextColor="#94A3B8" />
                            </VerticalStackLayout>

                            <!-- Slot 1 -->
                            <Border Grid.Column="1"
                                    IsVisible="{Binding HasSlot1}"
                                    BackgroundColor="#F5F3FF"
                                    Stroke="#DDD6FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6">
                                <VerticalStackLayout Spacing="4">
                                    <Grid>
                                        <Border HeightRequest="110"
                                                Padding="0"
                                                BackgroundColor="#EDE9FE"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid IsClippedToBounds="True">
                                                <Image Source="{Binding Slot1.ResolvedImageUrl}"
                                                       HeightRequest="110"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Grid>
                                        </Border>
                                        <Button Text="✕"
                                                Command="{Binding RemoveRoomCommand}"
                                                CommandParameter="{Binding Slot1}"
                                                BackgroundColor="#AA0F172A"
                                                TextColor="White"
                                                FontSize="10"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="3" />
                                    </Grid>
                                    <Label Text="{Binding Slot1.ShortTitle}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Slot1.FormattedRent}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#512BD4" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Slot 2 -->
                            <Border Grid.Column="2"
                                    IsVisible="{Binding HasSlot2}"
                                    BackgroundColor="#F5F3FF"
                                    Stroke="#DDD6FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6">
                                <VerticalStackLayout Spacing="4">
                                    <Grid>
                                        <Border HeightRequest="110"
                                                Padding="0"
                                                BackgroundColor="#EDE9FE"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid IsClippedToBounds="True">
                                                <Image Source="{Binding Slot2.ResolvedImageUrl}"
                                                       HeightRequest="110"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Grid>
                                        </Border>
                                        <Button Text="✕"
                                                Command="{Binding RemoveRoomCommand}"
                                                CommandParameter="{Binding Slot2}"
                                                BackgroundColor="#AA0F172A"
                                                TextColor="White"
                                                FontSize="10"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="3" />
                                    </Grid>
                                    <Label Text="{Binding Slot2.ShortTitle}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Slot2.FormattedRent}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#512BD4" />
                                </VerticalStackLayout>
                            </Border>

                            <!-- Slot 3 -->
                            <Border Grid.Column="3"
                                    IsVisible="{Binding HasSlot3}"
                                    BackgroundColor="#F5F3FF"
                                    Stroke="#DDD6FE"
                                    StrokeThickness="1"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="6">
                                <VerticalStackLayout Spacing="4">
                                    <Grid>
                                        <Border HeightRequest="110"
                                                Padding="0"
                                                BackgroundColor="#EDE9FE"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8">
                                            <Grid IsClippedToBounds="True">
                                                <Image Source="{Binding Slot3.ResolvedImageUrl}"
                                                       HeightRequest="110"
                                                       Aspect="AspectFill"
                                                       HorizontalOptions="Fill"
                                                       VerticalOptions="Fill" />
                                            </Grid>
                                        </Border>
                                        <Button Text="✕"
                                                Command="{Binding RemoveRoomCommand}"
                                                CommandParameter="{Binding Slot3}"
                                                BackgroundColor="#AA0F172A"
                                                TextColor="White"
                                                FontSize="10"
                                                WidthRequest="22"
                                                HeightRequest="22"
                                                Padding="0"
                                                CornerRadius="11"
                                                HorizontalOptions="End"
                                                VerticalOptions="Start"
                                                Margin="3" />
                                    </Grid>
                                    <Label Text="{Binding Slot3.ShortTitle}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           MaxLines="2"
                                           LineBreakMode="TailTruncation" />
                                    <Label Text="{Binding Slot3.FormattedRent}"
                                           FontSize="11"
                                           FontAttributes="Bold"
                                           TextColor="#512BD4" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <BoxView HeightRequest="1"
                                 Color="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}" />

                        <!-- Comparison Matrix Rows -->
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding ComparisonRows}"
                                             Spacing="6">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="models:ComparisonAttributeRowModel">
                                    <Grid ColumnDefinitions="92,*,*,*"
                                          ColumnSpacing="6">
                                        <Label Grid.Column="0"
                                               Text="{Binding DisplayLabel}"
                                               FontSize="11.5"
                                               FontAttributes="Bold"
                                               TextColor="{AppThemeBinding Light=#475569, Dark=#CBD5E1}"
                                               VerticalOptions="Center" />

                                        <Border Grid.Column="1"
                                                BackgroundColor="{Binding Slot1BgHex}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="6,6">
                                            <Label Text="{Binding Value1}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding Slot1TextHex}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Border Grid.Column="2"
                                                IsVisible="{Binding HasSlot2}"
                                                BackgroundColor="{Binding Slot2BgHex}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="6,6">
                                            <Label Text="{Binding Value2}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding Slot2TextHex}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" />
                                        </Border>

                                        <Border Grid.Column="3"
                                                IsVisible="{Binding HasSlot3}"
                                                BackgroundColor="{Binding Slot3BgHex}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 8"
                                                Padding="6,6">
                                            <Label Text="{Binding Value3}"
                                                   FontSize="11"
                                                   FontAttributes="Bold"
                                                   TextColor="{Binding Slot3TextHex}"
                                                   HorizontalTextAlignment="Center"
                                                   VerticalOptions="Center" />
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="1"
                Padding="14,10"
                BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#1C1C22}"
                Stroke="{AppThemeBinding Light=#E2E8F0, Dark=#32323C}"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 0">
            <Grid ColumnDefinitions="*,Auto"
                  ColumnSpacing="10">
                <VerticalStackLayout Grid.Column="0"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="{Binding StatusMessage}"
                           FontSize="12.5"
                           FontAttributes="Bold" />
                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           FontSize="11.5"
                           TextColor="#DC2626" />
                </VerticalStackLayout>

                <ActivityIndicator Grid.Column="1"
                                   IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
