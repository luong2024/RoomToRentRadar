<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.PageModels"
             xmlns:nav="clr-namespace:RoomToRentRadar.Pages.Controls.Navigation"
             xmlns:feedback="clr-namespace:RoomToRentRadar.Pages.Controls.Feedback"
             xmlns:common="clr-namespace:RoomToRentRadar.Pages.Controls.Common"
             xmlns:cards="clr-namespace:RoomToRentRadar.Pages.Controls.Cards"
             xmlns:cardmodels="clr-namespace:RoomToRentRadar.Pages.Controls.Cards.Models"
             xmlns:search="clr-namespace:RoomToRentRadar.Pages.Controls.Search"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Pages.MainLandingPage"
             x:DataType="vm:MainLandingPageModel"
             BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCanvasLight}, Dark={StaticResource SurfaceCanvasDark}}">

    <!-- SCR-HOME-01: layout follows the approved design export (Explore.dc.html). -->
    <Grid RowDefinitions="Auto, Auto, *, Auto" RowSpacing="0">

        <!-- Header: campus chip, notifications, filters / sort / map, active filter chips -->
        <Grid Grid.Row="0"
              RowDefinitions="Auto, 1"
              BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}">
            <VerticalStackLayout Padding="16,10,16,12"
                                 Spacing="10"
                                 MaximumWidthRequest="640">
                <Grid ColumnDefinitions="*, Auto">
                    <HorizontalStackLayout Spacing="6"
                                           HeightRequest="48"
                                           HorizontalOptions="Start"
                                           SemanticProperties.Description="{Binding CampusChipDescription}">
                        <HorizontalStackLayout.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenCampusCommand}" />
                        </HorizontalStackLayout.GestureRecognizers>
                        <Label Text="{x:Static fonts:FluentUI.location_20_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="20"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource ActionSecondaryLight}, Dark={StaticResource TextBrandDark}}" />
                        <Label Text="{Binding NearText}"
                               FontSize="13"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                        <Label Text="{Binding CampusName}"
                               FontFamily="{StaticResource FontFamilySemibold}"
                               FontSize="17"
                               FontAttributes="Bold"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
                        <Label Text="{x:Static fonts:FluentUI.chevron_down_20_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="18"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
                    </HorizontalStackLayout>

                    <Grid Grid.Column="1"
                          WidthRequest="48"
                          HeightRequest="48"
                          SemanticProperties.Description="{Binding NotificationsDescription}">
                        <Grid.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                        </Grid.GestureRecognizers>
                        <Label Text="{x:Static fonts:FluentUI.alert_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="24"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               AutomationProperties.IsInAccessibleTree="False"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                        <Border IsVisible="{Binding HasUnreadNotifications}"
                                Padding="0"
                                WidthRequest="11"
                                HeightRequest="11"
                                Margin="0,10,10,0"
                                HorizontalOptions="End"
                                VerticalOptions="Start"
                                StrokeThickness="2"
                                StrokeShape="RoundRectangle 6"
                                Stroke="{AppThemeBinding Light={StaticResource SurfaceCardLight}, Dark={StaticResource SurfaceCardDark}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource StatusDangerLight}, Dark={StaticResource StatusDangerDark}}" />
                    </Grid>
                </Grid>

                <search:ExploreFilterBarControl ActiveFilterCount="{Binding ActiveFilterCount}"
                                                HasActiveFilters="{Binding HasActiveFilters}"
                                                CurrentSortLabel="{Binding CurrentSortLabel}"
                                                FiltersButtonText="{Binding FiltersButtonText}"
                                                FiltersButtonDescription="{Binding FiltersButtonDescription}"
                                                SortButtonDescription="{Binding SortButtonDescription}"
                                                MapDescription="{Binding MapDescription}"
                                                OpenFiltersCommand="{Binding OpenFiltersCommand}"
                                                OpenSortCommand="{Binding OpenSortCommand}"
                                                OpenMapCommand="{Binding OpenMapCommand}" />

                <search:ActiveFilterChipsControl Chips="{Binding ActiveFilterChips}"
                                                 HasActiveFilters="{Binding HasActiveFilters}"
                                                 RemoveChipCommand="{Binding RemoveFilterChipCommand}"
                                                 ClearAllCommand="{Binding ClearFiltersCommand}"
                                                 ClearAllText="{Binding ClearAllText}" />
            </VerticalStackLayout>
            <BoxView Grid.Row="1"
                     Color="{AppThemeBinding Light={StaticResource BorderSubtleLight}, Dark={StaticResource BorderSubtleDark}}" />
        </Grid>

        <!-- US04 AC3: the result count stays visible in every state -->
        <Grid Grid.Row="1"
              ColumnDefinitions="*, Auto"
              Padding="16,4,16,0"
              MaximumWidthRequest="640">
            <HorizontalStackLayout VerticalOptions="Center">
                <Label Text="{Binding ResultCountText}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="14"
                       FontAttributes="Bold"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimaryLight}, Dark={StaticResource TextPrimaryDark}}" />
                <Label Text="{Binding VerifiedOnlySuffixText}"
                       FontSize="14"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
            </HorizontalStackLayout>
            <HorizontalStackLayout Grid.Column="1"
                                   Spacing="4"
                                   HeightRequest="48"
                                   Padding="4,0,0,0"
                                   SemanticProperties.Description="{Binding SaveSearchText}">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding SaveSearchCommand}" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="{x:Static fonts:FluentUI.star_16_regular}"
                       FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                       FontSize="16"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
                <Label Text="{Binding SaveSearchText}"
                       FontFamily="{StaticResource FontFamilySemibold}"
                       FontSize="13"
                       VerticalOptions="Center"
                       AutomationProperties.IsInAccessibleTree="False"
                       TextColor="{AppThemeBinding Light={StaticResource TextBrandLight}, Dark={StaticResource TextBrandDark}}" />
            </HorizontalStackLayout>
        </Grid>

        <Grid Grid.Row="2">
            <feedback:StateView State="{Binding State}"
                                HasContent="{Binding HasContent}"
                                ErrorMessage="{Binding ErrorMessage}"
                                RetryCommand="{Binding RetryCommand}"
                                ErrorTitle="{Binding ExploreErrorTitleText}"
                                EmptyTitle="{Binding ExploreEmptyTitleText}"
                                EmptyMessage="{Binding ExploreEmptyMessageText}"
                                EmptyActionText="{Binding ExploreEmptyActionText}"
                                EmptyActionCommand="{Binding ClearFiltersCommand}">
                <RefreshView IsRefreshing="{Binding IsRefreshing}"
                             Command="{Binding RefreshCommand}">
                    <CollectionView ItemsSource="{Binding Rooms}"
                                    SelectionMode="None"
                                    MaximumWidthRequest="640"
                                    RemainingItemsThreshold="5"
                                    RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="14" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.Header>
                            <Grid HeightRequest="8" />
                        </CollectionView.Header>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="cardmodels:RoomCardDisplayModel">
                                <cards:RoomCardView Margin="16,0"
                                                    Room="{Binding}"
                                                    DetailsCommand="{Binding Source={RelativeSource AncestorType={x:Type vm:MainLandingPageModel}}, Path=OpenRoomCommand, x:DataType=vm:MainLandingPageModel}" />
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.Footer>
                            <VerticalStackLayout Padding="16,14" Spacing="10">
                                <ActivityIndicator IsVisible="{Binding IsLoadingMore}"
                                                   IsRunning="{Binding IsLoadingMore}"
                                                   Color="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionAccentDark}}" />
                                <VerticalStackLayout IsVisible="{Binding IsLoadMoreFailed}" Spacing="8">
                                    <Label Text="{Binding LoadMoreErrorText}"
                                           FontSize="{StaticResource FontSizeBodyMedium}"
                                           HorizontalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondaryLight}, Dark={StaticResource TextSecondaryDark}}" />
                                    <common:RadaButton Text="{Binding RetryText}"
                                                       Variant="Primary"
                                                       ButtonHeight="48"
                                                       HorizontalOptions="Center"
                                                       Command="{Binding RetryLoadMoreCommand}" />
                                </VerticalStackLayout>
                                <!-- Keeps the last card clear of the floating compare tray -->
                                <Grid IsVisible="{Binding HasCompareSelection}"
                                      HeightRequest="60" />
                            </VerticalStackLayout>
                        </CollectionView.Footer>
                    </CollectionView>
                </RefreshView>
            </feedback:StateView>

            <!-- Compare tray (US10): shown once rooms can be picked for comparison -->
            <Border IsVisible="{Binding HasCompareSelection}"
                    Margin="16,0,16,12"
                    HeightRequest="52"
                    Padding="16,0"
                    VerticalOptions="End"
                    MaximumWidthRequest="608"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 14"
                    BackgroundColor="{AppThemeBinding Light={StaticResource ActionPrimaryLight}, Dark={StaticResource ActionPrimaryDark}}"
                    SemanticProperties.Description="{Binding CompareNowText}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding OpenCompareCommand}" />
                </Border.GestureRecognizers>
                <Grid ColumnDefinitions="Auto, Auto, *, Auto, Auto" ColumnSpacing="6">
                    <Label Text="{x:Static fonts:FluentUI.column_double_compare_20_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="18"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           TextColor="{StaticResource ActionAccentDark}" />
                    <Label Grid.Column="1"
                           Text="{Binding CompareCountText}"
                           FontSize="14"
                           VerticalOptions="Center"
                           TextColor="{AppThemeBinding Light={StaticResource TextInverseLight}, Dark={StaticResource TextInverseDark}}" />
                    <Label Grid.Column="3"
                           Text="{Binding CompareNowText}"
                           FontFamily="{StaticResource FontFamilySemibold}"
                           FontSize="14"
                           FontAttributes="Bold"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           TextColor="{AppThemeBinding Light={StaticResource TextInverseLight}, Dark={StaticResource TextInverseDark}}" />
                    <Label Grid.Column="4"
                           Text="{x:Static fonts:FluentUI.chevron_right_16_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="16"
                           VerticalOptions="Center"
                           AutomationProperties.IsInAccessibleTree="False"
                           TextColor="{AppThemeBinding Light={StaticResource TextInverseLight}, Dark={StaticResource TextInverseDark}}" />
                </Grid>
            </Border>
        </Grid>

        <!-- Bottom Navigation Bar -->
        <nav:BottomNavBarControl Grid.Row="3"
                                 ActiveRoute="explore" />
    </Grid>
</ContentPage>
