<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RoomToRentRadar.Features.Home.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:RoomToRentRadar.Features.Home.ViewModels"
    x:DataType="vm:HomeViewModel"
    Title="{Binding Title}">

    <VerticalStackLayout
        Padding="{StaticResource LayoutPadding}"
        Spacing="{StaticResource LayoutSpacing}"
        VerticalOptions="Center"
        HorizontalOptions="Center">

        <Label
            Text="{Binding Title}"
            Style="{StaticResource Title1}"
            HorizontalTextAlignment="Center" />

        <Label
            Text="{Binding Subtitle}"
            Style="{StaticResource Body1}"
            HorizontalTextAlignment="Center" />

        <Button
            Text="Go to Sign In / Sign Up"
            Command="{Binding NavigateToAuthCommand}"
            BackgroundColor="{StaticResource Primary}"
            TextColor="{StaticResource White}"
            CornerRadius="12"
            FontFamily="OpenSansSemibold"
            HeightRequest="48"
            Margin="0,16,0,0" />

    </VerticalStackLayout>
</ContentPage>
