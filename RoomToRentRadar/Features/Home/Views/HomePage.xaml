<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.Features.Home.ViewModels"
             x:Class="RoomToRentRadar.Features.Home.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="room radar"
             SafeAreaEdges="All">

    <ContentPage.Resources>
        <ResourceDictionary>
            <Style x:Key="FilterToggleButton" TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BackgroundColor" Value="{StaticResource AccentSoft}" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="BackgroundColor" Value="{StaticResource SoftSurface}" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                <Setter Property="CornerRadius" Value="16" />
                <Setter Property="Padding" Value="16,10" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <Style x:Key="LinkButton" TargetType="Button">
                <Setter Property="FontFamily" Value="OpenSansSemibold" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor" Value="{StaticResource Accent}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="HorizontalOptions" Value="Start" />
            </Style>
            <Style x:Key="FilterEntry" TargetType="Entry">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="TextColor" Value="{StaticResource Ink}" />
                <Setter Property="PlaceholderColor" Value="{StaticResource Muted}" />
                <Setter Property="BackgroundColor" Value="{StaticResource SoftSurface}" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>
            <DataTemplate x:Key="FilterChipTemplate" x:DataType="viewModels:FilterChip">
                <Border Margin="0,0,8,8" Padding="14,10" MinimumHeightRequest="44" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{StaticResource SoftSurface}" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding SelectCommand}" />
                    </Border.GestureRecognizers>
                    <Border.Triggers>
                        <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                            <Setter Property="BackgroundColor" Value="{StaticResource Accent}" />
                            <Setter Property="Stroke" Value="{StaticResource Accent}" />
                        </DataTrigger>
                    </Border.Triggers>
                    <Label Text="{Binding Label}" FontSize="12">
                        <Label.Triggers>
                            <DataTrigger TargetType="Label" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="TextColor" Value="White" />
                            </DataTrigger>
                        </Label.Triggers>
                    </Label>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ActiveFilterChipTemplate" x:DataType="viewModels:FilterSummaryChip">
                <Border Margin="0,0,6,4" Padding="10,6" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                        BackgroundColor="{StaticResource AccentSoft}">
                    <Label Text="{Binding Label}" FontSize="11" TextColor="{StaticResource Accent}" />
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,Auto,*,Auto">
        <Border StrokeShape="Rectangle" StrokeThickness="0" BackgroundColor="{StaticResource Canvas}">
            <Grid x:Name="TopBar" Padding="20,16" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  MaximumWidthRequest="1360" HorizontalOptions="Fill">
                <Border BackgroundColor="{StaticResource AccentSoft}" Padding="8" StrokeThickness="0" StrokeShape="RoundRectangle 16">
                    <Image Source="radar_mark.png" HeightRequest="28" WidthRequest="28" />
                </Border>
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="room radar" FontFamily="OpenSansSemibold" FontSize="22" CharacterSpacing="-0.7" />
                    <Label Text="Tìm chốn riêng, sống thảnh thơi." Style="{StaticResource Caption}" FontSize="11" />
                </VerticalStackLayout>
                <Label x:Name="NavCaption" Grid.Column="2" Text="KHÔNG GIAN NHỎ, CUỘC SỐNG LỚN"
                       Style="{StaticResource Eyebrow}" VerticalOptions="Center" IsVisible="False" />
            </Grid>
        </Border>

        <VerticalStackLayout x:Name="HomeChrome" Grid.Row="1" Padding="20,0,20,10" Spacing="5" MaximumWidthRequest="1280" HorizontalOptions="Fill">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                <Label Text="{Binding ResultsText}" AutomationId="HomeResultCount" FontSize="13" MaxLines="2"
                       VerticalOptions="Center" FontFamily="OpenSansSemibold" />
                <Button Grid.Column="1" Text="Bộ lọc" AutomationId="ToggleFilters" Command="{Binding ToggleFilterPanelCommand}"
                        Style="{StaticResource FilterToggleButton}" />
                <Button Grid.Column="2" Text="Xóa bộ lọc" AutomationId="ClearFilters" Command="{Binding ClearFiltersCommand}"
                        Style="{StaticResource LinkButton}" />
            </Grid>
            <FlexLayout AutomationId="HomeActiveFilters" Wrap="Wrap" Direction="Row" AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding ActiveFilterChips}"
                        BindableLayout.ItemTemplate="{StaticResource ActiveFilterChipTemplate}" />
            <Button Text="Khám phá trên bản đồ  ↗" AutomationId="OpenPolygonMap" Clicked="OnOpenMapClicked"
                    SemanticProperties.Description="Mở bản đồ để vẽ vùng và tìm phòng"
                    Style="{StaticResource SecondaryButton}" />
        </VerticalStackLayout>

        <RefreshView x:Name="ListingRefresh" Grid.Row="2" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     Margin="20,0,2,0" MaximumWidthRequest="1280" HorizontalOptions="Fill">
            <CollectionView x:Name="ListingsView" ItemsSource="{Binding Listings}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedListing, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenSelectedListingCommand}"
                            RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="CardsLayout" Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,8,18,16" Spacing="16">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20" Padding="2,4,0,4">
                            <VerticalStackLayout Spacing="9" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView Color="{StaticResource Accent}" WidthRequest="22" HeightRequest="2" VerticalOptions="Center" />
                                    <Label Text="MỘT NƠI ĐỂ GỌI LÀ NHÀ" Style="{StaticResource Eyebrow}" FontSize="9" TextColor="{StaticResource Accent}" />
                                </HorizontalStackLayout>
                                <Label x:Name="HeroTitle" Text="Chốn riêng,&#10;đúng ý bạn." FontSize="29"
                                       FontFamily="OpenSansSemibold" CharacterSpacing="-0.8" LineHeight="1.04" />
                                <Label Text="Một góc ưng ý, gần trường và vừa túi tiền."
                                       Style="{StaticResource Caption}" FontSize="12" MaxLines="2" />
                            </VerticalStackLayout>
                            <Image x:Name="HeroArt" Grid.Column="1" Source="campus_scene.png"
                                   WidthRequest="220" HeightRequest="150" IsVisible="False" Aspect="AspectFit"
                                   SemanticProperties.Description="Minh họa khuôn viên trường" />
                        </Grid>
                        <!-- Keep the empty state in the scrolling header. MAUI's Windows FormsGridView
                             disables ScrollViewer hit testing when its native EmptyView is visible,
                             which also disables the filter controls hosted in this header. -->
                        <ContentView IsVisible="False" AutomationId="HomeEmptyState">
                            <ContentView.Triggers>
                                <DataTrigger TargetType="ContentView" Binding="{Binding Listings.Count}" Value="0">
                                    <Setter Property="IsVisible" Value="True" />
                                </DataTrigger>
                            </ContentView.Triggers>
                            <VerticalStackLayout Padding="24,32" Spacing="12" HorizontalOptions="Center">
                                <Image Source="location_pin.png" WidthRequest="32" HeightRequest="32" />
                                <Label Text="{Binding EmptyMessage}" AutomationId="HomeEmptyMessage"
                                       HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}" />
                            </VerticalStackLayout>
                        </ContentView>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HomeListingItem">
                        <Border Margin="0,0,18,18" Padding="6" StrokeShape="RoundRectangle 26" StrokeThickness="0">
                            <Border.Shadow>
                                <Shadow Brush="#183B2B" Offset="0,4" Radius="12" Opacity="0.06" />
                            </Border.Shadow>
                            <Grid RowDefinitions="184,Auto">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="0">
                                    <Grid BackgroundColor="{StaticResource SoftSurface}">
                                        <Image Source="{Binding PhotoSource}" Aspect="AspectFill"
                                               SemanticProperties.Description="Ảnh hoặc hình minh họa phòng trọ" />
                                        <Border Margin="12" Padding="10,6" HorizontalOptions="Start" VerticalOptions="Start"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 12" BackgroundColor="#F7FAF3">
                                            <Label Text="ROOM RADAR" FontSize="9" CharacterSpacing="1" FontFamily="OpenSansSemibold"
                                                   TextColor="{StaticResource Accent}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Row="1" Padding="12,14,12,12" Spacing="10">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="PHÒNG CHO THUÊ" Style="{StaticResource Eyebrow}" FontSize="9" CharacterSpacing="0.8" />
                                        <Label Grid.Column="1" Text="{Binding AvailabilityText}" FontSize="10" TextColor="{StaticResource Accent}" />
                                    </Grid>
                                    <Label Text="{Binding Title}" FontSize="17" FontFamily="OpenSansSemibold" HeightRequest="48"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PriceText}" FontSize="24" FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" />
                                                <Span Text="  / tháng" FontSize="11" TextColor="{StaticResource Muted}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,2" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="area_icon.png" HeightRequest="14" WidthRequest="14" />
                                            <Label Text="{Binding AreaText}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </HorizontalStackLayout>
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalOptions="Center">
                                            <Image Source="location_pin.png" HeightRequest="14" WidthRequest="14" />
                                            <Label Grid.Column="1" Text="{Binding Address}" FontSize="11" TextColor="{StaticResource Muted}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                        </Grid>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12,18,32" Spacing="16">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HeightRequest="32" />
                        <Button Text="Xem thêm phòng" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}"
                                HorizontalOptions="Center" />
                        <Label Text="Danh sách được cập nhật từ hệ thống." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <ScrollView x:Name="FilterPanel" Grid.Row="2" IsVisible="{Binding IsFilterPanelOpen}" ZIndex="10" BackgroundColor="{StaticResource Canvas}"
                    AutomationId="FilterPanel" Margin="20,0,20,8">
                            <Border Padding="20" BackgroundColor="{StaticResource Surface}" StrokeShape="RoundRectangle 24" StrokeThickness="0">
                                <VerticalStackLayout Spacing="16">
                                    <Label Text="BỘ LỌC TÌM PHÒNG" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Accent}" />
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Giá thuê (triệu đồng/tháng)" Style="{StaticResource Eyebrow}" />
                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                            <Entry Grid.Column="0" Placeholder="Từ" Text="{Binding PriceMinText}"
                                                   Keyboard="Numeric" Style="{StaticResource FilterEntry}"
                                                   SemanticProperties.Description="Giá thuê tối thiểu, triệu đồng" />
                                            <Label Grid.Column="1" Text="–" VerticalOptions="Center"
                                                   TextColor="{StaticResource Muted}" />
                                            <Entry Grid.Column="2" Placeholder="Đến" Text="{Binding PriceMaxText}"
                                                   Keyboard="Numeric" Style="{StaticResource FilterEntry}"
                                                   SemanticProperties.Description="Giá thuê tối đa, triệu đồng" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Diện tích (m²)" Style="{StaticResource Eyebrow}" />
                                        <Grid ColumnDefinitions="*,Auto,*" ColumnSpacing="10">
                                            <Entry Grid.Column="0" Placeholder="Từ" Text="{Binding AreaMinText}"
                                                   Keyboard="Numeric" Style="{StaticResource FilterEntry}"
                                                   SemanticProperties.Description="Diện tích tối thiểu, mét vuông" />
                                            <Label Grid.Column="1" Text="–" VerticalOptions="Center"
                                                   TextColor="{StaticResource Muted}" />
                                            <Entry Grid.Column="2" Placeholder="Đến" Text="{Binding AreaMaxText}"
                                                   Keyboard="Numeric" Style="{StaticResource FilterEntry}"
                                                   SemanticProperties.Description="Diện tích tối đa, mét vuông" />
                                        </Grid>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Loại phòng" Style="{StaticResource Eyebrow}" />
                                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                                    BindableLayout.ItemsSource="{Binding RoomTypeChips}"
                                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Cách trường" Style="{StaticResource Eyebrow}" />
                                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                                    BindableLayout.ItemsSource="{Binding CampusChips}"
                                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}" />
                                        <FlexLayout Wrap="Wrap" Direction="Row" AlignItems="Center"
                                                    IsEnabled="{Binding IsDistanceEnabled}"
                                                    BindableLayout.ItemsSource="{Binding DistanceChips}"
                                                    BindableLayout.ItemTemplate="{StaticResource FilterChipTemplate}">
                                            <FlexLayout.Triggers>
                                                <DataTrigger TargetType="FlexLayout" Binding="{Binding IsDistanceEnabled}" Value="False">
                                                    <Setter Property="Opacity" Value="0.45" />
                                                </DataTrigger>
                                            </FlexLayout.Triggers>
                                        </FlexLayout>
                                        <Label Text="Khoảng cách áp dụng sau khi chọn trường." Style="{StaticResource Caption}" FontSize="10" />
                                    </VerticalStackLayout>
                                    <Label Text="{Binding FilterError}" IsVisible="{Binding HasFilterError}" FontSize="12"
                                           TextColor="#B3261E" />
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                        <Button Text="Áp dụng" Command="{Binding ApplyFiltersCommand}"
                                                SemanticProperties.Description="Áp dụng bộ lọc và cập nhật kết quả" />
                                        <Button Grid.Column="1" Text="Xóa bộ lọc" Command="{Binding ClearFiltersCommand}"
                                                Style="{StaticResource SecondaryButton}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
        </ScrollView>

        <Border Grid.Row="3" IsVisible="{Binding HasError}" Margin="20,8" Padding="16">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}" HorizontalTextAlignment="Center" />
                <Button Text="Thử lại" Command="{Binding RetryCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
