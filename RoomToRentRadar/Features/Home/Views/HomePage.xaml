<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RoomToRentRadar.Features.Home.Views.HomePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:loc="clr-namespace:RoomToRentRadar.Core.Localization"
    xmlns:vm="clr-namespace:RoomToRentRadar.Features.Home.ViewModels"
    Title="{Binding Title}"
    x:DataType="vm:HomeViewModel"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid
        HorizontalOptions="Fill"
        MaximumWidthRequest="1160"
        RowDefinitions="Auto,*"
        RowSpacing="0">

        <!-- Header Row: Button Menu (☰) + Title & Location + Actions (Bell & Profile) -->
        <Grid
            Grid.Row="0"
            Padding="{OnIdiom Phone='16,12,16,12', Tablet='24,16,24,16', Desktop='32,16,32,16'}"
            HorizontalOptions="Fill">
            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                <!-- Button Menu (Hamburger 44x44px) -->
                <Border
                    Grid.Column="0"
                    Padding="0"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    HeightRequest="44"
                    MinimumHeightRequest="44"
                    MinimumWidthRequest="44"
                    SemanticProperties.Description="{loc:Translate Menu_Open}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 14"
                    StrokeThickness="1"
                    VerticalOptions="Center"
                    WidthRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenMenuCommand}" />
                    </Border.GestureRecognizers>
                    <Label
                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                        FontSize="22"
                        HorizontalOptions="Center"
                        Text="{x:Static f:FluentUI.navigation_24_regular}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                        VerticalOptions="Center" />
                </Border>

                <!-- Title and Location in Center -->
                <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="13"
                            Text="{x:Static f:FluentUI.location_16_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            VerticalOptions="Center" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="12"
                            Text="{loc:Translate Campus_Location}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Label
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        FontSize="20"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding Title}"
                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                </VerticalStackLayout>

                <!-- Header Actions: Notification & Profile (44x44 Touch Targets) -->
                <HorizontalStackLayout Grid.Column="2" Spacing="8" VerticalOptions="Center">
                    <!-- Notification Action Button -->
                    <Border
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        HeightRequest="44"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        SemanticProperties.Description="{loc:Translate Notification_Title}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenNotificationsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid>
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{x:Static f:FluentUI.alert_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />
                            <!-- Subtle Unread Dot -->
                            <Border
                                Margin="0,9,10,0"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentHighlight}, Dark={StaticResource AccentHighlightDark}}"
                                HeightRequest="8"
                                HorizontalOptions="End"
                                Stroke="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                StrokeShape="RoundRectangle 4"
                                StrokeThickness="1.5"
                                VerticalOptions="Start"
                                WidthRequest="8" />
                        </Grid>
                    </Border>

                    <!-- Profile Action Button -->
                    <Border
                        Padding="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                        HeightRequest="44"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        SemanticProperties.Description="{loc:Translate Profile_Title}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 14"
                        StrokeThickness="1"
                        VerticalOptions="Center"
                        WidthRequest="44">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{x:Static f:FluentUI.person_20_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            VerticalOptions="Center" />
                    </Border>
                </HorizontalStackLayout>
            </Grid>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout
                Padding="{OnIdiom Phone='16,8,16,24', Tablet='24,12,24,28', Desktop='32,16,32,32'}"
                HorizontalOptions="Fill"
                MaximumWidthRequest="1080"
                Spacing="24">

            <!-- Hero Banner -->
            <Border
                Padding="{OnIdiom Phone='20,24', Tablet='32,32', Desktop='36,36'}"
                Background="{StaticResource PrimaryBrandGradient}"
                StrokeShape="RoundRectangle 22"
                StrokeThickness="0">
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource PrimaryBrand}"
                        Offset="0,10"
                        Opacity="0.18"
                        Radius="24" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="18">
                    <!-- Brand Pill and Auth CTA Header -->
                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                        <!-- Brand Pill -->
                        <Border
                            Grid.Column="0"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            HorizontalOptions="Start"
                            StrokeShape="RoundRectangle 20"
                            StrokeThickness="0">
                            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                <Border
                                    BackgroundColor="{StaticResource AccentHighlight}"
                                    HeightRequest="8"
                                    Stroke="{StaticResource White}"
                                    StrokeShape="RoundRectangle 4"
                                    StrokeThickness="1.5"
                                    VerticalOptions="Center"
                                    WidthRequest="8" />
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="12"
                                    Text="{loc:Translate Home_BannerPill}"
                                    TextColor="{StaticResource White}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Go to Sign In / Sign Up Button -->
                        <Button
                            Grid.Column="1"
                            Text="Go to Sign In / Sign Up"
                            Command="{Binding NavigateToAuthCommand}"
                            IsVisible="{Binding IsNotAuthenticated}"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            TextColor="{StaticResource White}"
                            CornerRadius="20"
                            FontSize="12"
                            FontFamily="OpenSansSemibold"
                            HeightRequest="36"
                            Padding="14,4"
                            VerticalOptions="Center" />
                    </Grid>

                    <!-- Welcome Heading -->
                    <Label
                        FontAttributes="Bold"
                        FontSize="{OnIdiom Phone=24, Tablet=30, Desktop=32}"
                        LineHeight="1.2"
                        Text="{Binding Subtitle}"
                        TextColor="{StaticResource White}" />

                    <Label
                        FontSize="15"
                        LineHeight="1.45"
                        MaximumWidthRequest="720"
                        HorizontalOptions="Start"
                        Text="{loc:Translate Home_IntroDesc}"
                        TextColor="{StaticResource HeroSubtitleLight}" />

                    <!-- Interactive Search Bar + Primary CTA -->
                    <Border
                        Margin="0,4,0,0"
                        Padding="12,8,8,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0">
                        <Grid
                            ColumnDefinitions="Auto,*,Auto"
                            ColumnSpacing="10"
                            VerticalOptions="Center">
                            <Label
                                Grid.Column="0"
                                Margin="4,0,0,0"
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="20"
                                Text="{x:Static f:FluentUI.search_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />

                            <Entry
                                Grid.Column="1"
                                StyleId="BorderlessEntry"
                                BackgroundColor="Transparent"
                                ClearButtonVisibility="WhileEditing"
                                FontSize="14"
                                Placeholder="{loc:Translate Home_SearchPlaceholder}"
                                PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                ReturnCommand="{Binding SearchFromHomeCommand}"
                                ReturnType="Search"
                                Text="{Binding QuickSearchText}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />

                            <Border
                                Grid.Column="2"
                                Padding="16,11"
                                Background="{StaticResource AccentHighlightGradient}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Border.Shadow>
                                    <Shadow
                                        Brush="{StaticResource AccentHighlight}"
                                        Offset="0,4"
                                        Opacity="0.28"
                                        Radius="10" />
                                </Border.Shadow>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Command="{Binding SearchFromHomeCommand}" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{loc:Translate Home_CtaButton}"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="18"
                                        Text="{x:Static f:FluentUI.arrow_forward_20_regular}"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Quick Popular Filter Chips inside Hero -->
                    <FlexLayout
                        AlignItems="Center"
                        Direction="Row"
                        Wrap="Wrap">
                        <Label
                            Margin="0,4,10,4"
                            FontAttributes="Bold"
                            FontSize="12"
                            Text="{loc:Translate Home_PopularTags}"
                            TextColor="{StaticResource HeroSubtitleLight}"
                            VerticalOptions="Center" />

                        <Border
                            Margin="0,4,8,4"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding QuickFilterCommand}"
                                    CommandParameter="Điều hòa" />
                            </Border.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{loc:Translate Home_Tag_AirConditioner}"
                                TextColor="{StaticResource White}" />
                        </Border>

                        <Border
                            Margin="0,4,8,4"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding QuickFilterCommand}"
                                    CommandParameter="Khép kín" />
                            </Border.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{loc:Translate Home_Tag_PrivateBathroom}"
                                TextColor="{StaticResource White}" />
                        </Border>

                        <Border
                            Margin="0,4,8,4"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding QuickFilterCommand}"
                                    CommandParameter="Gác xép" />
                            </Border.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{loc:Translate Home_Tag_Mezzanine}"
                                TextColor="{StaticResource White}" />
                        </Border>

                        <Border
                            Margin="0,4,8,4"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding QuickFilterCommand}"
                                    CommandParameter="Z115" />
                            </Border.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{loc:Translate Home_Tag_StreetZ115}"
                                TextColor="{StaticResource White}" />
                        </Border>

                        <Border
                            Margin="0,4,8,4"
                            Padding="12,6"
                            BackgroundColor="{StaticResource HeroOverlayGlass}"
                            StrokeShape="RoundRectangle 16"
                            StrokeThickness="0">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding QuickFilterCommand}"
                                    CommandParameter="Nóng lạnh" />
                            </Border.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                FontSize="12"
                                Text="{loc:Translate Home_Tag_WaterHeater}"
                                TextColor="{StaticResource White}" />
                        </Border>
                    </FlexLayout>
                </VerticalStackLayout>
            </Border>

            <!-- Quick Stats Grid -->
            <Grid
                ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*,*', Desktop='*,*,*'}"
                ColumnSpacing="14"
                RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                RowSpacing="14">

                <!-- Stat 1: Verified Rooms -->
                <Border
                    Grid.Row="0"
                    Grid.Column="0"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource Black}"
                            Offset="0,4"
                            Opacity="0.05"
                            Radius="12" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExploreRoomsCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="22"
                                Text="{x:Static f:FluentUI.shield_checkmark_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{loc:Translate Home_Stat_VerifiedTitle}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13"
                                Text="{loc:Translate Home_Stat_VerifiedDesc}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Stat 2: Near Campus -->
                <Border
                    Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource Black}"
                            Offset="0,4"
                            Opacity="0.05"
                            Radius="12" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExploreRoomsCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentTealSoft}, Dark={StaticResource AccentTealSoftDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="22"
                                Text="{x:Static f:FluentUI.location_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource AccentTeal}, Dark={StaticResource AccentTealDark}}" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{loc:Translate Home_Stat_NearCampusTitle}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13"
                                Text="{loc:Translate Home_Stat_NearCampusDesc}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>

                <!-- Stat 3: Student Price -->
                <Border
                    Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                    Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                    Padding="18"
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 16"
                    StrokeThickness="1">
                    <Border.Shadow>
                        <Shadow
                            Brush="{StaticResource Black}"
                            Offset="0,4"
                            Opacity="0.05"
                            Radius="12" />
                    </Border.Shadow>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ExploreRoomsCommand}" />
                    </Border.GestureRecognizers>

                    <HorizontalStackLayout Spacing="14" VerticalOptions="Center">
                        <Border
                            Padding="12"
                            BackgroundColor="{AppThemeBinding Light={StaticResource AccentHighlightSoft}, Dark={StaticResource AccentHighlightSoftDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="22"
                                Text="{x:Static f:FluentUI.money_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource AccentHighlight}, Dark={StaticResource AccentHighlightDark}}" />
                        </Border>
                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontSize="20"
                                Text="{loc:Translate Home_Stat_PriceTitle}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13"
                                Text="{loc:Translate Home_Stat_PriceDesc}"
                                TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </Border>
            </Grid>

            <!-- Modern Feature Guide Section -->
            <Border
                Padding="22"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 18"
                StrokeThickness="1">
                <Border.Shadow>
                    <Shadow
                        Brush="{StaticResource Black}"
                        Offset="0,4"
                        Opacity="0.04"
                        Radius="12" />
                </Border.Shadow>

                <VerticalStackLayout Spacing="16">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label
                                FontAttributes="Bold"
                                FontSize="18"
                                Text="{loc:Translate Home_Guide_Title}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <Label
                                FontSize="13"
                                Text="{loc:Translate Home_Guide_Subtitle}"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                        </VerticalStackLayout>

                        <Border
                            Grid.Column="1"
                            Padding="12,8"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ExploreRoomsCommand}" />
                            </Border.GestureRecognizers>
                            <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontSize="13"
                                    Text="{loc:Translate Home_Guide_ViewAll}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="15"
                                    Text="{x:Static f:FluentUI.chevron_right_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </Grid>

                    <Grid
                        ColumnDefinitions="{OnIdiom Phone='*', Tablet='*,*,*', Desktop='*,*,*'}"
                        ColumnSpacing="14"
                        RowDefinitions="{OnIdiom Phone='Auto,Auto,Auto', Tablet='Auto', Desktop='Auto'}"
                        RowSpacing="12">

                        <!-- Step 1 -->
                        <Border
                            Grid.Row="0"
                            Grid.Column="0"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="18"
                                        Text="{x:Static f:FluentUI.filter_20_regular}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{loc:Translate Home_Step1_Title}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="12.5"
                                    LineHeight="1.35"
                                    Text="{loc:Translate Home_Step1_Desc}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Step 2 -->
                        <Border
                            Grid.Row="{OnIdiom Phone=1, Tablet=0, Desktop=0}"
                            Grid.Column="{OnIdiom Phone=0, Tablet=1, Desktop=1}"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="18"
                                        Text="{x:Static f:FluentUI.checkmark_circle_20_regular}"
                                        TextColor="{AppThemeBinding Light={StaticResource AccentTeal}, Dark={StaticResource AccentTealDark}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{loc:Translate Home_Step2_Title}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="12.5"
                                    LineHeight="1.35"
                                    Text="{loc:Translate Home_Step2_Desc}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- Step 3 -->
                        <Border
                            Grid.Row="{OnIdiom Phone=2, Tablet=0, Desktop=0}"
                            Grid.Column="{OnIdiom Phone=0, Tablet=2, Desktop=2}"
                            Padding="14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 14"
                            StrokeThickness="1">
                            <VerticalStackLayout Spacing="8">
                                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="18"
                                        Text="{x:Static f:FluentUI.flash_20_regular}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                        VerticalOptions="Center" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="14"
                                        Text="{loc:Translate Home_Step3_Title}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label
                                    FontSize="12.5"
                                    LineHeight="1.35"
                                    Text="{loc:Translate Home_Step3_Desc}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </VerticalStackLayout>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
    </Grid>
</ContentPage>
