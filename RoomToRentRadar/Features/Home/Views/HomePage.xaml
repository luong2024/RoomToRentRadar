<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.Features.Home.ViewModels"
             x:Class="RoomToRentRadar.Features.Home.Views.HomePage"
             x:DataType="viewModels:HomeViewModel"
             Title="room radar"
             SafeAreaEdges="All">

    <Grid RowDefinitions="Auto,*,Auto">
        <Border StrokeShape="Rectangle" StrokeThickness="0" BackgroundColor="{StaticResource Surface}">
            <Grid x:Name="TopBar" Padding="20,18" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12"
                  MaximumWidthRequest="1360" HorizontalOptions="Fill">
                <Image Source="radar_mark.png" HeightRequest="34" WidthRequest="34" />
                <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="0">
                    <Label Text="room radar" FontFamily="OpenSansSemibold" FontSize="21" CharacterSpacing="-0.5" />
                    <Label Text="Một nơi ở. Một khởi đầu mới." Style="{StaticResource Caption}" FontSize="10" />
                </VerticalStackLayout>
                <Label x:Name="NavCaption" Grid.Column="2" Text="KHÔNG GIAN NHỎ, CUỘC SỐNG LỚN"
                       Style="{StaticResource Eyebrow}" VerticalOptions="Center" IsVisible="False" />
            </Grid>
        </Border>

        <RefreshView x:Name="ListingRefresh" Grid.Row="1" IsRefreshing="{Binding IsRefreshing}" Command="{Binding RefreshCommand}"
                     Margin="20,0,2,0" MaximumWidthRequest="1280" HorizontalOptions="Fill">
            <CollectionView x:Name="ListingsView" ItemsSource="{Binding Listings}"
                            SelectionMode="Single"
                            SelectedItem="{Binding SelectedListing, Mode=TwoWay}"
                            SelectionChangedCommand="{Binding OpenSelectedListingCommand}"
                            RemainingItemsThreshold="5" RemainingItemsThresholdReachedCommand="{Binding LoadMoreCommand}">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout x:Name="CardsLayout" Orientation="Vertical" Span="1" />
                </CollectionView.ItemsLayout>
                <CollectionView.Header>
                    <VerticalStackLayout Padding="0,20,18,20" Spacing="20">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="28" Padding="0,6,0,4">
                            <VerticalStackLayout Spacing="12" VerticalOptions="Center">
                                <HorizontalStackLayout Spacing="8">
                                    <BoxView Color="{StaticResource Accent}" WidthRequest="22" HeightRequest="2" VerticalOptions="Center" />
                                    <Label Text="TÌM PHÒNG GẦN TRƯỜNG" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Accent}" />
                                </HorizontalStackLayout>
                                <Label x:Name="HeroTitle" Text="Gần trường hơn.&#10;Thảnh thơi hơn." FontSize="30"
                                       FontFamily="OpenSansSemibold" CharacterSpacing="-0.5" />
                                <Label Text="Tìm một góc riêng ưng ý, để mỗi ngày đi học nhẹ nhàng hơn."
                                       Style="{StaticResource Caption}" FontSize="13" MaxLines="2" />
                            </VerticalStackLayout>
                            <Image x:Name="HeroArt" Grid.Column="1" Source="campus_scene.png"
                                   WidthRequest="220" HeightRequest="150" IsVisible="False" Aspect="AspectFit"
                                   SemanticProperties.Description="Minh họa khuôn viên trường" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="5">
                                <Label Text="Phòng dành cho bạn" FontSize="22" FontFamily="OpenSansSemibold" CharacterSpacing="-0.5" />
                                <Label Text="{Binding ResultsText}" Style="{StaticResource Caption}" FontSize="11" />
                            </VerticalStackLayout>
                            <Label Grid.Column="1" Text="Mới nhất trước" FontSize="11" TextColor="{StaticResource Muted}"
                                   VerticalOptions="Center" />
                        </Grid>
                    </VerticalStackLayout>
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:HomeListingItem">
                        <Border Margin="0,0,18,22" Padding="8" StrokeShape="RoundRectangle 18">
                            <Grid RowDefinitions="174,Auto">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 12" Padding="0">
                                    <Grid BackgroundColor="{StaticResource SoftSurface}">
                                        <Image Source="{Binding Illustration}" Aspect="AspectFill"
                                               SemanticProperties.Description="Hình minh họa phòng mẫu" />
                                        <Border Margin="10" Padding="7,3" HorizontalOptions="End" VerticalOptions="End"
                                                StrokeThickness="0" StrokeShape="RoundRectangle 5" BackgroundColor="#F8F9F3">
                                            <Label Text="Ảnh minh họa" FontSize="9" TextColor="{StaticResource Muted}" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <VerticalStackLayout Grid.Row="1" Padding="10,16,10,10" Spacing="12">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="PHÒNG CHO THUÊ" Style="{StaticResource Eyebrow}" FontSize="9" CharacterSpacing="1" />
                                        <Label Grid.Column="1" Text="{Binding AvailabilityText}" FontSize="10" TextColor="{StaticResource Accent}" />
                                    </Grid>
                                    <Label Text="{Binding Title}" FontSize="16" FontFamily="OpenSansSemibold" HeightRequest="46"
                                           LineBreakMode="TailTruncation" MaxLines="2" />
                                    <Label>
                                        <Label.FormattedText>
                                            <FormattedString>
                                                <Span Text="{Binding PriceText}" FontSize="23" FontFamily="OpenSansSemibold" TextColor="{StaticResource Ink}" />
                                                <Span Text="  / tháng" FontSize="11" TextColor="{StaticResource Muted}" />
                                            </FormattedString>
                                        </Label.FormattedText>
                                    </Label>
                                    <BoxView HeightRequest="1" Color="{StaticResource Line}" Margin="0,2" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                                            <Image Source="area_icon.png" HeightRequest="14" WidthRequest="14" />
                                            <Label Text="{Binding AreaText}" FontSize="11" TextColor="{StaticResource Muted}" />
                                        </HorizontalStackLayout>
                                        <Grid Grid.Column="1" ColumnDefinitions="Auto,*" ColumnSpacing="5" VerticalOptions="Center">
                                            <Image Source="location_pin.png" HeightRequest="14" WidthRequest="14" />
                                            <Label Grid.Column="1" Text="{Binding Address}" FontSize="11" TextColor="{StaticResource Muted}"
                                                   LineBreakMode="TailTruncation" MaxLines="1" />
                                        </Grid>
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <VerticalStackLayout Padding="24,32" Spacing="12" HorizontalOptions="Center">
                        <Image Source="location_pin.png" WidthRequest="32" HeightRequest="32" />
                        <Label Text="{Binding EmptyMessage}" HorizontalTextAlignment="Center" TextColor="{StaticResource Muted}" />
                    </VerticalStackLayout>
                </CollectionView.EmptyView>
                <CollectionView.Footer>
                    <VerticalStackLayout Padding="0,12,18,32" Spacing="16">
                        <ActivityIndicator IsRunning="{Binding IsLoadingMore}" IsVisible="{Binding IsLoadingMore}" HeightRequest="32" />
                        <Button Text="Xem thêm phòng" Command="{Binding LoadMoreCommand}" IsVisible="{Binding CanLoadMore}"
                                HorizontalOptions="Center" />
                        <Label Text="Danh sách được cập nhật từ hệ thống." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </CollectionView.Footer>
            </CollectionView>
        </RefreshView>

        <Border Grid.Row="2" IsVisible="{Binding HasError}" Margin="20,8" Padding="16">
            <VerticalStackLayout Spacing="8">
                <Label Text="{Binding ErrorMessage}" HorizontalTextAlignment="Center" />
                <Button Text="Thử lại" Command="{Binding RetryCommand}" HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
