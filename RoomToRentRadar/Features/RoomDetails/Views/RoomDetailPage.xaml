<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.Features.RoomDetails.ViewModels"
             xmlns:models="clr-namespace:RoomToRentRadar.Features.RoomDetails.Models"
             x:Class="RoomToRentRadar.Features.RoomDetails.Views.RoomDetailPage"
             x:DataType="vm:RoomDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light=#FAFAFC, Dark=#121214}">

    <Grid RowDefinitions="Auto, *, Auto" HorizontalOptions="Fill" VerticalOptions="Fill">

        <!-- 1. Header with subtle purple tint -->
        <Border Grid.Row="0" StrokeThickness="0" BackgroundColor="{AppThemeBinding Light=#EDE7F6, Dark=#1E1A29}" Padding="20, 14">
            <Grid ColumnDefinitions="40, *, 40" VerticalOptions="Center">
                <Border Grid.Column="0" WidthRequest="38" HeightRequest="38" StrokeShape="RoundRectangle 19"
                        BackgroundColor="{AppThemeBinding Light=White, Dark=#2D283E}" StrokeThickness="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="‹" FontSize="26" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,0,0"
                           TextColor="{AppThemeBinding Light=#1F2937, Dark=White}" FontAttributes="Bold"/>
                </Border>

                <Label Grid.Column="1" Text="Property Details" 
                       FontSize="18" FontAttributes="Bold" HorizontalOptions="Center" VerticalOptions="Center"
                       TextColor="{AppThemeBinding Light=#1F2937, Dark=White}"/>
            </Grid>
        </Border>

        <!-- 2. Main Scrollable Content -->
        <ScrollView Grid.Row="1" HorizontalOptions="Fill">
            <VerticalStackLayout Padding="20, 16" Spacing="18" HorizontalOptions="Fill">

                <!-- 2.1 Hero Image with Image Count Badge -->
                <Grid HeightRequest="280" HorizontalOptions="Fill">
                    <Border StrokeShape="RoundRectangle 20" StrokeThickness="0" HorizontalOptions="Fill" VerticalOptions="Fill">
                        <CarouselView ItemsSource="{Binding Room.ImageUrls}" Loop="True" HorizontalOptions="Fill" VerticalOptions="Fill">
                            <CarouselView.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Image Source="{Binding .}" Aspect="AspectFill" HorizontalOptions="Fill" VerticalOptions="Fill" />
                                </DataTemplate>
                            </CarouselView.ItemTemplate>
                        </CarouselView>
                    </Border>

                    <!-- '📷 1/3' Badge -->
                    <Border HorizontalOptions="Start" VerticalOptions="End" Margin="16"
                            Padding="12, 6" StrokeShape="RoundRectangle 12" BackgroundColor="#A0000000" StrokeThickness="0">
                        <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                            <Label Text="📷" FontSize="12" TextColor="White"/>
                            <Label Text="1/3" TextColor="White" FontSize="12" FontAttributes="Bold"/>
                        </HorizontalStackLayout>
                    </Border>
                </Grid>

                <!-- 2.2 Status Alert Banner (AC2, AC3) -->
                <Border IsVisible="{Binding IsRented}" StrokeShape="RoundRectangle 14" BackgroundColor="#FFFBEB" Stroke="#FCD34D" StrokeThickness="1" Padding="14">
                    <Label Text="⚠️ This property has been rented out. View similar properties below." TextColor="#92400E" FontSize="13" FontAttributes="Bold"/>
                </Border>

                <Border IsVisible="{Binding IsUnavailable}" StrokeShape="RoundRectangle 14" BackgroundColor="#FEF2F2" Stroke="#FCA5A5" StrokeThickness="1" Padding="14">
                    <Label Text="🚫 This listing is no longer available!" TextColor="#991B1B" FontSize="13" FontAttributes="Bold"/>
                </Border>

                <!-- 2.3 Title, Price, Location & Rating -->
                <VerticalStackLayout Spacing="8" HorizontalOptions="Fill">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Start">
                        <Label Grid.Column="0" Text="{Binding Room.Title}" FontSize="22" FontAttributes="Bold" 
                               TextColor="{AppThemeBinding Light=#111827, Dark=White}" LineBreakMode="WordWrap"/>

                        <HorizontalStackLayout Grid.Column="1" VerticalOptions="Start" Spacing="2">
                            <Label Text="₦450,000" FontSize="20" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Text=" /Year" FontSize="13" TextColor="#6B7280" VerticalOptions="End" Margin="0, 0, 0, 2"/>
                        </HorizontalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="Auto, *, Auto" VerticalOptions="Center" ColumnSpacing="8">
                        <Label Text="📍" FontSize="14" TextColor="#6B7280" VerticalOptions="Center"/>
                        <Label Grid.Column="1" Text="{Binding Room.Address}" FontSize="13" TextColor="#6B7280" LineBreakMode="TailTruncation"/>

                        <!-- Gold Star Rating -->
                        <HorizontalStackLayout Grid.Column="2" Spacing="4" VerticalOptions="Center">
                            <Label Text="★" TextColor="#F59E0B" FontSize="15" VerticalOptions="Center"/>
                            <Label Text="4.95 / 22 reviews" FontSize="13" TextColor="#6B7280" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Grid>
                </VerticalStackLayout>

                <!-- 2.4 FOUR QUICK STATS CARDS MATCHING DRIBBLE -->
                <Grid ColumnDefinitions="*, *, *, *" ColumnSpacing="10" HorizontalOptions="Fill">
                    <!-- Sitting rooms -->
                    <Border Grid.Column="0" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="8, 12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="🛋️" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Sitting rooms" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" LineBreakMode="NoWrap"/>
                            <Label Text="{Binding Room.SittingRooms}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bedrooms -->
                    <Border Grid.Column="1" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="8, 12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="🛏️" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Bedrooms" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" LineBreakMode="NoWrap"/>
                            <Label Text="{Binding Room.Bedrooms}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Bathrooms -->
                    <Border Grid.Column="2" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="8, 12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="🚿" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Bathrooms" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" LineBreakMode="NoWrap"/>
                            <Label Text="{Binding Room.Bathrooms}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Kitchens -->
                    <Border Grid.Column="3" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                            Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="8, 12">
                        <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                            <Label Text="🍳" FontSize="18" HorizontalOptions="Center"/>
                            <Label Text="Kitchens" FontSize="11" TextColor="#6B7280" HorizontalOptions="Center" LineBreakMode="NoWrap"/>
                            <Label Text="{Binding Room.Kitchens}" FontSize="14" FontAttributes="Bold" HorizontalOptions="Center" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        </VerticalStackLayout>
                    </Border>
                </Grid>

                <!-- 2.5 Description -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                        Stroke="{AppThemeBinding Light=#F3F4F6, Dark=#2E2E38}" StrokeThickness="1" Padding="18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Description" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <Label Text="{Binding Room.Description}" FontSize="13" TextColor="#4B5563" LineBreakMode="WordWrap" LineHeight="1.4"/>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.6 Amenities (2 Columns) -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                        Stroke="{AppThemeBinding Light=#F3F4F6, Dark=#2E2E38}" StrokeThickness="1" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Amenities" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <CollectionView ItemsSource="{Binding Room.Amenities}">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="2" VerticalItemSpacing="14" HorizontalItemSpacing="14"/>
                            </CollectionView.ItemsLayout>
                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RoomAmenityModel">
                                    <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                                        <Label Text="{Binding IconGlyph}" FontSize="16" VerticalOptions="Center"/>
                                        <Label Text="{Binding Name}" FontSize="13" TextColor="#4B5563" VerticalOptions="Center"/>
                                    </HorizontalStackLayout>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.7 Agent Information with AC4 Auth Check -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                        Stroke="{AppThemeBinding Light=#F3F4F6, Dark=#2E2E38}" StrokeThickness="1" Padding="18">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="Agent Information" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>

                        <Grid ColumnDefinitions="52, *, Auto" ColumnSpacing="14" VerticalOptions="Center">
                            <!-- Circular Avatar -->
                            <Border Grid.Column="0" WidthRequest="52" HeightRequest="52" StrokeShape="RoundRectangle 26" StrokeThickness="0">
                                <Image Source="{Binding Room.LandlordAvatar}" Aspect="AspectFill"/>
                            </Border>

                            <!-- Name & Contacts -->
                            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                                <HorizontalStackLayout Spacing="6">
                                    <Label Text="{Binding Room.LandlordName}" FontSize="15" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                                    <Label Text="★ 4.95" FontSize="12" TextColor="#F59E0B" VerticalOptions="Center"/>
                                </HorizontalStackLayout>
                                <Label Text="{Binding Room.LandlordEmail}" FontSize="12" TextColor="#6B7280"/>
                                
                                <!-- Masked/Visible Phone (AC4) -->
                                <HorizontalStackLayout Spacing="6" Margin="0, 2, 0, 0">
                                    <Label Text="📞" FontSize="11" TextColor="#6B7280"/>
                                    <Label Text="{Binding DisplayPhoneNumber}" FontSize="12" FontAttributes="Bold" 
                                           TextColor="{Binding CanViewPhoneNumber, Converter={x:Null}}"/>
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Label Grid.Column="2" Text="›" FontSize="26" TextColor="#9CA3AF" VerticalOptions="Center"/>
                        </Grid>

                        <!-- Action Buttons -->
                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0, 4, 0, 0">
                            <Button Grid.Column="0" Text="Call Agent" HeightRequest="38" CornerRadius="10" FontSize="12"
                                    IsEnabled="{Binding CanViewPhoneNumber}" Command="{Binding CallLandlordCommand}"
                                    BackgroundColor="#10B981" TextColor="White"/>
                            <Button Grid.Column="1" Text="Simulate Auth" HeightRequest="38" CornerRadius="10" FontSize="12"
                                    Command="{Binding ToggleAuthSimulationCommand}" BackgroundColor="#6B7280" TextColor="White"/>
                        </Grid>

                        <!-- Report Issue Button -->
                        <Border StrokeShape="RoundRectangle 10" Stroke="#FCA5A5" BackgroundColor="Transparent" Padding="10" StrokeThickness="1">
                            <Label Text="Report Issue" TextColor="#DC2626" FontSize="12" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.8 Total Package Breakdown -->
                <Border StrokeShape="RoundRectangle 16" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                        Stroke="{AppThemeBinding Light=#F3F4F6, Dark=#2E2E38}" StrokeThickness="1" Padding="18">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Total Package Breakdown" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                        <Label Text="• Annual Rent: ₦450,000" FontSize="13" TextColor="#4B5563"/>
                        <Label Text="• Annual Service Charge: ₦80,000" FontSize="13" TextColor="#4B5563"/>
                        <Label Text="• Agent Fee 5%(one time): ₦30,000" FontSize="13" TextColor="#4B5563"/>
                        <Label Text="• Legal Fee 5%(one time): ₦30,000" FontSize="13" TextColor="#4B5563"/>
                        <Label Text="• Caution Fee 2%(one time and refundable): ₦15,000" FontSize="13" TextColor="#4B5563"/>
                        
                        <BoxView HeightRequest="1" BackgroundColor="#E5E7EB" Margin="0, 8"/>

                        <Grid ColumnDefinitions="*, Auto">
                            <Label Text="TOTAL PACKAGE:" FontSize="14" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                            <Label Grid.Column="1" Text="₦605,000" FontSize="16" FontAttributes="Bold" TextColor="#482880"/>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- 2.9 Similar Properties (AC3) -->
                <VerticalStackLayout IsVisible="{Binding ShowSimilarRooms}" Spacing="12" Margin="0, 4">
                    <Label Text="Similar Properties" FontSize="16" FontAttributes="Bold" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                    <CollectionView ItemsSource="{Binding SimilarRooms}" HeightRequest="190">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Horizontal" ItemSpacing="14"/>
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:SimilarRoomModel">
                                <Border WidthRequest="240" StrokeShape="RoundRectangle 14" BackgroundColor="{AppThemeBinding Light=White, Dark=#1E1E24}" 
                                        Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="10">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoomDetailViewModel}}, Path=SelectSimilarRoomCommand}"
                                                              CommandParameter="{Binding .}"/>
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="8">
                                        <Border HeightRequest="110" StrokeShape="RoundRectangle 10" StrokeThickness="0">
                                            <Image Source="{Binding ThumbnailUrl}" Aspect="AspectFill"/>
                                        </Border>
                                        <Label Text="{Binding Title}" FontSize="13" FontAttributes="Bold" MaxLines="1" LineBreakMode="TailTruncation" TextColor="{AppThemeBinding Light=#111827, Dark=White}"/>
                                        <Label Text="{Binding FormattedPrice}" FontSize="13" TextColor="#482880" FontAttributes="Bold"/>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- 3. Fixed Bottom Action Bar: Royal Purple Pill Button -->
        <Border Grid.Row="2" BackgroundColor="{AppThemeBinding Light=White, Dark=#18181B}" 
                Stroke="{AppThemeBinding Light=#E5E7EB, Dark=#2E2E38}" StrokeThickness="1" Padding="20, 14">
            <Button Text="Book Inspection - ₦5,000" 
                    HeightRequest="52"
                    CornerRadius="16"
                    FontSize="16"
                    FontAttributes="Bold"
                    BackgroundColor="#482880"
                    TextColor="White"
                    HorizontalOptions="Fill"
                    IsEnabled="{Binding CanBookOrContact}"
                    Command="{Binding BookInspectionCommand}" />
        </Border>

    </Grid>
</ContentPage>