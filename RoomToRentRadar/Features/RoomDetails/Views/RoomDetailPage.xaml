<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:RoomToRentRadar.Features.RoomDetails.ViewModels"
             x:Class="RoomToRentRadar.Features.RoomDetails.Views.RoomDetailPage"
             x:DataType="vm:RoomDetailViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="#FFFFFF">

    <ContentPage.Resources>
        <Style x:Key="RoundIconButton" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#F6F5F2" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="WidthRequest" Value="42" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="StrokeShape" Value="RoundRectangle 21" />
            <Setter Property="Shadow">
                <Setter.Value><Shadow Brush="#33000000" Offset="0,2" Radius="8" Opacity="0.25" /></Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="OverviewIcon" TargetType="Label">
            <Setter Property="FontFamily" Value="OpenSansRegular" />
            <Setter Property="FontSize" Value="20" />
            <Setter Property="TextColor" Value="#314A55" />
            <Setter Property="WidthRequest" Value="25" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>
    </ContentPage.Resources>

    <Grid RowDefinitions="*,Auto">
        <ScrollView Grid.Row="0">
            <VerticalStackLayout Spacing="0">
                <Grid HeightRequest="370">
                    <CarouselView ItemsSource="{Binding Room.ImageUrls}" Loop="True">
                        <CarouselView.ItemTemplate>
                            <DataTemplate x:DataType="x:String"><Image Source="{Binding .}" Aspect="AspectFill" /></DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <Grid Padding="16,18" ColumnDefinitions="*,Auto,Auto" VerticalOptions="Start">
                        <Border Style="{StaticResource RoundIconButton}" HorizontalOptions="Start">
                            <Border.GestureRecognizers><TapGestureRecognizer Command="{Binding GoBackCommand}" /></Border.GestureRecognizers>
                            <Label Text="←" FontSize="25" TextColor="#18333E" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-2,0,0" />
                        </Border>
                        <Border Grid.Column="1" Style="{StaticResource RoundIconButton}" Margin="0,0,10,0">
                            <Label Text="↗" FontSize="24" TextColor="#18333E" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-3,0,0" />
                        </Border>
                        <Border Grid.Column="2" Style="{StaticResource RoundIconButton}">
                            <Label Text="♡" FontSize="27" TextColor="#18333E" HorizontalOptions="Center" VerticalOptions="Center" Margin="0,-5,0,0" />
                        </Border>
                    </Grid>

                    <Border VerticalOptions="End" HorizontalOptions="Start" Margin="18,0,0,16" Padding="15,10" BackgroundColor="#EDF0EE" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                        <Label Text="View Gallery" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#18333E" />
                    </Border>
                </Grid>

                <HorizontalStackLayout HorizontalOptions="Center" Spacing="12" Padding="0,14,0,10">
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#12323D" />
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#D6D8D9" />
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#D6D8D9" />
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#D6D8D9" />
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#D6D8D9" />
                    <Ellipse WidthRequest="10" HeightRequest="10" Fill="#D6D8D9" />
                </HorizontalStackLayout>

                <VerticalStackLayout Padding="20,0,20,28" Spacing="0">
                    <Border BackgroundColor="#E4F1FF" StrokeThickness="0" StrokeShape="RoundRectangle 2" Padding="14,10" Margin="0,0,0,21">
                        <HorizontalStackLayout Spacing="9"><Label Text="✿" FontSize="18" TextColor="#075470" /><Label Text="Verified Listing" FontFamily="OpenSansSemibold" FontSize="14" TextColor="#075470" VerticalOptions="Center" /></HorizontalStackLayout>
                    </Border>

                    <Label Text="{Binding Room.Title}" FontFamily="OpenSansSemibold" FontSize="22" LineHeight="1.16" TextColor="#102F3A" />
                    <Grid Margin="0,18,0,22" ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <Label Text="{Binding Room.Address}" FontSize="12" TextColor="#627078" LineBreakMode="WordWrap" VerticalOptions="Center" />
                        <VerticalStackLayout Grid.Column="1" Spacing="2" HorizontalOptions="End">
                            <HorizontalStackLayout Spacing="5" HorizontalOptions="End"><Label Text="★" FontSize="20" TextColor="#2185ED" /><Label Text="{Binding Room.Rating, StringFormat='{0:0.0} out of 5'}" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#17323D" VerticalOptions="Center" /></HorizontalStackLayout>
                            <Label Text="{Binding Room.ReviewCount, StringFormat='{0} reviews'}" FontSize="12" TextColor="#08719B" TextDecorations="Underline" HorizontalOptions="End" />
                        </VerticalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D7E0E2" />
                    <Label Text="Main Overview" FontFamily="OpenSansSemibold" FontSize="17" TextColor="#102F3A" Margin="0,25,0,20" />
                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="28" RowSpacing="20">
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="0" Spacing="8"><Label Style="{StaticResource OverviewIcon}" Text="▥" /><Label Text="{Binding Room.FormattedArea}" FontSize="13" TextColor="#29434D" VerticalOptions="Center" /></HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" Grid.Column="1" Spacing="8"><Label Style="{StaticResource OverviewIcon}" Text="♧" /><Label Text="{Binding Room.Bedrooms, StringFormat='{0} People'}" FontSize="13" TextColor="#29434D" VerticalOptions="Center" /></HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="0" Spacing="8"><Label Style="{StaticResource OverviewIcon}" Text="⌁" /><Label Text="300 Mbps" FontSize="13" TextColor="#29434D" VerticalOptions="Center" /></HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="1" Grid.Column="1" Spacing="8"><Label Style="{StaticResource OverviewIcon}" Text="▭" /><Label Text="{Binding Room.Bedrooms, StringFormat='{0} Rooms'}" FontSize="13" TextColor="#29434D" VerticalOptions="Center" /></HorizontalStackLayout>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#D7E0E2" Margin="0,27,0,0" />
                    <Label Text="About this Listing" FontFamily="OpenSansSemibold" FontSize="17" TextColor="#102F3A" Margin="0,25,0,25" />
                    <Label Text="Rented 8 times since 2023." FontFamily="OpenSansSemibold" FontSize="12" TextColor="#18333E" Margin="0,0,0,14" />
                    <Label Text="{Binding Room.Description}" FontSize="13" LineHeight="1.42" TextColor="#53636A" />
                    <Button Text="See More" HorizontalOptions="End" Margin="0,12,0,26" Padding="15,8" CornerRadius="10" FontFamily="OpenSansSemibold" FontSize="12" BackgroundColor="#E5F2FF" TextColor="#075470" />

                    <BoxView HeightRequest="1" Color="#D7E0E2" />
                    <Border HorizontalOptions="Start" Margin="0,26,0,12" Padding="13,9" BackgroundColor="#F4D7FF" Stroke="#D827F4" StrokeThickness="2" StrokeShape="RoundRectangle 18">
                        <HorizontalStackLayout Spacing="9"><Label Text="Need help?" FontFamily="OpenSansSemibold" FontSize="13" TextColor="#283043" /><Label Text="▣" FontSize="15" TextColor="#283043" /></HorizontalStackLayout>
                    </Border>
                    <Label Text="1. Quiet Hours" FontFamily="OpenSansSemibold" FontSize="14" TextColor="#17323D" Margin="0,0,0,8" />
                    <Label Text="{Binding Room.HouseRules[0]}" FontSize="13" TextColor="#53636A" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <Border Grid.Row="1" BackgroundColor="#FFFFFF" Stroke="#E4E8EA" StrokeThickness="1" Padding="14,13,14,12" StrokeShape="RoundRectangle 22,22,0,0">
            <Border.Shadow><Shadow Brush="#250C2330" Offset="0,-4" Radius="14" Opacity="0.25" /></Border.Shadow>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="3" VerticalOptions="Center">
                    <HorizontalStackLayout Spacing="3"><Label Text="{Binding Room.FormattedPrice}" FontFamily="OpenSansSemibold" FontSize="19" TextColor="#102F3A" /><Label Text="/month" FontSize="12" TextColor="#53636A" VerticalOptions="End" Margin="0,0,0,3" /></HorizontalStackLayout>
                    <Label Text="23 July—26 Sep" FontFamily="OpenSansSemibold" FontSize="12" TextColor="#08719B" TextDecorations="Underline" />
                    <Label Text="You won’t be charged yet!" FontSize="11" TextColor="#53636A" />
                </VerticalStackLayout>
                <Button Grid.Column="1" Text="Request to Book" HeightRequest="48" Padding="18,0" VerticalOptions="Center" CornerRadius="11" FontFamily="OpenSansSemibold" FontSize="13" BackgroundColor="#1877F2" TextColor="White" IsEnabled="{Binding CanBookOrContact}" Command="{Binding BookInspectionCommand}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>
