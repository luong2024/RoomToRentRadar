<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.Features.Login.ViewModels"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:inputLayout="clr-namespace:Syncfusion.Maui.Toolkit.TextInputLayout;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             x:Class="RoomToRentRadar.Features.Login.Views.LoginPage"
             x:DataType="viewModels:LoginViewModel"
             Title="Đăng nhập"
             Shell.NavBarIsVisible="True"
             SafeAreaEdges="All">
    <ContentPage.Resources>
        <Style x:Key="LoginEntry" TargetType="Entry">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
            <Setter Property="PlaceholderColor" Value="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
            <Setter Property="BackgroundColor" Value="Transparent" />
            <Setter Property="MinimumHeightRequest" Value="46" />
        </Style>
    </ContentPage.Resources>
    <ScrollView>
        <VerticalStackLayout x:Name="LoginContent" Padding="24,28,24,28" Spacing="24"
                             MaximumWidthRequest="460" HorizontalOptions="Fill">
            <!-- Brand Intro -->
            <VerticalStackLayout Spacing="12">
                <Border WidthRequest="64" HeightRequest="64" Padding="13" StrokeThickness="0"
                        BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}"
                        StrokeShape="RoundRectangle 20" HorizontalOptions="Start">
                    <Image Source="radar_mark.png" SemanticProperties.Description="Room Radar" />
                </Border>
                <Label Text="KẾT NỐI VỚI CHỦ PHÒNG" Style="{StaticResource Eyebrow}"
                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                <Label Text="Một bước nữa,&#10;gần nơi ở mới hơn." FontSize="28" FontFamily="OpenSansSemibold"
                       CharacterSpacing="-0.6" LineHeight="1.12" SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Đăng nhập để xem số điện thoại, lưu khu vực yêu thích và quản lý tin cho thuê của bạn."
                       Style="{StaticResource Caption}" FontSize="14" LineHeight="1.35" />
            </VerticalStackLayout>

            <!-- Login Form Card -->
            <Border Padding="22,24" StrokeShape="RoundRectangle 22">
                <Border.Shadow>
                    <Shadow Brush="{StaticResource InkBrush}" Offset="0,4" Radius="12" Opacity="0.05" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="16">
                    <inputLayout:SfTextInputLayout Hint="Email" ShowHelperText="False">
                        <Entry Text="{Binding Email}" Keyboard="Email" ReturnType="Next"
                               IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                               Placeholder="ban@example.com" ClearButtonVisibility="WhileEditing"
                               AutomationId="LoginEmail" SemanticProperties.Description="Địa chỉ email"
                               Style="{StaticResource LoginEntry}" />
                    </inputLayout:SfTextInputLayout>

                    <inputLayout:SfTextInputLayout Hint="Mật khẩu" EnablePasswordVisibilityToggle="True">
                        <Entry Text="{Binding Password}" IsPassword="True" ReturnType="Go"
                               ReturnCommand="{Binding SignInCommand}" Placeholder="Nhập mật khẩu của bạn"
                               AutomationId="LoginPassword" SemanticProperties.Description="Mật khẩu"
                               Style="{StaticResource LoginEntry}" />
                    </inputLayout:SfTextInputLayout>

                    <Border IsVisible="{Binding HasError}" Padding="14,10" StrokeThickness="0"
                            StrokeShape="RoundRectangle 14"
                            BackgroundColor="{AppThemeBinding Light={StaticResource DangerSoft}, Dark={StaticResource DangerSoftDark}}">
                        <Label Text="{Binding ErrorMessage}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark={StaticResource DangerDark}}"
                               FontSize="12" FontFamily="OpenSansSemibold" />
                    </Border>

                    <progressBar:SfLinearProgressBar IsIndeterminate="True" IsVisible="{Binding IsBusy}" />

                    <Grid HeightRequest="50">
                        <buttons:SfButton Text="Đăng nhập" Command="{Binding SignInCommand}" IsEnabled="{Binding IsNotBusy}"
                                          AutomationId="LoginSignIn" HorizontalOptions="Fill" Padding="40,0"
                                          SemanticProperties.Description="Đăng nhập"
                                          SemanticProperties.Hint="Đăng nhập để xem liên hệ của chủ phòng">
                            <buttons:SfButton.Triggers>
                                <DataTrigger TargetType="buttons:SfButton" Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Text" Value="Đang đăng nhập…" />
                                </DataTrigger>
                            </buttons:SfButton.Triggers>
                        </buttons:SfButton>
                        <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" InputTransparent="True"
                                           HorizontalOptions="End" WidthRequest="20" HeightRequest="20" Margin="0,0,14,0" Color="{StaticResource Muted}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <buttons:SfButton Text="←  Quay lại phòng đang xem" Command="{Binding CancelCommand}"
                              Style="{StaticResource GhostSfButton}" HorizontalOptions="Center"
                              SemanticProperties.Description="Hủy đăng nhập"
                              SemanticProperties.Hint="Quay lại trang thông tin phòng" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
