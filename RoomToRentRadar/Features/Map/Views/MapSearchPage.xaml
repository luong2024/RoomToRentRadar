<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:mapsui="clr-namespace:Mapsui.UI.Maui;assembly=Mapsui.UI.Maui"
             xmlns:models="clr-namespace:RoomToRentRadar.Models"
             xmlns:vm="clr-namespace:RoomToRentRadar.Features.Map.ViewModels"
             x:Class="RoomToRentRadar.Features.Map.Views.MapSearchPage"
             x:DataType="vm:MapSearchPageModel"
             Title="Bản đồ"
             SafeAreaEdges="All">
    <Grid>
        <mapsui:MapControl x:Name="MapView" />

        <Border VerticalOptions="Start" Margin="20,16" Padding="16,12">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <VerticalStackLayout Spacing="3">
                    <Label Text="TÌM PHÒNG THEO KHU VỰC" Style="{StaticResource Eyebrow}" FontSize="9"
                           TextColor="{StaticResource Accent}" />
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="Sắp xếp" FontSize="11" TextColor="{StaticResource Muted}" VerticalOptions="Center" />
                        <Picker ItemsSource="{Binding SortOptions}"
                                ItemDisplayBinding="{Binding Label, x:DataType=models:MapSortOption}"
                                SelectedIndex="{Binding SelectedSortIndex}"
                                FontSize="12" MinimumHeightRequest="32" WidthRequest="170"
                                SemanticProperties.Description="Chọn thứ tự kết quả theo giá hoặc khoảng cách" />
                    </HorizontalStackLayout>
                    <Label Text="{Binding StatusMessage}" FontSize="13" LineBreakMode="WordWrap" />
                    <Label Text="{Binding ResultsText}" Style="{StaticResource Caption}" FontSize="11"
                           IsVisible="{Binding HasResults}" />
                    <Label Text="Bản đồ © Esri, HERE, Garmin, © OpenStreetMap contributors" Style="{StaticResource Caption}" FontSize="9" />
                </VerticalStackLayout>
                <ActivityIndicator Grid.Column="1" IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}"
                                   VerticalOptions="Center" />
            </Grid>
        </Border>

        <Border VerticalOptions="End" HorizontalOptions="Start" MaximumWidthRequest="430" Margin="20,0,20,96"
                Padding="16,14" IsVisible="{Binding ShowPreviewCard}">
            <Grid RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" ColumnSpacing="10" RowSpacing="6">
                <Label Text="{Binding SelectedListing.Title}" FontFamily="OpenSansSemibold" FontSize="16"
                       MaxLines="2" />
                <Button Grid.Column="1" Text="✕" Command="{Binding ClearSelectionCommand}"
                        BackgroundColor="{StaticResource SoftSurface}" TextColor="{StaticResource Ink}"
                        FontSize="12" Padding="10,4" MinimumHeightRequest="28" WidthRequest="34" CornerRadius="8"
                        SemanticProperties.Description="Đóng thẻ xem trước" />
                <Label Grid.Row="1" Text="{Binding SelectedListing.RentText}" FontSize="18"
                       FontFamily="OpenSansSemibold" TextColor="{StaticResource Accent}" />
                <HorizontalStackLayout Grid.Row="2" Spacing="12">
                    <Label Text="{Binding SelectedListing.AreaText}" Style="{StaticResource Caption}" FontSize="11" />
                    <Label Text="{Binding SelectedListing.BedroomText}" Style="{StaticResource Caption}" FontSize="11" />
                    <Label Text="{Binding SelectedListing.DistanceText}" Style="{StaticResource Caption}" FontSize="11" />
                </HorizontalStackLayout>
                <Label Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding SelectedListing.AddressText}"
                       Style="{StaticResource Caption}" FontSize="11" MaxLines="2" />
            </Grid>
        </Border>

        <Border VerticalOptions="End" HorizontalOptions="End" MaximumWidthRequest="390" Margin="20,0,20,96"
                Padding="16,14" IsVisible="{Binding IsSavedPanelOpen}">
            <VerticalStackLayout Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Khu vực đã lưu" FontFamily="OpenSansSemibold" FontSize="15" VerticalOptions="Center" />
                    <Button Grid.Column="1" Text="Đóng" Command="{Binding ToggleSavedAreasCommand}"
                            BackgroundColor="{StaticResource SoftSurface}" TextColor="{StaticResource Ink}"
                            FontSize="11" Padding="12,4" MinimumHeightRequest="28" CornerRadius="8" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Text="{Binding NewAreaName}" Placeholder="Tên khu vực"
                           SemanticProperties.Description="Tên cho khu vực đã vẽ" />
                    <Button Grid.Column="1" Text="Lưu" Command="{Binding SaveAreaCommand}"
                            IsEnabled="{Binding CanSaveCurrentArea}" FontSize="12" Padding="16,8"
                            MinimumHeightRequest="36" />
                </Grid>
                <Picker ItemsSource="{Binding SavedAreas}" Title="Chọn khu vực đã lưu"
                        ItemDisplayBinding="{Binding Name, x:DataType=models:SavedAreaSearch}"
                        SelectedItem="{Binding SelectedSavedArea}" IsVisible="{Binding HasSavedAreas}"
                        FontSize="12" MinimumHeightRequest="36" />
                <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding HasSavedAreas}">
                    <Button Text="Áp dụng" Command="{Binding ApplySavedAreaCommand}"
                            IsEnabled="{Binding HasSelectedSavedArea}" FontSize="12" Padding="14,8"
                            MinimumHeightRequest="36" />
                    <Button Grid.Column="1" Text="Xóa" Command="{Binding DeleteSavedAreaCommand}"
                            IsEnabled="{Binding HasSelectedSavedArea}" FontSize="12" Padding="14,8"
                            MinimumHeightRequest="36" BackgroundColor="{StaticResource SoftSurface}"
                            TextColor="{StaticResource Ink}" />
                </Grid>
                <Label Text="Khu vực đã lưu chỉ nằm trên thiết bị này." Style="{StaticResource Caption}" FontSize="10" />
            </VerticalStackLayout>
        </Border>

        <Border VerticalOptions="End" HorizontalOptions="Fill" Margin="20" Padding="8"
                StrokeShape="RoundRectangle 14">
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never"
                        VerticalOptions="Center" HeightRequest="42">
                <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                    <Button Text="Vẽ khu vực" Command="{Binding StartDrawingCommand}"
                            IsVisible="{Binding ShowStartDrawing}" FontSize="12" Padding="16,10"
                            MinimumHeightRequest="38" />
                    <Button Text="Hoàn tác" Command="{Binding UndoVertexCommand}"
                            IsVisible="{Binding ShowDrawingTools}" FontSize="12" Padding="14,10"
                            MinimumHeightRequest="38" BackgroundColor="{StaticResource SoftSurface}"
                            TextColor="{StaticResource Ink}" />
                    <Button Text="Hoàn tất" Command="{Binding FinishDrawingCommand}"
                            IsVisible="{Binding ShowDrawingTools}" IsEnabled="{Binding CanFinishDrawing}"
                            FontSize="12" Padding="16,10" MinimumHeightRequest="38" />
                    <Button Text="Xóa" Command="{Binding CancelDrawingCommand}"
                            IsVisible="{Binding ShowDrawingTools}" FontSize="12" Padding="14,10"
                            MinimumHeightRequest="38" BackgroundColor="{StaticResource SoftSurface}"
                            TextColor="{StaticResource Ink}" />
                    <Button Text="Tìm lại" Command="{Binding SearchCommand}"
                            IsVisible="{Binding ShowSearchButton}" FontSize="12" Padding="14,10"
                            MinimumHeightRequest="38" BackgroundColor="{StaticResource SoftSurface}"
                            TextColor="{StaticResource Ink}" />
                    <Button Text="Khu vực đã lưu" Command="{Binding ToggleSavedAreasCommand}"
                            FontSize="12" Padding="14,10" MinimumHeightRequest="38"
                            BackgroundColor="{StaticResource SoftSurface}" TextColor="{StaticResource Ink}" />
                </HorizontalStackLayout>
            </ScrollView>
        </Border>
    </Grid>
</ContentPage>
