<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.Features.RoomDetail.ViewModels"
             xmlns:listings="clr-namespace:RoomToRentRadar.Shared.Listings;assembly=RoomToRentRadar.Shared"
             xmlns:buttons="clr-namespace:Syncfusion.Maui.Toolkit.Buttons;assembly=Syncfusion.Maui.Toolkit"
             xmlns:cards="clr-namespace:Syncfusion.Maui.Toolkit.Cards;assembly=Syncfusion.Maui.Toolkit"
             xmlns:progressBar="clr-namespace:Syncfusion.Maui.Toolkit.ProgressBar;assembly=Syncfusion.Maui.Toolkit"
             xmlns:shimmer="clr-namespace:Syncfusion.Maui.Toolkit.Shimmer;assembly=Syncfusion.Maui.Toolkit"
             xmlns:sheet="clr-namespace:Syncfusion.Maui.Toolkit.BottomSheet;assembly=Syncfusion.Maui.Toolkit"
             xmlns:report="clr-namespace:RoomToRentRadar.Features.RoomReport.ViewModels"
             x:Class="RoomToRentRadar.Features.RoomDetail.Views.RoomDetailPage"
             x:DataType="viewModels:RoomDetailViewModel"
             Title="Chi tiết phòng"
             Shell.NavBarIsVisible="False"
             SafeAreaEdges="All">

    <sheet:SfBottomSheet x:Name="ReportSheet"
                         IsOpen="{Binding Report.IsOpen, Mode=TwoWay}"
                         AllowedState="FullExpanded"
                         FullExpandedRatio="0.94"
                         IsModal="True"
                         ShowGrabber="True"
                         GrabberWidth="40"
                         GrabberHeight="4"
                         GrabberAreaHeight="20"
                         EnableSwiping="True"
                         SwipeFromHeaderOnly="True"
                         CollapseOnOverlayTap="True"
                         CornerRadius="26,26,0,0"
                         ContentPadding="0"
                         AnimationDuration="200"
                         Background="{AppThemeBinding Light={StaticResource SurfaceBrush}, Dark={StaticResource SurfaceDarkBrush}}">
        <sheet:SfBottomSheet.Content>
    <Grid RowDefinitions="*,Auto" RowSpacing="0">
        <!-- Skeleton Loading State -->
        <shimmer:SfShimmer IsVisible="{Binding IsLoadingVisible}"
                           IsActive="{Binding IsLoadingVisible}"
                           Type="Article"
                           RepeatCount="3"
                           VerticalOptions="Fill"
                           Margin="16,12,16,0"
                           SemanticProperties.Description="Đang tải thông tin phòng" />

        <!-- Main Content -->
        <ScrollView IsVisible="{Binding IsContentVisible}" AutomationId="RoomDetailContent">
            <VerticalStackLayout x:Name="DetailContent" Spacing="12" MaximumWidthRequest="760" HorizontalOptions="Fill" Padding="16,10,16,16">
                <!-- Hero photo with floating back button and price badge -->
                <Border StrokeThickness="0" StrokeShape="RoundRectangle 22" HeightRequest="290" Padding="0">
                    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                        <Image Source="{Binding PhotoSource}" Aspect="AspectFill"
                               SemanticProperties.Description="Hình ảnh không gian phòng" />

                        <Border WidthRequest="42" HeightRequest="42" Margin="12" Padding="0"
                                HorizontalOptions="Start" VerticalOptions="Start"
                                StrokeThickness="0" StrokeShape="RoundRectangle 21"
                                BackgroundColor="#F2FFFFFF">
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                            </Border.GestureRecognizers>
                            <Image Source="back_icon.png" WidthRequest="19" HeightRequest="19"
                                   SemanticProperties.Description="Quay lại danh sách phòng" />
                        </Border>

                        <HorizontalStackLayout Margin="12" Spacing="8"
                                               HorizontalOptions="End" VerticalOptions="Start">
                            <Border Padding="11,6" VerticalOptions="Center"
                                    StrokeThickness="0" StrokeShape="RoundRectangle 10"
                                    BackgroundColor="#F2FFFFFF">
                                <Label Text="{Binding StatusDisplayText}" FontSize="11" FontFamily="OpenSansSemibold"
                                       TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                            </Border>

                            <Button Text="{Binding FavouriteGlyph}"
                                    Command="{Binding ToggleFavouriteCommand}"
                                    AutomationId="FavouriteToggle"
                                    FontSize="22"
                                    Padding="0"
                                    WidthRequest="42" HeightRequest="42"
                                    MinimumHeightRequest="42"
                                    CornerRadius="21"
                                    BackgroundColor="#F2FFFFFF"
                                    TextColor="{StaticResource Accent}"
                                    SemanticProperties.Description="Lưu phòng vào yêu thích"
                                    SemanticProperties.Hint="Thêm hoặc bỏ phòng khỏi danh sách yêu thích" />
                        </HorizontalStackLayout>

                        <Border Margin="0,0,0,20" Padding="20,8" HorizontalOptions="Center" VerticalOptions="End"
                                StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                BackgroundColor="#B33B332C">
                            <VerticalStackLayout Spacing="0">
                                <Label Text="Giá thuê" FontSize="10.5" HorizontalTextAlignment="Center" TextColor="#D9FFFFFF" />
                                <Label Text="{Binding Listing.Price, StringFormat='{0:N0} ₫'}"
                                       FontSize="20" FontFamily="OpenSansSemibold" HorizontalTextAlignment="Center" TextColor="White" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </Border>

                <!-- Host card -->
                <Border Padding="12" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <Grid ColumnDefinitions="48,*,Auto" ColumnSpacing="12">
                        <Border WidthRequest="48" HeightRequest="48" StrokeThickness="0" StrokeShape="RoundRectangle 24"
                                BackgroundColor="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}">
                            <Image Source="person_icon.png" WidthRequest="22" HeightRequest="22"
                                   SemanticProperties.Description="Chủ phòng" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding Listing.LandlordName}" FontFamily="OpenSansSemibold" FontSize="15"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                            <Label Text="{Binding PostedOnText, StringFormat='Đăng tin ngày {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        </VerticalStackLayout>
                        <Border Grid.Column="2" Padding="10,6" VerticalOptions="Center" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                            <Label Text="{Binding RoomTypeDisplayText}" FontSize="11.5" FontFamily="OpenSansSemibold"
                                   TextColor="{AppThemeBinding Light={StaticResource BodyInk}, Dark={StaticResource InkDark}}" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Title, address and quick specs -->
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Listing.Title}"
                                   FontSize="22" FontFamily="OpenSansSemibold" CharacterSpacing="-0.4" LineHeight="1.15"
                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}"
                                   SemanticProperties.HeadingLevel="Level1" />
                            <Label Text="{Binding Listing.Address}" FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
                            <VerticalStackLayout Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                    <Image Source="bed_icon.png" WidthRequest="20" HeightRequest="20" />
                                </Border>
                                <Label Text="{Binding BedroomsText}" FontSize="12.5" FontFamily="OpenSansSemibold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource BodyInk}, Dark={StaticResource InkDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                    <Image Source="home_icon.png" WidthRequest="20" HeightRequest="20" />
                                </Border>
                                <Label Text="{Binding RoomTypeDisplayText}" FontSize="12.5" FontFamily="OpenSansSemibold"
                                       HorizontalTextAlignment="Center" MaxLines="1" LineBreakMode="TailTruncation"
                                       TextColor="{AppThemeBinding Light={StaticResource BodyInk}, Dark={StaticResource InkDark}}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="2" Spacing="6" HorizontalOptions="Center">
                                <Border WidthRequest="44" HeightRequest="44" StrokeThickness="0" StrokeShape="RoundRectangle 22"
                                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                    <Image Source="area_icon.png" WidthRequest="19" HeightRequest="19" />
                                </Border>
                                <Label Text="{Binding Listing.AreaM2, StringFormat='{0:N0} m²'}" FontSize="12.5" FontFamily="OpenSansSemibold"
                                       HorizontalTextAlignment="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource BodyInk}, Dark={StaticResource InkDark}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <Border Padding="12,9" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="TIỀN CỌC" Style="{StaticResource Eyebrow}" FontSize="8.5"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                    <Label Text="{Binding Listing.Deposit, StringFormat='{0:N0} ₫'}"
                                           FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Grid.Column="1" Padding="12,9" StrokeThickness="0" StrokeShape="RoundRectangle 12"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="1">
                                    <Label Text="CẬP NHẬT" Style="{StaticResource Eyebrow}" FontSize="8.5"
                                           TextColor="{AppThemeBinding Light={StaticResource Muted}, Dark={StaticResource MutedDark}}" />
                                    <Label Text="{Binding UpdatedOnText}" FontSize="13" FontFamily="OpenSansSemibold"
                                           TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <!-- Description Card -->
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="Về căn phòng" Style="{StaticResource SectionTitle}" FontSize="17"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding Listing.Description}"
                               Style="{StaticResource BodyText}" LineHeight="1.45" />
                    </VerticalStackLayout>
                </Border>

                <!-- Amenities Card (100% Vietnamese Labels) -->
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasAmenities}">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="Tiện nghi có sẵn" Style="{StaticResource SectionTitle}" FontSize="17"
                               SemanticProperties.HeadingLevel="Level2" />
                        <FlexLayout BindableLayout.ItemsSource="{Binding AmenityDisplayLabels}"
                                    Direction="Row" Wrap="Wrap" JustifyContent="Start">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Padding="12,7" Margin="0,0,8,8" StrokeThickness="0"
                                            StrokeShape="RoundRectangle 12"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}"
                                            HorizontalOptions="Start">
                                        <Label Text="{Binding ., StringFormat='✓  {0}'}" FontSize="12.5" FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource BodyInk}, Dark={StaticResource InkDark}}" />
                                    </Border>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </FlexLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- House Rules Card -->
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasRules}">
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Nội quy chung" Style="{StaticResource SectionTitle}" FontSize="17"
                               SemanticProperties.HeadingLevel="Level2" />
                        <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}" Spacing="8">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Label Text="{Binding ., StringFormat='•  {0}'}"
                                           Style="{StaticResource BodyText}" LineHeight="1.35" />
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- House Rules Card -->
                <Border Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18" IsVisible="{Binding HasHouseRules}"
                        AutomationId="HouseRulesSection">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Nội quy tòa nhà" Style="{StaticResource SectionTitle}" FontSize="17"
                                   SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding HouseRulesVersionText}" Style="{StaticResource Caption}"
                                   AutomationId="HouseRulesVersionCaption" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="10">
                            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Giờ yên tĩnh" Style="{StaticResource Eyebrow}"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    <Label Text="{Binding HouseRules.QuietHours}"
                                           Style="{StaticResource BodyText}" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Khách đến thăm" Style="{StaticResource Eyebrow}"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    <Label Text="{Binding HouseRules.GuestPolicy}"
                                           Style="{StaticResource BodyText}" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Nấu ăn" Style="{StaticResource Eyebrow}"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    <Label Text="{Binding HouseRules.CookingRules}"
                                           Style="{StaticResource BodyText}" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Border>
                            <Border Padding="14" StrokeThickness="0" StrokeShape="RoundRectangle 14"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Gửi xe" Style="{StaticResource Eyebrow}"
                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}" />
                                    <Label Text="{Binding HouseRules.ParkingRules}"
                                           Style="{StaticResource BodyText}" LineHeight="1.3" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <!-- Travel time from the user's campus -->
                <Border x:Name="TravelSection"
                        x:DataType="viewModels:RoomDetailTravelViewModel"
                        Padding="18" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                        BackgroundColor="{AppThemeBinding Light={StaticResource SoftSurface}, Dark={StaticResource SoftSurfaceDark}}"
                        AutomationId="RoomDetailTravelSection">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="DI CHUYỂN TỪ KHU VỰC CỦA BẠN" Style="{StaticResource Eyebrow}" />
                        <Picker Title="Chọn khu vực của bạn"
                                ItemsSource="{Binding CampusNames}"
                                SelectedItem="{Binding SelectedCampusName, Mode=TwoWay}"
                                SemanticProperties.Description="Chọn khu vực học tập để tính thời gian di chuyển" />

                        <Label Text="Chọn khu vực của bạn để xem thời gian di chuyển tới phòng này."
                               IsVisible="{Binding IsNoCampusVisible}"
                               Style="{StaticResource Caption}" />

                        <ActivityIndicator IsRunning="{Binding IsLoadingVisible}"
                                           IsVisible="{Binding IsLoadingVisible}"
                                           HorizontalOptions="Start"
                                           SemanticProperties.Description="Đang tính thời gian di chuyển" />

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsLoadedVisible}">
                            <VerticalStackLayout BindableLayout.ItemsSource="{Binding Estimates}" Spacing="6">
                                <BindableLayout.ItemTemplate>
                                    <DataTemplate x:DataType="viewModels:TravelModeEstimateItem">
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                            <Label Text="{Binding ModeLabel}"
                                                   FontFamily="OpenSansSemibold" FontSize="14" />
                                            <Label Grid.Column="1"
                                                   Text="{Binding ValueText}"
                                                   FontSize="14"
                                                   HorizontalTextAlignment="End"
                                                   SemanticProperties.Description="{Binding AccessibilityText}" />
                                        </Grid>
                                    </DataTemplate>
                                </BindableLayout.ItemTemplate>
                            </VerticalStackLayout>
                            <Label Text="Chưa lấy được lộ trình nên đang hiển thị khoảng cách đường thẳng ước tính."
                                   IsVisible="{Binding HasFallbackNote}"
                                   Style="{StaticResource Caption}" />
                        </VerticalStackLayout>

                        <Button Text="Chỉ đường"
                                Command="{Binding OpenDirectionsCommand}"
                                HorizontalOptions="Start"
                                AutomationId="TravelDirectionsButton"
                                SemanticProperties.Description="Mở trang chỉ đường tới phòng trong ứng dụng"
                                SemanticProperties.Hint="Mở bản đồ chỉ đường tới phòng ngay trong ứng dụng" />

                        <Label Text="Phòng này không còn khả dụng nên không thể tính thời gian di chuyển."
                               IsVisible="{Binding IsListingGoneVisible}"
                               Style="{StaticResource Caption}" />

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsRateLimitedVisible}">
                            <Label Text="{Binding RateLimitedMessage}"
                                   Style="{StaticResource Caption}" />
                            <Button Text="Thử lại"
                                    Command="{Binding LoadCommand}"
                                    AutomationId="TravelRateLimitedRetryButton"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Description="Thử tải lại thời gian di chuyển"
                                    SemanticProperties.Hint="Tải lại thời gian di chuyển tới phòng này" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8" IsVisible="{Binding IsErrorVisible}">
                            <Label Text="Chưa tải được thời gian di chuyển. Kiểm tra kết nối mạng rồi thử lại nhé."
                                   Style="{StaticResource Caption}" />
                            <Button Text="Thử lại"
                                    Command="{Binding LoadCommand}"
                                    HorizontalOptions="Start"
                                    SemanticProperties.Description="Thử tải lại thời gian di chuyển"
                                    SemanticProperties.Hint="Tải lại thời gian di chuyển tới phòng này" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Border>

                <buttons:SfButton Text="Báo cáo tin đăng"
                                  Command="{Binding OpenReportCommand}"
                                  Style="{StaticResource TextActionButton}"
                                  HorizontalOptions="Center"
                                  AutomationId="ReportListingAction"
                                  SemanticProperties.Description="Báo cáo tin đăng này với kiểm duyệt viên"
                                  SemanticProperties.Hint="Mở biểu mẫu báo cáo tin đăng" />

                <Label Text="Đăng nhập để xem số điện thoại và trao đổi trực tiếp với chủ phòng."
                       IsVisible="{Binding IsSignInPromptVisible}" Style="{StaticResource Caption}"
                       HorizontalTextAlignment="Center" Margin="0,2,0,6" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Bottom contact bar -->
        <Border Grid.Row="1" IsVisible="{Binding IsContentVisible}" Padding="16,10,16,14"
                StrokeShape="Rectangle" StrokeThickness="0" BackgroundColor="Transparent">
            <Border StrokeThickness="0" StrokeShape="RoundRectangle 20" Padding="14,10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" MaximumWidthRequest="760" HorizontalOptions="Fill">
                    <VerticalStackLayout Spacing="1" VerticalOptions="Center">
                        <Label Text="Liên hệ chủ phòng" Style="{StaticResource Caption}" FontSize="11" />
                        <Label Text="{Binding LandlordPhone}" IsVisible="{Binding IsPhoneVisible}"
                               FontSize="17" FontFamily="OpenSansSemibold" SemanticProperties.Description="Số điện thoại chủ phòng" />
                        <Label Text="{Binding Listing.Price, StringFormat='{0:N0} ₫ / tháng'}" IsVisible="{Binding IsSignInPromptVisible}"
                               FontSize="16" FontFamily="OpenSansSemibold" TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                    </VerticalStackLayout>
                    <buttons:SfButton Grid.Column="1" Text="Liên hệ" Command="{Binding ShowLoginCommand}"
                                      IsVisible="{Binding IsSignInPromptVisible}" MinimumWidthRequest="118"
                                      AutomationId="RoomContact" SemanticProperties.Description="Đăng nhập để liên hệ chủ phòng" />
                </Grid>
            </Border>
        </Border>

        <!-- Unavailable State -->
        <ScrollView IsVisible="{Binding IsUnavailableVisible}" Margin="16,12,16,16">
            <VerticalStackLayout Spacing="20" MaximumWidthRequest="720" HorizontalOptions="Fill">
                <cards:SfCardView Padding="22" Style="{StaticResource ElevatedCard}"
                                  IndicatorColor="{StaticResource WarmAccent}" IndicatorPosition="Left" IndicatorThickness="4">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="KHÔNG CÒN TRỐNG" Style="{StaticResource Eyebrow}" TextColor="{StaticResource WarmAccent}" />
                        <Label Text="Phòng này đã có người thuê"
                               FontSize="22" FontFamily="OpenSansSemibold"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="Tin đăng đã được gỡ hoặc phòng đã được thuê. Cùng khám phá những lựa chọn tương tự bên dưới nhé."
                               Style="{StaticResource BodyText}" LineHeight="1.35" />
                        <buttons:SfButton Text="Khám phá phòng khác"
                                          Command="{Binding GoBackCommand}"
                                          HorizontalOptions="Start"
                                          SemanticProperties.Description="Quay lại danh sách phòng"
                                          SemanticProperties.Hint="Đóng thông tin phòng và quay lại danh sách" />
                    </VerticalStackLayout>
                </cards:SfCardView>

                <VerticalStackLayout Spacing="10">
                    <Label Text="Có thể bạn sẽ thích" Style="{StaticResource SectionTitle}"
                           SemanticProperties.HeadingLevel="Level2" />

                    <progressBar:SfCircularProgressBar IsIndeterminate="True"
                                                      IsVisible="{Binding IsSimilarLoading}"
                                                      HorizontalOptions="Start"
                                                      SemanticProperties.Description="Đang tìm phòng tương tự" />

                    <Label Text="{Binding SimilarStatusMessage}"
                           IsVisible="{Binding HasSimilarStatusMessage}"
                           Style="{StaticResource Caption}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SimilarRooms}" Spacing="10">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="listings:ListingSummaryDto">
                                <Border Padding="16" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                                        SemanticProperties.Description="{Binding Title}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSimilarRoomTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="{Binding Title}" FontSize="15" FontFamily="OpenSansSemibold"
                                               LineBreakMode="TailTruncation" MaxLines="2" />
                                        <Label Text="{Binding Address}" Style="{StaticResource Caption}"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="12" Margin="0,4,0,0">
                                            <Label Text="{Binding Price, StringFormat='{0:N0} ₫ / tháng'}"
                                                   FontFamily="OpenSansSemibold" FontSize="13.5"
                                                   TextColor="{AppThemeBinding Light={StaticResource Ink}, Dark={StaticResource InkDark}}" />
                                            <Label Text="{Binding AreaM2, StringFormat='{0:N0} m²'}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                            <Label Text="{Binding Bedrooms, StringFormat='{0} phòng ngủ'}" Style="{StaticResource Caption}" VerticalOptions="Center" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Not Found State -->
        <cards:SfCardView IsVisible="{Binding IsNotFoundVisible}" VerticalOptions="Center"
                          MaximumWidthRequest="480" HorizontalOptions="Fill" Padding="24" Margin="16"
                          Style="{StaticResource ElevatedCard}">
            <VerticalStackLayout Spacing="14">
                <Label Text="KHÔNG TÌM THẤY" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Muted}" />
                <Label Text="Chưa tìm thấy căn phòng này" FontSize="22" FontFamily="OpenSansSemibold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Tin đăng không còn tồn tại. Hãy thử khám phá thêm những căn phòng khác."
                       Style="{StaticResource BodyText}" LineHeight="1.35" />
                <buttons:SfButton Text="Khám phá phòng khác" Command="{Binding GoBackCommand}" HorizontalOptions="Start"
                                  SemanticProperties.Description="Quay lại danh sách phòng"
                                  SemanticProperties.Hint="Quay lại danh sách phòng" />
            </VerticalStackLayout>
        </cards:SfCardView>

        <!-- Error State -->
        <cards:SfCardView IsVisible="{Binding IsErrorVisible}" VerticalOptions="Center"
                          MaximumWidthRequest="480" HorizontalOptions="Fill" Padding="24" Margin="16"
                          Style="{StaticResource ElevatedCard}"
                          IndicatorColor="{StaticResource Danger}" IndicatorPosition="Top" IndicatorThickness="4">
            <VerticalStackLayout Spacing="14">
                <Label Text="LỖI KẾT NỐI" Style="{StaticResource Eyebrow}" TextColor="{StaticResource Danger}" />
                <Label Text="Chưa tải được thông tin phòng" FontSize="22" FontFamily="OpenSansSemibold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Kiểm tra kết nối mạng rồi thử lại nhé." Style="{StaticResource BodyText}" />
                <VerticalStackLayout Spacing="10">
                    <buttons:SfButton Text="Thử lại" Command="{Binding LoadCommand}"
                                      SemanticProperties.Description="Thử tải lại"
                                      SemanticProperties.Hint="Tải lại thông tin phòng này" />
                    <buttons:SfButton Text="Khám phá phòng khác" Command="{Binding GoBackCommand}"
                                      Style="{StaticResource SoftSfButton}"
                                      SemanticProperties.Description="Quay lại danh sách phòng"
                                      SemanticProperties.Hint="Quay lại danh sách phòng" />
                </VerticalStackLayout>
            </VerticalStackLayout>
        </cards:SfCardView>
    </Grid>
        </sheet:SfBottomSheet.Content>

        <sheet:SfBottomSheet.BottomSheetContent>
            <Grid BindingContext="{Binding Report}"
                  SafeAreaEdges="All">
                <Grid x:Name="ReportSheetRoot"
                      x:DataType="report:RoomReportViewModel"
                      RowDefinitions="Auto,*,Auto">
                    <Grid Padding="20,0,16,12"
                          ColumnDefinitions="*,Auto">
                        <VerticalStackLayout Spacing="3"
                                             VerticalOptions="Center">
                            <Label Text="Báo cáo tin đăng"
                                   Style="{StaticResource ScreenTitle}" />
                            <Label Text="{Binding ListingTitle}"
                                   Style="{StaticResource Caption}"
                                   FontSize="12"
                                   LineBreakMode="TailTruncation"
                                   MaxLines="1" />
                        </VerticalStackLayout>
                        <buttons:SfButton Grid.Column="1"
                                          Command="{Binding CloseCommand}"
                                          Style="{StaticResource IconActionButton}"
                                          SemanticProperties.Description="Đóng biểu mẫu báo cáo">
                            <buttons:SfButton.Content>
                                <DataTemplate x:DataType="report:RoomReportViewModel">
                                    <Image Source="close_icon.png"
                                           WidthRequest="22"
                                           HeightRequest="22"
                                           InputTransparent="True" />
                                </DataTemplate>
                            </buttons:SfButton.Content>
                        </buttons:SfButton>
                    </Grid>

                    <ScrollView Grid.Row="1">
                        <VerticalStackLayout Padding="20,4,20,20"
                                             Spacing="18">
                            <VerticalStackLayout Spacing="16"
                                                 IsVisible="{Binding IsFormVisible}">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Vì sao bạn báo cáo tin này?"
                                           Style="{StaticResource SectionTitle}" />
                                    <Label Text="Chọn lý do phù hợp nhất với vấn đề bạn gặp."
                                           Style="{StaticResource Caption}"
                                           FontSize="12" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="8"
                                                     BindableLayout.ItemsSource="{Binding Reasons}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="report:ReportReasonOption">
                                            <Border Padding="14,11"
                                                    StrokeThickness="1"
                                                    Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                                    StrokeShape="RoundRectangle 14"
                                                    BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}"
                                                    SemanticProperties.Description="{Binding Label}">
                                                <Border.GestureRecognizers>
                                                    <TapGestureRecognizer
                                                        Command="{Binding BindingContext.SelectReasonCommand, Source={x:Reference ReportSheetRoot}}"
                                                        CommandParameter="{Binding .}" />
                                                </Border.GestureRecognizers>
                                                <Border.Triggers>
                                                    <DataTrigger TargetType="Border"
                                                                 Binding="{Binding IsSelected}"
                                                                 Value="True">
                                                        <Setter Property="Stroke"
                                                                Value="{StaticResource AccentBrush}" />
                                                        <Setter Property="StrokeThickness"
                                                                Value="2" />
                                                        <Setter Property="BackgroundColor"
                                                                Value="{AppThemeBinding Light={StaticResource AccentSoft}, Dark={StaticResource AccentSoftDark}}" />
                                                    </DataTrigger>
                                                </Border.Triggers>
                                                <Grid ColumnDefinitions="*,Auto"
                                                      ColumnSpacing="10">
                                                    <VerticalStackLayout Spacing="2">
                                                        <Label Text="{Binding Label}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14" />
                                                        <Label Text="{Binding Description}"
                                                               Style="{StaticResource Caption}"
                                                               FontSize="12" />
                                                    </VerticalStackLayout>
                                                    <Label Grid.Column="1"
                                                           Text="✓"
                                                           IsVisible="{Binding IsSelected}"
                                                           FontFamily="OpenSansSemibold"
                                                           TextColor="{AppThemeBinding Light={StaticResource Accent}, Dark={StaticResource AccentDark}}"
                                                           VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Ghi chú thêm (không bắt buộc)"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Border StrokeThickness="1"
                                            Stroke="{AppThemeBinding Light={StaticResource Line}, Dark={StaticResource LineDark}}"
                                            StrokeShape="RoundRectangle 14"
                                            Padding="10,4"
                                            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource SurfaceDark}}">
                                        <Editor Text="{Binding Note}"
                                                AutomationId="ReportNote"
                                                HeightRequest="110"
                                                FontSize="14"
                                                AutoSize="Disabled"
                                                Placeholder="Mô tả ngắn giúp kiểm duyệt viên xử lý nhanh hơn"
                                                SemanticProperties.Description="Ghi chú thêm cho báo cáo, tối đa 1000 ký tự" />
                                    </Border>
                                    <Label Text="{Binding NoteLengthText}"
                                           Style="{StaticResource Caption}"
                                           FontSize="11"
                                           HorizontalOptions="End" />
                                </VerticalStackLayout>

                                <Border IsVisible="{Binding HasStatusMessage}"
                                        Padding="12"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource DangerSoft}">
                                    <Label Text="{Binding StatusMessage}"
                                           FontSize="13"
                                           TextColor="{StaticResource Danger}"
                                           SemanticProperties.Description="{Binding StatusMessage}" />
                                </Border>
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="12"
                                                 IsVisible="{Binding IsSignInRequiredVisible}">
                                <Label Text="Đăng nhập để gửi báo cáo"
                                       Style="{StaticResource SectionTitle}" />
                                <Label Text="Báo cáo được gắn với tài khoản của bạn để kiểm duyệt viên liên hệ khi cần."
                                       Style="{StaticResource Caption}" />
                                <Border IsVisible="{Binding HasStatusMessage}"
                                        Padding="12"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 12"
                                        BackgroundColor="{StaticResource DangerSoft}">
                                    <Label Text="{Binding StatusMessage}"
                                           FontSize="13"
                                           TextColor="{StaticResource Danger}" />
                                </Border>
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </ScrollView>

                    <Border Grid.Row="2"
                            StrokeShape="Rectangle"
                            Padding="20,12,20,16"
                            StrokeThickness="0">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="8">
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16"
                                  IsVisible="{Binding IsFormVisible}">
                                <buttons:SfButton Text="Hủy"
                                                  Command="{Binding CloseCommand}"
                                                  Style="{StaticResource TextActionButton}"
                                                  Padding="4,0"
                                                  SemanticProperties.Description="Đóng biểu mẫu, không gửi báo cáo" />
                                <buttons:SfButton Grid.Column="1"
                                                  Text="{Binding SubmitButtonText}"
                                                  Command="{Binding SubmitCommand}"
                                                  IsEnabled="{Binding CanSubmit}"
                                                  Style="{StaticResource PrimaryActionButton}"
                                                  AutomationId="SubmitListingReport"
                                                  SemanticProperties.Description="Gửi báo cáo tới kiểm duyệt viên" />
                            </Grid>
                            <Grid Grid.Row="1"
                                  ColumnDefinitions="Auto,*"
                                  ColumnSpacing="16"
                                  IsVisible="{Binding IsSignInRequiredVisible}">
                                <buttons:SfButton Text="Để sau"
                                                  Command="{Binding CloseCommand}"
                                                  Style="{StaticResource TextActionButton}"
                                                  Padding="4,0"
                                                  SemanticProperties.Description="Đóng biểu mẫu, không đăng nhập" />
                                <buttons:SfButton Grid.Column="1"
                                                  Text="Đăng nhập"
                                                  Command="{Binding SignInCommand}"
                                                  Style="{StaticResource PrimaryActionButton}"
                                                  AutomationId="ReportSignIn"
                                                  SemanticProperties.Description="Đăng nhập để gửi báo cáo" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </sheet:SfBottomSheet.BottomSheetContent>
    </sheet:SfBottomSheet>
</ContentPage>
