<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewModels="clr-namespace:RoomToRentRadar.Features.RoomDetail.ViewModels"
             xmlns:listings="clr-namespace:RoomToRentRadar.Shared.Listings;assembly=RoomToRentRadar.Shared"
             x:Class="RoomToRentRadar.Features.RoomDetail.Views.RoomDetailPage"
             x:DataType="viewModels:RoomDetailViewModel"
             Title="Room details"
             Shell.NavBarIsVisible="True"
             SafeAreaEdges="All">

    <Grid Padding="20"
          RowSpacing="16">

        <!-- Loading -->
        <ActivityIndicator IsRunning="{Binding IsLoadingVisible}"
                           IsVisible="{Binding IsLoadingVisible}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           SemanticProperties.Description="Loading room details" />

        <!-- Content -->
        <ScrollView IsVisible="{Binding IsContentVisible}">
            <VerticalStackLayout Spacing="16">
                <Border Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <HorizontalStackLayout Spacing="8">
                            <Border Padding="10,4"
                                    BackgroundColor="{StaticResource AccentSoft}"
                                    StrokeThickness="0"
                                    VerticalOptions="Center">
                                <Label Text="{Binding StatusText}"
                                       Style="{StaticResource Eyebrow}"
                                       TextColor="{StaticResource Accent}" />
                            </Border>
                            <Label Text="{Binding UpdatedOnText, StringFormat='Updated on {0}'}"
                                   Style="{StaticResource Caption}"
                                   VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <Label Text="{Binding Listing.Title}"
                               FontSize="24" FontFamily="OpenSansSemibold"
                               SemanticProperties.HeadingLevel="Level1" />
                        <Label Text="{Binding Listing.Price, StringFormat='{0:N0} VND'}"
                               FontSize="20" FontFamily="OpenSansSemibold"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label Text="{Binding Listing.Deposit, StringFormat='Deposit: {0:N0} VND'}"
                               Style="{StaticResource Caption}" />
                        <HorizontalStackLayout Spacing="12">
                            <Label Text="{Binding Listing.AreaM2, StringFormat='{0:N0} m²'}"
                                   Style="{StaticResource Caption}" />
                            <Label Text="{Binding RoomTypeText}"
                                   Style="{StaticResource Caption}" />
                            <Label Text="{Binding Listing.Bedrooms, StringFormat='{0} BR'}"
                                   Style="{StaticResource Caption}" />
                        </HorizontalStackLayout>
                        <Label Text="{Binding Listing.Address}"
                               Style="{StaticResource Caption}" />
                    </VerticalStackLayout>
                </Border>

                <VerticalStackLayout Spacing="4">
                    <Label Text="Description"
                           FontSize="18" FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="{Binding Listing.Description}"
                           Style="{StaticResource BodyText}" />
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasAmenities}">
                    <Label Text="Amenities"
                           FontSize="18" FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level2" />
                    <FlexLayout BindableLayout.ItemsSource="{Binding AmenityLabels}"
                                Direction="Row"
                                Wrap="Wrap"
                                JustifyContent="Start">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border Padding="10,6"
                                        Margin="0,0,8,8"
                                        BackgroundColor="{StaticResource SoftSurface}"
                                        StrokeThickness="0">
                                    <Label Text="{Binding .}"
                                           Style="{StaticResource Caption}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" IsVisible="{Binding HasRules}">
                    <Label Text="House rules"
                           FontSize="18" FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level2" />
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Rules}" Spacing="6">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Label Text="{Binding ., StringFormat='• {0}'}"
                                       Style="{StaticResource BodyText}" />
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <Border Padding="16">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="LANDLORD" Style="{StaticResource Eyebrow}" />
                        <Label Text="{Binding Listing.LandlordName}"
                               FontSize="16" FontFamily="OpenSansSemibold" />
                        <Label Text="{Binding LandlordPhone, StringFormat='Phone: {0}'}"
                               IsVisible="{Binding IsPhoneVisible}"
                               Style="{StaticResource BodyText}" />
                        <Label Text="Sign in to view the landlord's phone number."
                               IsVisible="{Binding IsSignInPromptVisible}"
                               Style="{StaticResource Caption}" />
                        <Button Text="Sign in"
                                Command="{Binding ShowLoginCommand}"
                                IsVisible="{Binding IsSignInPromptVisible}"
                                HorizontalOptions="Start"
                                SemanticProperties.Description="Sign in"
                                SemanticProperties.Hint="Signs in to reveal the landlord's phone number" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding PostedOnText, StringFormat='Posted on {0}'}"
                       Style="{StaticResource Caption}" />
            </VerticalStackLayout>
        </ScrollView>

        <!-- Unavailable -->
        <ScrollView IsVisible="{Binding IsUnavailableVisible}">
            <VerticalStackLayout Spacing="16">
                <Label Text="This room is no longer available"
                       FontSize="24" FontFamily="OpenSansSemibold"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="The owner has removed this listing or the room has already been rented. Details are no longer shown."
                       Style="{StaticResource BodyText}" />
                <Button Text="Back to listings"
                        Command="{Binding GoBackCommand}"
                        HorizontalOptions="Start"
                        SemanticProperties.Description="Back to listings"
                        SemanticProperties.Hint="Closes this room and returns to the list of rooms" />

                <VerticalStackLayout Spacing="8">
                    <Label Text="Similar rooms"
                           FontSize="18" FontFamily="OpenSansSemibold"
                           SemanticProperties.HeadingLevel="Level2" />

                    <ActivityIndicator IsRunning="{Binding IsSimilarLoading}"
                                       IsVisible="{Binding IsSimilarLoading}"
                                       HorizontalOptions="Start"
                                       SemanticProperties.Description="Loading similar rooms" />

                    <Label Text="{Binding SimilarStatusMessage}"
                           IsVisible="{Binding HasSimilarStatusMessage}"
                           Style="{StaticResource Caption}" />

                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding SimilarRooms}"
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="listings:ListingSummaryDto">
                                <Border Padding="14"
                                        Margin="0,0,0,8"
                                        SemanticProperties.Description="{Binding Title}">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnSimilarRoomTapped"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>
                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="{Binding Title}"
                                               FontSize="15" FontFamily="OpenSansSemibold"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding Address}"
                                               Style="{StaticResource Caption}"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="12">
                                            <Label Text="{Binding Price, StringFormat='{0:N0} VND'}"
                                                   Style="{StaticResource Caption}" />
                                            <Label Text="{Binding AreaM2, StringFormat='{0:N0} m²'}"
                                                   Style="{StaticResource Caption}" />
                                            <Label Text="{Binding Bedrooms, StringFormat='{0} BR'}"
                                                   Style="{StaticResource Caption}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Not found -->
        <VerticalStackLayout IsVisible="{Binding IsNotFoundVisible}"
                             Spacing="12"
                             VerticalOptions="Center">
            <Label Text="Listing not found"
                   FontSize="24" FontFamily="OpenSansSemibold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="This room does not exist or has been removed."
                   Style="{StaticResource BodyText}" />
            <Button Text="Back to listings"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="Back to listings"
                    SemanticProperties.Hint="Closes this screen and returns to the list of rooms" />
        </VerticalStackLayout>

        <!-- Error -->
        <VerticalStackLayout IsVisible="{Binding IsErrorVisible}"
                             Spacing="12"
                             VerticalOptions="Center">
            <Label Text="Could not load this room."
                   FontSize="24" FontFamily="OpenSansSemibold"
                   SemanticProperties.HeadingLevel="Level1" />
            <Label Text="Check your connection and try again."
                   Style="{StaticResource BodyText}" />
            <Button Text="Try again"
                    Command="{Binding LoadCommand}"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="Try again"
                    SemanticProperties.Hint="Reloads the details for this room" />
            <Button Text="Back to listings"
                    Command="{Binding GoBackCommand}"
                    HorizontalOptions="Start"
                    SemanticProperties.Description="Back to listings"
                    SemanticProperties.Hint="Closes this screen and returns to the list of rooms" />
        </VerticalStackLayout>
    </Grid>
</ContentPage>
