<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="RoomToRentRadar.Features.Profile.Views.ProfilePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:vm="clr-namespace:RoomToRentRadar.Features.Profile.ViewModels"
    x:DataType="vm:ProfileViewModel"
    Title="Hồ sơ cá nhân"
    BackgroundColor="{AppThemeBinding Light={StaticResource PageBackground}, Dark={StaticResource PageBackgroundDark}}"
    Shell.NavBarIsVisible="False">

    <Grid MaximumWidthRequest="760" RowDefinitions="Auto,*" RowSpacing="0">
        <Grid Grid.Row="0" Padding="16,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <Border
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                HeightRequest="44"
                MinimumHeightRequest="44"
                MinimumWidthRequest="44"
                SemanticProperties.Description="Mở menu chính"
                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                StrokeShape="RoundRectangle 14"
                StrokeThickness="1"
                WidthRequest="44">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnOpenMenuTapped" />
                </Border.GestureRecognizers>
                <Label
                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                    FontSize="22"
                    HorizontalOptions="Center"
                    Text="{x:Static f:FluentUI.navigation_24_regular}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                    VerticalOptions="Center" />
            </Border>

            <VerticalStackLayout Grid.Column="1" Spacing="1" VerticalOptions="Center">
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    FontSize="20"
                    Text="Hồ sơ cá nhân"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                <Label
                    FontSize="12.5"
                    Text="Quản lý thông tin tài khoản của bạn"
                    TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
            </VerticalStackLayout>
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,32" Spacing="18">
                <ActivityIndicator
                    Color="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                    IsRunning="{Binding IsBusy}"
                    IsVisible="{Binding IsBusy}"
                    VerticalOptions="Center" />

                <!-- Account summary -->
                <Border
                    Padding="20"
                    Background="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    StrokeShape="RoundRectangle 20"
                    StrokeThickness="1">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                        <Border
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                            HeightRequest="88"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 44"
                            StrokeThickness="1"
                            WidthRequest="88">
                            <Grid>
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="38"
                                    HorizontalOptions="Center"
                                    Text="{x:Static f:FluentUI.person_48_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                                <Image Aspect="AspectFill" Source="{Binding AvatarPreview}" />
                            </Grid>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="5" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="20"
                                LineBreakMode="TailTruncation"
                                MaxLines="1"
                                Text="{Binding FullName, TargetNullValue='Chưa cập nhật tên'}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                            <HorizontalStackLayout Spacing="6">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="15"
                                    Text="{x:Static f:FluentUI.mail_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                <Label
                                    FontSize="13"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="1"
                                    Text="{Binding AccountEmail}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                            </HorizontalStackLayout>
                            <Border
                                Padding="9,4"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                HorizontalOptions="Start"
                                StrokeShape="RoundRectangle 10"
                                StrokeThickness="0">
                                <HorizontalStackLayout Spacing="5">
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="13"
                                        Text="{x:Static f:FluentUI.badge_20_regular}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                    <Label
                                        FontAttributes="Bold"
                                        FontSize="12"
                                        Text="{Binding RoleDisplay}"
                                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                </HorizontalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </Border>

                <Button
                    BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                    BorderColor="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    BorderWidth="1"
                    Command="{Binding ChooseAvatarCommand}"
                    CornerRadius="14"
                    FontAttributes="Bold"
                    HeightRequest="48"
                    Text="Đổi ảnh đại diện"
                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />

                <Border
                    IsVisible="{Binding HasStatusMessage}"
                    Padding="12"
                    BackgroundColor="{AppThemeBinding Light={StaticResource AccentTealSoft}, Dark={StaticResource AccentTealSoftDark}}"
                    StrokeThickness="0">
                    <Label
                        FontSize="13"
                        Text="{Binding StatusMessage}"
                        TextColor="{AppThemeBinding Light={StaticResource AccentTeal}, Dark={StaticResource AccentTealDark}}" />
                </Border>

                <!-- Basic information -->
                <VerticalStackLayout Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="20"
                            Text="{x:Static f:FluentUI.person_20_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="18"
                            Text="Thông tin cá nhân"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                    </HorizontalStackLayout>
                    <Border
                        Padding="16"
                        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 18"
                        StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="13" Text="Họ và tên" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                <Entry ClearButtonVisibility="WhileEditing" Placeholder="Nhập họ và tên" Text="{Binding FullName}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="13" Text="Số điện thoại" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                <Entry ClearButtonVisibility="WhileEditing" Keyboard="Telephone" Placeholder="Ví dụ: 0912 345 678" Text="{Binding PhoneNumber}" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Spacing="5">
                                <Label FontAttributes="Bold" FontSize="13" Text="Giới thiệu ngắn" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                <Editor AutoSize="TextChanges" HeightRequest="92" Placeholder="Giới thiệu về bạn để chủ trọ hoặc người thuê hiểu hơn" Text="{Binding Bio}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Student fields -->
                <VerticalStackLayout IsVisible="{Binding IsStudent}" Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.hat_graduation_20_regular}" TextColor="{AppThemeBinding Light={StaticResource AccentHighlight}, Dark={StaticResource AccentHighlightDark}}" />
                        <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="18" Text="Thông tin sinh viên" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                    </HorizontalStackLayout>
                    <Border Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 18" StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Mã sinh viên" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập mã sinh viên" Text="{Binding StudentId}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Trường / Đại học" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập tên trường" Text="{Binding University}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Khoa / Chuyên ngành" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập khoa hoặc chuyên ngành" Text="{Binding Faculty}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Ngân sách tối đa mỗi tháng" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Keyboard="Numeric" Placeholder="Ví dụ: 2500000" Text="{Binding MaxBudgetText}" /></VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Landlord fields -->
                <VerticalStackLayout IsVisible="{Binding IsLandlord}" Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.building_20_regular}" TextColor="{AppThemeBinding Light={StaticResource AccentHighlight}, Dark={StaticResource AccentHighlightDark}}" />
                        <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="18" Text="Thông tin chủ trọ" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                    </HorizontalStackLayout>
                    <Border Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 18" StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Tên cơ sở / doanh nghiệp" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập tên cơ sở" Text="{Binding BusinessName}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Địa chỉ liên hệ" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập địa chỉ" Text="{Binding Address}" /></VerticalStackLayout>
                            <Border Padding="12" BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}" StrokeThickness="0">
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8"><Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="18" Text="{x:Static f:FluentUI.shield_checkmark_16_regular}" TextColor="{AppThemeBinding Light={StaticResource AccentTeal}, Dark={StaticResource AccentTealDark}}" /><VerticalStackLayout Grid.Column="1" Spacing="1"><Label FontAttributes="Bold" FontSize="12" Text="Trạng thái xác minh" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Label FontSize="13" Text="{Binding VerificationStatus, TargetNullValue='Chưa gửi xác minh'}" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" /></VerticalStackLayout></Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <!-- Administrator fields -->
                <VerticalStackLayout IsVisible="{Binding IsAdmin}" Spacing="10">
                    <HorizontalStackLayout Spacing="8">
                        <Label FontFamily="{x:Static f:FluentUI.FontFamily}" FontSize="20" Text="{x:Static f:FluentUI.briefcase_20_regular}" TextColor="{AppThemeBinding Light={StaticResource AccentHighlight}, Dark={StaticResource AccentHighlightDark}}" />
                        <Label FontAttributes="Bold" FontFamily="OpenSansSemibold" FontSize="18" Text="Thông tin quản trị" TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                    </HorizontalStackLayout>
                    <Border Padding="16" BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}" Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" StrokeShape="RoundRectangle 18" StrokeThickness="1">
                        <VerticalStackLayout Spacing="14">
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Mã nhân viên" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập mã nhân viên" Text="{Binding StaffCode}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Phòng ban" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập phòng ban" Text="{Binding Department}" /></VerticalStackLayout>
                            <VerticalStackLayout Spacing="5"><Label FontAttributes="Bold" FontSize="13" Text="Chức danh" TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" /><Entry Placeholder="Nhập chức danh" Text="{Binding JobTitle}" /></VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>

                <Button
                    Background="{StaticResource PrimaryBrandGradient}"
                    Command="{Binding SaveCommand}"
                    CornerRadius="16"
                    FontAttributes="Bold"
                    HeightRequest="54"
                    Text="Lưu thay đổi"
                    TextColor="White" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
