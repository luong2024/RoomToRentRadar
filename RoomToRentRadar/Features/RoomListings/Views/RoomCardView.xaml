<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RoomToRentRadar.Features.RoomListings.Views.RoomCardView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:f="clr-namespace:Fonts"
    xmlns:loc="clr-namespace:RoomToRentRadar.Core.Localization"
    xmlns:models="clr-namespace:RoomToRentRadar.Features.RoomListings.Models"
    xmlns:vm="clr-namespace:RoomToRentRadar.Features.RoomListings.ViewModels"
    x:DataType="models:RoomListItemModel">

    <Border
        Padding="0"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
        StrokeShape="RoundRectangle 18"
        StrokeThickness="1">
        <Border.Shadow>
            <Shadow
                Brush="{StaticResource Black}"
                Offset="0,6"
                Opacity="0.06"
                Radius="16" />
        </Border.Shadow>

        <VerticalStackLayout Spacing="0">
            <!-- 16:10 Hero Image Section -->
            <Border
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                HeightRequest="214"
                StrokeShape="RoundRectangle 18,18,0,0"
                StrokeThickness="0">
                <Grid>
                    <!-- Placeholder Icon -->
                    <Label
                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                        FontSize="36"
                        HorizontalOptions="Center"
                        Text="{x:Static f:FluentUI.building_home_24_regular}"
                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                        VerticalOptions="Center" />

                    <!-- Property Photo -->
                    <Image
                        Aspect="AspectFill"
                        HeightRequest="214"
                        Source="{Binding ThumbnailUrl}" />

                    <!-- Top Gradient Scrim -->
                    <BoxView HeightRequest="64" VerticalOptions="Start">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0.0" Color="{StaticResource ScrimStart}" />
                                <GradientStop Offset="1.0" Color="{StaticResource ScrimEnd}" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Bottom Gradient Scrim for Distance Overlay -->
                    <BoxView HeightRequest="64" VerticalOptions="End">
                        <BoxView.Background>
                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                <GradientStop Offset="0.0" Color="{StaticResource ScrimStart}" />
                                <GradientStop Offset="1.0" Color="{StaticResource ScrimEnd}" />
                            </LinearGradientBrush>
                        </BoxView.Background>
                    </BoxView>

                    <!-- Top Row: Verified Badge (Left) + Favorite Heart Action (Top-Right, 44x44) -->
                    <Grid
                        Padding="12"
                        ColumnDefinitions="Auto,*,Auto"
                        VerticalOptions="Start">

                        <Border
                            Grid.Column="0"
                            Padding="10,5"
                            BackgroundColor="{AppThemeBinding Light={StaticResource VerifiedBadgeBg}, Dark={StaticResource VerifiedBadgeBgDark}}"
                            IsVisible="{Binding IsVerified}"
                            StrokeShape="RoundRectangle 10"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="15"
                                    Text="{x:Static f:FluentUI.shield_checkmark_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11.5"
                                    Text="{loc:Translate Card_Verified}"
                                    TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Favorite Heart Button (44x44 Touch Target) -->
                        <Border
                            Grid.Column="2"
                            Padding="0"
                            BackgroundColor="{AppThemeBinding Light={StaticResource FavoriteButtonBg}, Dark={StaticResource FavoriteButtonBgDark}}"
                            HeightRequest="44"
                            HorizontalOptions="End"
                            MinimumHeightRequest="44"
                            MinimumWidthRequest="44"
                            SemanticProperties.Description="Favorite room"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 22"
                            StrokeThickness="1"
                            VerticalOptions="Start"
                            WidthRequest="44">
                            <Border.Triggers>
                                <DataTrigger
                                    Binding="{Binding IsFavorite}"
                                    TargetType="Border"
                                    Value="True">
                                    <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource FavoriteButtonActiveBg}, Dark={StaticResource FavoriteButtonActiveBgDark}}" />
                                    <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource FavoriteHeartActive}, Dark={StaticResource FavoriteHeartActiveDark}}" />
                                </DataTrigger>
                            </Border.Triggers>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ToggleFavoriteCommand}" />
                            </Border.GestureRecognizers>

                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="20"
                                HorizontalOptions="Center"
                                Text="{x:Static f:FluentUI.heart_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center">
                                <Label.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsFavorite}"
                                        TargetType="Label"
                                        Value="True">
                                        <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource FavoriteHeartActive}, Dark={StaticResource FavoriteHeartActiveDark}}" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>
                        </Border>
                    </Grid>

                    <!-- Bottom Overlay: Subtle Distance Pill -->
                    <Border
                        Margin="12"
                        Padding="10,5"
                        BackgroundColor="{StaticResource DistanceOverlayBg}"
                        HorizontalOptions="Start"
                        StrokeShape="RoundRectangle 10"
                        StrokeThickness="0"
                        VerticalOptions="End">
                        <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="14"
                                Text="{x:Static f:FluentUI.location_16_regular}"
                                TextColor="{StaticResource White}"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="12"
                                Text="{Binding FormattedDistance}"
                                TextColor="{StaticResource White}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </Border>

            <!-- Card Body -->
            <VerticalStackLayout Padding="16,14,16,16" Spacing="10">

                <!-- Row 1: Prominent Rental Price + Compact Availability & Area Metadata -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontAttributes="Bold"
                        FontFamily="OpenSansSemibold"
                        FontSize="20"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding FormattedPrice}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                        VerticalOptions="Center" />

                    <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                        <!-- Availability Metadata Pill -->
                        <Border
                            Padding="8,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource VerifiedBadgeBg}, Dark={StaticResource VerifiedBadgeBgDark}}"
                            IsVisible="{Binding IsAvailable}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="0"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="5" VerticalOptions="Center">
                                <Border
                                    BackgroundColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    HeightRequest="6"
                                    StrokeShape="RoundRectangle 3"
                                    StrokeThickness="0"
                                    VerticalOptions="Center"
                                    WidthRequest="6" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="11.5"
                                    Text="{loc:Translate Card_Available}"
                                    TextColor="{AppThemeBinding Light={StaticResource VerifiedBadgeText}, Dark={StaticResource VerifiedBadgeTextDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>

                        <!-- Area Metadata Pill -->
                        <Border
                            Padding="8,4"
                            BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                            Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            StrokeShape="RoundRectangle 8"
                            StrokeThickness="1"
                            VerticalOptions="Center">
                            <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="14"
                                    Text="{x:Static f:FluentUI.ruler_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    Text="{Binding FormattedArea}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>
                        </Border>
                    </HorizontalStackLayout>
                </Grid>

                <!-- Row 2: Two-Line Property Title -->
                <Label
                    FontAttributes="Bold"
                    FontFamily="OpenSansSemibold"
                    FontSize="16"
                    LineBreakMode="TailTruncation"
                    LineHeight="1.25"
                    MaxLines="2"
                    Text="{Binding Title}"
                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />

                <!-- Row 3: Location with MapPin Icon -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                    <Label
                        Grid.Column="0"
                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                        FontSize="16"
                        Text="{x:Static f:FluentUI.location_16_regular}"
                        TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                        VerticalOptions="Center" />
                    <Label
                        Grid.Column="1"
                        FontSize="13"
                        LineBreakMode="TailTruncation"
                        MaxLines="1"
                        Text="{Binding Address}"
                        TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                        VerticalOptions="Center" />
                </Grid>

                <!-- Divider -->
                <BoxView
                    Margin="0,2,0,2"
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                <!-- Row 4: Compact Amenity Chips + Accessible "Xem chi tiết" Action -->
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10" VerticalOptions="Center">
                    <FlexLayout
                        Grid.Column="0"
                        AlignItems="Center"
                        BindableLayout.ItemsSource="{Binding PreviewAmenities}"
                        Direction="Row"
                        Wrap="Wrap">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <Border
                                    Margin="0,2,6,2"
                                    Padding="9,5"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                    Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                    StrokeShape="RoundRectangle 8"
                                    StrokeThickness="1">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="11.5"
                                        Text="{Binding .}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </FlexLayout>

                    <Border
                        Grid.Column="1"
                        Padding="14,10"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                        MinimumHeightRequest="44"
                        MinimumWidthRequest="44"
                        SemanticProperties.Description="View room details"
                        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                        StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer
                                Command="{Binding Source={RelativeSource AncestorType={x:Type vm:RoomListingsViewModel}}, Path=OpenRoomDetailsCommand, x:DataType=vm:RoomListingsViewModel}"
                                CommandParameter="{Binding .}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="4" VerticalOptions="Center">
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="13"
                                Text="{loc:Translate Card_ViewDetails}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="15"
                                Text="{x:Static f:FluentUI.chevron_right_16_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>
                    </Border>
                </Grid>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </Border>
</ContentView>
