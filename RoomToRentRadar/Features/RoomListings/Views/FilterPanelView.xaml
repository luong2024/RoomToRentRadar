<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="RoomToRentRadar.Features.RoomListings.Views.FilterPanelView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:behaviors="clr-namespace:RoomToRentRadar.Shared.Behaviors"
    xmlns:f="clr-namespace:Fonts"
    xmlns:loc="clr-namespace:RoomToRentRadar.Core.Localization"
    xmlns:vm="clr-namespace:RoomToRentRadar.Features.RoomListings.ViewModels"
    x:Name="FilterPanelRoot"
    x:DataType="vm:RoomListingsViewModel">

    <!-- Bottom Sheet Container (50% Mobile Screen Height) -->
    <Border
        x:Name="FilterMenuBorder"
        Padding="0"
        BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
        HeightRequest="420"
        HorizontalOptions="Fill"
        MaximumWidthRequest="540"
        Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
        StrokeShape="RoundRectangle 26,26,0,0"
        StrokeThickness="1"
        VerticalOptions="End">
        <Border.Shadow>
            <Shadow
                Brush="{StaticResource Black}"
                Offset="0,-6"
                Opacity="0.14"
                Radius="20" />
        </Border.Shadow>

        <Grid RowDefinitions="Auto,*,Auto">

            <!-- 1. Sheet Header: Drag Handle + Title & Subtitle + Close (X) -->
            <VerticalStackLayout
                Grid.Row="0"
                Padding="20,10,16,10"
                Spacing="8">
                <!-- Top Drag Handle Pill -->
                <Border
                    BackgroundColor="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                    HeightRequest="5"
                    HorizontalOptions="Center"
                    StrokeShape="RoundRectangle 3"
                    StrokeThickness="0"
                    WidthRequest="44" />

                <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                    <VerticalStackLayout Grid.Column="0" Spacing="2" VerticalOptions="Center">
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="20"
                            Text="{loc:Translate Filter_SheetTitle}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                        <Label
                            FontSize="12.5"
                            Text="{loc:Translate Filter_SheetSubtitle}"
                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}" />
                    </VerticalStackLayout>

                    <!-- Close X Button (40x40 Touch Target) -->
                    <Border
                        Grid.Column="1"
                        Padding="0"
                        BackgroundColor="Transparent"
                        HeightRequest="40"
                        MinimumHeightRequest="40"
                        MinimumWidthRequest="40"
                        StrokeShape="RoundRectangle 20"
                        StrokeThickness="0"
                        VerticalOptions="Start"
                        WidthRequest="40">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding CloseFilterPanelCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontFamily="{x:Static f:FluentUI.FontFamily}"
                            FontSize="20"
                            HorizontalOptions="Center"
                            Text="{x:Static f:FluentUI.dismiss_20_regular}"
                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>

                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />
            </VerticalStackLayout>

            <!-- 2. Scrollable Filter Form Body -->
            <ScrollView
                Grid.Row="1"
                Padding="20,4,20,12"
                VerticalScrollBarVisibility="Default">
                <VerticalStackLayout Spacing="16">

                    <!-- SECTION A: Price Range -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="18"
                                Text="{x:Static f:FluentUI.tag_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="{loc:Translate Filter_PriceRange}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- 3 Price Preset Pills: Under 1M | 1M - 2M | 2M - 3M -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <!-- Pill 1: Under 1M -->
                            <Border
                                Grid.Column="0"
                                Padding="8,9"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                MinimumHeightRequest="40"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPriceUnder1MSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectPricePresetCommand}"
                                        CommandParameter="under1m" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12.5"
                                        Text="{loc:Translate Filter_PriceUnder1M}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPriceUnder1MSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="13"
                                        IsVisible="{Binding IsPriceUnder1MSelected}"
                                        Text="{x:Static f:FluentUI.checkmark_16_regular}"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Pill 2: 1M - 2M -->
                            <Border
                                Grid.Column="1"
                                Padding="8,9"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                MinimumHeightRequest="40"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPrice1MTo2MSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectPricePresetCommand}"
                                        CommandParameter="1m-2m" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12.5"
                                        Text="{loc:Translate Filter_Price1MTo2M}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPrice1MTo2MSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="13"
                                        IsVisible="{Binding IsPrice1MTo2MSelected}"
                                        Text="{x:Static f:FluentUI.checkmark_16_regular}"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>

                            <!-- Pill 3: 2M - 3M -->
                            <Border
                                Grid.Column="2"
                                Padding="8,9"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                MinimumHeightRequest="40"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 20"
                                StrokeThickness="1">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPrice2MTo3MSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                        <Setter Property="StrokeThickness" Value="0" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectPricePresetCommand}"
                                        CommandParameter="2m-3m" />
                                </Border.GestureRecognizers>
                                <HorizontalStackLayout HorizontalOptions="Center" Spacing="4" VerticalOptions="Center">
                                    <Label
                                        FontFamily="OpenSansSemibold"
                                        FontSize="12.5"
                                        Text="{loc:Translate Filter_Price2MTo3M}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                        VerticalOptions="Center">
                                        <Label.Triggers>
                                            <DataTrigger
                                                Binding="{Binding IsPrice2MTo3MSelected}"
                                                TargetType="Label"
                                                Value="True">
                                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                                <Setter Property="FontAttributes" Value="Bold" />
                                            </DataTrigger>
                                        </Label.Triggers>
                                    </Label>
                                    <Label
                                        FontFamily="{x:Static f:FluentUI.FontFamily}"
                                        FontSize="13"
                                        IsVisible="{Binding IsPrice2MTo3MSelected}"
                                        Text="{x:Static f:FluentUI.checkmark_16_regular}"
                                        TextColor="{StaticResource White}"
                                        VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Min Price & Max Price Numeric Entry Boxes -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Min Price Box -->
                            <Border
                                Grid.Column="0"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="{loc:Translate Filter_MinPrice}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Entry
                                            Grid.Column="0"
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            Keyboard="Numeric"
                                            StyleId="BorderlessEntry"
                                            Text="{Binding FilterMinPriceText}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}">
                                            <Entry.Behaviors>
                                                <behaviors:ThousandSeparatorBehavior />
                                            </Entry.Behaviors>
                                        </Entry>
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="₫"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                            TextDecorations="Underline"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Max Price Box -->
                            <Border
                                Grid.Column="1"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="{loc:Translate Filter_MaxPrice}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Entry
                                            Grid.Column="0"
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            Keyboard="Numeric"
                                            StyleId="BorderlessEntry"
                                            Text="{Binding FilterMaxPriceText}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}">
                                            <Entry.Behaviors>
                                                <behaviors:ThousandSeparatorBehavior />
                                            </Entry.Behaviors>
                                        </Entry>
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="₫"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                            TextDecorations="Underline"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Price Validation Error Indicator (Red Text) -->
                        <Label
                            FontSize="12"
                            FontFamily="OpenSansSemibold"
                            IsVisible="{Binding HasPriceError}"
                            Text="{Binding PriceErrorMessage}"
                            TextColor="{StaticResource Error}" />
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                    <!-- SECTION B: Area Range -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="18"
                                Text="{x:Static f:FluentUI.arrow_autofit_content_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="{loc:Translate Filter_AreaRange}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Min Area & Max Area Boxes -->
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                            <!-- Min Area Box -->
                            <Border
                                Grid.Column="0"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="{loc:Translate Filter_MinArea}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Entry
                                            Grid.Column="0"
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            Keyboard="Numeric"
                                            Placeholder="15"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                            StyleId="BorderlessEntry"
                                            Text="{Binding FilterMinAreaText}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="m²"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <!-- Max Area Box -->
                            <Border
                                Grid.Column="1"
                                Padding="12,8"
                                BackgroundColor="{AppThemeBinding Light={StaticResource SurfaceSubtle}, Dark={StaticResource SurfaceSubtleDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 12"
                                StrokeThickness="1">
                                <VerticalStackLayout Spacing="2">
                                    <Label
                                        FontSize="11"
                                        Text="{loc:Translate Filter_MaxArea}"
                                        TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                                    <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                                        <Entry
                                            Grid.Column="0"
                                            BackgroundColor="Transparent"
                                            FontAttributes="Bold"
                                            FontFamily="OpenSansSemibold"
                                            FontSize="14"
                                            Keyboard="Numeric"
                                            Placeholder="35"
                                            PlaceholderColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}"
                                            StyleId="BorderlessEntry"
                                            Text="{Binding FilterMaxAreaText}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}" />
                                        <Label
                                            Grid.Column="1"
                                            FontAttributes="Bold"
                                            FontSize="13"
                                            Text="m²"
                                            TextColor="{AppThemeBinding Light={StaticResource TextSecondarySlate}, Dark={StaticResource TextSecondarySlateDark}}"
                                            VerticalOptions="Center" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>
                        </Grid>

                        <!-- Area Validation Error Indicator (Red Text) -->
                        <Label
                            FontSize="12"
                            FontFamily="OpenSansSemibold"
                            IsVisible="{Binding HasAreaError}"
                            Text="{Binding AreaErrorMessage}"
                            TextColor="{StaticResource Error}" />
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                    <!-- SECTION C: Distance Slider -->
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto" VerticalOptions="Center">
                            <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                                <Label
                                    FontFamily="{x:Static f:FluentUI.FontFamily}"
                                    FontSize="18"
                                    Text="{x:Static f:FluentUI.location_16_regular}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                    VerticalOptions="Center" />
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="15"
                                    Text="{loc:Translate Filter_Distance}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                    VerticalOptions="Center" />
                            </HorizontalStackLayout>

                            <!-- Live Radius Badge -->
                            <Border
                                Grid.Column="1"
                                Padding="8,4"
                                BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}"
                                StrokeShape="RoundRectangle 8"
                                StrokeThickness="0"
                                VerticalOptions="Center">
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    Text="{Binding FormattedRadius}"
                                    TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                            </Border>
                        </Grid>

                        <Slider
                            Maximum="20"
                            MaximumTrackColor="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                            Minimum="1"
                            MinimumTrackColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            ThumbColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            Value="{Binding RadiusInKm, Mode=TwoWay}" />

                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Label
                                Grid.Column="0"
                                FontSize="11"
                                Text="1 km"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                            <Label
                                Grid.Column="1"
                                FontSize="11"
                                HorizontalOptions="Center"
                                Text="ĐH CNTT&amp;TT (ICTU)"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                            <Label
                                Grid.Column="2"
                                FontSize="11"
                                Text="20 km"
                                TextColor="{AppThemeBinding Light={StaticResource TextMutedSlate}, Dark={StaticResource TextMutedSlateDark}}" />
                        </Grid>
                    </VerticalStackLayout>

                    <BoxView
                        HeightRequest="1"
                        Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                    <!-- SECTION D: Room Type -->
                    <VerticalStackLayout Spacing="10">
                        <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                            <Label
                                FontFamily="{x:Static f:FluentUI.FontFamily}"
                                FontSize="18"
                                Text="{x:Static f:FluentUI.home_20_regular}"
                                TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                                VerticalOptions="Center" />
                            <Label
                                FontAttributes="Bold"
                                FontFamily="OpenSansSemibold"
                                FontSize="15"
                                Text="{loc:Translate Filter_RoomType}"
                                TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                VerticalOptions="Center" />
                        </HorizontalStackLayout>

                        <!-- Room Type Option Buttons: Tất cả | Khép kín | Ở ghép -->
                        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                            <!-- Option 1: All -->
                            <Border
                                Grid.Column="0"
                                Padding="8,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1.2">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsAllRoomTypeSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectRoomTypeCommand}"
                                        CommandParameter="all" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{loc:Translate Filter_AllRooms}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                    VerticalOptions="Center" />
                            </Border>

                            <!-- Option 2: Private Room -->
                            <Border
                                Grid.Column="1"
                                Padding="8,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1.2">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsPrivateRoomSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectRoomTypeCommand}"
                                        CommandParameter="private" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{loc:Translate Filter_PrivateRoom}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                    VerticalOptions="Center" />
                            </Border>

                            <!-- Option 3: Shared Room -->
                            <Border
                                Grid.Column="2"
                                Padding="8,10"
                                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                                Stroke="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}"
                                StrokeShape="RoundRectangle 14"
                                StrokeThickness="1.2">
                                <Border.Triggers>
                                    <DataTrigger
                                        Binding="{Binding IsSharedRoomSelected}"
                                        TargetType="Border"
                                        Value="True">
                                        <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource PrimaryBrandSoft}, Dark={StaticResource PrimaryBrandSoftDark}}" />
                                        <Setter Property="Stroke" Value="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}" />
                                    </DataTrigger>
                                </Border.Triggers>
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding SelectRoomTypeCommand}"
                                        CommandParameter="shared" />
                                </Border.GestureRecognizers>
                                <Label
                                    FontAttributes="Bold"
                                    FontFamily="OpenSansSemibold"
                                    FontSize="12"
                                    HorizontalOptions="Center"
                                    Text="{loc:Translate Filter_SharedRoom}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimarySlate}, Dark={StaticResource TextPrimarySlateDark}}"
                                    VerticalOptions="Center" />
                            </Border>
                        </Grid>
                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>

            <!-- 3. Sticky Footer: Reset All + Apply CTA -->
            <VerticalStackLayout
                Grid.Row="2"
                Padding="20,10,20,14"
                BackgroundColor="{AppThemeBinding Light={StaticResource CardBackground}, Dark={StaticResource CardBackgroundDark}}"
                Spacing="10">
                <BoxView
                    HeightRequest="1"
                    Color="{AppThemeBinding Light={StaticResource BorderSubtle}, Dark={StaticResource BorderSubtleDark}}" />

                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16" VerticalOptions="Center">
                    <!-- Reset All Button -->
                    <Border
                        Grid.Column="0"
                        Padding="12,10"
                        BackgroundColor="Transparent"
                        MinimumHeightRequest="44"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ResetFiltersCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="14.5"
                            Text="{loc:Translate Filter_ResetAll}"
                            TextColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                            VerticalOptions="Center" />
                    </Border>

                    <!-- Apply Primary CTA Button -->
                    <Border
                        Grid.Column="1"
                        Padding="16,12"
                        BackgroundColor="{AppThemeBinding Light={StaticResource PrimaryBrand}, Dark={StaticResource PrimaryBrandDark}}"
                        IsEnabled="{Binding IsFilterValid}"
                        MinimumHeightRequest="48"
                        StrokeShape="RoundRectangle 16"
                        StrokeThickness="0"
                        VerticalOptions="Center">
                        <Border.Triggers>
                            <DataTrigger
                                Binding="{Binding IsFilterValid}"
                                TargetType="Border"
                                Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ApplyFiltersCommand}" />
                        </Border.GestureRecognizers>
                        <Label
                            FontAttributes="Bold"
                            FontFamily="OpenSansSemibold"
                            FontSize="15"
                            HorizontalOptions="Center"
                            Text="{Binding FilterShowResultsText}"
                            TextColor="{StaticResource White}"
                            VerticalOptions="Center" />
                    </Border>
                </Grid>
            </VerticalStackLayout>

        </Grid>
    </Border>

</ContentView>
