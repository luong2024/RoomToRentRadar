<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomToRentRadar.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SixLabors.ImageSharp" Version="4.1.3" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.1.7" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RoomToRentRadar.Shared\RoomToRentRadar.Shared.csproj" />
  </ItemGroup>

  <Target Name="KillRunningApiProcess" BeforeTargets="PrepareForBuild">
    <Exec Command="taskkill /F /IM RoomToRentRadar.Api.exe 2&gt;nul &amp; exit /b 0" IgnoreExitCode="true" />
  </Target>

</Project>
