<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomToRentRadar.Api</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Share pure C# Contracts and Core layers directly from RoomToRentRadar -->
    <Compile Include="..\RoomToRentRadar\Contracts\**\*.cs" LinkBase="Contracts" />
    <Compile Include="..\RoomToRentRadar\Core\**\*.cs" LinkBase="Core" />
  </ItemGroup>

</Project>

