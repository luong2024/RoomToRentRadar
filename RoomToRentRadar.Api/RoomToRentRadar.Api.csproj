    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>RoomToRentRadar.Api</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
