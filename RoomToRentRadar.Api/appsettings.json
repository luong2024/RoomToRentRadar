{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "DatabaseProvider": "Sqlite",
  "CosmosDb": {
    "EndpointUri": "https://localhost:8081",
    "DatabaseName": "RoomToRentRadarDb",
    "ContainerName": "Rooms",
    "UsersContainerName": "Users"
  },
  "Sqlite": {
    "ConnectionString": "Data Source=roomtorentradar.db"
  },
  "Media": {
    "RootPath": "uploads",
    "PublicBaseUrl": ""
  },
  "Jwt": {
    "Issuer": "RoomToRentRadar.Api",
    "Audience": "RoomToRentRadar.Client",
    "AccessTokenExpirationMinutes": 30,
    "RefreshTokenExpirationDays": 7
  },
  "IctuSso": {
    "UseMockVerifier": false
  }
}
