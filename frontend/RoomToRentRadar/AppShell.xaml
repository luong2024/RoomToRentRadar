<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="RoomToRentRadar.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:sf="clr-namespace:Syncfusion.Maui.Toolkit.SegmentedControl;assembly=Syncfusion.Maui.Toolkit"
    xmlns:home="clr-namespace:RoomToRentRadar.Features.Home"
    xmlns:auth="clr-namespace:RoomToRentRadar.Features.Auth"
    xmlns:rooms="clr-namespace:RoomToRentRadar.Features.Rooms"
    Shell.FlyoutBehavior="Flyout"
    Title="RoomToRentRadar - ICTU">

    <!-- Baseline Home Screen: MUST stay the first ShellContent, because Shell opens its first item at startup. -->
    <ShellContent
        Title="Trang chủ ICTU Radar"
        Icon="{StaticResource IconDashboard}"
        ContentTemplate="{DataTemplate home:HomePage}"
        Route="home"
        SemanticProperties.Description="Trang chủ RoomToRentRadar"
        SemanticProperties.Hint="Màn hình khởi động RoomToRentRadar"/>

    <!-- ========================================================================= -->
    <!-- ROOMTORENTRADAR SPRINT 1 MENU ZONES (CONFLICT-FREE DEVELOPER ZONES)       -->
    <!-- Route registration for non-flyout pages goes in your FeatureModule.cs!    -->
    <!-- Only add Flyout ShellContent inside your own designated zone below.       -->
    <!-- ========================================================================= -->

    <!-- [ZONE 2: LAM MINH HIEU - T02.2 RoomListPage, T06.1 RoomMapPage, T07.2 FavoritesPage, T11.1 RoomComparePage] -->
    <!-- T02.2: route "room-list-menu" (not "room-list") because "room-list" is already registered in RoomsFeatureModule. -->
    <ShellContent
        Title="Danh sách phòng"
        Icon="{StaticResource IconProjects}"
        ContentTemplate="{DataTemplate rooms:RoomListPage}"
        Route="room-list-menu"
        SemanticProperties.Description="Danh sách phòng trọ đã xác thực"
        SemanticProperties.Hint="Khám phá phòng trọ quanh ICTU"/>

    <!-- [ZONE 1: LEAD DEV NGUYEN DANG QUANG - T09.1 PublishListingPage] -->

    <!-- [ZONE 3: PHAM THI THUY - T13.2 ReportListingModalPage] -->

    <!-- [ZONE 4: LIEU HAI NAM - T01.2 LoginPage, T08.2 SearchAlertsPage] -->
    <!-- T01.2: route "login-menu" (not "login") because "login"/"register" are already registered in AuthFeatureModule. -->
    <ShellContent
        Title="Đăng nhập / Đăng ký"
        Icon="{StaticResource IconMeta}"
        ContentTemplate="{DataTemplate auth:LoginPage}"
        Route="login-menu"
        SemanticProperties.Description="Đăng nhập hoặc tạo tài khoản RoomToRentRadar"/>

    <Shell.FlyoutFooter>
        <Grid Padding="15">
            <sf:SfSegmentedControl x:Name="ThemeSegmentedControl" 
                VerticalOptions="Center" HorizontalOptions="Center" SelectionChanged="SfSegmentedControl_SelectionChanged"
                SegmentWidth="40" SegmentHeight="40">
                <sf:SfSegmentedControl.ItemsSource>
                    <x:Array Type="{x:Type sf:SfSegmentItem}">
                        <sf:SfSegmentItem ImageSource="{StaticResource IconLight}" SemanticProperties.Description="Light mode"/>
                        <sf:SfSegmentItem ImageSource="{StaticResource IconDark}" SemanticProperties.Description="Dark mode"/>
                    </x:Array>
                </sf:SfSegmentedControl.ItemsSource>
            </sf:SfSegmentedControl>
        </Grid>
    </Shell.FlyoutFooter>

</Shell>
