<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:RoomToRentRadar.Models;assembly=RoomToRentRadar.Core"
             xmlns:rooms="clr-namespace:RoomToRentRadar.Features.Rooms"
             xmlns:controls="clr-namespace:RoomToRentRadar.Pages.Controls"
             xmlns:pullToRefresh="clr-namespace:Syncfusion.Maui.Toolkit.PullToRefresh;assembly=Syncfusion.Maui.Toolkit"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:fonts="clr-namespace:Fonts"
             x:Class="RoomToRentRadar.Features.Rooms.RoomListPage"
             x:DataType="rooms:RoomListPageModel"
             Title="Phòng trọ gần ICTU">

    <ContentPage.Resources>
        <ResourceDictionary>
            <toolkit:InvertedBoolConverter x:Key="InvertedBoolConverter" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <Grid RowDefinitions="Auto, *">

        <!-- HEADER, SEARCH & SORT BAR -->
        <VerticalStackLayout Grid.Row="0"
                             Padding="{StaticResource LayoutPadding}"
                             Spacing="12"
                             BackgroundColor="{AppThemeBinding Light={StaticResource LightBackground}, Dark={StaticResource DarkBackground}}">

            <!-- Title & Campus Subtitle (US02 AC1) -->
            <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Phòng trọ gần ICTU"
                           Style="{StaticResource Title2}"
                           FontAttributes="Bold" />
                    <Label Text="Sắp xếp theo khoảng cách gần trường nhất"
                           FontSize="12"
                           TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}" />
                </VerticalStackLayout>

                <!-- Map Button Shortcut (US06 Integration) -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray300}, Dark={StaticResource Gray600}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                        HeightRequest="40"
                        WidthRequest="40"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToMapCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.map_24_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="20"
                           TextColor="{StaticResource Primary}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Entry point to the filter screen (search/filters belong to US05 / T05.2, not to this list) -->
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
                <Border Grid.Column="0"
                        StrokeShape="RoundRectangle 12"
                        Stroke="{AppThemeBinding Light={StaticResource Gray200}, Dark={StaticResource Gray600}}"
                        StrokeThickness="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource DarkSecondaryBackground}}"
                        Padding="12, 0"
                        HeightRequest="44">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFilterCommand}" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto, *">
                        <Label Grid.Column="0"
                               Text="{x:Static fonts:FluentUI.search_24_regular}"
                               FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                               FontSize="18"
                               TextColor="{StaticResource Gray400}"
                               VerticalOptions="Center"
                               Margin="0, 0, 8, 0" />
                        <Label Grid.Column="1"
                               Text="Lọc theo giá, diện tích, khoảng cách..."
                               FontSize="14"
                               TextColor="{StaticResource Gray400}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Filter Modal Button -->
                <Border Grid.Column="1"
                        StrokeShape="RoundRectangle 12"
                        Stroke="Transparent"
                        BackgroundColor="{StaticResource Primary}"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        VerticalOptions="Center">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding NavigateToFilterCommand}" />
                    </Border.GestureRecognizers>
                    <Label Text="{x:Static fonts:FluentUI.filter_24_regular}"
                           FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                           FontSize="20"
                           TextColor="{StaticResource White}"
                           HorizontalOptions="Center"
                           VerticalOptions="Center" />
                </Border>
            </Grid>

            <!-- Sorting chips (US02 AC1: DistanceAsc is the default). Keys match GET /api/rooms;
                 the chip of the current SelectedSortBy is highlighted by a DataTrigger. -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="8">
                    <HorizontalStackLayout.Resources>
                        <Style x:Key="SortChip" TargetType="Button">
                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource DarkSecondaryBackground}}" />
                            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource DarkOnLightBackground}, Dark={StaticResource LightOnDarkBackground}}" />
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="CornerRadius" Value="16" />
                            <Setter Property="HeightRequest" Value="32" />
                            <Setter Property="Padding" Value="12, 0" />
                        </Style>
                    </HorizontalStackLayout.Resources>

                    <Button Text="📍 Gần ICTU nhất"
                            Style="{StaticResource SortChip}"
                            Command="{Binding ChangeSortByCommand}"
                            CommandParameter="DistanceAsc"
                            AutomationId="SortDistanceButton">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSortBy}" Value="DistanceAsc">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="💰 Giá thấp nhất"
                            Style="{StaticResource SortChip}"
                            Command="{Binding ChangeSortByCommand}"
                            CommandParameter="PriceAsc"
                            AutomationId="SortPriceAscButton">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSortBy}" Value="PriceAsc">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>

                    <Button Text="💎 Giá cao nhất"
                            Style="{StaticResource SortChip}"
                            Command="{Binding ChangeSortByCommand}"
                            CommandParameter="PriceDesc"
                            AutomationId="SortPriceDescButton">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding SelectedSortBy}" Value="PriceDesc">
                                <Setter Property="BackgroundColor" Value="{StaticResource Primary}" />
                                <Setter Property="TextColor" Value="{StaticResource White}" />
                                <Setter Property="FontAttributes" Value="Bold" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- Load/navigation error with retry (instead of silently showing an empty list) -->
            <Border IsVisible="{Binding HasError}"
                    Padding="12,8"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="{AppThemeBinding Light=#FDECEA, Dark=#5C1F1A}">
                <Grid ColumnDefinitions="*, Auto" ColumnSpacing="8">
                    <Label Text="{Binding ErrorMessage}"
                           TextColor="{AppThemeBinding Light=#B3261E, Dark=#F2B8B5}"
                           VerticalOptions="Center"
                           AutomationId="RoomListErrorLabel" />
                    <Button Grid.Column="1"
                            Text="Thử lại"
                            Command="{Binding LoadRoomsCommand}"
                            FontSize="12"
                            HeightRequest="32"
                            Padding="12,0"
                            CornerRadius="16"
                            AutomationId="RoomListRetryButton" />
                </Grid>
            </Border>

        </VerticalStackLayout>

        <!-- MAIN LIST WITH PULL-TO-REFRESH & INFINITE SCROLL (US02 AC3) -->
        <Grid Grid.Row="1">
            <pullToRefresh:SfPullToRefresh
                IsRefreshing="{Binding IsRefreshing}"
                RefreshCommand="{Binding RefreshRoomsCommand}">
                <pullToRefresh:SfPullToRefresh.PullableContent>
                    <Grid>
                        <!-- EMPTY STATE -->
                        <VerticalStackLayout IsVisible="{Binding IsEmpty}"
                                             HorizontalOptions="Center"
                                             VerticalOptions="Center"
                                             Spacing="14"
                                             Padding="30">
                            <Label Text="{x:Static fonts:FluentUI.search_24_regular}"
                                   FontFamily="{x:Static fonts:FluentUI.FontFamily}"
                                   FontSize="40"
                                   TextColor="{StaticResource Gray400}"
                                   HorizontalOptions="Center" />
                            <Label Text="Chưa có phòng trọ nào"
                                   Style="{StaticResource Title3}"
                                   FontAttributes="Bold"
                                   HorizontalTextAlignment="Center" />
                            <Label Text="Hiện chưa có phòng trọ đã xác minh còn trống quanh ICTU. Vui lòng quay lại sau."
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray400}}"
                                   HorizontalTextAlignment="Center" />
                            <Button Text="Tải lại danh sách"
                                    Command="{Binding LoadRoomsCommand}"
                                    BackgroundColor="{StaticResource Primary}"
                                    TextColor="{StaticResource White}"
                                    CornerRadius="20"
                                    HeightRequest="40"
                                    Padding="20, 0"
                                    HorizontalOptions="Center" />
                        </VerticalStackLayout>

                        <!-- LIST OF ROOM CARDS (US02 AC2 & AC3 Infinite Scroll) -->
                        <CollectionView ItemsSource="{Binding Rooms}"
                                        IsVisible="{Binding IsEmpty, Converter={StaticResource InvertedBoolConverter}}"
                                        SelectionMode="None"
                                        RemainingItemsThreshold="3"
                                        RemainingItemsThresholdReachedCommand="{Binding LoadMoreRoomsCommand}"
                                        Margin="16, 8, 16, 16">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout Orientation="Vertical" ItemSpacing="12" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="models:RoomListing">
                                    <controls:RoomCardView />
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <!-- INFINITE SCROLL FOOTER -->
                            <CollectionView.Footer>
                                <VerticalStackLayout Padding="16" Spacing="8" HorizontalOptions="Center">
                                    <ActivityIndicator IsRunning="{Binding IsLoadingMore}"
                                                       IsVisible="{Binding IsLoadingMore}"
                                                       Color="{StaticResource Primary}" />
                                    <Label Text="Đang tải thêm phòng quanh ICTU..."
                                           IsVisible="{Binding IsLoadingMore}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray500}"
                                           HorizontalOptions="Center" />
                                    <Label Text="✓ Đã hiển thị tất cả phòng trọ khả dụng"
                                           IsVisible="{Binding HasMoreItems, Converter={StaticResource InvertedBoolConverter}}"
                                           FontSize="12"
                                           TextColor="{StaticResource Gray400}"
                                           HorizontalOptions="Center"
                                           Margin="0, 10, 0, 20" />
                                </VerticalStackLayout>
                            </CollectionView.Footer>

                        </CollectionView>
                    </Grid>
                </pullToRefresh:SfPullToRefresh.PullableContent>
            </pullToRefresh:SfPullToRefresh>
        </Grid>

    </Grid>

</ContentPage>
